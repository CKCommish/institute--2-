---
/* ONE PILOT. ONE ANATOMY.

   Round 4 gave each pilot its own shape and the critic named the cost: four
   institutions that made the same kind of commitment rendered as four
   unrelated objects, so a reader had to re-learn where PROBLEM / APPROACH /
   GOAL live four times. The target was never four shapes. It is one shape,
   ranked.

   THE ANATOMY, identical on all four:

     1  a full-bleed frame
     2  the nameplate on its top edge      index · partner · sector
     3  the name and its one line at its foot
     4  the argument on ground beneath it, always in this order and always on
        the same rails: PROBLEM and APPROACH as two adjacent columns under
        one hairline, then GOAL alone below them, brass-labelled, hung on the
        left rail.

   THREE DEGREES OF VARIATION, and nothing else:

     RANK    band height and the rung the name is set at, descending
             86vh · 66vh · 54vh · 42vh   and   head · feature · head · sub
     GROUND  the series opens on cream and closes on a plate; the two middle
             cards stand on page ground. Two ground events, at the two ends.
     THE ONE AMPLIFICATION  pilot 01's GOAL — the field every card ends on —
             is the sentence this page exists to make, so on the anchor alone
             that field is set at poster size THROUGH a twelve-month axis.
             It is the same field, in the same place in the same anatomy,
             said loudly once.

   Held constant: the palette, the nameplate grammar, one line per field, the
   scrim placement, and the order the three fields are read in. */
import Figure from './Figure.astro';
import Scale from './pilots-scale.astro';

const {
  pilot: p,
  rank = 2,
  grade = 0.5,
  focal = '50% 50%',
  parallax = 5,
  loading = 'lazy',
} = Astro.props;

const hid = `${p.id}-h`;

/* The descent, stated once. --step-feature is spent on 02 — the page's one
   series-breaker — and nowhere else; --step-poster belongs to the masthead
   and to the anchor's amplified GOAL. */
const rungs = { 1: 'display--head', 2: 'display--feature', 3: 'display--head', 4: 'display--sub' };
const rung = rungs[rank] ?? 'display--head';

/* Every frame is now written on in the same two places — the rail at the top
   edge, the name at the foot — so every frame takes the same ink, placed
   once, by Figure. One system, one placement. The ramp's HEIGHT is the one
   thing that has to track the ranking: a name set on the foot of a 42vh
   frame sits proportionally higher in it than the same name on an 86vh
   frame, so the ramp opens as the frame shortens. Measured against
   photo-meter, not chosen. */
const RISE = { 1: 0.46, 2: 0.60, 3: 0.68, 4: 0.78 };
const SCRIM = { scrim: 'bottom', reach: 1.0, rise: RISE[rank] ?? 0.6, ink: 0.98, vig: 0.5 };
---
<article class:list={['pcard', `pcard--r${rank}`]} id={p.id} aria-labelledby={hid}>
  <div class="band">
    <!-- WHAT THE PHOTOGRAPH IS. Three of these four photographs are of
         somewhere and something other than the pilot they illustrate, and a
         name set across a full-bleed frame reads as that frame's caption
         whether or not it was meant as one. The credit is the house remedy;
         refs/PHOTO-FACTS.md names the misreading it prevents. -->
    <Figure
      src={p.image} alt="" ratio="auto"
      grade={grade} focal={focal} parallax={parallax} loading={loading}
      credit={p.credit} creditPos="bottom-right"
      scrim={SCRIM.scrim} reach={SCRIM.reach} rise={SCRIM.rise} ink={SCRIM.ink} vig={SCRIM.vig}
    />

    <p class="shell rail" data-reveal>
      <span class="index">{p.index}</span>
      <span class="eyebrow rail__partner">{p.partner}</span>
      <span class="label rail__field">{p.field}</span>
    </p>

    <!-- a TRIGGER, not a fade: neutralised below, so the masked name lands on
         the earlier [data-reveal] threshold and the line hangs off that beat -->
    <div class="shell say" data-reveal>
      <h2 class:list={['display', rung, 'say__t', 'lines']} id={hid}>{p.title}</h2>
      <p class="say__tag">{p.tagline}</p>
    </div>
  </div>

  {rank === 1 ? (
    <div class="print on-cream">
      <!-- ── THE PAGE TURNED OVER ──────────────────────────────────────
           This page's one exception, spent once, on the one sentence it
           exists to make. Everything on this site is cream on navy; the
           institute talking. Pilot 01's outcome is not the institute talking
           — it is the thing that will be true or not true in ninety days,
           and the thing the page promises to publish either way. So it is
           PRINTED. The anatomy does not change: problem, approach, then
           goal. Only the goal's size and the ground under it do. -->
      <div class="shell arg">
        <span class="arg__rule" aria-hidden="true" data-wipe="center"></span>
        <dl class="arg__setup" data-seq="150" data-seq-from="80">
          <div data-reveal><dt class="label">Problem</dt><dd>{p.problem}</dd></div>
          <div data-reveal><dt class="label">Approach</dt><dd>{p.approach}</dd></div>
        </dl>
      </div>

      <!-- THE SENTENCE, SET THROUGH THE AXIS.
           The outcome is a claim about a quantity, so the page stops stating
           the quantity in words and draws it: a twelve-month axis run at the
           page's own measure, margin to margin, and the sentence set across
           it. The head starts on the page's left rail like every other line
           on this site; the tail starts at the closing edge of the ninety-day
           span, which is the x of the numeral 3. You do not read that ninety
           days is a quarter of the window. You see it.
           Round 7: the axis used to be composed against the VIEWPORT — its 0
           at x=11, its tail hanging at x=357 on no rail — and it was the one
           object on the site with no grid under it. The idea is unchanged.
           It is on the armature now. -->
      <div class="shell measure">
        <p class="label label--brass measure__gl" data-reveal>Goal</p>
        <p class="display display--poster measure__g" data-reveal="90">{p.goalHead ?? p.goal}</p>
        <Scale />
        {p.goalTail && (
          <p class="display display--poster measure__g measure__g--hang" data-settle="0.62">{p.goalTail}</p>
        )}
      </div>
    </div>
  ) : (
    <div class="shell argwrap">
      <div class:list={['arg', 'arg--std', rank === 4 && 'arg--plate', rank === 4 && 'on-plate']}>
        <span class="arg__rule" aria-hidden="true" data-wipe="center"></span>
        <dl class="arg__setup" data-seq="150" data-seq-from="80">
          <div data-reveal><dt class="label">Problem</dt><dd>{p.problem}</dd></div>
          <div data-reveal><dt class="label">Approach</dt><dd>{p.approach}</dd></div>
        </dl>
        <div class="arg__goal" data-reveal="120">
          <p class="label label--brass">Goal</p>
          <p class="bridge bridge--fg arg__g">{p.goal}</p>
        </div>
      </div>
    </div>
  )}
</article>

<style>
  /* overflow-x: clip, not hidden — it clips the frame's full-bleed ink ramp
     without making the card a scroll container. */
  .pcard { scroll-margin-top: calc(var(--nav-h) + 0.5rem); position: relative; overflow-x: clip; }

  /* ── The frame ────────────────────────────────────────────────────
     Four rows: rail on the top edge, the name on the foot. Identical on all
     four cards; only --band changes. */
  .band {
    position: relative;
    isolation: isolate;
    /* The foot of the frame belongs to the photograph's credit, which is
       painted by the absolutely-positioned figure. This padding lifts the
       name clear of it — without it the credit reads as a third line of the
       tagline, the caption misreading PHOTO-FACTS exists to prevent. */
    padding-bottom: clamp(1.7rem, 3.4vw, 3rem);
    min-height: var(--band, clamp(19rem, 48vh, 28rem));
    display: grid;
    grid-template-rows: auto auto 1fr auto;
  }
  /* THE RANKING, and it is the only thing that separates one card from the
     next: 86 → 66 → 54 → 42 vh, one step apart the whole way down. */
  .pcard--r1 { --band: clamp(31rem, 86vh, 48rem); }
  .pcard--r2 { --band: clamp(24rem, 66vh, 36rem); }
  .pcard--r3 { --band: clamp(21rem, 54vh, 30rem); }
  .pcard--r4 { --band: clamp(17rem, 42vh, 25rem); }

  /* padding lives on the children: the fill Figure is positioned against the
     band's padding box, so padding here would inset the photograph. */
  .rail, .say { position: relative; z-index: 1; }

  /* ── Nameplate ────────────────────────────────────────────────────
     Three registers and nothing else: brass numeral, the partner as this
     card's one eyebrow, the sector as a dim label. */
  .rail {
    margin: 0;
    padding-top: clamp(1.35rem, 2.6vw, 2.25rem);
    display: flex;
    align-items: baseline;
    gap: 1.15ch;
    grid-row: 1;
  }
  .rail__field { margin-left: auto; text-align: right; white-space: nowrap; }

  .say {
    grid-row: 4;
    padding-bottom: clamp(1.75rem, 3.4vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 0.75rem;
    align-items: start;
  }
  .say__t { line-height: 0.94; letter-spacing: -0.026em; text-wrap: initial; }
  /* the small serif display rung wants less negative tracking and more
     leading than the poster rung does */
  .pcard--r4 .say__t { line-height: 1.04; letter-spacing: -0.012em; }
  .pcard--r2 .say__t { line-height: 1.0; letter-spacing: -0.02em; }
  .say__tag {
    margin: 0;
    padding-bottom: 0;
    max-width: 34ch;
    font-size: var(--step-lede);
    line-height: 1.45;
    color: var(--fg-mute);
    text-wrap: pretty;
  }

  /* ── THE ARGUMENT ─────────────────────────────────────────────────
     One block, four times, same rails: a hairline, two clauses side by side
     under it, the outcome alone beneath them. */
  .argwrap { padding-block: clamp(1.5rem, 3vw, 2.4rem) clamp(2.25rem, 4.5vw, 3.75rem); }
  .arg {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: clamp(1.4rem, 2.8vw, 2.3rem);
  }
  .arg__rule {
    height: 1px; background: var(--rule);
    margin-bottom: calc(clamp(1.4rem, 2.8vw, 2.3rem) * -1 + clamp(1rem, 2vw, 1.6rem));
  }
  /* two halves of one sentence: adjacent, sharing a gutter rule, held to the
     left two thirds so what follows them lands as the conclusion it is */
  .arg__setup {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 24rem) minmax(0, 24rem);
    column-gap: clamp(1.75rem, 3.4vw, 3.25rem);
    align-items: start;
  }
  .arg__setup > div + div {
    border-left: 1px solid var(--rule-soft);
    padding-left: clamp(1.75rem, 3.4vw, 3.25rem);
    margin-left: calc(clamp(1.75rem, 3.4vw, 3.25rem) * -1);
  }
  /* the outcome, on the left rail, under both clauses */
  .arg__goal { display: grid; gap: clamp(0.6rem, 1.2vw, 0.95rem); }
  .arg__goal .label { color: var(--brass); }
  .arg__g { margin: 0; max-width: 26ch; }

  /* ── Field grammar, shared ───────────────────────────────────────── */
  .arg__setup > div { display: grid; gap: 0.55rem; align-content: start; }
  .arg dt { color: var(--brass); }
  .arg dd {
    margin: 0;
    color: var(--fg-mute);
    font-size: var(--step-body);
    line-height: 1.45;
    max-width: 34ch;
    text-wrap: pretty;
  }

  /* ── The close, on a plate ────────────────────────────────────────
     The series opens on cream and closes on an object set down on the page,
     with its own edges. Two ground events, at the two ends of the run; the
     anatomy inside them is the same anatomy. */
  .arg--plate {
    /* an object, not a wide box with a hole in it: the plate is cut to the
       measure of the argument it carries, so its right edge closes on the
       text rather than on the page margin */
    width: min(100%, 58rem);
    background: var(--bg);
    border: 1px solid var(--rule-soft);
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3.4vw, 3rem) clamp(1.75rem, 3.4vw, 2.75rem);
  }

  /* ── THE PRINT ────────────────────────────────────────────────────
     Full bleed, navy on cream, once on this page. It lands directly off the
     foot of the largest photograph on the site, so the change of value is
     also a change of medium: a photograph, then a printed page. */
  .print {
    border-top: 1px solid color-mix(in srgb, var(--ink-900) 22%, transparent);
    padding-block: clamp(1.6rem, 3vw, 2.6rem) clamp(2.6rem, 5vw, 4.5rem);
  }

  /* ── THE MEASURE ──────────────────────────────────────────────────
     The axis is the widest rule on the site — and it now begins and ends on
     the page's own margins, so its 0 sits on the same x as every other line
     on every page and its 12 closes on the right one. The tail of the
     sentence starts at 25% of that measure: the closing edge of the
     ninety-day span, the x of the numeral 3, and a real column on the grid. */
  .measure {
    position: relative;
    margin-top: clamp(1.9rem, 4vw, 3.4rem);
  }
  .measure__gl { margin: 0 0 clamp(0.5rem, 1vw, 0.8rem); }
  .measure__g {
    margin: 0;
    max-width: none;
    color: var(--fg);
    line-height: 0.98;
    letter-spacing: -0.024em;
    text-wrap: initial;
    --settle-origin: 0% 100%;
    --settle-shift: 2.4vh;
  }
  /* the axis is the space between the two halves of the sentence */
  .measure :global(.mscale) { margin-block: clamp(0.7rem, 1.6vw, 1.25rem) 0; }
  /* …and the tail hangs off the closing edge of the ninety-day span */
  .measure__g--hang { margin-left: 25%; margin-top: clamp(0.15rem, 0.5vw, 0.4rem); }

  /* ── Motion ───────────────────────────────────────────────────────
     The masked name has to lead. .say is a bare trigger so it fires on the
     earlier [data-reveal] threshold; the tagline hangs off that same beat. */
  .say[data-reveal] { opacity: 1; transform: none; transition: none; will-change: auto; }
  .say__tag {
    opacity: 0;
    transform: translate3d(0, 12px, 0);
    transition:
      opacity 680ms var(--ease-out) var(--tag-delay, 190ms),
      transform 900ms var(--ease-out) var(--tag-delay, 190ms);
  }
  .say.is-in .say__tag { opacity: 1; transform: none; }
  .pcard--r1 { --tag-delay: 620ms; }
  .pcard--r1 .say__t :global(.line > span) { transition-duration: 1400ms; }

  @media (prefers-reduced-motion: reduce) {
    .say__tag { opacity: 1; transform: none; transition: none; }
  }

  /* ── Narrow ───────────────────────────────────────────────────────── */
  @media (max-width: 1080px) {
    .arg__setup { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  @media (max-width: 860px) {
    /* The credit wraps to two lines at this measure and the say block sits
       far closer to the frame's foot, so the shelf has to be deeper here. */
    .band { padding-bottom: clamp(2.7rem, 8vw, 3.4rem); }

    /* Below ~700px the display range compresses and size alone stops reading
       as rank, so the descent is carried by frame height as well. */
    .pcard--r1 { --band: clamp(25rem, 68vh, 34rem); }
    .pcard--r2 { --band: clamp(22rem, 58vh, 30rem); }
    .pcard--r3 { --band: clamp(19rem, 50vh, 26rem); }
    .pcard--r4 { --band: clamp(15rem, 40vh, 21rem); }

    .rail { gap: 0.9ch; }
    /* the axis stays margin to margin and the tail stays on the ninety-day
       edge; only the type comes down a rung so the head sets inside it */
    .measure__g { font-size: clamp(1.4rem, 0.7rem + 3.5vw, 2.4rem); }
    .measure__g--hang { margin-top: clamp(0.4rem, 1.6vw, 0.8rem); }
    /* the axis caption is a footnote on the axis, not a line of the sentence.
       At this width it falls back to the flow and landed BETWEEN the two
       halves of the goal — so it is hung out of flow at the foot of the whole
       block instead, and the sentence closes uninterrupted. */
    .measure { padding-bottom: 1.9rem; }
    .measure :global(.mscale) { position: static; }
    .measure :global(.mscale__cap) {
      /* the shell's own left margin — an absolutely positioned child is laid
         against the padding box, so 0 would be the page edge */
      position: absolute; left: var(--gutter); right: auto; bottom: 0;
      margin: 0; text-align: left;
    }
  }

  @media (max-width: 560px) {
    .arg__setup { grid-template-columns: minmax(0, 1fr); row-gap: clamp(1.1rem, 3vw, 1.5rem); }
    .arg__setup > div + div { border-left: 0; padding-left: 0; margin-left: 0; }
    .arg dd { max-width: 38ch; }
  }
</style>
