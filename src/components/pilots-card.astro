---
/* THE CARD — the top layer of /pilots/, and only the top layer.

   The brief asks for "Cards first. Detail on click or a short dedicated
   block," and it caps a pilot card at problem / approach / goal, one line
   each. Every earlier round read that cap as a cap on the PAGE, and built
   four two-viewport objects that between them told a funder twenty-five
   words. The cap is here, on the card, where it belongs; the detail it was
   always the summary OF is in pilots-detail.astro, below.

   So this is a card and behaves like one: it is a cell in a four-up
   comparison grid, not a scene. Four of them fit on one screen, which is
   the only way a reader can hold "which of these four" in their head at
   once — the thing the old page made impossible by spending two viewports
   per pilot. No photograph, no display rung above --step-sub, no motion
   beyond the hairline: the picture and the argument are downstairs.

   The anatomy, identical on all four:

     rail    numeral · sector
     who     the partner, and the qualifier that says nobody has signed
     name    the title, one serif rung
     tag     one line
     fields  PROBLEM · APPROACH · GOAL, one line each, in that order
     door    the anchor to this pilot's detail block

   The only variable is the numeral. Four institutions making the same kind
   of commitment should look like four of the same thing. */
const { pilot: p } = Astro.props;
---
<article class="card">
  <p class="card__rail">
    <span class="index card__i">{p.index}</span>
    <span class="label card__field">{p.field}</span>
  </p>

  <!-- WHOSE PILOT THIS IS, AND HOW FAR ALONG. Two of the four values in
       this slot are living, identifiable public officials. A bare name in a
       partner slot asserts a partnership; nobody has signed one. The
       qualifier rides the name everywhere it appears on this site. -->
  <p class="card__who">
    <span class="eyebrow card__partner">{p.partner}</span>
    <span class="label card__q">Proposed</span>
  </p>

  <h3 class="display display--sub card__t">
    <a class="card__a" href={`#${p.id}`}>{p.title}</a>
  </h3>
  <p class="card__tag">{p.tagline}</p>

  <dl class="card__f">
    <div><dt class="label">Problem</dt><dd>{p.problem}</dd></div>
    <div><dt class="label">Approach</dt><dd>{p.approach}</dd></div>
    <div><dt class="label label--brass">Goal</dt><dd class="card__goal">{p.goal}</dd></div>
  </dl>

  <p class="card__door" aria-hidden="true">
    <span>Detail</span>
    <svg class="arrow card__arrow" viewBox="0 0 22 10">
      <path d="M16 1l5 4-5 4M21 5H0" stroke="currentColor" stroke-width="1" fill="none"/>
    </svg>
  </p>
</article>

<style>
  /* A cell, not a plate. The grid's own hairlines draw the four; giving
     each one edges of its own would make the comparison read as four
     objects again, which is the thing this layer exists to undo. */
  .card {
    position: relative;
    /* the six rows are the PAGE's rows, inherited through the cell: every
       card's PROBLEM sits on the same line as every other card's. The block
       padding is therefore carried as margins on the first and last rows —
       padding on a subgrid item would shift its rows out of the shared
       track and undo the alignment it is here to get. */
    grid-row: 1 / -1;
    display: grid;
    grid-template-rows: subgrid;
    row-gap: 0;
    padding-right: clamp(1rem, 2.4vw, 2.6rem);
  }

  /* the brass hairline that wipes along the cell's own top rule — the same
     gesture the homepage register uses, so the two card layers rhyme */
  .card::before {
    content: ''; position: absolute; top: -1px; left: 0; right: 0; height: 1px;
    background: var(--brass);
    transform: scaleX(0); transform-origin: right;
    transition: transform 620ms var(--ease-out);
    pointer-events: none;
  }

  .card__rail {
    margin: clamp(1.4rem, 2.4vw, 2rem) 0 0;
    display: flex; align-items: baseline; gap: 1ch;
  }
  .card__field { margin-left: auto; white-space: nowrap; }

  .card__who {
    margin: clamp(0.9rem, 1.8vw, 1.35rem) 0 0;
    display: flex; align-items: baseline; gap: 0 0.85ch; flex-wrap: wrap;
    min-width: 0;
  }
  .card__partner { transition: color 380ms var(--ease-out); }
  .card__q { color: var(--fg-meta); white-space: nowrap; opacity: 0.72; }
  .card__q::before { content: '\00b7'; margin-right: 0.85ch; }

  .card__t {
    margin: 0.5rem 0 0;
    line-height: 1.06;
    letter-spacing: -0.014em;
  }
  /* the whole cell is the target; the name carries the accessible name.
     The padding is a tap target, not space: a 22px line box is under the
     24px floor the audit holds mobile links to, and the negative margin
     gives the row back so the type does not move. */
  .card__a {
    color: inherit; text-decoration: none;
    display: inline-block;
    padding-block: 0.32rem; margin-block: -0.32rem;
  }
  .card__a::after { content: ''; position: absolute; inset: 0; }
  .card__a:focus-visible { outline: none; }
  .card:has(.card__a:focus-visible) { outline: 2px solid var(--brass); outline-offset: 8px; }

  .card__tag {
    margin: 0.6rem 0 0;
    max-width: 32ch;
    color: var(--fg-mute);
    font-size: var(--step-body);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* PROBLEM · APPROACH · GOAL, stacked, one line each, on their own rule.
     Stacked and not columned: at a quarter of the page's width a two-up
     setup wraps every field to three lines and the "one line each" the
     brief asks for stops being visible as a discipline. */
  .card__f {
    margin: clamp(1.15rem, 2.2vw, 1.7rem) 0 0;
    padding-top: clamp(1rem, 1.8vw, 1.4rem);
    border-top: 1px solid var(--rule-soft);
    display: grid;
    row-gap: clamp(0.7rem, 1.3vw, 1rem);
  }
  .card__f > div { display: grid; gap: 0.3rem; }
  .card__f dd {
    margin: 0;
    color: var(--fg-mute);
    font-size: var(--step-body);
    line-height: 1.45;
    max-width: 36ch;
    text-wrap: pretty;
  }
  /* the outcome is the one line a funder is being asked to believe */
  .card__goal { color: var(--fg); }

  .card__door {
    margin: clamp(1.2rem, 2.2vw, 1.7rem) 0 clamp(1.3rem, 2.2vw, 1.8rem);
    align-self: end;
    display: flex; align-items: center; gap: 0.75ch;
    font-size: var(--step-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-meta);
    transition: color 380ms var(--ease-out);
  }
  .card__arrow {
    width: 20px; color: var(--brass);
    opacity: 0; transform: translateX(-8px);
    transition: opacity 380ms var(--ease-out), transform 520ms var(--ease-out);
  }

  /* On a touch screen there is no hover, so the arrow — the only mark that
     says the whole cell is a door — never appeared at all: the door read as
     a static block of text. Where there is no hover it is simply drawn, and
     the hover choreography below never applies. Same rule as .link's
     underline, which is already handled this way in base.css. */
  @media (hover: none) {
    .card__arrow { opacity: 1; transform: none; }
  }

  @media (hover: hover) {
    .card:hover::before { transform: scaleX(1); transform-origin: left; }
    .card:hover .card__partner { color: var(--brass); }
    .card:hover .card__door { color: var(--fg); }
    .card:hover .card__arrow { opacity: 1; transform: none; }
  }
  .card:focus-within::before { transform: scaleX(1); transform-origin: left; }
  .card:focus-within .card__arrow { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .card::before, .card__arrow, .card__door, .card__partner { transition-duration: 1ms; }
  }

  @media (max-width: 620px) {
    .card { padding-right: 0; }
    .card__tag, .card__f dd { max-width: 44ch; }
  }
</style>
