---
import { cta, site, nav, forum } from '../data/site.js';
import Mark from './chrome-mark.astro';
const year = new Date().getFullYear();
const { pathname } = Astro.url;

const isHere = (href) => pathname === href || (href !== '/' && pathname.startsWith(href));

/* Two modes, and they are not the same object.
   Everywhere but /partner/ the footer is the site's one conversion scene:
   the ask, the address, the arrow — the first and only time you meet it.
   On /partner/ the ask has already been made at the top of the page, at full
   size, so the footer must not sing it again. It collapses to a coda: one
   line of display type on a hairline. No eyebrow, no address, no gloss. */
const coda = isHere(cta.href) ? { line: 'Come to the Forum.', href: '/forum/' } : null;

/* ONE ask, ONE action. The close used to print the ask twice — the display
   line on the left and a 26px underlined address on the right, on the same
   row, at near-equal optical weight. There is now a single lit object: the
   line, with its own verb under it. The address lives on /partner/, which is
   where the line goes. Above the line, the bridge rung, so the close climbs
   11px → 27px → 86px instead of jumping. */
const scene = {
  kicker: 'Work with us',
  bridge: 'Funding, the technology, or the ground to run it on.',
  line: cta.label + '.',
  href: cta.href,
  action: 'Start the conversation',
};

/* The one quieter door the brief allows, set two ranks below the ask so it
   can never read as a second focal point. It is NULL on /forum/, because a
   door labelled "Inquire about the Lion Forum" pointing at /forum/ is the
   page you are standing on: on that one route it was a no-op dressed as a
   second destination. No copy is added to replace it — the ask above it is
   the scene, and the route row below reaches /forum/ in any case. */
const second = isHere('/forum/') ? null : { k: forum.access, t: 'Inquire about the Lion Forum', href: '/forum/' };

/* THE ROUTE ROW — every route, every page, in one fixed order.

   What it was: `nav.filter(not-here && not-a-door-above).slice(0, 2)` — a
   rotating two-item slice whose contents depended on which doors the ask
   band happened to be showing. Measured at 1440 and 390: the slice always
   resolved to [Institute, Pilots], because the two doors above always took
   Forum and Partner out of the list — so /people/ was out of footer reach
   on four of the seven routes (/, /forum/, /partner/, /404), and the three
   that were complete (/institute/, /pilots/, /people/) were complete only
   because the page you were standing on happened to free a slot.
   Completeness was an accident of the slice, not a decision.

   What the slice did NOT do, contra one reading of it: strand /forum/ and
   /partner/ on the homepage. Both are reachable from the homepage close —
   they are the two doors in the band above. /people/ was the only loss.

   It matters most where there is least: at 390px the bar's links AND the
   pill are display:none (Nav.astro, the 860px query) and the only route
   control is a burger that needs JavaScript. With script off, on a phone,
   this row is the site's entire navigation.

   So it is now the same object as the bar: the five destinations, always,
   in nav order plus the ask, at the house .label rung — not a slice, not a
   mega-footer, not a new type scale. The current page stays in the row and
   is marked, exactly as the bar marks it, so the row does not move under a
   reader who is walking the site. Home is the wordmark to its left, which
   has always been a link. */
const footNav = [...nav, cta];
---
<footer class:list={['foot', { 'foot--coda': !!coda }]}>
  {!coda && <span class="foot__glow" aria-hidden="true"></span>}

  {coda ? (
    <div class="shell coda">
      <span class="coda__rule" data-wipe="left" aria-hidden="true"></span>
      <a class="coda__a" href={coda.href}>
        <span class="display coda__line">{coda.line}</span>
        <svg class="arrow coda__arrow" viewBox="0 0 22 10" aria-hidden="true">
          <path d="M16 1l5 4-5 4M21 5H0" stroke="currentColor" stroke-width="1" fill="none"/>
        </svg>
      </a>
    </div>
  ) : (
    <div class="shell foot__scene">
      <p class="eyebrow foot__kicker" data-reveal>{scene.kicker}</p>
      <p class="bridge foot__bridge" data-reveal="110">{scene.bridge}</p>

      <a class="foot__cta" href={scene.href}>
        <span class="display display--poster foot__line lines">{scene.line}</span>
        <span class="foot__go">
          <svg class="arrow foot__arrow" viewBox="0 0 22 10" aria-hidden="true">
            <path d="M16 1l5 4-5 4M21 5H0"/>
          </svg>
          <span class="label label--lit foot__go-t">{scene.action}</span>
        </span>
      </a>

      {second && (
        <a class="foot__second" href={second.href} data-reveal="380">
          <span class="label foot__second-k">{second.k}</span>
          <span class="foot__second-t">{second.t}</span>
        </a>
      )}
    </div>
  )}

  {/* Corner-anchored utility, set below the header's weight on purpose. */}
  <div class="shell foot__base">
    <span class="foot__rule" aria-hidden="true"></span>

    <div class="foot__row">
      <Mark tone="quiet" class="foot__id tap" />
      <nav class="foot__nav" aria-label="Footer">
        {footNav.map((n) => (
          <a href={n.href}
             class:list={['label', 'foot__nav-a', { 'is-here': isHere(n.href) }]}
             aria-current={isHere(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <span class="label foot__fine tnum">© {year} {site.name}</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative; isolation: isolate; overflow: hidden;
    padding-block: clamp(4rem, 1.6rem + 7.5vw, 9rem) clamp(1.4rem, 2vw, 2rem);
    display: grid; gap: clamp(2.6rem, 4vw, 4.5rem);
  }
  /* One quiet light source so the last scene reads as a scene, not a page end.
     Local to this component — no new token. */
  .foot__glow {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(56% 58% at 86% 26%, color-mix(in srgb, var(--brass) 10%, transparent) 0%, transparent 68%),
      radial-gradient(74% 62% at 6% 98%, color-mix(in srgb, var(--ink-700) 52%, transparent) 0%, transparent 72%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
  }

  /* ── Mode A: the conversion scene ─────────────────────────────────
     One column carries the whole ask — eyebrow, bridge, line, verb — and
     the second column holds only the quiet door, pinned to the bottom of
     the scene so it reads as a footnote to the ask, not a rival to it. */
  .foot__scene {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: clamp(1.1rem, 1.8vw, 1.6rem);
    align-items: end;
  }
  .foot__kicker { grid-column: 1; grid-row: 1; }
  .foot__bridge { grid-column: 1; grid-row: 2; max-width: 34ch; }
  .foot__cta {
    grid-column: 1; grid-row: 3;
    margin-top: clamp(0.6rem, 1.4vw, 1.4rem);
    display: grid; gap: clamp(1.1rem, 2vw, 1.9rem);
    align-content: start; justify-items: start;
  }
  .foot__line { max-width: 11ch; }
  /* .lines masks each line; give descenders room inside the mask. */
  .foot__line :global(.line) { padding-bottom: 0.1em; margin-bottom: -0.1em; }

  /* The house arrow, at the house size. No second arrow construction. */
  .foot__go { display: inline-flex; align-items: center; gap: clamp(0.8rem, 1.5vw, 1.2rem); }
  .foot__arrow { width: clamp(26px, 2.6vw, 34px); color: var(--brass); }
  .foot__go-t { transition: color var(--dur-hover) var(--ease-out); }
  .foot__cta:hover .foot__arrow,
  .foot__cta:focus-visible .foot__arrow { transform: translateX(9px); }
  .foot__cta:hover .foot__go-t,
  .foot__cta:focus-visible .foot__go-t { color: var(--brass); }

  /* Two ranks below the ask. It used to be set at --step-lede, which made the
     quiet door optically HEAVIER than the primary action's verb sitting on the
     same baseline row. Body rung: subordinate at a glance, still a real door. */
  .foot__second {
    grid-column: 2; grid-row: 3; align-self: end; justify-self: end;
    display: grid; gap: 0.6rem; justify-items: end; text-align: right;
    padding-bottom: 0.3rem;
  }
  .foot__second-t {
    font-size: var(--step-body); line-height: 1.35; color: var(--fg-mute);
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--rule);
    transition: color var(--dur-hover) var(--ease-out), border-color var(--dur-hover) var(--ease-out);
  }
  .foot__second:hover .foot__second-t,
  .foot__second:focus-visible .foot__second-t { color: var(--fg); border-bottom-color: var(--brass); }

  /* ── Mode B: the coda ───────────────────────────────────────────────
     A page whose hero already holds the address ends on a note, not on a
     reprise. Rule, one line, arrow in the line. Nothing else. */
  .foot--coda {
    padding-block: clamp(3.2rem, 1.6rem + 4.4vw, 6.5rem) clamp(1.4rem, 2vw, 2rem);
    gap: clamp(3.2rem, 6vw, 6rem);
  }
  .coda { display: grid; gap: clamp(1.2rem, 2.1vw, 1.9rem); }
  .coda__rule { display: block; height: 1px; background: var(--rule); }
  .coda__a {
    display: inline-flex; align-items: baseline; gap: clamp(0.9rem, 2vw, 1.7rem);
    justify-self: start;
  }
  .coda__line {
    font-size: var(--step-head);
    line-height: 1.02; letter-spacing: -0.018em;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .coda__arrow { width: clamp(26px, 2.6vw, 34px); color: var(--brass); align-self: center; }
  .coda__a:hover .coda__line,
  .coda__a:focus-visible .coda__line { color: var(--brass); }
  .coda__a:hover .coda__arrow,
  .coda__a:focus-visible .coda__arrow { transform: translateX(9px); }

  /* ── Base: lockup, two routes, fine print ───────────────────────── */
  .foot__base { display: grid; gap: clamp(0.9rem, 1.6vw, 1.4rem); }
  .foot__rule { display: block; height: 1px; background: var(--rule-soft); }
  .foot__row {
    display: flex; flex-wrap: wrap; align-items: baseline;
    gap: 0.5rem clamp(1.4rem, 3vw, 3rem);
  }
  /* Third child is the copyright. A pair of office locations used to sit
     between the nav and it; neither string was in refs/BRIEF.md or site.js
     and the Institute has published no address, so they are gone. */
  .foot__row > :nth-child(3) { margin-left: auto; }

  /* Wordmark: chrome-mark.astro, same object as the bar.
     Everything else on this row is the house .label register — the footer
     used to invent its own micro scale down here at its own tracking. */
  .foot__nav { display: flex; flex-wrap: wrap; align-items: baseline; gap: clamp(1rem, 2.2vw, 1.8rem); }
  .foot__nav-a {
    padding-block: 0.55rem; margin-block: -0.55rem;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .foot__nav-a:hover,
  .foot__nav-a:focus-visible { color: var(--fg); }
  /* Marked, not removed. The bar's own device for the page you are on:
     no second colour, no rule, no weight change — the brass index the
     rest of the site uses to say "here". */
  .foot__nav-a.is-here { color: var(--fg); }
  .foot__nav-a.is-here::before {
    content: ''; display: inline-block;
    width: 4px; height: 4px; margin-inline-end: 0.55em;
    vertical-align: 0.18em; background: var(--brass);
  }

  @media (max-width: 860px) {
    .foot { gap: clamp(2.4rem, 9vw, 4rem); }
    .foot__scene { grid-template-columns: 1fr; align-items: start; row-gap: clamp(1rem, 3.5vw, 1.6rem); }
    .foot__line { max-width: 10ch; }
    .foot__second {
      grid-column: 1; grid-row: 4;
      justify-self: start; justify-items: start; text-align: left;
      margin-top: clamp(2rem, 8vw, 2.8rem); padding-bottom: 0;
    }
    .foot__row { gap: 0.6rem 1.4rem; }
    /* Five words will not sit beside a 178px wordmark at 390. Own line,
       one wrap at most, same rung. */
    .foot__nav { flex: 1 0 100%; gap: 0.55rem 1.15rem; margin-top: 0.2rem; }
    .foot__row > :nth-child(3) { margin-left: 0; }
    .foot__fine { flex: 1 0 100%; }
    .foot--coda { gap: clamp(4rem, 14vw, 6rem); padding-block-start: clamp(3.5rem, 13vw, 5rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .foot__arrow, .foot__go-t, .foot__second-t, .coda__line, .coda__arrow { transition-duration: 1ms; }
    /* Every hover state still resolves — it just resolves in place. The ink
       lights; the arrow does not travel. Same rule /partner/ holds. */
    .foot__cta:hover .foot__arrow, .foot__cta:focus-visible .foot__arrow,
    .coda__a:hover .coda__arrow, .coda__a:focus-visible .coda__arrow { transform: none; }
  }
</style>
