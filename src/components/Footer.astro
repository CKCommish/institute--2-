---
import { cta, site, nav } from '../data/site.js';
const year = new Date().getFullYear();
const { pathname } = Astro.url;

const isHere = (href) => pathname === href || (href !== '/' && pathname.startsWith(href));

/* Two modes, and they are not the same object.
   Everywhere but /partner/ the footer is the site's one conversion scene:
   the ask, the address, the arrow — the first and only time you meet it.
   On /partner/ the ask has already been made at the top of the page, at full
   size, so the footer must not sing it again. It collapses to a coda: one
   line of display type on a hairline. No eyebrow, no address, no gloss. */
const coda = isHere(cta.href) ? { line: 'Come to the Forum.', href: '/forum/' } : null;

const scene = {
  kicker: 'Work with us',
  line: cta.label + '.',
  href: cta.href,
  action: 'Start the conversation',
  sub: 'Funding, the technology, or the ground to run it on.',
};

/* The base row is a close, not a second header: two destinations, chosen so
   they never repeat the page you are on or the door the scene above opens. */
const skip = coda ? coda.href : cta.href;
const footNav = nav.filter((n) => !isHere(n.href) && n.href !== skip).slice(0, 2);
---
<footer class:list={['foot', { 'foot--coda': !!coda }]}>
  {!coda && <span class="foot__glow" aria-hidden="true"></span>}

  {coda ? (
    <div class="shell coda">
      <span class="coda__rule" aria-hidden="true"></span>
      <a class="coda__a" href={coda.href}>
        <span class="display coda__line">{coda.line}</span>
        <svg class="arrow coda__arrow" viewBox="0 0 22 10" aria-hidden="true">
          <path d="M16 1l5 4-5 4M21 5H0" stroke="currentColor" stroke-width="1" fill="none"/>
        </svg>
      </a>
    </div>
  ) : (
    <div class="shell foot__scene">
      <p class="label foot__kicker" data-reveal>{scene.kicker}</p>

      <a class="foot__cta" href={scene.href}>
        <span class="display display--xl foot__line lines">{scene.line}</span>
        <span class="foot__go">
          <span class="foot__arrow" aria-hidden="true">
            <span class="foot__arrow-line"></span>
            <svg class="foot__arrow-head" viewBox="0 0 11 12"><path d="M4 1.5 9.5 6 4 10.5" stroke="currentColor" stroke-width="1" fill="none"/></svg>
          </span>
          <span class="label foot__go-t">{scene.action}</span>
        </span>
      </a>

      <div class="foot__aside">
        <a class="foot__mail" href={`mailto:${site.email}`} data-reveal="240">{site.email}</a>
        <p class="foot__sub" data-reveal="320">{scene.sub}</p>
      </div>
    </div>
  )}

  <!-- Corner-anchored utility, set below the header's weight on purpose. -->
  <div class="shell foot__base">
    <span class="foot__rule" aria-hidden="true"></span>

    <div class="foot__row">
      <a class="mark foot__id tap" href="/" aria-label={`${site.name} — home`}>
        <span class="mark__a">Lion Forum</span>
        <span class="mark__b">Institute</span>
      </a>
      <nav class="foot__nav" aria-label="Footer">
        {footNav.map((n) => (
          <a href={n.href} class="foot__nav-a">{n.label}</a>
        ))}
      </nav>
      <span class="foot__fine">Hyannis Port · Washington, D.C.</span>
      <span class="foot__fine tnum">© {year} {site.name}</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative; isolation: isolate; overflow: hidden;
    padding-block: clamp(4rem, 1.6rem + 7.5vw, 9rem) clamp(1.4rem, 2vw, 2rem);
    display: grid; gap: clamp(2.6rem, 4vw, 4.5rem);
  }
  /* One quiet light source so the last scene reads as a scene, not a page end.
     Local to this component — no new token. */
  .foot__glow {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(56% 58% at 86% 26%, color-mix(in srgb, var(--brass) 10%, transparent) 0%, transparent 68%),
      radial-gradient(74% 62% at 6% 98%, color-mix(in srgb, var(--ink-700) 52%, transparent) 0%, transparent 72%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
  }

  /* ── Mode A: the conversion scene ───────────────────────────────── */
  .foot__scene {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: clamp(1.5rem, 2.4vw, 2.2rem);
    align-items: end;
  }
  .foot__kicker { grid-column: 1 / -1; }

  .foot__cta { display: grid; gap: clamp(1rem, 1.8vw, 1.7rem); align-content: start; justify-items: start; }
  .foot__line { max-width: 11ch; }
  /* .lines masks each line; give descenders room inside the mask. */
  .foot__line :global(.line) { padding-bottom: 0.1em; margin-bottom: -0.1em; }

  .foot__go { display: inline-flex; align-items: center; gap: clamp(0.7rem, 1.4vw, 1.1rem); }
  .foot__arrow {
    display: flex; align-items: center;
    width: clamp(46px, 6vw, 84px); height: 12px; color: var(--brass);
    flex: none;
    transition: width 620ms var(--ease-out);
  }
  .foot__arrow-line { flex: 1 1 auto; height: 1px; background: currentColor; }
  .foot__arrow-head { width: 11px; height: 12px; margin-left: -1px; flex: none; }
  .foot__go-t { color: var(--fg); transition: color 380ms var(--ease-out); }
  .foot__cta:hover .foot__arrow { width: clamp(62px, 8vw, 112px); }
  .foot__cta:hover .foot__go-t { color: var(--brass); }

  .foot__aside { display: grid; gap: clamp(0.75rem, 1.4vw, 1.1rem); justify-items: end; text-align: right; padding-bottom: 0.35rem; }
  .foot__mail {
    font-size: clamp(1.05rem, 0.82rem + 0.85vw, 1.62rem);
    letter-spacing: -0.012em; line-height: 1.15;
    color: var(--cream);
    padding-bottom: 0.34rem;
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 55%, transparent);
    transition: color 380ms var(--ease-out), border-color 380ms var(--ease-out);
    overflow-wrap: anywhere;
  }
  .foot__mail:hover { color: var(--brass); border-bottom-color: var(--brass); }
  .foot__sub { color: var(--fg-mute); font-size: var(--step-xs); max-width: 26ch; }

  /* ── Mode B: the coda ───────────────────────────────────────────────
     A page whose hero already holds the address ends on a note, not on a
     reprise. Rule, one line, arrow in the line. Nothing else. */
  .foot--coda {
    padding-block: clamp(3.2rem, 1.6rem + 4.4vw, 6.5rem) clamp(1.4rem, 2vw, 2rem);
    gap: clamp(3.2rem, 6vw, 6rem);
  }
  .coda { display: grid; gap: clamp(1.2rem, 2.1vw, 1.9rem); }
  .coda__rule { display: block; height: 1px; background: var(--rule); }
  .coda__a {
    display: inline-flex; align-items: baseline; gap: clamp(0.9rem, 2vw, 1.7rem);
    justify-self: start;
  }
  .coda__line {
    font-size: clamp(1.85rem, 1.2rem + 2.1vw, 3.3rem);
    line-height: 1.02; letter-spacing: -0.018em;
    transition: color 380ms var(--ease-out);
  }
  .coda__arrow { width: clamp(26px, 2.6vw, 34px); color: var(--brass); align-self: center; }
  .coda__a:hover .coda__line { color: var(--brass); }
  .coda__a:hover .coda__arrow { transform: translateX(9px); }

  /* ── Base: lockup, two routes, fine print ───────────────────────── */
  .foot__base { display: grid; gap: clamp(0.9rem, 1.6vw, 1.4rem); }
  .foot__rule { display: block; height: 1px; background: var(--rule-soft); }
  .foot__row {
    display: flex; flex-wrap: wrap; align-items: baseline;
    gap: 0.5rem clamp(1.4rem, 3vw, 3rem);
  }
  .foot__row > :nth-child(3) { margin-left: auto; }

  /* Same lockup as the header — the brand is one object. */
  .mark {
    display: inline-flex; align-items: baseline; gap: 0.5ch;
    font-family: var(--sans);
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.85rem);
    letter-spacing: 0.15em; text-transform: uppercase;
    line-height: 1; white-space: nowrap; color: var(--fg-mute);
    padding-block: 0.5rem; margin-block: -0.5rem;
    transition: color 380ms var(--ease-out);
  }
  .mark__a { font-weight: 600; }
  .mark__b { font-weight: 400; color: var(--fg-faint); transition: color 380ms var(--ease-out); }
  .mark:hover { color: var(--fg); }
  .mark:hover .mark__b { color: var(--fg); }

  /* One step below the header: smaller, tighter, quieter. This is a close. */
  .foot__nav { display: flex; flex-wrap: wrap; align-items: baseline; gap: clamp(1rem, 2.2vw, 1.8rem); }
  /* The house micro-label, not a fourth scale invented down here. */
  .foot__nav-a,
  .foot__fine {
    font-family: var(--sans);
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: 0.155em; text-transform: uppercase;
    line-height: 1;
    color: var(--fg-faint);
  }
  .foot__nav-a {
    padding-block: 0.55rem; margin-block: -0.55rem;
    transition: color 340ms var(--ease-out);
  }
  .foot__nav-a:hover { color: var(--fg); }

  @media (max-width: 860px) {
    .foot { gap: clamp(2.4rem, 9vw, 4rem); }
    .foot__scene { grid-template-columns: 1fr; align-items: start; row-gap: clamp(1.6rem, 6vw, 2.4rem); }
    .foot__line { max-width: 10ch; }
    .foot__aside { padding-bottom: 0; justify-items: start; text-align: left; }
    .foot__row { gap: 0.6rem 1.4rem; }
    .foot__row > :nth-child(3) { margin-left: 0; }
    .foot__fine { flex: 1 0 100%; }
    .foot--coda { gap: clamp(4rem, 14vw, 6rem); padding-block-start: clamp(3.5rem, 13vw, 5rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .foot__arrow, .foot__go-t, .mark, .mark__b, .coda__line, .coda__arrow { transition-duration: 1ms; }
  }
</style>
