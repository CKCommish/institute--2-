---
import { cta, site, forum } from '../data/site.js';
const year = new Date().getFullYear();
const { pathname } = Astro.url;

/* The footer is the site's one conversion scene, so it never repeats the ask
   you are already standing on. On /partner/ it hands you the quieter door. */
const onPartner = pathname.startsWith(cta.href);
const onForum = pathname.startsWith('/forum/');

const scene = onPartner
  ? { kicker: 'The other door', line: 'Come to the Forum.', href: '/forum/', sub: `${forum.access} · ${forum.place}.` }
  : { kicker: 'Work with us', line: cta.label + '.', href: cta.href, sub: 'Funding, the technology, or the ground to run it on.' };

const aside = onPartner || onForum ? null : { label: forum.cta, href: '/forum/' };
---
<footer class="foot">
  <span class="foot__glow" aria-hidden="true"></span>

  <div class="shell foot__scene">
    <p class="label foot__kicker" data-reveal>{scene.kicker}</p>

    <a class="foot__cta" href={scene.href}>
      <span class="display display--xl foot__line lines">{scene.line}</span>
      <span class="foot__arrow" aria-hidden="true">
        <span class="foot__arrow-line"></span>
        <svg class="foot__arrow-head" viewBox="0 0 14 15"><path d="M5.5 1.5 12 7.5 5.5 13.5" stroke="currentColor" stroke-width="1" fill="none"/></svg>
      </span>
    </a>

    <div class="foot__aside">
      <a class="foot__mail" href={`mailto:${site.email}`} data-reveal="240">{site.email}</a>
      <p class="foot__sub" data-reveal="320">{scene.sub}</p>
      {aside && <a class="label foot__second link" href={aside.href} data-reveal="400">{aside.label}</a>}
    </div>
  </div>

  <div class="shell foot__base">
    <span class="foot__rule" aria-hidden="true"></span>
    <div class="foot__row">
      <a class="foot__id" href="/">{site.name}</a>
      <span class="foot__meta">
        <span>Hyannis Port · Washington, D.C.</span>
        <span class="tnum">© {year}</span>
      </span>
    </div>
  </div>
</footer>

<style>
  /* The close is one block: a big lead-in of ground, the ask, then the legal
     line tucked immediately beneath it. No third stratum, no repeated nav. */
  .foot {
    position: relative; isolation: isolate; overflow: hidden;
    padding-block: clamp(4.5rem, 2rem + 8.5vw, 10.5rem) clamp(1.4rem, 2vw, 2rem);
    display: grid; gap: clamp(2.6rem, 4vw, 4.5rem);
  }
  /* One quiet light source so the last scene reads as a scene, not a page end.
     Local to this component — no new token. */
  .foot__glow {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(56% 58% at 86% 26%, color-mix(in srgb, var(--brass) 10%, transparent) 0%, transparent 68%),
      radial-gradient(74% 62% at 6% 98%, color-mix(in srgb, var(--ink-700) 52%, transparent) 0%, transparent 72%);
    /* Fade the light in from the seam so the footer does not read as a
       lighter rectangle pasted under the scene above it. */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
  }

  .foot__scene {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: clamp(1.5rem, 2.4vw, 2.2rem);
    align-items: end;
  }
  .foot__kicker { grid-column: 1 / -1; }

  .foot__cta { display: grid; gap: clamp(1rem, 1.8vw, 1.7rem); align-content: start; }
  .foot__line { max-width: 11ch; }
  /* .lines masks each line; give descenders room inside the mask. */
  .foot__line :global(.line) { padding-bottom: 0.1em; margin-bottom: -0.1em; }
  .foot__arrow {
    display: flex; align-items: center;
    width: clamp(84px, 10vw, 148px); height: 15px; color: var(--brass);
    transition: transform 620ms var(--ease-out);
  }
  .foot__arrow-line { flex: 1 1 auto; height: 1px; background: currentColor; }
  .foot__arrow-head { width: 14px; height: 15px; margin-left: -1px; flex: none; }
  .foot__cta:hover .foot__arrow { transform: translateX(10px); }

  /* Anchored to the same right edge as the nav and the legal row, so the
     scene reads as two corners with air between them. The address is the
     anchor here — it outranks the supporting line beneath it. */
  .foot__aside { display: grid; gap: clamp(0.75rem, 1.4vw, 1.1rem); justify-items: end; text-align: right; padding-bottom: 0.35rem; }
  .foot__mail {
    font-size: clamp(1.05rem, 0.82rem + 0.85vw, 1.62rem);
    letter-spacing: -0.012em; line-height: 1.15;
    color: var(--cream);
    padding-bottom: 0.34rem;
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 55%, transparent);
    transition: color 380ms var(--ease-out), border-color 380ms var(--ease-out);
    overflow-wrap: anywhere;
  }
  .foot__mail:hover { color: var(--brass); border-bottom-color: var(--brass); }
  .foot__sub { color: var(--fg-mute); font-size: var(--step-xs); max-width: 26ch; }
  .foot__second { color: var(--fg-faint); }
  .foot__second:hover { color: var(--cream); }

  /* ── Corner-anchored utility. Two corners only: the mark, and the fine print. ── */
  .foot__base { display: grid; gap: clamp(0.8rem, 1.3vw, 1.1rem); }
  .foot__rule { display: block; height: 1px; background: var(--rule-soft); }
  .foot__row {
    display: flex; flex-wrap: wrap; align-items: baseline;
    justify-content: space-between;
    gap: clamp(0.8rem, 2vw, 2rem);
  }
  /* The wordmark closes the page, so it is set as a mark, not as fine print. */
  .foot__id {
    font-family: var(--serif); font-weight: 340;
    font-size: clamp(1.15rem, 0.95rem + 0.6vw, 1.55rem);
    letter-spacing: -0.014em; line-height: 1;
    color: var(--fg);
    transition: color 340ms var(--ease-out);
  }
  .foot__id:hover { color: var(--brass); }
  .foot__meta {
    display: inline-flex; gap: clamp(1rem, 2vw, 1.75rem);
    font-size: var(--step-label);
    letter-spacing: 0.115em; text-transform: uppercase;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .foot { gap: clamp(2.4rem, 9vw, 4rem); }
    .foot__scene { grid-template-columns: 1fr; align-items: start; row-gap: clamp(1.6rem, 6vw, 2.4rem); }
    .foot__line { max-width: 10ch; }
    .foot__aside { padding-bottom: 0; justify-items: start; text-align: left; }
    .foot__row { flex-direction: column; align-items: flex-start; }
    .foot__meta { flex-wrap: wrap; white-space: normal; }
  }

  @media (prefers-reduced-motion: reduce) {
    .foot__arrow { transition-duration: 1ms; }
  }
</style>
