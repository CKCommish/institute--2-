---
import { nav, cta, site } from '../data/site.js';
const { pathname } = Astro.url;
const isActive = (href) => pathname === href || (href !== '/' && pathname.startsWith(href));
const ctaActive = isActive(cta.href);
const star = 'M6 0c.55 4.1 1.9 5.45 6 6-4.1.55-5.45 1.9-6 6-.55-4.1-1.9-5.45-6-6 4.1-.55 5.45-1.9 6-6Z';
---
<header class="nav" data-nav>
  <div class="nav__in">
    <a class="mark" href="/" aria-label={`${site.name} — home`}>
      <span class="mark__a">Lion Forum</span>
      <span class="mark__b">Institute</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} class:list={['nav__link', { 'is-active': isActive(n.href) }]}>{n.label}</a>
      ))}
    </nav>

    <a href={cta.href} class:list={['pill', { 'is-active': ctaActive }]}>
      <svg class="star" viewBox="0 0 12 12" aria-hidden="true"><path d={star} fill="currentColor" /></svg>
      <span>{cta.label}</span>
    </a>

    <button class="pill pill--burger" type="button" aria-expanded="false" aria-controls="menu" data-burger>
      <svg class="star" viewBox="0 0 12 12" aria-hidden="true"><path d={star} fill="currentColor" /></svg>
      <span class="pill__t" data-burger-label>Menu</span>
    </button>
  </div>
</header>

<div class="menu" id="menu" hidden data-menu>
  <div class="menu__in">
    <nav class="menu__links" aria-label="Primary">
      {nav.map((n, i) => (
        <a href={n.href} style={`--i:${i}`}><span class="index">{String(i + 1).padStart(2, '0')}</span>{n.label}</a>
      ))}
    </nav>
    <a class="menu__cta" href={cta.href} style={`--i:${nav.length}`}>
      <svg class="star" viewBox="0 0 12 12" aria-hidden="true"><path d={star} fill="currentColor" /></svg>
      {cta.label}
    </a>
    <div class="menu__foot" style={`--i:${nav.length + 1}`}>
      <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      <span>Hyannis Port · Washington, D.C.</span>
    </div>
  </div>
</div>

<style>
  /* The bar has no chrome of its own: no panel, no border, no blur. A wordmark,
     four whisper-quiet labels, and exactly one lit object — the CTA pill. On
     scroll an edgeless scrim keeps type legible; over a cream scene the whole
     bar inverts to ink. --nav-scrim / --nav-fg are local to this file. */
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    height: var(--nav-h);
    color: var(--nav-fg, var(--cream));
    --nav-scrim: var(--ink-900);
    transition: color 420ms var(--ease-out);
    pointer-events: none;
  }
  .nav::before {
    content: ''; position: absolute; inset: 0 0 auto 0;
    height: calc(100% + 3.4rem);
    background: linear-gradient(
      to bottom,
      var(--nav-scrim) 0%,
      color-mix(in srgb, var(--nav-scrim) 82%, transparent) 52%,
      color-mix(in srgb, var(--nav-scrim) 0%, transparent) 100%
    );
    opacity: 0; transition: opacity 460ms var(--ease-out);
    pointer-events: none;
  }
  .nav.is-scrolled::before { opacity: 1; }
  .nav.is-inverted { --nav-fg: var(--ink-900); --nav-scrim: var(--cream); }

  .nav__in {
    position: relative;
    height: 100%;
    max-width: var(--max); margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex; align-items: center; gap: clamp(1rem, 2.6vw, 2.6rem);
  }
  .nav__in > * { pointer-events: auto; }

  /* ── Wordmark: two words, one weight change. No rule, no box. ── */
  .mark {
    display: flex; align-items: baseline;
    gap: 0.5ch;
    margin-right: auto;
    font-family: var(--sans);
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.85rem);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
  .mark__a { font-weight: 600; }
  .mark__b { font-weight: 400; color: color-mix(in srgb, currentColor 42%, transparent); transition: color 420ms var(--ease-out); }
  .mark:hover .mark__b { color: currentColor; }

  /* ── Links: nearly invisible until asked for ── */
  .nav__links { display: flex; align-items: center; gap: clamp(1rem, 2vw, 2.1rem); }
  .nav__link {
    font-size: var(--step-label); font-weight: 500;
    letter-spacing: 0.145em; text-transform: uppercase;
    color: color-mix(in srgb, currentColor 42%, transparent);
    transition: color 340ms var(--ease-out);
    position: relative; padding-block: 0.5rem;
    white-space: nowrap;
  }
  .nav__link::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0.2rem;
    height: 1px; background: currentColor; opacity: 0.5;
    transform: scaleX(0); transform-origin: right;
    transition: transform 460ms var(--ease-out);
  }
  .nav__link:hover { color: currentColor; }
  .nav__link:hover::after, .nav__link.is-active::after { transform: scaleX(1); transform-origin: left; }
  .nav__link.is-active { color: currentColor; }

  /* ── The one lit object in the bar ──
     Hairline brass pill; fills on hover. Radius/fill are local to the chrome —
     no token exists for a pill and none should. */
  .pill {
    display: inline-flex; align-items: center; gap: 0.72ch;
    padding: 0.62em 1.05em 0.6em;
    border: 1px solid color-mix(in srgb, var(--brass) 42%, transparent);
    border-radius: 999px;
    font-size: var(--step-label); font-weight: 500;
    letter-spacing: 0.145em; text-transform: uppercase;
    line-height: 1; white-space: nowrap;
    color: currentColor;
    transition: background-color 420ms var(--ease-out), border-color 420ms var(--ease-out), color 420ms var(--ease-out);
  }
  .pill .star { width: 8px; height: 8px; color: var(--brass); flex: none; transition: transform 620ms var(--ease-out), color 420ms var(--ease-out); }
  .pill:hover { background: var(--brass); border-color: var(--brass); color: var(--ink-900); }
  .pill:hover .star { transform: rotate(90deg); color: var(--ink-900); }
  .pill.is-active { border-color: var(--brass); }
  .nav.is-inverted .pill:hover { color: var(--cream); }

  .pill--burger { display: none; }
  .pill__t { min-width: 4.4ch; text-align: left; }

  @media (max-width: 940px) {
    .nav__links, .nav__in > a.pill:not(.pill--burger) { display: none; }
    .pill--burger { display: inline-flex; }
  }

  /* ── Mobile menu ── */
  .menu {
    position: fixed; inset: 0; z-index: 99;
    background: var(--ink-900); color: var(--cream);
    display: grid; align-items: center;
    opacity: 0; pointer-events: none;
    transition: opacity 420ms var(--ease-out);
  }
  .menu[data-open] { opacity: 1; pointer-events: auto; }
  .menu__in { padding: calc(var(--nav-h) + 2rem) var(--gutter) var(--gutter); width: 100%; }
  .menu__links { display: grid; gap: 0.14em; }
  .menu__links a {
    font-family: var(--serif); font-weight: 320;
    font-size: clamp(2.1rem, 10vw, 3.4rem); line-height: 1.1;
    letter-spacing: -0.022em;
    display: flex; align-items: baseline; gap: 1rem;
    opacity: 0; transform: translateY(14px);
    transition: opacity 520ms var(--ease-out), transform 620ms var(--ease-out);
    transition-delay: calc(var(--i) * 55ms + 80ms);
  }
  .menu__links .index { font-size: 0.62rem; }
  .menu[data-open] .menu__links a { opacity: 1; transform: none; }
  .menu__cta,
  .menu__foot {
    opacity: 0; transform: translateY(14px);
    transition: opacity 520ms var(--ease-out), transform 620ms var(--ease-out);
    transition-delay: calc(var(--i) * 55ms + 80ms);
  }
  .menu[data-open] .menu__cta, .menu[data-open] .menu__foot { opacity: 1; transform: none; }
  .menu__cta {
    margin-top: 2.4rem; display: inline-flex; align-items: center; gap: 0.8ch;
    font-size: var(--step-label); letter-spacing: 0.145em; text-transform: uppercase; font-weight: 500;
    padding-bottom: 0.6rem; border-bottom: 1px solid var(--brass);
  }
  .menu__cta .star { width: 8px; height: 8px; color: var(--brass); flex: none; }
  .menu__foot {
    margin-top: 3.2rem; display: grid; gap: 0.5rem; justify-items: start;
    font-size: var(--step-xs); color: var(--fg-mute);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav, .nav::before, .mark__b, .nav__link::after, .pill, .pill .star,
    .menu, .menu__links a, .menu__cta, .menu__foot { transition-duration: 1ms !important; }
  }
</style>

<script>
  const nav = document.querySelector('[data-nav]');
  const burger = document.querySelector('[data-burger]');
  const burgerLabel = document.querySelector('[data-burger-label]');
  const menu = document.querySelector('[data-menu]');

  /* Scrim + inversion. motion.js also toggles .is-scrolled at the same
     threshold, so the two agree frame to frame. Inversion is local: no
     token or engine change, just a class when a cream scene is under the bar. */
  if (nav) {
    const light = [...document.querySelectorAll('.on-cream')];
    let queued = false;
    const sync = () => {
      queued = false;
      nav.classList.toggle('is-scrolled', window.scrollY > 24);
      const y = nav.offsetHeight * 0.55;
      const inverted =
        !menu?.hasAttribute('data-open') &&
        light.some((el) => {
          const r = el.getBoundingClientRect();
          return r.top <= y && r.bottom >= y;
        });
      nav.classList.toggle('is-inverted', inverted);
    };
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(sync); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    sync();
    nav.dataset.sync = '1';
    window.__navSync = sync;
  }

  if (burger && menu) {
    const set = (open) => {
      burger.setAttribute('aria-expanded', String(open));
      if (burgerLabel) burgerLabel.textContent = open ? 'Close' : 'Menu';
      if (open) { menu.hidden = false; requestAnimationFrame(() => menu.setAttribute('data-open', '')); }
      else { menu.removeAttribute('data-open'); setTimeout(() => { menu.hidden = true; }, 420); }
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (window.__navSync) window.__navSync();
    };
    burger.addEventListener('click', () => set(burger.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => { if (e.target.closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
</script>
