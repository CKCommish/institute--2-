---
import { nav, cta, site } from '../data/site.js';
import Mark from './chrome-mark.astro';
const { pathname } = Astro.url;
const isActive = (href) => pathname === href || (href !== '/' && pathname.startsWith(href));
const ctaActive = isActive(cta.href);
const star = 'M6 0c.55 4.1 1.9 5.45 6 6-4.1.55-5.45 1.9-6 6-.55-4.1-1.9-5.45-6-6 4.1-.55 5.45-1.9 6-6Z';
---
<header class="nav" data-nav>
  <div class="nav__in">
    <Mark tone="lit" class="nav__mark" />

    <nav class="nav__links" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} class:list={['label', 'nav__link', { 'is-active': isActive(n.href) }]} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>

    <a href={cta.href} class:list={['label', 'pill', { 'is-active': ctaActive }]} aria-current={ctaActive ? 'page' : undefined}>
      <svg class="star" viewBox="0 0 12 12" aria-hidden="true"><path d={star} fill="currentColor" /></svg>
      <span>{cta.label}</span>
    </a>

    <button class="label pill pill--burger" type="button" aria-expanded="false" aria-controls="menu" data-burger>
      <svg class="star" viewBox="0 0 12 12" aria-hidden="true"><path d={star} fill="currentColor" /></svg>
      <span class="pill__t t-text-swap" data-burger-label>Menu</span>
    </button>
  </div>

  <!-- The bar's scroll affordance: a hairline that fills as the page runs
       out. Only visible once you have started, so the first screen is clean.
       --nav-p is written by the sync() below; no token or engine change. -->
  <span class="nav__prog" aria-hidden="true"></span>
</header>

<div class="menu" id="menu" hidden data-menu>
  <div class="menu__in">
    <nav class="menu__links" aria-label="Menu">
      {nav.map((n, i) => (
        <a class="display display--poster" href={n.href} style={`--i:${i}`} aria-current={isActive(n.href) ? 'page' : undefined}><span class="index">{String(i + 1).padStart(2, '0')}</span>{n.label}</a>
      ))}
    </nav>
    <a class="label menu__cta" href={cta.href} style={`--i:${nav.length}`} aria-current={ctaActive ? 'page' : undefined}>
      <svg class="star" viewBox="0 0 12 12" aria-hidden="true"><path d={star} fill="currentColor" /></svg>
      {cta.label}
    </a>
    <div class="menu__foot" style={`--i:${nav.length + 1}`}>
      <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      <span class="label">Hyannis Port · Washington, D.C.</span>
    </div>
  </div>
</div>

<style>
  /* The bar has no chrome of its own: no panel, no border, no blur. A wordmark,
     four whisper-quiet labels, and exactly one lit object — the CTA pill. On
     scroll an edgeless scrim keeps type legible; over a cream scene the whole
     bar inverts to ink. --nav-scrim / --nav-fg are local to this file. */
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    height: var(--nav-h);
    color: var(--nav-fg, var(--cream));
    --nav-scrim: var(--ink-900);
    --nav-tail: 3.5rem;
    transition: color 420ms var(--ease-out);
    pointer-events: none;
  }
  /* The scrim has one job: nothing on the page may be read through the bar.
     It therefore holds at FULL opacity for the whole height of the bar and a
     little past it, and only then falls away — the fade is the tail, not the
     body.

     The scrim also has to sit on the RIGHT ground. A single --nav-scrim colour
     is only correct while one ground runs the whole reach; the moment a cream
     section's edge passes under the bar, one flat colour is wrong on one side
     of that edge — a dark scrim printing over the top of a cream panel (which
     is what /partner/ did at the .proles edge, and every other route did at
     its own). So the scrim is now TWO grounds with a hard cut at the section
     edge itself, written by sync() below: --nav-a above the cut, --nav-b under
     it, --nav-cut where the page's own edge falls. The fade moved to a mask so
     it applies to whichever ground it lands on. When no edge is in reach the
     cut sits past the end and the scrim is one colour, as before. */
  .nav::before {
    content: ''; position: absolute; inset: 0 0 auto 0;
    /* The tail is the fade, and every pixel of it is reach over content the
       bar is not covering. 5.5rem gave the scrim 89px of tail past a 62px
       bar; 3.5rem keeps the bar itself fully opaque (the ramp holds solid to
       64% of the span = 73px) and halves what the tail can paint over. */
    height: calc(100% + var(--nav-tail));
    background: linear-gradient(
      to bottom,
      var(--nav-a, var(--nav-scrim)) 0,
      var(--nav-a, var(--nav-scrim)) var(--nav-cut, 100%),
      var(--nav-b, var(--nav-scrim)) var(--nav-cut, 100%),
      var(--nav-b, var(--nav-scrim)) 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom, #000 0%, #000 64%,
      rgba(0,0,0,0.84) 76%, rgba(0,0,0,0.44) 87%, rgba(0,0,0,0.14) 94%,
      transparent 100%);
    mask-image: linear-gradient(
      to bottom, #000 0%, #000 64%,
      rgba(0,0,0,0.84) 76%, rgba(0,0,0,0.44) 87%, rgba(0,0,0,0.14) 94%,
      transparent 100%);
    opacity: 0; transition: opacity 460ms var(--ease-out);
    pointer-events: none;
  }
  .nav.is-scrolled::before { opacity: 1; }
  .nav.is-inverted { --nav-fg: var(--ink-900); --nav-scrim: var(--cream); }

  .nav__prog {
    position: absolute; left: 0; bottom: 0; z-index: 1;
    display: block; height: 1px; width: 100%;
    background: var(--brass);
    transform: scaleX(var(--nav-p, 0)); transform-origin: left;
    opacity: 0; transition: opacity 460ms var(--ease-out);
    pointer-events: none;
  }
  .nav.is-scrolled .nav__prog { opacity: 0.6; }
  /* While the sheet is open the bar sits on top of it, and a hairline
     reporting how far down a page you cannot see you are is noise. */
  .nav.is-menu .nav__prog { opacity: 0; }

  .nav__in {
    position: relative;
    height: 100%;
    max-width: var(--max); margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex; align-items: center; gap: clamp(1rem, 2.6vw, 2.6rem);
  }
  .nav__in > * { pointer-events: auto; }

  /* Wordmark: chrome-mark.astro. The bar only says where it sits. */
  :global(.nav__mark) { margin-right: auto; }

  /* ── Links: the .label register, dimmed against whatever is behind the bar.
     54% of currentColor is --fg-meta's ratio, written in currentColor because
     the bar inverts over cream and the tokens do not follow it. ── */
  .nav__links { display: flex; align-items: center; gap: clamp(1rem, 2vw, 2.1rem); }
  .nav__link {
    color: color-mix(in srgb, currentColor 54%, transparent);
    transition: color 340ms var(--ease-out);
    position: relative; padding-block: 0.5rem;
    white-space: nowrap;
  }
  .nav__link::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0.2rem;
    height: 1px; background: currentColor; opacity: 0.5;
    transform: scaleX(0); transform-origin: right;
    transition: transform 460ms var(--ease-out);
  }
  .nav__link:hover { color: currentColor; }
  .nav__link:hover::after, .nav__link.is-active::after { transform: scaleX(1); transform-origin: left; }
  .nav__link.is-active { color: currentColor; }

  /* ── The one lit object in the bar ──
     Hairline brass pill; fills on hover. Radius/fill are local to the chrome —
     no token exists for a pill and none should. */
  .pill {
    display: inline-flex; align-items: center; gap: 0.7ch;
    padding: 0.5em 0.85em 0.48em;
    min-height: 26px;
    border: 1px solid color-mix(in srgb, var(--brass) 20%, transparent);
    border-radius: 999px;
    white-space: nowrap;
    /* The bar owns exactly two brightnesses: 54% for the quiet register and
       full for the lit one. The pill used to sit at 72% — a singleton level
       with one member. It is the lit object; it is lit. */
    color: currentColor;
    transition: background-color 420ms var(--ease-out), border-color 420ms var(--ease-out), color 420ms var(--ease-out);
  }
  .pill .star { width: 7px; height: 7px; color: var(--brass); flex: none; transition: transform 620ms var(--ease-out), color 420ms var(--ease-out); }
  .pill:hover { background: var(--brass); border-color: var(--brass); color: var(--ink-900); }
  .pill:hover .star { transform: rotate(90deg); color: var(--ink-900); }
  /* Already on the page the pill points at: the ring comes off, so the bar
     never carries a lit button for a door you are standing in. */
  .pill.is-active { border-color: transparent; color: color-mix(in srgb, currentColor 54%, transparent); }
  .pill.is-active:hover { color: var(--ink-900); border-color: var(--brass); }
  .nav.is-inverted .pill:hover { color: var(--cream); }

  /* The burger is the ONLY navigation control below 940px, and it was a
     69x26 target. Grow the hit area to the 44px comfortable floor with
     padding and give the row back with a negative margin, so the pill's
     drawn size and the bar's height are unchanged. */
  /* The burger is the ONLY navigation control below 940px, and it was a
     69x26 target — under the 44px comfortable floor in the one place the
     whole site's navigation lives. Grow the HIT AREA with an overlay
     rather than the box, so the drawn pill and the bar's height are
     untouched: the ring is still 26px, the target is 44. */
  /* ── Text states swap ── transitions-dev/04-text-states-swap.md
     The burger's label is the word that reports the sheet's state, and it
     used to change between two frames: 'Menu' was simply not there and
     'Close' simply was. The swap now reads as one word leaving and another
     arriving, which is what actually happened.

     Only the four variables this transition reads are declared, not the
     skill's full :root block -- ~90 tokens for eleven transitions this site
     has no surfaces for would be dead weight in a codebase whose whole
     discipline is a closed token set. The semantic names are unchanged, so
     the snippet below is verbatim. */
  .pill--burger {
    --text-swap-dur: 200ms;
    --text-swap-translate-y: 8px;
    --text-swap-blur: 2px;
    --text-swap-ease: ease-out;
  }
  .t-text-swap {
    display: inline-block;
    transform: translateY(0);
    filter: blur(0);
    opacity: 1;
    transition:
      transform var(--text-swap-dur) var(--text-swap-ease),
      filter    var(--text-swap-dur) var(--text-swap-ease),
      opacity   var(--text-swap-dur) var(--text-swap-ease);
    will-change: transform, filter, opacity;
  }
  .t-text-swap.is-exit {
    transform: translateY(calc(var(--text-swap-translate-y) * -1));
    filter: blur(var(--text-swap-blur));
    opacity: 0;
  }
  .t-text-swap.is-enter-start {
    transform: translateY(var(--text-swap-translate-y));
    filter: blur(var(--text-swap-blur));
    opacity: 0;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .t-text-swap { transition: none !important; }
  }

  .pill--burger { display: none; }
  /* The burger is the ONLY navigation control below 940px, and it was a
     69x26 target. Unlike a.tap in base.css, this one cannot take the box
     invisibly — the pill has a drawn ring, so a real 44px box is a
     visibly taller pill. It is still the right trade where the pointer is
     actually a thumb, and a hairline capsule at 44px sits comfortably in
     the 58px bar. A pseudo-element overlay is not the alternative: it
     hit-tests at 44 while the button's own geometry — what an inspector
     and WCAG's target-size measurement read — stays 26.

     Scoped to coarse pointers, so a narrowed desktop window still gets
     the 26px ring the bar was drawn around. */
  @media (pointer: coarse) {
    .pill--burger { min-height: 44px; }
  }
  .pill__t { min-width: 4.4ch; text-align: left; }
  /* Open is a state, and "Close" was carrying it alone. Turn the star to
     the diagonal — the same mark, rotated to read as a cross. */
  .pill--burger[aria-expanded='true'] .star { transform: rotate(45deg); }

  @media (max-width: 940px) {
    .nav__links, .nav__in > a.pill:not(.pill--burger) { display: none; }
    .pill--burger { display: inline-flex; }
  }

  /* ── Mobile menu ── */
  .menu {
    position: fixed; inset: 0; z-index: 99;
    background: var(--ink-900); color: var(--cream);
    display: grid;
    /* `safe` centre, not centre: on a landscape phone (844×390) the sheet is
       546px tall in a 390px window, and a centred grid item overflows at BOTH
       ends — the address and the location line sat below the fold with no way
       to reach them, because the panel is fixed and the page behind it is
       locked. Safe alignment falls back to start when it would overflow, and
       the panel scrolls itself. */
    align-items: safe center;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0; pointer-events: none;
    /* Dismissal is a reply to a tap and wants to be quick; arrival is the
       sheet introducing itself and can take its time. Asymmetric on
       purpose. The JS still waits 420ms before [hidden], which is longer
       than either — it only has to outlast the exit. */
    transition: opacity 240ms var(--ease-out);
  }
  /* [hidden] sets display:none at UA weight; .menu's own display:grid was
     beating it, so the six menu links stayed in the tab order of every page
     at every width. Restore it explicitly. */
  .menu[hidden] { display: none; }
  .menu[data-open] { opacity: 1; pointer-events: auto; transition-duration: 420ms; }
  .menu__in { padding: calc(var(--nav-h) + 2rem) var(--gutter) var(--gutter); width: 100%; }
  .menu__links { display: grid; gap: 0.14em; }
  /* Rows arrive in sequence and leave together.

     The stagger used to live on the base rule, which meant it ran in BOTH
     directions: closing the sheet walked the six rows out one at a time
     over ~400ms while the panel itself faded in 420ms and went [hidden] at
     exactly 420 — so the last rows were cut off mid-exit and the whole
     dismissal read as slower than the panel it was inside.

     A stagger is for reading order, and on the way out there is nothing
     left to read. So the delay and the long duration are on [data-open]
     only; the closed state is the exit, and it is fast and simultaneous. */
  .menu__links a,
  .menu__cta,
  .menu__foot {
    opacity: 0; transform: translateY(14px);
    transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out);
    transition-delay: 0ms;
  }
  .menu__links a {
    line-height: 1.1;
    display: flex; align-items: baseline; gap: 1rem;
  }
  .menu__links .index { font-size: var(--step-micro); }
  .menu[data-open] .menu__links a,
  .menu[data-open] .menu__cta,
  .menu[data-open] .menu__foot {
    opacity: 1; transform: none;
    transition: opacity 520ms var(--ease-out), transform 620ms var(--ease-out);
    transition-delay: calc(var(--i) * 55ms + 80ms);
  }
  .menu__cta {
    margin-top: 2.4rem; display: inline-flex; align-items: center; gap: 0.8ch;
    color: var(--fg);
    padding-bottom: 0.6rem; border-bottom: 1px solid var(--brass);
  }
  .menu__cta .star { width: 8px; height: 8px; color: var(--brass); flex: none; }
  .menu__foot {
    margin-top: 3.2rem; display: grid; gap: 0.75rem; justify-items: start;
    font-size: var(--step-body); color: var(--fg-mute);
  }

  /* A phone on its side is 390px tall, and the poster rung alone is taller
     than that window. Drop the sheet one rung so all six doors are on screen
     at once; the scroll above is only the safety net. */
  @media (max-height: 520px) {
    .menu__in { padding-top: calc(var(--nav-h) + 1rem); }
    .menu__links a { font-size: var(--step-sub); }
    .menu__cta { margin-top: 1.4rem; }
    .menu__foot { margin-top: 1.6rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav, .nav::before, .nav__prog, .nav__link::after, .pill, .pill .star,
    .menu, .menu__links a, .menu__cta, .menu__foot { transition-duration: 1ms !important; }
  }
</style>

<script>
  const nav = document.querySelector('[data-nav]');
  const burger = document.querySelector('[data-burger]');
  const burgerLabel = document.querySelector('[data-burger-label]');
  const menu = document.querySelector('[data-menu]');

  /* Scrim + inversion. motion.js also toggles .is-scrolled at the same
     threshold, so the two agree frame to frame. Inversion is local: no
     token or engine change, just a class when a cream scene is under the bar. */
  if (nav) {
    const light = [...document.querySelectorAll('.on-cream')];
    let queued = false;
    const sync = () => {
      queued = false;
      nav.classList.toggle('is-scrolled', window.scrollY > 24);
      const run = document.documentElement.scrollHeight - window.innerHeight;
      nav.style.setProperty('--nav-p', run > 0 ? Math.min(1, window.scrollY / run).toFixed(4) : '0');
      /* The bar has two independent questions to answer, and they used to be
         one: what colour the SCRIM is (a ground, and it can change part-way
         down the bar's reach) and what colour the TYPE is (one answer, decided
         by whichever ground holds most of the bar). */
      const band = nav.offsetHeight;
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      const tail = 3.5 * rem;
      const reach = band + tail;
      const open = menu?.hasAttribute('data-open');

      const rects = open ? [] : light.map((el) => el.getBoundingClientRect());
      const creamAt = (y) => rects.some((r) => r.top <= y && r.bottom > y);

      /* The BAND keeps one ground, because the type sits across it: whichever
         ground holds most of the bar wins, and the type inverts with it. A
         one-pixel overlap used to flip the whole bar to ink over a navy
         header, so this is a majority test, not an intersection test. */
      let creamInBand = 0;
      for (const r of rects) {
        const a = Math.max(0, r.top), b = Math.min(band, r.bottom);
        if (b > a) creamInBand += b - a;
      }
      const inverted = !open && creamInBand > band * 0.5;
      nav.classList.toggle('is-inverted', inverted);

      /* The TAIL is a different question. It reaches 3.5rem past the bar over
         content the bar is not covering, and that is where the page's ground
         usually changes — a cream section's top edge sitting just under the
         bar took the full dark ramp across it on every route. So the tail is
         cut at the first ground edge below the bar and carries the ground it
         actually lands on. No edge in reach: one colour, as before. */
      let cut = reach;
      for (const r of rects) {
        if (r.top > band && r.top < cut) cut = r.top;
        if (r.bottom > band && r.bottom < cut) cut = r.bottom;
      }
      /* The band's own bottom edge is always a candidate cut: the band may be
         holding a ground its majority chose while the page under the tail has
         already changed. Where the two agree the cut is invisible. */
      if (cut >= reach && creamAt(band + 1) !== inverted) cut = band;
      const CREAM = 'var(--cream)', INK = 'var(--ink-900)';
      nav.style.setProperty('--nav-a', inverted ? CREAM : INK);
      nav.style.setProperty('--nav-b', (cut >= reach ? inverted : creamAt(cut + 1)) ? CREAM : INK);
      nav.style.setProperty('--nav-cut', cut >= reach ? '100%' : cut + 'px');
    };
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(sync); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    sync();
    nav.dataset.sync = '1';
    window.__navSync = sync;
  }

  if (burger && menu) {
    /* Three-phase text swap — transitions-dev/04-text-states-swap.md.
       The pending timer is tracked so a fast double-tap cannot leave the
       label stuck mid-exit: a second swap cancels the first outright. */
    const swapDur = parseFloat(
      getComputedStyle(document.documentElement).getPropertyValue('--text-swap-dur')
    ) || 200;
    let swapT = null;
    const swapLabel = (next) => {
      if (!burgerLabel) return;
      if (swapT) { clearTimeout(swapT); swapT = null; }
      /* Already showing the right word — but a cancelled swap may have left
         the label mid-exit, so put it back on its feet before returning.
         Without this, a double-tap inside --text-swap-dur ends with the
         label at opacity 0 and the button apparently blank. */
      if (burgerLabel.textContent === next) {
        burgerLabel.classList.remove('is-exit', 'is-enter-start');
        return;
      }
      burgerLabel.classList.add('is-exit');
      swapT = setTimeout(() => {
        swapT = null;
        burgerLabel.textContent = next;
        burgerLabel.classList.remove('is-exit');
        burgerLabel.classList.add('is-enter-start');
        void burgerLabel.offsetHeight; // force reflow so the next change transitions
        burgerLabel.classList.remove('is-enter-start');
      }, swapDur);
    };

    const set = (open) => {
      burger.setAttribute('aria-expanded', String(open));
      if (burgerLabel) swapLabel(open ? 'Close' : 'Menu');
      if (open) { menu.hidden = false; requestAnimationFrame(() => menu.setAttribute('data-open', '')); }
      else { menu.removeAttribute('data-open'); setTimeout(() => { menu.hidden = true; }, 420); }
      nav?.classList.toggle('is-menu', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (window.__navSync) window.__navSync();
    };
    burger.addEventListener('click', () => set(burger.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => { if (e.target.closest('a')) set(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') { set(false); burger.focus(); }
    });

    /* The panel covers the page, so Tab must stay inside it: the burger (which
       is the close control) plus everything in the sheet, and nothing behind. */
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || burger.getAttribute('aria-expanded') !== 'true') return;
      const ring = [burger, ...menu.querySelectorAll('a[href], button:not([disabled])')];
      const i = ring.indexOf(document.activeElement);
      const next = e.shiftKey
        ? ring[(i <= 0 ? ring.length : i) - 1]
        : ring[(i + 1) % ring.length];
      if (next) { e.preventDefault(); next.focus(); }
    });
  }
</script>
