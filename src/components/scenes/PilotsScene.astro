---
import { pilots } from '../../data/site.js';
import Figure from '../Figure.astro';
---
<section class="pilots scene" id="pilots" aria-labelledby="pilots-h">
  <div class="shell">
    <header class="pilots__head">
      <p class="label" data-reveal>Four pilots · 2026</p>
      <h2 class="display display--l pilots__h lines" id="pilots-h">
        Each one starts with a problem a family can name.
      </h2>
    </header>

    <ol class="pilots__list" data-pilot-list>
      {pilots.map((p, i) => (
        <li class="pilot" data-reveal={String(120 + i * 90)} data-pilot={p.id}>
          <a class="pilot__a" href={`/pilots/#${p.id}`}>
            <span class="index pilot__i">{p.index}</span>
            <span class="pilot__body">
              <span class="pilot__partner label">{p.partner}</span>
              <span class="display display--m pilot__title">{p.title}</span>
              <span class="pilot__tag">{p.tagline}</span>
            </span>
            <span class="pilot__field label">{p.field}</span>
            <span class="pilot__arrow" aria-hidden="true">
              <svg viewBox="0 0 22 10"><path d="M16 1l5 4-5 4M21 5H0" stroke="currentColor" stroke-width="1" fill="none"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>

  <div class="pilots__preview" aria-hidden="true" data-preview>
    {pilots.map((p) => (
      <div class="pilots__preview-item" data-preview-for={p.id}>
        <Figure src={p.image} ratio="4 / 5" grade={0.42} />
      </div>
    ))}
  </div>
</section>

<style>
  .pilots { position: relative; }
  .pilots__head { display: grid; gap: var(--stack-2); margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  .pilots__h { max-width: 22ch; }

  .pilots__list { list-style: none; margin: 0; padding: 0; }
  .pilot { border-top: 1px solid var(--rule); }
  .pilot:last-child { border-bottom: 1px solid var(--rule); }

  .pilot__a {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto 3rem;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    padding-block: clamp(1.5rem, 3vw, 2.6rem);
    transition: opacity 480ms var(--ease-out);
  }
  .pilot__i { align-self: start; padding-top: 0.35em; }
  .pilot__body { display: grid; gap: 0.45rem; }
  .pilot__partner { color: var(--fg-faint); }
  .pilot__title { transition: transform 620ms var(--ease-out); }
  .pilot__tag { color: var(--fg-mute); font-size: var(--step-xs); max-width: 42ch; }
  .pilot__field { justify-self: end; color: var(--fg-faint); white-space: nowrap; }
  .pilot__arrow { justify-self: end; width: 22px; color: var(--brass); opacity: 0; transform: translateX(-8px); transition: opacity 460ms var(--ease-out), transform 560ms var(--ease-out); }
  .pilot__arrow svg { width: 100%; height: auto; }

  @media (hover: hover) {
    [data-pilot-list]:hover .pilot__a { opacity: 0.38; }
    .pilot:hover .pilot__a { opacity: 1; }
    .pilot:hover .pilot__title { transform: translateX(0.5rem); }
    .pilot:hover .pilot__arrow { opacity: 1; transform: none; }
  }

  /* Cursor-following preview, desktop only */
  .pilots__preview {
    position: fixed; top: 0; left: 0; z-index: 40;
    width: clamp(200px, 17vw, 280px);
    pointer-events: none;
    opacity: 0;
    transform: translate3d(var(--x, 0), var(--y, 0), 0) translate(-50%, -50%);
    transition: opacity 420ms var(--ease-out);
    display: none;
  }
  .pilots__preview.is-on { opacity: 1; }
  .pilots__preview-item {
    position: absolute; inset: 0;
    opacity: 0; transform: scale(0.97);
    transition: opacity 400ms var(--ease-out), transform 700ms var(--ease-out);
  }
  .pilots__preview-item.is-on { opacity: 1; transform: none; }
  @media (hover: hover) and (min-width: 900px) { .pilots__preview { display: block; } }

  @media (max-width: 760px) {
    .pilot__a { grid-template-columns: 2.25rem minmax(0, 1fr); row-gap: 0.5rem; }
    .pilot__field { grid-column: 2; justify-self: start; }
    .pilot__arrow { display: none; }
  }
</style>

<script>
  const list = document.querySelector('[data-pilot-list]');
  const prev = document.querySelector('[data-preview]');
  if (list && prev && window.matchMedia('(hover: hover) and (min-width: 900px)').matches
      && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf = 0, tx = 0, ty = 0, cx = 0, cy = 0;
    const loop = () => {
      cx += (tx - cx) * 0.14; cy += (ty - cy) * 0.14;
      prev.style.setProperty('--x', cx + 'px');
      prev.style.setProperty('--y', cy + 'px');
      raf = requestAnimationFrame(loop);
    };
    list.addEventListener('pointermove', (e) => { tx = e.clientX; ty = e.clientY; });
    list.addEventListener('pointerenter', (e) => {
      tx = cx = e.clientX; ty = cy = e.clientY;
      prev.classList.add('is-on');
      if (!raf) raf = requestAnimationFrame(loop);
    });
    list.addEventListener('pointerleave', () => {
      prev.classList.remove('is-on');
      cancelAnimationFrame(raf); raf = 0;
      prev.querySelectorAll('.is-on').forEach((n) => n.classList.remove('is-on'));
    });
    list.querySelectorAll('[data-pilot]').forEach((li) => {
      li.addEventListener('pointerenter', () => {
        prev.querySelectorAll('.pilots__preview-item').forEach((n) =>
          n.classList.toggle('is-on', n.dataset.previewFor === li.dataset.pilot));
      });
    });
  }
</script>
