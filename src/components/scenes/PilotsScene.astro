---
import { pilots } from '../../data/site.js';
---
<section class="pilots scene" id="pilots" aria-labelledby="pilots-h">
  <div class="shell">
    <header class="pilots__head">
      <p class="eyebrow pilots__eyebrow" data-reveal>Four pilots proposed for 2026</p>
      <p class="label pilots__count" data-reveal="60">01 — 04</p>
      <h2 class="display display--l pilots__h lines" id="pilots-h">
        Each one starts with a problem a family can name.
      </h2>
      <!-- THE HEDGE, BESIDE THE NAMES AND NOT 479px BELOW THEM. Each row
           names a living public figure or a real institution in the partner
           slot. Nothing on this page had said those partners are sought
           rather than signed, and /partner/ stopped making that claim in
           83d4018 while / never got the correction. One line, in the same
           micro-label voice as the row labels, inside the same head block
           the names sit under. -->
      <p class="label pilots__note" data-reveal="90">Partners named are sought for 2026, not committed.</p>
    </header>

    <ol class="pilots__list" data-pilot-list>
      {pilots.map((p, i) => (
        <li class="pilot" data-reveal={String(120 + i * 90)} data-pilot={p.id}>
          <a class="pilot__a" href={`/pilots/#${p.id}`} aria-label={`${p.title} — ${p.partner}`}>
            <span class="index pilot__i">{p.index}</span>
            <span class="label pilot__partner">{p.partner}</span>
            <span class="display pilot__title">{p.title}</span>
            <span class="pilot__v" aria-hidden="true"></span>
            <span class="label pilot__field">{p.field}</span>
            <span class="pilot__tag">{p.tagline}</span>
            <span class="pilot__arrow" aria-hidden="true">
              <svg class="arrow" viewBox="0 0 22 10"><path d="M16 1l5 4-5 4M21 5H0" stroke="currentColor" stroke-width="1" fill="none"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>

</section>

<style>
  .pilots { position: relative; }

  /* Masthead: eyebrow left, range right, statement below — corner-anchored. */
  .pilots__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 1.5rem;
    row-gap: var(--stack-2);
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
  }
  .pilots__count { font-variant-numeric: tabular-nums; }
  .pilots__h { grid-column: 1 / -1; max-width: 20ch; }
  .pilots__note { grid-column: 1 / -1; color: var(--fg-mute); margin: 0; }

  /* ── The register ───────────────────────────────────────────────────
     Horizontal rules carry the rhythm. One quiet vertical hairline carries
     the structure — any more and the register reads as a table. */
  .pilots__list { list-style: none; margin: 0; padding: 0; }
  .pilot { position: relative; border-top: 1px solid var(--rule); }
  .pilot:last-child { border-bottom: 1px solid var(--rule); }

  /* brass hairline that wipes along the row's own rule */
  .pilot::after {
    content: ''; position: absolute; top: -1px; left: 0; right: 0; height: 1px;
    background: var(--brass);
    transform: scaleX(0); transform-origin: right;
    transition: transform 660ms var(--ease-out);
    pointer-events: none;
  }

  /* Two tiers: micro-labels on the top line, content on the bottom line.
     Baseline alignment does the work, so the serif title and the sans
     tagline sit on one shared baseline across the row. The 1px track is
     the hairline — spaced by the gap, not by padding. */
  .pilot__a {
    --rowpad: clamp(1.35rem, 2.5vw, 2.05rem);
    position: relative;
    padding-block: var(--rowpad);
    display: grid;
    grid-template-columns:
      3.25rem minmax(0, 1.15fr) 1px minmax(0, 1fr) 1.6rem;
    grid-template-rows: auto auto;
    align-items: baseline;
    column-gap: clamp(1.1rem, 2.2vw, 2.4rem);
    row-gap: 0.55rem;
    transition: opacity 300ms var(--ease-out), background-color 420ms var(--ease-out);
  }
  /* one hairline, not a table: it divides who runs it from what it does */
  .pilot__v {
    grid-column: 3; grid-row: 1 / -1;
    background: var(--rule-soft);
    margin-block: calc(-1 * var(--rowpad));
    align-self: stretch;
  }

  /* the same nameplate grammar as /pilots/: brass numeral and dim labels,
     number + partner left, sector flush right, all on one baseline. */
  .pilot__i { grid-column: 1; grid-row: 1; }
  .pilot__partner {
    grid-column: 2; grid-row: 1;
    transition: color 380ms var(--ease-out);
  }
  /* --step-sub, not a hand-rolled clamp. The clamp landed on 40.5px at 1440,
     which is a rung the ladder does not have: the page then ran
     33.8 (nothing) 40.5 (nothing) 53.1 and the row titles sat 12px under the
     section head instead of a clear step under it. */
  .pilot__title {
    grid-column: 2; grid-row: 2;
    font-size: var(--step-sub);
    line-height: 1.05;
    letter-spacing: -0.015em;
    transition: transform 620ms var(--ease-out);
  }
  .pilot__tag {
    grid-column: 4; grid-row: 2;
    color: var(--fg-mute);
    font-size: var(--step-body);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .pilot__field {
    grid-column: 4 / -1; grid-row: 1;
    justify-self: end;
    white-space: nowrap;
    transition: color 380ms var(--ease-out);
  }
  .pilot__arrow {
    grid-column: 5; grid-row: 2;
    justify-self: end; align-self: baseline;
    width: 22px; color: var(--brass);
    opacity: 0; transform: translateX(-10px);
    transition: opacity 380ms var(--ease-out), transform 520ms var(--ease-out);
  }
  .pilot__arrow :global(.arrow) { width: 100%; }

  @media (hover: hover) {
    [data-pilot-list]:hover .pilot__a { opacity: 0.4; }
    .pilot:hover .pilot__a {
      opacity: 1;
      background-color: color-mix(in srgb, var(--cream) 3%, transparent);
    }
    .pilot:hover::after { transform: scaleX(1); transform-origin: left; }
    .pilot:hover .pilot__partner { color: var(--brass); }
    .pilot:hover .pilot__field { color: var(--fg-mute); }
    .pilot:hover .pilot__title { transform: translateX(0.35rem); }
    .pilot:hover .pilot__arrow { opacity: 1; transform: none; }
  }
  /* keyboard gets the same row treatment as the pointer */
  .pilot:focus-within .pilot__a { opacity: 1; }
  .pilot:focus-within::after { transform: scaleX(1); transform-origin: left; }
  .pilot:focus-within .pilot__partner { color: var(--brass); }
  .pilot:focus-within .pilot__arrow { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .pilot::after, .pilot__title, .pilot__arrow { transition-duration: 1ms; }
  }

  /* ── The hover state is ink, not photography ────────────────────
     A cursor-following photo plate used to live here: position:fixed,
     244px, aria-hidden, uncredited, display:none on every touch device,
     cycling four documentary photographs — one of them an identifiable
     child — so that a cursor would feel alive. It is gone. /pilots/ shows
     the same photographs at size, credited, carrying an argument.
     What carries the row now is what is above: the ledger dims to 0.4, the
     hovered row comes back to full, its rule wipes brass left-to-right, its
     partner goes brass, its title steps 0.35rem right and the arrow arrives.
     Keyboard focus gets the identical treatment. Nothing here is an image. */

  /* ── Narrow ─────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .pilot__a {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      align-items: baseline;
      row-gap: 0.35rem;
      column-gap: 1rem;
      padding-block: clamp(1.3rem, 4.2vw, 1.8rem);
    }
    .pilot__v { display: none; }
    .pilot__field { grid-column: 2; grid-row: 1; justify-self: end; }
    .pilot__partner { grid-column: 1 / -1; grid-row: 2; margin-top: 0.5rem; }
    .pilot__title { grid-column: 1 / -1; grid-row: 3; }
    .pilot__tag { grid-column: 1 / -1; grid-row: 4; margin-top: 0.5rem; max-width: 40ch; }
    .pilot__arrow { display: none; }
  }
  @media (max-width: 560px) {
    .pilots__head { grid-template-columns: minmax(0, 1fr); }
    .pilots__count { display: none; }
  }
</style>

<script>
  /* The row register is CSS-only now — see the note above .pilot__i. */
</script>
