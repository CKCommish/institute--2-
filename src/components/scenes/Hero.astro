---
import Figure from '../Figure.astro';
import { pilots } from '../../data/site.js';
---
<!-- Three deliberate horizontal registers, top to bottom:
     1. the stamp rail — who this is (left) and where the frame is (right)
     2. the poster — the thesis, at the top of the frame, at hero scale
     3. the ledger rail — the four 2026 pilots, inside the first screen
     The photograph holds the middle. Nothing floats between registers. -->
<section class="hero" aria-labelledby="hero-h">
  <Figure src="/media/hero.jpg" alt="" ratio="auto" grade={0.58} focal="36% 58%" parallax={5} loading="eager" class="hero__bg" />
  <div class="hero__veil" aria-hidden="true"></div>

  <!-- Register 1. The eyebrow finishes into the H1 — read together they are
       the brief's sentence in full. The locator is the photograph's own
       caption (Greenville, Mississippi — Highsmith, LOC), set on the same
       optical line so the rail reads as one rule, not two orphans. -->
  <div class="hero__top shell">
    <p class="label hero__eyebrow">
      <span class="hero__dot" aria-hidden="true"></span>The Lion Forum Institute exists
    </p>
    <p class="label hero__place">Greenville, Mississippi</p>
  </div>

  <!-- Register 2. -->
  <div class="hero__mid shell">
    <h1 class="display display--hero hero__h lines" id="hero-h">
      To ensure the technologies of tomorrow strengthen American families today.
    </h1>

    <p class="hero__lede" data-reveal="520">
      Short, measurable pilots inside institutions families already trust.
    </p>
  </div>

  <!-- Register 3. -->
  <div class="hero__index shell">
    <span class="hero__rule" aria-hidden="true"></span>
    <span class="label hero__index-label">Pilots · 2026</span>
    <ul class="hero__index-list">
      {pilots.map((p) => (
        <li><span class="index">{p.index}</span>{p.title}</li>
      ))}
    </ul>
    <a class="hero__scroll" href="#why">
      <span class="label">Scroll</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    isolation: isolate;
    overflow: hidden;
  }
  .hero__bg { position: absolute; inset: 0; aspect-ratio: auto; z-index: -2; }

  /* Legibility scrim, weighted to the top now that the poster sits there.
     One open window across the lower-middle so the river still reads as a
     photograph. Local to this component — no new token invented. */
  .hero__veil {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(64% 44% at 88% 76%, color-mix(in srgb, var(--brass) 11%, transparent) 0%, transparent 68%),
      radial-gradient(78% 52% at 4% 4%, color-mix(in srgb, var(--ink-900) 74%, transparent) 0%, transparent 72%),
      linear-gradient(180deg,
        color-mix(in srgb, var(--ink-900) 84%, transparent) 0%,
        color-mix(in srgb, var(--ink-900) 66%, transparent) 24%,
        color-mix(in srgb, var(--ink-900) 32%, transparent) 50%,
        color-mix(in srgb, var(--ink-900) 22%, transparent) 68%,
        color-mix(in srgb, var(--ink-900) 68%, transparent) 90%,
        color-mix(in srgb, var(--ink-900) 96%, transparent) 100%);
  }

  /* ── Register 1: the stamp rail ───────────────────────────────────── */
  .hero__top {
    width: 100%;
    padding-top: calc(var(--nav-h) + clamp(0.9rem, 3vh, 2rem));
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
  }
  .hero__eyebrow {
    display: flex; align-items: baseline; gap: 0.75rem;
    color: var(--cream);
  }
  .hero__place { color: color-mix(in srgb, var(--cream) 52%, transparent); text-align: right; }

  .hero__dot {
    width: 5px; height: 5px; border-radius: 50%; background: var(--brass);
    transform: translateY(-0.1em);
    flex: none;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--brass) 60%, transparent);
    animation: pulse 3.6s var(--ease-out) infinite;
  }
  @keyframes pulse {
    0%, 70%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--brass) 55%, transparent); }
    35% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--brass) 0%, transparent); }
  }

  /* the whole rail arrives as one object, before the poster */
  .hero__top { opacity: 0; animation: heroIn 640ms var(--ease-out) 120ms forwards; }

  /* ── Register 2: the poster ───────────────────────────────────────── */
  .hero__mid {
    width: 100%;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    padding-top: clamp(0.75rem, 2.4vh, 1.7rem);
    padding-bottom: clamp(1rem, 3vh, 2rem);
  }

  /* Font size comes from .display--hero → --step-hero. The thesis line is the
     largest type on the site; nothing below it may outrank it. */
  .hero__h {
    line-height: 0.94;
    letter-spacing: -0.032em;
    text-wrap: initial;
    hyphens: none;
    max-width: 24ch;
  }

  /* Right-anchored, left-set: the one supporting register, hung in the
     bottom-right of the open band so the photograph keeps the middle. */
  .hero__lede {
    align-self: end;
    justify-self: end;
    max-width: 26ch;
    font-size: clamp(1.06rem, 0.94rem + 0.5vw, 1.35rem);
    line-height: 1.42;
    font-weight: 340;
    letter-spacing: -0.004em;
    color: color-mix(in srgb, var(--cream) 82%, transparent);
    text-wrap: pretty;
  }

  /* ── Register 3: the 2026 ledger rail ─────────────────────────────── */
  .hero__index {
    width: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: clamp(1.25rem, 3vw, 3rem);
    row-gap: 0.9rem;
    padding-bottom: clamp(1.5rem, 4vh, 2.75rem);
  }
  .hero__rule {
    grid-column: 1 / -1;
    height: 1px; width: 100%;
    background: var(--rule);
    transform-origin: left;
    margin-bottom: clamp(0.9rem, 2.2vh, 1.6rem);
    transform: scaleX(0);
    animation: heroDraw 1000ms var(--ease-out) 520ms forwards;
  }

  .hero__index-label { white-space: nowrap; color: var(--cream); }
  /* Local step below --step-xs: the rail must sit under the deck, not beside it. */
  .hero__index-list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap;
    gap: 0.55rem clamp(1rem, 2.6vw, 2.8rem);
    font-size: clamp(0.85rem, 0.82rem + 0.13vw, 0.95rem);
    color: color-mix(in srgb, var(--cream) 64%, transparent);
  }
  .hero__index-list li { display: flex; align-items: baseline; gap: 0.65ch; white-space: nowrap; }

  .hero__scroll { display: flex; align-items: center; gap: 0.75rem; }
  .hero__scroll-line {
    display: block; width: 34px; height: 1px;
    background: color-mix(in srgb, var(--cream) 40%, transparent);
    position: relative; overflow: hidden;
  }
  .hero__scroll-line::after {
    content: ''; position: absolute; inset: 0; background: var(--brass);
    transform: translateX(-100%);
    animation: sweep 2.8s var(--ease-io) infinite;
  }

  /* The rail sits low in the first screen, where an IntersectionObserver
     reveal would never fire. Staged on load instead — local to this component. */
  .hero__index-label,
  .hero__index-list li,
  .hero__scroll {
    opacity: 0;
    animation: heroIn 720ms var(--ease-out) forwards;
  }
  .hero__index-label { animation-delay: 640ms; }
  .hero__index-list li:nth-child(1) { animation-delay: 700ms; }
  .hero__index-list li:nth-child(2) { animation-delay: 760ms; }
  .hero__index-list li:nth-child(3) { animation-delay: 820ms; }
  .hero__index-list li:nth-child(4) { animation-delay: 880ms; }
  .hero__scroll { animation-delay: 960ms; }

  @keyframes heroIn { from { opacity: 0; transform: translate3d(0, 12px, 0); } to { opacity: 1; transform: none; } }
  @keyframes heroDraw { to { transform: none; } }
  @keyframes sweep { 0% { transform: translateX(-100%); } 55%, 100% { transform: translateX(100%); } }

  @media (prefers-reduced-motion: reduce) {
    .hero__dot,
    .hero__scroll-line::after { animation: none; }
    .hero__scroll-line::after { transform: none; opacity: .5; }
    .hero__top,
    .hero__index-label,
    .hero__index-list li,
    .hero__scroll { opacity: 1; animation: none; }
    .hero__rule { transform: none; animation: none; }
  }

  @media (max-width: 1180px) {
    .hero__h { max-width: none; }
  }

  @media (max-width: 900px) {
    .hero__lede { justify-self: start; max-width: 30ch; }
  }

  @media (max-width: 760px) {
    /* one anchor per corner is enough at this width */
    .hero__place { display: none; }
    .hero__h { letter-spacing: -0.028em; }
    .hero__lede { align-self: end; max-width: 34ch; }
  }

  @media (max-width: 700px) {
    .hero__index { grid-template-columns: minmax(0, 1fr) auto; }
    .hero__index-list {
      grid-column: 1 / -1; order: 3;
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem 1rem;
    }
    .hero__index-list li { white-space: normal; }
  }
</style>
