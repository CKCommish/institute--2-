      --claim-in:   84px;
      --claim-full: 150px;
      --claim-mid:  260px;
      --claim-hold: 376px;  /* the last descender lands at 382 */
      --claim-out:  404px;
      --claim-fade: 440px;
      --claim-end:  476px;  /* …and the man's head begins at 388 */
    }
