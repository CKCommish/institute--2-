---
import { method } from '../../data/site.js';
---
<!-- The answer to the cream scene's asterisk, and the page's tightest beat:
     a section thesis held on the left, the mechanism as three ranked rows on
     the right.

     Every size in it is now a rung: 53 head / 34 step title / 27 stat /
     16 body / 11.7 label. Nothing here is a number this component invented.

     Its motion is mixed on purpose. The words arrive (reveal / lines); the
     three-row register is TERRITORY and is uncovered left to right in one
     wipe, so this scene does not land the same way as the four that follow
     it. -->
<section class="method" id="method" aria-labelledby="method-h">
  <div class="shell method__in">
    <div class="method__head">
      <p class="eyebrow method__eyebrow" data-reveal>The method</p>
      <p class="label tnum method__meta" data-reveal="70">01 — 03</p>
    </div>

    <span class="method__rule" aria-hidden="true" data-wipe="left" data-delay="60"></span>

    <div class="method__grid">
      <div class="method__thesis">
        <h2 class="display display--head method__h lines" id="method-h">How we work.</h2>

        <p class="method__stat" data-reveal="320">
          <span class="method__stat-n tnum">3&ndash;12</span>
          <span class="label method__stat-k">Months<br />per pilot</span>
        </p>
      </div>

      <!-- TERRITORY, not arrival. Three rows on a hairline register are a
           table, not three sentences, so the block is uncovered left to
           right in one move instead of fading up row by row on the same
           vector as everything else on the page. -->
      <div class="method__stepsWrap" data-wipe="left" data-delay="120">
        <ol class="method__steps">
          {method.map((m) => (
            <li class="mstep">
              <span class="index mstep__i">{m.index}</span>
              <h3 class="mstep__t">{m.title}</h3>
              <p class="mstep__p">{m.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .method {
    position: relative;
    background: var(--ink-800);
    padding-block: clamp(3.75rem, 2rem + 5.4vw, 7rem);
    border-top: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
  }
  .method__in { display: grid; }

  .method__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: clamp(0.7rem, 1.6vw, 1.1rem);
  }
  /* Local durations: the house --dur-2/--dur-3 pair runs 1.15s, so a scene
     with six staggered objects would still be arriving two seconds after it
     is on screen. Everything here lands inside one. */
  .method__eyebrow[data-reveal],
  .method__meta[data-reveal],
  .method__stat[data-reveal] { transition-duration: 520ms, 640ms; }

  .method__meta { text-align: right; }

  /* The rule is territory too — the house wipe, not a local scaleX. */
  .method__rule {
    display: block; height: 1px; width: 100%; background: var(--rule);
    transition-duration: 980ms;
  }

  /* ── The split ────────────────────────────────────────────────────
     Thesis left, sequence right. Not three equal columns. */
  .method__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.3fr);
    column-gap: clamp(2rem, 6vw, 6.5rem);
    padding-top: clamp(2rem, 4.4vw, 3.6rem);
  }

  .method__thesis {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(2rem, 5vh, 3.5rem);
  }
  /* The scene's ONLY display register, and deliberately quieter than the
     section head that opens the pilots ledger below it. */
  .method__h { max-width: 9ch; }

  /* The one operating fact, hung in the corner of the column under a
     hairline. The rule is what makes the air above it a field with a foot
     instead of a hole between two blocks. */
  .method__stat {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }
  @media (min-width: 901px) {
    .method__stat {
      border-top: 1px solid var(--rule-soft);
      padding-top: clamp(0.9rem, 1.8vw, 1.35rem);
      width: 100%;
    }
  }
  .method__stat-n {
    font-size: var(--step-bridge);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.012em;
    color: var(--brass);
    white-space: nowrap;
  }
  /* .label, not a fourth micro scale invented in this component. */
  .method__stat-k { line-height: 1.5; }

  /* ── The three stops ──────────────────────────────────────────────
     Rows on a hairline register, staggered 01 → 02 → 03. Each row holds one
     numeral, one title and one line, at three clearly different sizes. */
  .method__stepsWrap { min-width: 0; transition-duration: 1100ms; }
  .method__steps { list-style: none; margin: 0; padding: 0; }
  .mstep {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: clamp(1rem, 2.4vw, 2rem);
    align-items: baseline;
    padding-block: clamp(1rem, 2.2vw, 1.5rem);
    border-top: 1px solid var(--rule-soft);
  }
  .mstep:first-child { border-top: 0; padding-top: 0; }
  .mstep:last-child { padding-bottom: 0; }

  .mstep__i { grid-row: 1; }
  /* The same three steps appear as a ledger on /institute/. One object, one
     treatment: shared .index numeral, serif title, one rank quieter here so it
     stays under the section head. */
  .mstep__t {
    grid-row: 1;
    font-family: var(--serif);
    font-size: var(--step-sub);
    font-weight: 320;
    line-height: 1.1;
    letter-spacing: -0.014em;
  }
  .mstep__p {
    grid-column: 2;
    margin-top: 0.5rem;
    font-size: var(--step-body);
    line-height: 1.5;
    color: var(--fg-mute);
    max-width: 30ch;
  }

  @media (max-width: 900px) {
    .method__grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: clamp(2.25rem, 6vw, 3rem);
    }
    .method__thesis {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1.5rem;
    }
    .method__h { max-width: none; }
    .method__stat { align-self: baseline; }
  }

  @media (max-width: 520px) {
    .method__thesis { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
    .mstep { column-gap: 1rem; }
  }
</style>
