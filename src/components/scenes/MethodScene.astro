---
import { method } from '../../data/site.js';
---
{/* THE ARMATURE BREAK.
     Every other scene on this page — and on this site — opens the same way:
     an 11.7px label flush left at x=51, a hairline ruled the full width of
     the frame under it, a right-aligned counter on the same baseline, then
     the content hung below. A left-edge histogram of the homepage put 28
     text elements at exactly x=51. Method and Pilots are CONSECUTIVE and
     used to open with that identical three-element overture, one after the
     other.

     This scene no longer has a left edge. It is set on the frame's centre
     line: eyebrow, thesis, then the mechanism as three equal columns
     divided by vertical hairlines, and the one operating fact centred at
     the foot. Nothing in it begins at x=51. The rules run down, not across.

     It also carries the page's single --step-feature — the documented
     series-breaker, spent once, on the sentence the whole institute is:
     three steps, three to twelve months, and the lesson shared.

     The ground moved with it. This band used to be .on-panel; the homepage's
     only other tonal event was the cream at 16% of the scroll, after which
     1,700px of the back half never changed value again. The panel is now
     spent on the board wall at 76% instead, where the pacing needed it, and
     this scene earns its distinction from composition rather than value.

     MOTION unchanged: the words arrive, the three-column register is
     TERRITORY and is uncovered in one wipe. */}
<section class="method on-panel" id="method" aria-labelledby="method-h">
  <div class="shell method__in">
    <p class="eyebrow method__eyebrow" data-reveal>The method</p>

    <h2 class="display display--feature method__h lines" id="method-h">How we work.</h2>

    {/* TERRITORY, not arrival. Three columns on a vertical register are a
         table, not three sentences, so the block is uncovered in one move
         instead of fading up column by column on the same vector as
         everything else on the page. */}
    <div class="method__stepsWrap" data-wipe="left" data-delay="120">
      <ol class="method__steps">
        {method.map((m) => (
          <li class="mstep">
            <span class="index mstep__i">{m.index}</span>
            <h3 class="mstep__t">{m.title}</h3>
            <p class="mstep__p">{m.text}</p>
          </li>
        ))}
      </ol>
    </div>

    <p class="method__stat" data-reveal="320">
      <span class="method__stat-n tnum">3&ndash;12</span>
      <span class="label method__stat-k">months per pilot</span>
    </p>
  </div>
</section>

<style>
  .method {
    position: relative;
    /* Asymmetric on purpose: the Stake photograph runs hard into the foot of
       this scene, so the bottom pad is half the top one. A full scene pad
       above a full-bleed frame reads as a seam, not a pause. */
    padding-block: clamp(4rem, 2rem + 6vw, 8rem) clamp(2.25rem, 1rem + 3vw, 4rem);
  }
  .method__in {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .method__eyebrow { margin-bottom: clamp(1.1rem, 2.4vw, 1.9rem); }
  .method__eyebrow[data-reveal],
  .method__stat[data-reveal] { transition-duration: 520ms, 640ms; }

  /* The page's ONE --step-feature. Two lines at every width — the measure is
     em-fixed so the break never drifts. */
  .method__h {
    margin: 0;
    max-width: 14ch;
    text-wrap: balance;
  }

  /* ── The three stops ──────────────────────────────────────────────
     Three equal columns divided by vertical hairlines. The division is the
     only mark in the scene, and it runs down. */
  .method__stepsWrap {
    width: 100%;
    min-width: 0;
    transition-duration: 1100ms;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  /* The three columns share ROWS, not just a width: numeral, title and line
     each sit on one baseline across the frame, so a title that takes two
     lines does not drop its own caption below its neighbours'. The rows are
     the register; the list items dissolve into it. */
  .method__steps {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto auto;
    row-gap: 0.7rem;
  }
  .mstep__i { line-height: 1; }

  @media (min-width: 861px) {
    .mstep { display: contents; }
    .mstep > * {
      justify-self: center;
      padding-inline: clamp(1rem, 3vw, 3rem);
    }
    .mstep:nth-child(1) > * { grid-column: 1; }
    .mstep:nth-child(2) > * { grid-column: 2; }
    .mstep:nth-child(3) > * { grid-column: 3; }
    .mstep__i  { grid-row: 1; }
    .mstep__t  { grid-row: 2; }
    .mstep__p  { grid-row: 3; }

    /* The division runs DOWN — a hairline on the inside edge of columns 2
       and 3, spanning all three rows. */
    .method__steps::before,
    .method__steps::after {
      content: ''; grid-row: 1 / -1; width: 1px; justify-self: start;
      background: var(--rule-soft);
      margin-block: 0.1rem;
    }
    .method__steps::before { grid-column: 2; }
    .method__steps::after  { grid-column: 3; }
  }
  /* The same three steps appear as a ledger on /institute/. One object, one
     treatment: shared .index numeral, serif title, one rank quieter here so
     it stays under the thesis. */
  .mstep__t {
    font-family: var(--serif);
    font-size: var(--step-sub);
    font-weight: 320;
    line-height: 1.1;
    letter-spacing: -0.014em;
    max-width: 14ch;
    text-wrap: balance;
  }
  .mstep__p {
    margin: 0;
    align-self: start;
    font-size: var(--step-body);
    line-height: 1.5;
    color: var(--fg-mute);
    max-width: 26ch;
    text-wrap: pretty;
  }

  /* The one operating fact, at the foot of the centre line, under the only
     horizontal hairline in the scene — short, and centred with it. */
  .method__stat {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.7rem;
    margin: clamp(2.5rem, 5vw, 4.25rem) 0 0;
    padding-top: clamp(1rem, 2vw, 1.5rem);
    border-top: 1px solid var(--rule-soft);
    width: min(20rem, 100%);
  }
  /* THE BRASS FIGURE, ONE WAY. The site sets a piece of key data as a brass
     tabular numeral beside a .label twice: here, and in the /people/ masthead
     ledger ("02 Founders", "16 Prospective board"). They were two objects —
     Libre Franklin 400 here, Newsreader 300 there — so the same move read as
     two. Newsreader is the one that carries a figure at display scale, so
     this takes its face and its weight. The rung stays where it is: this is
     the smaller of the two moments and does not need the size as well. */
  .method__stat-n {
    font-family: var(--serif);
    font-size: var(--step-bridge);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--brass);
    white-space: nowrap;
  }
  .method__stat-k { line-height: 1.5; }

  /* Three columns need width. Below this the register turns back through
     ninety degrees — rows on horizontal hairlines — but the scene keeps its
     centre line for the eyebrow, the thesis and the fact. */
  @media (max-width: 860px) {
    .method__steps { display: block; }
    .mstep {
      display: grid;
      justify-items: start;
      text-align: left;
      padding-block: clamp(1.1rem, 4vw, 1.6rem);
      border-top: 1px solid var(--rule-soft);
      row-gap: 0.5rem;
    }
    .mstep:first-child { border-top: 0; padding-top: 0; }
    .mstep:last-child { padding-bottom: 0; }
    .mstep__t, .mstep__p { max-width: 34ch; }
  }
</style>
