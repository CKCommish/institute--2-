---
import { method } from '../../data/site.js';
---
<section class="method" id="method" aria-labelledby="method-h">
  <div class="shell method__in">
    <header class="method__head">
      <h2 class="label method__eyebrow" id="method-h" data-reveal>How we work</h2>
      <p class="label tnum method__meta" data-reveal="90">01 — 03</p>
    </header>

    <ol class="method__steps">
      <span class="method__track" aria-hidden="true" data-reveal="100"></span>
      <span class="method__tip" aria-hidden="true" data-reveal="620"></span>
      {method.map((m, i) => (
        <li class="step" data-reveal={String(220 + i * 110)}>
          <span class="step__node" aria-hidden="true"></span>
          <span class="index step__i">{m.index}</span>
          <h3 class="display step__t">{m.title}</h3>
          <p class="step__p">{m.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* The quiet beat between two loud ones. One continuous rule that runs the
     width of the page and ends in an arrow, with three stops hung beneath it —
     a sequence, not three columns. Deliberately the smallest display type on
     the page so the scroll drops in volume here before the Forum. */
  .method {
    position: relative;
    background: var(--ink-800);
    padding-block: clamp(3.5rem, 1.75rem + 5.5vw, 7rem);
    border-top: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
  }
  .method__in { display: grid; gap: clamp(2.25rem, 5vw, 4rem); }

  .method__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
  }
  .method__eyebrow { color: var(--cream); }
  .method__meta { color: var(--fg-faint); text-align: right; }

  .method__steps {
    list-style: none; margin: 0; padding: 0;
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 4vw, 4rem);
  }

  /* the track the sequence runs along */
  .method__track {
    position: absolute; top: 0; left: 0; right: 0;
    height: 1px; background: var(--rule);
    transform-origin: left;
  }
  .method__track[data-reveal] {
    opacity: 1; transform: scaleX(0);
    transition: transform 900ms var(--ease-out) var(--reveal-delay, 0ms);
  }
  .method__track.is-in { transform: scaleX(1); }

  /* Terminus. The one mark that turns three stops into a direction.
     Local primitive — no arrowhead token exists. */
  .method__tip {
    position: absolute; top: 0; right: 0;
    width: 9px; height: 9px;
    border-top: 1px solid var(--brass);
    border-right: 1px solid var(--brass);
    transform-origin: center;
  }
  /* own reveal, so base.css's translate/none does not eat the rotation */
  .method__tip[data-reveal] {
    opacity: 0;
    transform: translate(-10px, -50%) rotate(45deg);
    transition: opacity 420ms var(--ease-out) var(--reveal-delay, 0ms),
                transform 620ms var(--ease-out) var(--reveal-delay, 0ms);
  }
  .method__tip.is-in { opacity: 1; transform: translate(0, -50%) rotate(45deg); }

  .step {
    position: relative;
    padding-top: clamp(1.6rem, 3vw, 2.6rem);
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }
  .step__node {
    position: absolute; top: -3px; left: 0;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--brass);
    transform: scale(0.3);
    opacity: 0;
    transition: transform 440ms var(--ease-out) calc(var(--reveal-delay, 0ms) + 60ms),
                opacity 320ms var(--ease-out) calc(var(--reveal-delay, 0ms) + 60ms);
  }
  .step.is-in .step__node { transform: none; opacity: 1; }

  .step__i { line-height: 1; }
  .step__t {
    font-size: clamp(1.3rem, 1.05rem + 1.05vw, 2.1rem);
    line-height: 1.08;
    letter-spacing: -0.014em;
    margin-top: 0.1rem;
  }
  .step__p {
    color: var(--fg-mute);
    font-size: var(--step-xs);
    max-width: 24ch;
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .step__node { transition-duration: 1ms; opacity: 1; transform: none; }
  }

  @media (max-width: 820px) {
    .method__head { flex-direction: row; }

    /* track rotates: the same diagram, read downward */
    .method__steps {
      grid-template-columns: minmax(0, 1fr);
      row-gap: clamp(1.6rem, 4.5vw, 2.25rem);
      padding-left: 1.75rem;
    }
    .method__track {
      top: 0; bottom: 0; left: 3px; right: auto;
      width: 1px; height: auto;
      transform-origin: top;
    }
    .method__track[data-reveal] { transform: scaleY(0); }
    .method__track.is-in { transform: scaleY(1); }
    .method__tip { top: auto; bottom: 0; left: 3px; right: auto; }
    .method__tip[data-reveal] { transform: translate(-50%, -10px) rotate(135deg); }
    .method__tip.is-in { transform: translate(-50%, 0) rotate(135deg); }
    .step { padding-top: 0; }
    .step__node { top: 0.5em; left: -1.75rem; }
    .step__p { max-width: 34ch; }
  }
</style>
