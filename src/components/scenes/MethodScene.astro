---
import { method } from '../../data/site.js';
---
<!-- The answer to the cream scene's asterisk, and the page's tightest beat:
     a section thesis held on the left, the mechanism as three ranked rows on
     the right.

     It used to be three anonymous columns whose titles were set at 51px — as
     loud as the section head that introduces the pilots, so a sub-item
     outranked its own section. The section head is now the only display type
     here; the steps drop to the page's mid tier (~26px), which puts four
     ranked sizes in one scene: 50 / 26 / 15 / 10.5. -->
<section class="method" id="method" aria-labelledby="method-h">
  <div class="shell method__in">
    <div class="method__head">
      <p class="label method__eyebrow" data-reveal>The method</p>
      <p class="label tnum method__meta" data-reveal="70">01 — 03</p>
    </div>

    <span class="method__rule" aria-hidden="true" data-reveal="60"></span>

    <div class="method__grid">
      <div class="method__thesis">
        <h2 class="display method__h lines" id="method-h">How we work.</h2>

        <p class="method__stat" data-reveal="320">
          <span class="method__stat-n tnum">3&ndash;12</span>
          <span class="method__stat-k">Months<br />per pilot</span>
        </p>
      </div>

      <ol class="method__steps">
        {method.map((m, i) => (
          <li class="mstep" data-reveal={String(140 + i * 120)}>
            <span class="index mstep__i">{m.index}</span>
            <h3 class="mstep__t">{m.title}</h3>
            <p class="mstep__p">{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .method {
    position: relative;
    background: var(--ink-800);
    padding-block: clamp(3.75rem, 2rem + 5.4vw, 7rem);
    border-top: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
  }
  .method__in { display: grid; }

  .method__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: clamp(0.7rem, 1.6vw, 1.1rem);
  }
  /* Local durations: the house --dur-2/--dur-3 pair runs 1.15s, so a scene
     with six staggered objects would still be arriving two seconds after it
     is on screen. Everything here lands inside one. */
  .method__eyebrow[data-reveal],
  .method__meta[data-reveal],
  .method__stat[data-reveal],
  .mstep[data-reveal] { transition-duration: 520ms, 640ms; }

  .method__meta { color: var(--fg-faint); text-align: right; }

  /* Local motion primitive: hairline that draws left→right on reveal. */
  .method__rule {
    display: block; height: 1px; width: 100%;
    background: var(--rule);
    transform-origin: left;
  }
  .method__rule[data-reveal] {
    opacity: 1; transform: scaleX(0);
    transition: transform 860ms var(--ease-out) var(--reveal-delay, 0ms);
  }
  .method__rule.is-in { transform: scaleX(1); }

  /* ── The split ────────────────────────────────────────────────────
     Thesis left, sequence right. Not three equal columns. */
  .method__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.3fr);
    column-gap: clamp(2rem, 6vw, 6.5rem);
    padding-top: clamp(2rem, 4.4vw, 3.6rem);
  }

  .method__thesis {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(2rem, 5vh, 3.5rem);
  }
  /* The scene's ONLY display register, and deliberately quieter than the
     section head that opens the pilots ledger below it. */
  .method__h {
    font-size: clamp(1.9rem, 0.85rem + 2.9vw, 3.05rem);
    line-height: 0.98;
    letter-spacing: -0.022em;
    max-width: 9ch;
  }

  /* The one operating fact, hung in the corner of the column. */
  .method__stat {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }
  .method__stat-n {
    font-size: clamp(1.35rem, 0.95rem + 1.05vw, 1.85rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.012em;
    color: var(--brass);
    white-space: nowrap;
  }
  .method__stat-k {
    font-size: 0.655rem;
    font-weight: 500;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--fg-faint);
  }

  /* ── The three stops ──────────────────────────────────────────────
     Rows on a hairline register, staggered 01 → 02 → 03. Each row holds one
     numeral, one title and one line, at three clearly different sizes. */
  .method__steps { list-style: none; margin: 0; padding: 0; }
  .mstep {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: clamp(1rem, 2.4vw, 2rem);
    align-items: baseline;
    padding-block: clamp(1rem, 2.2vw, 1.5rem);
    border-top: 1px solid var(--rule-soft);
  }
  .mstep:first-child { border-top: 0; padding-top: 0; }
  .mstep:last-child { padding-bottom: 0; }

  .mstep__i { grid-row: 1; }
  /* The same three steps appear as a ledger on /institute/. One object, one
     treatment: shared .index numeral, serif title, one rank quieter here so it
     stays under the section head. */
  .mstep__t {
    grid-row: 1;
    font-family: var(--serif);
    font-size: clamp(1.24rem, 0.9rem + 0.92vw, 1.62rem);
    font-weight: 320;
    line-height: 1.1;
    letter-spacing: -0.014em;
  }
  .mstep__p {
    grid-column: 2;
    margin-top: 0.4rem;
    font-size: clamp(0.88rem, 0.85rem + 0.14vw, 0.95rem);
    line-height: 1.5;
    color: var(--fg-mute);
    max-width: 30ch;
  }

  @media (max-width: 900px) {
    .method__grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: clamp(2.25rem, 6vw, 3rem);
    }
    .method__thesis {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1.5rem;
    }
    .method__h { max-width: none; }
    .method__stat { align-self: baseline; }
  }

  @media (max-width: 520px) {
    .method__thesis { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
    .mstep { column-gap: 1rem; }
  }
</style>
