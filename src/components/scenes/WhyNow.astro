---
import { whyNow } from '../../data/site.js';
---
<!-- The page's one inversion, and its only silent scene. A single claim on a
     cream field, an asterisk hung off its last word, and a footnote at the
     foot of the frame that hands straight down into the method. No second
     idea lives here — the operating facts moved to the scene below, where
     they are evidence rather than decoration. -->
<section class="why on-cream" id="why" aria-labelledby="why-h">
  <div class="shell why__in">
    <p class="label why__label" data-reveal>Why now</p>
    <h2 class="display why__h lines" id="why-h">{whyNow}</h2>
  </div>

  <div class="shell why__foot">
    <span class="why__rule" aria-hidden="true" data-reveal="200"></span>
    <p class="label why__note" data-reveal="340">
      <span class="why__note-ast" aria-hidden="true">*</span>Our answer
      <span class="why__note-arrow" aria-hidden="true"></span>
    </p>
  </div>
</section>

<style>
  .why {
    position: relative;
    min-height: min(62svh, 580px);
    display: grid;
    grid-template-rows: 1fr auto;
    padding-top: clamp(4.5rem, 12vh, 8rem);
    padding-bottom: clamp(1.5rem, 4vh, 2.75rem);
    overflow: hidden;
  }

  /* ── Claim ──────────────────────────────────────────────────────── */
  .why__in { position: relative; align-self: center; }

  /* Local durations throughout this scene: the house --dur-2/--dur-3 pair
     runs 1.15s, so a staggered scene needs most of two seconds to settle.
     A statement this short should be finished arriving in one. */
  .why__label[data-reveal] { transition-duration: 620ms, 760ms; }
  :global(.why__h .line > span) { transition-duration: 820ms; }
  .why__note[data-reveal] { transition-duration: 540ms, 660ms; }

  .why__label {
    display: block;
    color: var(--fg-mute);
    margin-bottom: clamp(0.7rem, 1.3vw, 1.1rem);
  }

  /* Deliberately ranked below the hero thesis: this is the page's second
     voice, not a competing poster. */
  .why__h {
    font-size: clamp(2.2rem, 0.2rem + 5.6vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: initial;
    max-width: 30ch;
  }

  /* Footnote mark, hung off the end of the last line of the statement and
     answered at the foot of the frame. Attached to the masked line motion.js
     builds, so it always lands on the final line at any width.
     :global — motion.js builds .line/span at runtime, so they never carry
     Astro's scope attribute. .why__h keeps the selector local in practice. */
  :global(.why__h .line:last-child > span::after) {
    content: '*';
    color: var(--brass);
    font-size: 0.34em;
    vertical-align: 0.88em;
    margin-left: 0.14em;
    letter-spacing: 0;
  }

  /* ── The hand-off ───────────────────────────────────────────────── */
  .why__foot {
    align-self: end;
    display: grid;
    row-gap: clamp(0.7rem, 1.6vh, 1.1rem);
    padding-top: clamp(2.5rem, 8vh, 5rem);
  }

  /* Local motion primitive: hairline that draws left→right on reveal. */
  .why__rule {
    display: block;
    height: 1px;
    width: 100%;
    background: var(--brass);
    transform-origin: left;
  }
  .why__rule[data-reveal] {
    opacity: 1;
    transform: scaleX(0);
    transition: transform 820ms var(--ease-out) var(--reveal-delay, 0ms);
  }
  .why__rule.is-in { transform: scaleX(1); }

  .why__note {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--fg-mute);
  }
  .why__note-ast { font-family: var(--serif); font-size: 1.3em; color: var(--brass); line-height: 1; }

  /* Direction, not decoration: the footnote points into the scene that
     answers it. Local primitive — no chevron token exists. */
  .why__note-arrow {
    width: 7px; height: 7px;
    border-right: 1px solid var(--brass);
    border-bottom: 1px solid var(--brass);
    transform: rotate(45deg) translate(-1px, -1px);
    margin-left: 0.35rem;
  }

  @media (max-width: 1100px) {
    .why__h { max-width: 22ch; }
  }

  @media (max-width: 900px) {
    .why__h { max-width: 16ch; }
  }

  @media (max-width: 700px) {
    .why {
      min-height: min(56svh, 480px);
      padding-top: clamp(3rem, 7vh, 5rem);
    }
    .why__h { max-width: none; }
    .why__foot { padding-top: clamp(2rem, 6vh, 3rem); }
  }
</style>
