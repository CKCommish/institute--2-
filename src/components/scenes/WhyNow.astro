---
import { whyNow, whyNowLead } from '../../data/site.js';
---
<!-- The page's one inversion, and its only silent scene.

     WHAT CHANGED, ROUND 3. The held interval used to be 290px of a 630px
     section — 46% — containing two brass hairlines that measured nothing,
     terminated on nothing, and pointed at nothing. A measure that measures
     nothing is worse than air. Both are gone. The interval is now bounded
     by MARKS instead of by a viewport edge and a bracket:

       eyebrow (left) ─────────────────── bridge (right rail)
       ── one rule, corner to corner ──                        ← top jaw
              [ the held pause, --pause, ~118px ]
       claim, three lines of 86px across the foot               ← bottom jaw

     The scene also stops opening the way the other five do. Every other
     scene on this page starts with an 11.7px label at the top-left rail and
     nothing else on that line; here the lead runs the full width — the name
     of the scene at one corner, the sentence that sets up the claim at the
     other — so the top edge is a composed line rather than a tick.

     MOTION. Three classes of object, three vectors, one rule each and no
     more: the WORDS arrive (reveal), the RULE is territory and is uncovered
     from the right, growing out from under the bridge it hangs off; the
     CLAIM is weight and is on settle — scroll-linked, continuous,
     reversible, already there when the scene arrives and resolving under
     the reader rather than firing at them. Settle is used once on this
     page, here, on the thing the page is actually about. -->
<section class="why on-cream" id="why" aria-labelledby="why-h">
  <div class="shell why__lead">
    <p class="eyebrow why__eyebrow" data-reveal>Why now</p>
    <p class="bridge why__bridge" data-reveal="140">{whyNowLead}</p>
  </div>

  <!-- The top jaw. Corner to corner, so the pause under it is an interval
       between two marks and not the top half of a blank page. -->
  <div class="shell why__ruleWrap">
    <span class="why__rule" aria-hidden="true" data-wipe="right" data-delay="260"></span>
  </div>

  <div class="shell why__foot">
    <h2 class="display display--poster why__h" id="why-h" data-settle="0.5">
      {whyNow}<span class="why__ast" aria-hidden="true">*</span>
    </h2>
    <a class="label tap why__note" href="#method" data-reveal="320">
      <span class="why__note-ast" aria-hidden="true">*</span>Our answer
      <svg class="arrow arrow--down why__note-arrow" viewBox="0 0 22 10" aria-hidden="true"><path d="M16 1l5 4-5 4M21 5H0" stroke="currentColor" stroke-width="1" fill="none"/></svg>
    </a>
  </div>
</section>

<style>
  .why {
    position: relative;
    display: grid;
    /* Four rows: lead, rule, THE PAUSE, foot. The pause is the only row
       that absorbs slack, and it is floored at the house --pause — a held
       rest, bounded above by the rule and below by the claim. It is capped
       so a tall viewport cannot reopen the hole this scene was built to
       close. */
    grid-template-rows: auto auto minmax(var(--pause), 1fr) auto;
    min-height: min(64svh, 620px);
    padding-top: clamp(1.6rem, 4.4vh, 3.1rem);
    padding-bottom: clamp(1.9rem, 5vh, 3.4rem);
    overflow: hidden;
  }

  /* ── The lead: the scene's name at one corner, its set-up at the other ── */
  .why__lead {
    width: 100%;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .why__eyebrow { flex: none; }
  .why__bridge {
    margin: 0;
    text-align: right;
    max-width: 30ch;
  }

  /* ── The top jaw ──────────────────────────────────────────────────── */
  .why__ruleWrap { width: 100%; margin-top: clamp(1rem, 2.6vh, 1.7rem); }
  .why__rule {
    display: block;
    height: 1px;
    width: 100%;
    background: var(--rule);
    /* --dur-4 is the length of a full-bleed figure uncovering. A 1px rule
       crossing 1337px at that speed is still travelling long after the
       words have landed, which is the point of a silent scene. */
    transition-duration: 1180ms;
  }

  /* ── The claim, on the foot of the frame ──────────────────────────── */
  .why__foot {
    align-self: end;
    display: grid;
    row-gap: clamp(1.4rem, 3.6vh, 2.3rem);
  }

  /* --step-poster: one rank under the hero, which is the only thing on the
     site allowed to be louder. The measure is set in em and tight enough to
     break the sentence over THREE lines, not two: 258px of type across the
     foot is what bounds the pause above it. Bottom-heavy on purpose — the
     hero loads its top-left corner, this one loads its foot. */
  .why__h {
    margin: 0;
    line-height: 1.0;
    letter-spacing: -0.026em;
    max-width: min(9.6em, 100%);
    text-wrap: initial;

    /* Tuned up from the house defaults: this is the one element on the page
       carrying the vector, so it has to be legible as motion. */
    --settle-scale: 0.94;
    --settle-shift: 3.6vh;
    --settle-origin: 0% 100%;
  }

  /* Footnote mark, hung off the end of the claim and answered in the open
     right-hand corner the tight measure leaves behind. */
  .why__ast {
    color: var(--brass);
    font-size: 0.34em;
    vertical-align: 0.88em;
    margin-left: 0.1em;
    letter-spacing: 0;
  }

  .why__note {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    transition: color 420ms var(--ease-out);
  }
  .why__note:hover { color: var(--fg); }
  .why__note[data-reveal] { transition-duration: 520ms, 640ms; }
  .why__note-ast { font-family: var(--serif); font-size: 1.3em; color: var(--brass); line-height: 1; }

  /* Direction, not decoration: the footnote points into the scene that
     answers it. It is the house arrow turned a quarter, not a second glyph
     drawn out of two borders — the site has ONE arrow. */
  .why__note-arrow {
    width: 1.15em;
    color: var(--brass);
    margin-left: 0.15rem;
  }
  .why__note:hover .why__note-arrow { transform: rotate(90deg) translateX(3px); }

  .why__eyebrow[data-reveal],
  .why__bridge[data-reveal] { transition-duration: 560ms, 700ms; }

  @media (max-width: 860px) {
    /* Two corners need width. Below this the lead stacks and the bridge
       returns to the rail, but it keeps its full measure so the rule under
       it still reads as the foot of a block rather than a stray line. */
    .why__lead {
      display: block;
    }
    .why__bridge {
      text-align: left;
      max-width: 34ch;
      margin-top: clamp(0.75rem, 2vh, 1.1rem);
    }
  }

  @media (max-width: 700px) {
    .why {
      min-height: min(52svh, 430px);
      padding-top: clamp(1.3rem, 3.4vh, 2.1rem);
      /* Below ~700px the display range compresses and the interval has to
         be carried by space alone; keep it, but do not let it eat the
         screen the claim needs. */
      grid-template-rows: auto auto minmax(calc(var(--pause) * 0.42), 1fr) auto;
    }
    .why__h { max-width: none; letter-spacing: -0.022em; }
    .why__foot { row-gap: clamp(1.1rem, 2.8vh, 1.7rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .why__note-arrow, .why__note { transition-duration: 1ms; }
  }
</style>
