---
import { whyNow } from '../../data/site.js';
---
<section class="why on-cream scene" id="why" aria-labelledby="why-h">
  <div class="shell why__in">
    <p class="label why__label" data-reveal>Why now</p>
    <h2 class="display display--xl why__h lines" id="why-h">{whyNow}</h2>
    <div class="why__mark" aria-hidden="true" data-reveal="420"></div>
  </div>
</section>

<style>
  .why { padding-block: clamp(6rem, 14vw, 14rem); }
  .why__in { display: grid; gap: clamp(2rem, 4vw, 3.5rem); }
  .why__h { max-width: 20ch; }
  .why__mark { height: 1px; background: var(--rule); width: 100%; transform-origin: left; }
  .why__mark[data-reveal] { transform: scaleX(0); transition: transform 1400ms var(--ease-out) 300ms, opacity 1ms; opacity: 1; }
  .why__mark.is-in { transform: scaleX(1); }
</style>
