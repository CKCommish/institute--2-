---
import { whyNow, whyNowLead } from '../../data/site.js';
---
{/* THE PAGE'S ONE EXCEPTION.

     Everything else on this site is drawn with the same move: an 11.7px
     label at the top-left rail, a full-width horizontal rule under it, and a
     block hung below that rule. Six scenes, one armature, one column down
     x=51. A critic counted it: "the same left-third armature drawn four
     times."

     This scene is the one that does not do that. It is turned ninety
     degrees. The division is VERTICAL — the only vertical rule on the site,
     running the full height of the only cream ground on the site — and the
     major column is the RIGHT one, so the claim starts a third of the way
     across the page instead of at the rail every other scene opens on. The
     eyebrow and the lead sit in the narrow left column, set flush to the
     rule rather than to the page edge, which is the one place on this site
     where type is right-aligned against something.

     Why here and nowhere else: this is the only scene that is not the
     institute talking about itself. It is the fact the institute exists
     because of, and it is one sentence long. If the page is allowed to
     break its own grid exactly once, it breaks it on that.

     WHAT THIS REPLACED. A 630px band whose middle 292px was empty and
     bounded only by a hairline on the margin — the pause had been bounded,
     which was the last round's ask, but a bounded hole is still a hole. The
     interval is now the gap between the eyebrow at the top of the left
     column and the lead at its foot: air with a mark above it, a mark below
     it, and a rule down its right-hand side. Three sides, not two.

     MOTION. Still three vectors, still one each. The WORDS arrive (reveal).
     The RULE is territory and is uncovered downward from the top, so the
     scene draws its own division before anything is set against it. The
     CLAIM is weight and is on settle — scroll-linked, reversible, resolving
     under the reader. Settle is spent once on this page, here. */}
<section class="why on-cream" id="why" aria-labelledby="why-h">
  <div class="shell why__in">

    {/* The narrow column. Flush to the rule, not to the page. */}
    <div class="why__side">
      <p class="eyebrow why__eyebrow" data-reveal>Why now</p>
      <p class="bridge why__bridge" data-reveal="220">{whyNowLead}</p>
    </div>

    {/* The division. Vertical, full height, drawn top-down. */}
    <span class="why__rule" aria-hidden="true" data-wipe="top" data-delay="60"></span>

    {/* The major column. */}
    <div class="why__main">
      <h2 class="display display--poster why__h" id="why-h" data-settle="0.5">
        {whyNow}<span class="why__ast" aria-hidden="true">*</span>
      </h2>
      <a class="label tap why__note" href="/institute/" data-reveal="320">
        <span class="why__note-ast" aria-hidden="true">*</span>Our answer
        <svg class="arrow why__note-arrow" viewBox="0 0 22 10" aria-hidden="true"><path d="M16 1l5 4-5 4M21 5H0" stroke="currentColor" stroke-width="1" fill="none"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .why {
    position: relative;
    padding-block: clamp(3rem, 2rem + 4.6vw, 6.5rem);
    overflow: hidden;
  }

  /* Narrow · hairline · major. The rule is a grid TRACK, not a border on a
     column, so it spans the full height of the tallest column and reads as
     a division of the page rather than an edge of a box. */
  .why__in {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) 1px minmax(0, 1.6fr);
    column-gap: clamp(1.6rem, 4vw, 3.75rem);
    align-items: stretch;
  }

  /* ── The narrow column ────────────────────────────────────────────
     Eyebrow at the head, lead at the foot, --pause held between them.
     Right-aligned: the one place on this site type sets to a rule instead
     of to the rail. */
  .why__side {
    display: grid;
    grid-template-rows: auto minmax(var(--pause), 1fr) auto;
    text-align: right;
    justify-items: end;
  }
  .why__eyebrow { grid-row: 1; }
  .why__bridge {
    grid-row: 3;
    margin: 0;
    max-width: 24ch;
    text-wrap: pretty;
  }

  /* ── The division ─────────────────────────────────────────────────── */
  .why__rule {
    display: block;
    width: 1px;
    height: 100%;
    background: var(--rule);
    /* A rule crossing the scene's full height at the speed of a full-bleed
       figure uncovering — still travelling after the words have landed,
       which is what a silent scene is for. */
    transition-duration: 1180ms;
  }

  /* ── The major column ─────────────────────────────────────────────── */
  .why__main {
    display: grid;
    grid-template-rows: auto auto;
    row-gap: clamp(1.4rem, 3.4vh, 2.4rem);
    align-content: start;
  }

  /* --step-poster: one rank under the hero, which is the only thing on this
     site allowed to be louder. The measure is em-fixed so the sentence
     breaks over three lines at every width. */
  .why__h {
    margin: 0;
    line-height: 1.0;
    letter-spacing: -0.026em;
    max-width: min(12.2em, 100%);
    text-wrap: initial;

    /* This is the one element on the page carrying the settle vector, so it
       is tuned up far enough to read as motion. */
    --settle-scale: 0.94;
    --settle-shift: 3.6vh;
    --settle-origin: 0% 100%;
  }

  /* Footnote mark, hung off the end of the claim and answered under it.

     THE TIE IS INK, NOT BRASS, AND IT IS A MEASUREMENT THAT SAYS SO.
     Both marks were `var(--brass)`. On this scene `.on-cream` maps
     `--brass` to `--brass-deep` (#7E6431), which against `--cream`
     (#F2EDE3) is 4.79:1 ARITHMETIC — the tightest colour pair on the
     site, and the whole of the headroom a brass mark on cream can ever
     have. At rest these two measured 4.657:1 (13px, mobile), 4.744:1
     (14px, mobile) and 4.601:1 (15px, desktop) by glyph-floor. All three
     pass 4.5, and all three pass it by a tenth. That is marginal by
     design, not by accident, and it is why nothing else on the site
     lands here: no other brass mark on cream is this small.

     What made it fail is the second half. An asterisk at 13px carries
     FOUR CSS ROWS OF INK. The fixed bar's half-lit band is SIX — the
     scrim's mask is solid to 58px and transparent at 64px, measured off
     `.nav.is-scrolled::before` on this page at 390x844 — and that band
     was sized against 8.67px, the ink of the site's smallest label
     ("Special Olympics" on /pilots/; see AGENTS.md). A mark with four
     rows of ink is smaller than the ramp that takes it away, so it does
     not slide under the bar being cut row by row like every other string
     on the site: it goes under WHOLE AND HALF-LIT. Measured on mobile /
     by subtraction, the 13px mark with its entire body still on the
     glass and not one row lost:

         scrollY   1039   1041   1043   1045
         box top     62     60     58     56   (viewport px)
         ratio    4.646  4.446  3.054  1.895

     1043 is the last offset at which the whole mark is visible; 1045 is
     already a sliver and glyph-floor sets it aside. 3.054:1 is therefore
     a real reading of a wholly-visible, wholly-crushed mark — exactly the
     state that gate exists to fail, and the 14px twin does the same thing
     at 1102 (3.816:1). The gate is right. Its `SHOWN` rule cannot excuse
     this and must not be taught to: "the string's ink is shorter than the
     ramp" would have excused wave 15's 39px ramp swallowing whole
     headings, which is that rule's own positive control.

     So the fix is a colour decision, forced by measurement. `--fg` is
     `--ink-900` here: 16.268:1 at rest, and 7.427:1 at scrollY 1043 —
     the same wholly-visible, wholly-crushed offset that read 3.054 in
     brass — because the same cream wash over near-black ink lands far
     higher than it does over brass. The 14px twin goes 3.816 -> 7.619
     at its own last full-body offset. The mark keeps its job — the tie
     is carried by position, the superscript and the answering `*` under
     it — and the brass register is still in the scene, on the arrow
     beside the note. That arrow is a stroke, not a glyph, so glyph-floor
     does not measure it and this note makes no claim about it; what it
     claims is measured above. */
  .why__ast {
    color: var(--fg);
    font-size: 0.34em;
    vertical-align: 0.88em;
    margin-left: 0.1em;
    letter-spacing: 0;
  }

  .why__note {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .why__note:hover,
  .why__note:focus-visible { color: var(--fg); }
  /* This has to be the whole list, not a `transition-duration` override.
     The rule above sets `transition: color …`, which resets
     transition-property to `color` alone — so base.css's [data-reveal]
     pair was gone, `520ms, 640ms` landed the 520 on the HOVER and dropped
     the 640, and this footnote was the one thing in the scene that
     snapped into place instead of arriving. Both jobs are now declared
     together: the reveal at this scene's tempo, the hover on the site's
     register. Reduced motion still flattens all three — base.css sets
     transition-duration on [data-reveal] with !important. */
  .why__note[data-reveal] {
    transition:
      opacity 520ms var(--ease-out) var(--reveal-delay, 0ms),
      transform 640ms var(--ease-out) var(--reveal-delay, 0ms),
      color var(--dur-hover) var(--ease-out);
  }
  /* Ink, not brass, for the reason written over `.why__ast` above. */
  .why__note-ast { font-family: var(--serif); font-size: 1.3em; color: var(--fg); line-height: 1; }

  /* Direction, not decoration: the footnote points into the scene that
     answers it. The house arrow turned a quarter — the site has ONE arrow. */
  .why__note-arrow {
    width: 1.15em;
    color: var(--brass);
    margin-left: 0.15rem;
  }
  .why__note:hover .why__note-arrow,
  .why__note:focus-visible .why__note-arrow { transform: rotate(90deg) translateX(3px); }

  .why__eyebrow[data-reveal],
  .why__bridge[data-reveal] { transition-duration: 560ms, 700ms; }

  @media (prefers-reduced-motion: reduce) {
    /* The arrow lights, it does not slide. It keeps its quarter-turn. */
    .why__note:hover .why__note-arrow,
    .why__note:focus-visible .why__note-arrow { transform: rotate(90deg); }
  }

  /* If the script never runs, nothing may stay under its mask. */
  :global(html:not(.js)) .why__rule { clip-path: none; }

  /* A vertical division needs width on both sides of it. Below this the
     scene returns to a single column — but it keeps the ORDER it was
     composed in, and the rule turns horizontal and sits under the lead, so
     the top edge of the scene is still a composed pair rather than a tick.  */
  @media (max-width: 820px) {
    .why__in {
      grid-template-columns: minmax(0, 1fr);
      row-gap: clamp(1.1rem, 3vh, 1.7rem);
    }
    .why__side {
      grid-template-rows: auto auto;
      row-gap: clamp(0.7rem, 2vh, 1.05rem);
      text-align: left;
      justify-items: start;
    }
    .why__bridge { grid-row: 2; max-width: 34ch; }
    .why__rule { width: 100%; height: 1px; }
    .why__h { max-width: none; letter-spacing: -0.022em; }
  }
</style>
