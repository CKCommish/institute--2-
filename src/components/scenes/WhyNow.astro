---
import { whyNow, whyNowLead } from '../../data/site.js';
---
<!-- The page's one inversion, and its only silent scene.

     It is composed the opposite way round from the hero: the hero loads its
     top-left corner and lets the photograph fall away beneath it; this loads
     the FOOT of the frame and holds cream above it. Two scenes in a row
     cannot land the same way, and the cut from a dark top-weighted screen
     into a light bottom-weighted one is the beat.

     WHAT CHANGED. The held space used to be a 394px void — 56% of the
     section — with an 11.7px label stranded at the top of it and a 75px
     claim at the bottom, and nothing in between. The intent was legible in
     this comment and nowhere in the pixels, because a pause is only a pause
     when something bounds it at both ends. Now:

       eyebrow   11.7px   names the scene
       bridge    26.6px   says what weight is coming            ← the rung
       ─ drop ─           a hairline runs the length of the rest
       claim     86.1px   the fact, on the foot of the frame
       rule + footnote    and points into the scene that answers it

     The rest is the same length; it is now an interval between two marks,
     with a line measuring it, instead of an empty top half.

     MOTION. The rest of the page arrives on one vector — masked fade-up at
     staggered delays. This scene deliberately does not use it. The drop line
     WIPES downward out of the bridge (territory), and the claim is on
     SETTLE (weight): scroll-linked, continuous, reversible, no entry
     trigger. It is already there when the scene arrives and it resolves
     under the reader instead of firing at them, which is the whole argument
     of a silent scene. Settle is used once on this page, here, on the thing
     the page is actually about. -->
<section class="why on-cream" id="why" aria-labelledby="why-h">
  <div class="shell why__lead">
    <p class="eyebrow why__eyebrow" data-reveal>Why now</p>
    <p class="bridge why__bridge" data-reveal="150">{whyNowLead}</p>
  </div>

  <!-- The pause. Bounded above by the bridge, below by the claim, and
       measured by a hairline that grows down between them. -->
  <div class="shell why__gap" aria-hidden="true">
    <span class="why__drop" data-wipe="top" data-delay="340"></span>
  </div>

  <div class="shell why__foot">
    <h2 class="display display--poster why__h" id="why-h" data-settle="0.46">
      {whyNow}<span class="why__ast" aria-hidden="true">*</span>
    </h2>
    <span class="why__rule" aria-hidden="true" data-wipe="left" data-delay="120"></span>
    <a class="label tap why__note" href="#method" data-reveal="300">
      <span class="why__note-ast" aria-hidden="true">*</span>Our answer
      <span class="why__note-arrow" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  .why {
    position: relative;
    min-height: min(70svh, 680px);
    display: grid;
    /* The middle row is the pause: never shorter than the house --pause,
       and the only row that absorbs slack, so a tall viewport lengthens the
       held interval rather than opening a hole under the label. */
    grid-template-rows: auto minmax(var(--pause), 1fr) auto;
    padding-top: clamp(1.5rem, 4.2vh, 3rem);
    padding-bottom: clamp(1.5rem, 4vh, 2.8rem);
    overflow: hidden;
  }

  /* ── The lead: eyebrow → bridge ───────────────────────────────────── */
  .why__lead { width: 100%; }
  .why__bridge { margin-top: clamp(0.85rem, 2.2vh, 1.35rem); }

  /* ── The pause, and the line that measures it ─────────────────────── */
  .why__gap { width: 100%; display: flex; }
  .why__drop {
    display: block;
    width: 1px;
    align-self: stretch;
    /* Brass, like the rule under the claim: the two together bracket the
       claim on its left and its foot, so the held space is inside a frame
       rather than beside one. */
    background: var(--brass);
    margin-block: clamp(0.9rem, 2.4vh, 1.6rem);
  }

  /* ── The claim, on the foot of the frame ──────────────────────────── */
  .why__foot {
    align-self: end;
    display: grid;
    row-gap: clamp(1.5rem, 4vh, 2.6rem);
  }

  /* --step-poster: one rank under the hero banner, which is the only thing
     on the site allowed to be louder. Measure in em so the break holds at
     every width; text-wrap: initial so balance does not move it. */
  .why__h {
    margin: 0;
    line-height: 1.0;
    letter-spacing: -0.026em;
    max-width: min(13.2em, 100%);
    text-wrap: initial;

    /* Weight, tuned up from the house defaults: this is the one element on
       the page carrying the vector, so it has to be readable as motion. */
    --settle-scale: 0.935;
    --settle-shift: 4vh;
    --settle-origin: 0% 100%;
  }

  /* Footnote mark, hung off the end of the claim and answered in the bottom
     corner. Inline now rather than pinned to the last masked line — this
     scene no longer splits into lines. */
  .why__ast {
    color: var(--brass);
    font-size: 0.34em;
    vertical-align: 0.88em;
    margin-left: 0.1em;
    letter-spacing: 0;
  }

  .why__rule {
    display: block;
    height: 1px;
    width: 100%;
    background: var(--brass);
    /* --dur-4 is the length of a full-bleed figure uncovering. A 1px rule
       crossing the same distance at that speed is still travelling long
       after the words have landed. */
    transition-duration: 980ms;
  }

  .why__note {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: calc(clamp(1.5rem, 4vh, 2.6rem) * -0.55);
    transition: color 420ms var(--ease-out);
  }
  .why__note:hover { color: var(--fg); }
  .why__note[data-reveal] { transition-duration: 520ms, 640ms; }
  .why__note-ast { font-family: var(--serif); font-size: 1.3em; color: var(--brass); line-height: 1; }

  /* Direction, not decoration: the footnote points into the scene that
     answers it. Local primitive — no chevron token exists. */
  .why__note-arrow {
    width: 7px; height: 7px;
    border-right: 1px solid var(--brass);
    border-bottom: 1px solid var(--brass);
    transform: rotate(45deg) translate(-1px, -1px);
    margin-left: 0.35rem;
    transition: transform 420ms var(--ease-out);
  }
  .why__note:hover .why__note-arrow { transform: rotate(45deg) translate(2px, 2px); }

  .why__eyebrow[data-reveal],
  .why__bridge[data-reveal] { transition-duration: 560ms, 700ms; }

  @media (max-width: 700px) {
    .why {
      min-height: min(60svh, 500px);
      padding-top: clamp(1.25rem, 3.2vh, 2rem);
      /* Below ~700px the display range compresses and the interval has to
         be carried by space alone; keep it, but do not let it eat the
         screen the claim needs. */
      grid-template-rows: auto minmax(calc(var(--pause) * 0.72), 1fr) auto;
    }
    .why__h { max-width: none; letter-spacing: -0.022em; }
    .why__foot { row-gap: clamp(1.25rem, 3vh, 1.9rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .why__note-arrow, .why__note { transition-duration: 1ms; }
  }
</style>
