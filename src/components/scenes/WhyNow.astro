---
import { whyNow } from '../../data/site.js';

/* The footnote apparatus. Numerals only — these are the same operating facts
   the method scene used to carry as a limp right-aligned meta label, promoted
   here into the missing middle rung of the type scale. Held locally because
   this piece may not add keys to src/data/site.js. */
const ledger = [
  { n: '3–12', k: 'Months per pilot' },
  { n: '01', k: 'Measured outcome' },
  { n: '04', k: 'Pilots running now' },
];
---
<section class="why on-cream" id="why" aria-labelledby="why-h">
  <div class="shell why__in">
    <p class="label why__label" data-reveal>Why now</p>
    <h2 class="display why__h lines" id="why-h">{whyNow}</h2>
  </div>

  <div class="shell why__foot">
    <p class="label why__note" data-reveal="240">
      <span class="why__note-ast" aria-hidden="true">*</span>Our answer
    </p>

    <span class="why__rule" aria-hidden="true" data-reveal="310"></span>

    <dl class="why__ledger">
      {ledger.map((c, i) => (
        <div class="why__cell" data-reveal={String(390 + i * 90)}>
          <dt class="display tnum why__n">{c.n}</dt>
          <dd class="label why__k">{c.k}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* The page's one inversion. A claim at the top of the frame, an asterisk
     hanging in the right margin, and the answer to it — three numerals on a
     brass rule — anchored to the bottom. Four ranked registers, top tied to
     bottom, so the cream field is composed rather than merely empty. */
  .why {
    position: relative;
    min-height: min(70svh, 660px);
    display: grid;
    grid-template-rows: 1fr auto;
    padding-top: clamp(4.5rem, 12vh, 8rem);
    padding-bottom: clamp(1.75rem, 4.5vh, 3rem);
    overflow: hidden;
  }

  /* ── Claim ──────────────────────────────────────────────────────── */
  .why__in { position: relative; align-self: center; }

  .why__label {
    display: block;
    color: var(--fg-mute);
    margin-bottom: clamp(0.65rem, 1.2vw, 0.95rem);
  }

  .why__h {
    font-size: clamp(2.35rem, 0.2rem + 6.6vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.032em;
    text-wrap: initial;
    max-width: 21ch;
  }

  /* Footnote mark, hung off the end of the last line of the statement and
     answered by the one above the rule at the foot of the frame. Attached to
     the masked line motion.js builds, so it always lands on the final line at
     any width. Decorative: absent if the splitter never runs. */
  /* :global — motion.js builds .line/span at runtime, so they never carry
     Astro's scope attribute. .why__h keeps the selector local in practice. */
  :global(.why__h .line:last-child > span::after) {
    content: '*';
    color: var(--brass);
    font-size: 0.34em;
    vertical-align: 0.88em;
    margin-left: 0.14em;
    letter-spacing: 0;
  }

  /* ── Answer ─────────────────────────────────────────────────────── */
  .why__foot {
    align-self: end;
    display: grid;
    row-gap: clamp(0.6rem, 1.4vh, 0.95rem);
    padding-top: clamp(2rem, 5vh, 3.25rem);
  }

  .why__note {
    justify-self: end;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--fg-mute);
  }
  .why__note-ast { font-family: var(--serif); font-size: 1.25em; color: var(--brass); }

  /* Local motion primitive: hairline that draws left→right on reveal. */
  .why__rule {
    display: block;
    height: 1px;
    width: 100%;
    background: var(--brass);
    transform-origin: left;
  }
  .why__rule[data-reveal] {
    opacity: 1;
    transform: scaleX(0);
    transition: transform 950ms var(--ease-out) var(--reveal-delay, 0ms);
  }
  .why__rule.is-in { transform: scaleX(1); }

  .why__ledger {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 4vw, 4rem);
    padding-top: clamp(0.85rem, 2vh, 1.4rem);
  }
  .why__cell {
    display: grid;
    gap: clamp(0.4rem, 0.9vh, 0.65rem);
    align-content: start;
    /* local, faster than --dur-2/3: the ledger should settle as a group */
    transition-duration: 560ms, 660ms;
  }
  .why__n {
    font-size: clamp(1.9rem, 1.1rem + 2.3vw, 3.4rem);
    line-height: 0.88;
    letter-spacing: -0.024em;
    color: var(--fg);
  }
  .why__k { color: var(--fg-mute); }
  /* the ledger is justified edge to edge, so the frame closes on the right */
  .why__cell:last-child { justify-items: end; text-align: right; }

  @media (max-width: 900px) {
    .why__h { max-width: 18ch; }
  }

  @media (max-width: 700px) {
    .why {
      min-height: min(66svh, 560px);
      padding-top: clamp(3rem, 7vh, 5rem);
    }
    .why__h { max-width: none; }

    /* the ledger becomes a three-row micro table, flush to the rule */
    .why__ledger { grid-template-columns: minmax(0, 1fr); padding-top: 0; }
    .why__cell {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
      column-gap: 1rem;
      padding-block: clamp(0.6rem, 1.6vh, 0.9rem);
      border-bottom: 1px solid var(--rule-soft);
    }
    .why__cell:last-child { border-bottom: 0; justify-items: stretch; text-align: left; }
    .why__k { justify-self: end; text-align: right; }
  }
</style>
