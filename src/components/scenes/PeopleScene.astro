---
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';
import { founders, board } from '../../data/site.js';
import { standingOf, homeBridge } from '../people-cohorts.js';

/* Portrait drop-in slot — same contract as /people/.
   public/media/founder-mckelvy.jpg · founder-olanoff.jpg (or .jpeg/.png/.webp).
   Absent files render nothing at all, so this scene never shows an empty
   frame and never requests a missing asset. */
const EXTS = ['.jpg', '.jpeg', '.png', '.webp'];
function resolvePortrait(p) {
  if (!p) return null;
  const stem = p.replace(/\.(jpe?g|png|webp)$/i, '');
  for (const ext of EXTS) {
    const rel = `${stem}${ext}`;
    try {
      if (fs.existsSync(fileURLToPath(new URL(`../../../public${rel}`, import.meta.url)))) return rel;
    } catch { /* unresolvable path — treat as absent */ }
  }
  return null;
}

const people = founders.map((f, i) => ({
  name: f.name,
  role: f.role,
  index: String(i + 1).padStart(2, '0'),
  portraitSrc: resolvePortrait(f.portrait),
}));

/* One run, in site.js's order, which is the prospectus's order. This scene
   used to split the sixteen into Policy / Capital / Practice, the same
   three buckets /people/ carried — invented here, unsupported by any
   source, and wrong on the titles twice over. The header of
   people-cohorts.js has the argument. Both pages now show the flat list the
   prospectus shows, so the two still cannot drift. */
const standing = standingOf(board);
---
<section class="people scene" id="people" aria-labelledby="people-h">
  <div class="shell people__in">
    {/* The head is a SPREAD, not a stack. Every other scene on this page
        opens eyebrow → bridge → display down one column at the rail, which
        leaves the display line's tight measure staring at half a page of
        nothing. Here the claim holds the left and the bridge answers it from
        the right rail, sitting on the claim's last baseline — so the scene's
        top edge is a composed line across the frame and the void the measure
        used to leave is where the calibre is written. */}
    <header class="people__head">
      <div class="people__headL">
        <p class="eyebrow" data-reveal>People</p>
        {/* THE VERB IS "PUT FORWARD", NOT "ASKED". people-cohorts.js already
            holds the rule and /people/ already ships it: "asked" asserts that
            an invitation was extended to sixteen named living people, and
            nobody has confirmed that one was. Put forward is what
            CONTENT-NOTES.md says is true. One char shorter, so the 18ch
            measure below is unchanged. */}
        <h2 class="display display--head people__h lines" id="people-h">Two founders. Sixteen put forward to govern the work.</h2>
      </div>
      <p class="bridge people__bridge" data-reveal="90">{homeBridge}</p>
    </header>

    <div class="people__founders">
      {people.map((p, i) => (
        <article class:list={['fd', { 'fd--portrait': p.portraitSrc }]} data-reveal={String(80 + i * 100)}>
          <hr class="rule" />
          <div class="fd__row">
            {p.portraitSrc && <img class="fd__img" src={p.portraitSrc} alt={p.name} loading="lazy" decoding="async" width="240" height="300" />}
            <h3 class="display fd__name">{p.name}</h3>
            <p class="label fd__role">{p.role}</p>
          </div>
        </article>
      ))}
    </div>

  </div>

  {/* THE WALL — the page's second tonal event, and its answer to its own
      headline. Sixteen names were being set at 19px in a right-hand column,
      which is a caption; they are the only credential this institute has,
      and one of them ran the Department of Education. They are now a
      full-bleed .on-panel band set at --step-sub, one rung under the claim
      that asks for them, running the full width of the frame. What is on the
      band is the sixteen names and nothing else: the three constituency
      labels that used to head them were claims about the people under them
      and they are gone from both pages.

      It lands at 76% of the scroll. The homepage's only other change of
      ground was the cream at 16%, after which 1,700px of the back half held
      one value and no image; the panel that used to sit on Method at 25%
      is spent here instead. It also closes the 290px of empty navy that
      stood between "All people" and the footer — the band now runs flush
      into the CTA, so the page ends on a hard tonal edge rather than a
      seam. */}
  <div class="people__wall on-panel">
    <div class="shell people__wallIn">
      <div class="people__wall-head">
        {/* THE QUALIFIER CARRIES THE SAME WEIGHT AS THE CLAIM.
            These sixteen people have been ASKED; none has agreed. The word
            that says so was set at 11.7px in the micro register while the
            names beneath it ran at 27px in the serif — a hierarchy that
            asserts more than the copy admits, on a page that names sitting
            and former officials. "Prospective" is now set in the serif at
            reading size, one rung under the names it governs rather than
            three, so the qualifier is read at the same glance as the roster
            it qualifies.

            AND IT CARRIES THE ZERO. /people/ shows all sixteen faces, and
            the fact that had to survive that — the board is not yet seated — is
            the same fact here, in the same words, out of the same export, so
            the two pages cannot drift. Both places say "put forward", which
            is the only verb CONTENT-NOTES.md supports. */}
        <p class="people__board-label" data-reveal>
          <span class="index tnum">{standing.put}</span>
          <span class="people__qual">Prospective board. {standing.none}</span>
        </p>
        <a class="link tap label label--lit people__more" href="/people/" data-reveal="220">All people</a>
      </div>
      <hr class="rule" data-wipe="left" />

      {/* ONE RUN, NOT THREE. It was three labelled runs — Policy, Capital,
          Practice — which meant this scene put a brass heading over five
          named people and told a reader what they do for an institute none
          of them has joined. The names are the same names; what is gone is
          the three claims that were sorting them, and the three brass marks
          that made those claims look like structure.

          It uncovers as one territory, left to right, which is the same
          gesture the roster on /people/ makes. Every name is one unbreakable
          unit, so a run of sixteen never wraps mid-name — which is the whole
          of what the three runs were buying typographically.

          NO SEPARATOR MARK. There was a brass middot between names, carried
          on the end of each name so a line could not open on one. Three runs
          of 6 / 5 / 5 each set on a single desktop line, so it never ended
          one either. One run of sixteen sets on three lines at 1440 and four
          at 1024, and the mark then hangs in the rag at the end of every
          line but the last. The gap separates instead, at every width — see
          the CSS below. */}
      <p class="people__names" data-wipe="left" data-delay="160">
        {board.map((b, i) => (
          <>
            {i > 0 ? ' ' : null}
            <span class="people__name">{b.name}</span>
          </>
        ))}
      </p>
    </div>
  </div>
</section>

<style>
  .people { padding-bottom: 0; }
  .people__in { display: grid; gap: clamp(2.25rem, 5.5vw, 4.5rem); }
  .people__head {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    column-gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
  }
  .people__headL { display: grid; }
  .people__bridge {
    margin: 0;
    max-width: 30ch;
    text-align: right;
    justify-self: end;
    /* Sits on the claim's last baseline, not on its box. */
    padding-bottom: 0.16em;
  }
  .people__h { margin-top: var(--stack-2); max-width: 18ch; }

  /* Founders as two entries in a register — name left, role right. */
  .fd__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(1.25rem, 3vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1rem, 2.2vw, 1.75rem);
  }
  .fd--portrait .fd__row {
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
  }
  .fd__img {
    width: clamp(56px, 6vw, 84px);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.62) contrast(1.04) brightness(0.9);
  }
  .fd__name {
    font-size: var(--step-sub);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .fd__role { line-height: 1.7; text-align: right; }

  /* ── THE WALL ────────────────────────────────────────────────────
     Full-bleed band, --ink-800, running flush into the footer. The section
     keeps its top pad and gives up its bottom one: the band IS the bottom
     of the scene. */
  .people__wall {
    margin-top: clamp(3rem, 6vw, 5.5rem);
    padding-block: clamp(2.75rem, 5vw, 4.5rem);
    border-top: 1px solid var(--rule-soft);
  }
  .people__wallIn { display: grid; gap: clamp(1.1rem, 2.2vw, 1.75rem); }
  .people__wall-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .people__board-label { display: flex; align-items: baseline; gap: 0.75rem; }
  .people__qual {
    font-family: var(--serif);
    font-weight: 340;
    font-size: var(--step-body);
    line-height: 1.2;
    letter-spacing: -0.008em;
    color: var(--fg);
  }
  /* THE SIZE IS THE POINT. These sixteen names were set at 19px in a
     right-hand column — a caption for the people the scene's own headline
     asks the reader to weigh. They are set at --step-sub here, one rung
     under the claim above them and the same rank as the two founders'
     names, which is what "put forward to govern the work" actually means. */
  .people__names {
    margin: 0;
    padding-top: clamp(0.5rem, 1.2vw, 1rem);
    font-family: var(--serif);
    font-weight: 340;
    font-size: var(--step-sub);
    line-height: 1.28;
    letter-spacing: -0.014em;
    color: var(--fg);
    text-wrap: pretty;
  }
  /* Each name is one unbreakable unit, so nothing ever wraps as
     "Tess deBlanc-" / "Knowles" and no line opens mid-name. */
  .people__name { display: inline-block; white-space: nowrap; padding-right: 0.85em; }

  /* THE GAP IS THE SEPARATOR, AT EVERY WIDTH. The brass middot used to be
     dropped below 861px only, where the run first wrapped; a rule written
     for three runs that each fitted one desktop line. Sixteen names take
     three lines at 1440 and four at 1024, and a name-plus-middot unit leaves
     the mark at the end of every line but the last — 2 to 3 brass ticks
     hanging in the rag. A separator that separates nothing is not a mark.

     Hanging it off the FOLLOWING name instead only moves the fault to the
     flush-left rail, where it is worse, and CSS cannot see a line end. So
     0.85em plus the word space does the work at every width, the way a
     masthead sets a run of names — and the "16" in the qualifier above is
     left as the only brass in the scene, which is the same thing the
     standing rail is on the roster at /people/. */
  /* One line, always. It is a rule-closing tick — a two-line 11px label is
     not a tick, it is a scrap. See the 480 fold below for where the row
     gives up the corner rather than the label giving up its register. */
  .people__more { justify-self: start; white-space: nowrap; }
  @media (hover: hover) {
    .people__more:hover { color: var(--brass); }
  }
  /* Keyboard parity, outside the hover query — a keyboard exists on touch. */
  .people__more:focus-visible { color: var(--brass); }
  /* If the script never runs, nothing may stay under its mask. */
  :global(html:not(.js)) .people__names,
  :global(html:not(.js)) .people__board .rule { clip-path: none; }

  @media (max-width: 860px) {
    /* Two corners need width. Below this the head stacks: eyebrow, claim,
       then the bridge under it, back on the rail. */
    .people__head { grid-template-columns: minmax(0, 1fr); }
    .people__bridge {
      text-align: left;
      justify-self: start;
      max-width: 38ch;
      padding-bottom: 0;
      margin-top: clamp(0.9rem, 2.4vw, 1.35rem);
    }
    .fd__row { grid-template-columns: 1fr; row-gap: 0.4rem; }
    .fd--portrait .fd__row { grid-template-columns: auto minmax(0, 1fr); row-gap: 0.4rem; }
    .fd--portrait .fd__role { grid-column: 2; }
    .fd__role { text-align: left; }
    /* The separator rule is unconditional now — see the base rule above. */
  }

  /* THE ROW GIVES UP THE CORNER; THE LABEL DOES NOT GIVE UP ITS REGISTER.
     The head is a spread — count and qualifier at the left rule, "All
     people" closing on the right. 481px is the last width at which the
     spread holds: measured, the qualifier sets on one line and the link
     closes the row. Below it the sentence takes two lines, the link is left
     67px and sets as "ALL" over "PEOPLE" — a stacked 11px scrap where the
     row's right-hand mark should be, hung off the first baseline of a
     two-line sentence. The register cannot go smaller: 11px is the site's
     floor, and these are the words that qualify sixteen named people. So
     the spread is what is spent. Below 480 the head stacks, and the
     qualifier — now holding the whole measure — comes back to one line with
     the link under it on the rail, a single-line tick opening the rule it
     precedes. The same move the scene's own head makes at 860. */
  @media (max-width: 480px) {
    .people__wall-head { display: block; }
    .people__more { display: inline-block; margin-top: 0.9rem; }
  }
</style>
