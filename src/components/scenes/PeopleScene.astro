---
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';
import { founders, board } from '../../data/site.js';
import { cohortsOf, homeBridge } from '../people-cohorts.js';

/* Portrait drop-in slot — same contract as /people/.
   public/media/founder-mckelvy.jpg · founder-olanoff.jpg (or .jpeg/.png/.webp).
   Absent files render nothing at all, so this scene never shows an empty
   frame and never requests a missing asset. */
const EXTS = ['.jpg', '.jpeg', '.png', '.webp'];
function resolvePortrait(p) {
  if (!p) return null;
  const stem = p.replace(/\.(jpe?g|png|webp)$/i, '');
  for (const ext of EXTS) {
    const rel = `${stem}${ext}`;
    try {
      if (fs.existsSync(fileURLToPath(new URL(`../../../public${rel}`, import.meta.url)))) return rel;
    } catch { /* unresolvable path — treat as absent */ }
  }
  return null;
}

const people = founders.map((f, i) => ({
  name: f.name,
  role: f.role,
  index: String(i + 1).padStart(2, '0'),
  portraitSrc: resolvePortrait(f.portrait),
}));

/* Same three constituencies as /people/, in the same order, so the roster
   reads the same way in both places. Here they are three runs, not three
   columns — the homepage gets the shape of the board, the People page gets
   the board. */
const cohorts = cohortsOf(board);
---
<section class="people scene" id="people" aria-labelledby="people-h">
  <div class="shell people__in">
    <header class="people__head">
      <p class="eyebrow" data-reveal>People</p>
      {/* The bridge carries the calibre in one breath, so the display line
          underneath can be a count and a claim rather than a list. */}
      <p class="bridge people__bridge" data-reveal="90">{homeBridge}</p>
      <h2 class="display display--head people__h lines" id="people-h">Two founders. Sixteen people asked to govern the work.</h2>
    </header>

    <div class="people__founders">
      {people.map((p, i) => (
        <article class:list={['fd', { 'fd--portrait': p.portraitSrc }]} data-reveal={String(80 + i * 100)}>
          <hr class="rule" />
          <div class="fd__row">
            {p.portraitSrc && <img class="fd__img" src={p.portraitSrc} alt={p.name} loading="lazy" decoding="async" width="240" height="300" />}
            <h3 class="display fd__name">{p.name}</h3>
            <p class="label fd__role">{p.role}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="people__board">
      <hr class="rule" data-wipe="left" />
      <div class="people__board-row">
        <p class="people__board-label" data-reveal="120">
          <span class="index tnum">16</span>
          <span class="label">Prospective board</span>
        </p>
        {/* One run per constituency. Each uncovers as a territory rather
            than fading in with everything else, and every name is one
            unbreakable unit so a roster never turns back into prose. */}
        <ul class="people__cohorts">
          {cohorts.map((c, ci) => (
            <li data-wipe="left" data-delay={String(160 + ci * 130)}>
              <span class="label label--brass people__cohort">{c.label}</span>
              <span class="people__names">
                {c.people.map((b, i) => (
                  <>
                    {i > 0 ? ' ' : null}
                    <span class="people__name">{b.name}{i < c.people.length - 1 && <span class="people__sep" aria-hidden="true">·</span>}</span>
                  </>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </div>
      <a class="link tap label label--lit people__more" href="/people/" data-reveal="220">All people</a>
    </div>
  </div>
</section>

<style>
  .people__in { display: grid; gap: clamp(2.25rem, 5.5vw, 4.5rem); }
  .people__head { display: grid; }
  .people__bridge { margin-top: clamp(0.8rem, 1.4vw, 1.15rem); max-width: 38ch; }
  .people__h { margin-top: var(--stack-2); max-width: 18ch; }

  /* Founders as two entries in a register — name left, role right. */
  .fd__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(1.25rem, 3vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1rem, 2.2vw, 1.75rem);
  }
  .fd--portrait .fd__row {
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
  }
  .fd__img {
    width: clamp(56px, 6vw, 84px);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.62) contrast(1.04) brightness(0.9);
  }
  .fd__name {
    font-size: var(--step-sub);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .fd__role { line-height: 1.7; text-align: right; }

  .people__board { display: grid; gap: clamp(1.25rem, 2.5vw, 2rem); }
  .people__board-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr);
    column-gap: clamp(1.25rem, 3vw, 3rem);
    align-items: start;
    padding-top: clamp(1rem, 2.2vw, 1.75rem);
  }
  .people__board-label { display: flex; align-items: baseline; gap: 0.75rem; }
  .people__cohorts {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    row-gap: clamp(0.9rem, 1.7vw, 1.4rem);
  }
  .people__cohorts li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    column-gap: clamp(0.75rem, 1.6vw, 1.5rem);
    align-items: baseline;
  }
  .people__cohort { line-height: 1.9; }
  /* Names are the substance, so they are set in the serif at reading size
     and at full ink — the run is a roster, not a grey caption. */
  .people__names {
    font-family: var(--serif);
    font-weight: 340;
    font-size: var(--step-lede);
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  /* Each name plus its trailing middot is one unbreakable unit, so nothing
     ever wraps as "Tess deBlanc-" / "Knowles" and no line opens on a
     separator. */
  .people__name { display: inline-block; white-space: nowrap; }
  /* The word space between two units supplies the gap on the right, so the
     middot is only padded on the left. */
  .people__sep { color: var(--brass); padding-left: 0.3em; }
  .people__more { justify-self: start; }
  @media (hover: hover) {
    .people__more:hover { color: var(--brass); }
  }
  /* If the script never runs, nothing may stay under its mask. */
  :global(html:not(.js)) .people__cohorts li,
  :global(html:not(.js)) .people__board .rule { clip-path: none; }

  @media (max-width: 860px) {
    .fd__row { grid-template-columns: 1fr; row-gap: 0.4rem; }
    .fd--portrait .fd__row { grid-template-columns: auto minmax(0, 1fr); row-gap: 0.4rem; }
    .fd--portrait .fd__role { grid-column: 2; }
    .fd__role { text-align: left; }
    .people__board-row { grid-template-columns: 1fr; row-gap: 1rem; }
    .people__cohorts li { grid-template-columns: 1fr; row-gap: 0.28rem; }
    .people__cohorts { row-gap: clamp(1.1rem, 3.4vw, 1.5rem); }
    /* Once a run takes more than one line the middot starts dangling at
       line ends, so the separator becomes space instead of a mark. */
    .people__sep { display: none; }
    .people__name { padding-right: 1.15em; }
  }
</style>
