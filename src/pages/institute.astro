---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { method } from '../data/site.js';

const builds = ['Technology companies', 'Founders', 'Research labs'];
const runs = ['Health systems', 'Universities', 'Community organizations', 'Government'];

/* The spec used to be a card pinned to the right of the statement. It is now
   a rail: four hairline cells across the full width, directly under the
   photograph, so the first screen is a picture and the second thing you read
   is a horizontal register rather than a second column. */
const spec = [
  { k: 'Horizon', v: '3–12 months' },
  { k: 'Scope', v: 'One problem, one owner' },
  { k: 'Partners', v: 'Two sides, one table' },
  /* Was "Active now — Four pilots, 2026". One click away, /pilots/ labels all
     four of those pilots "Proposed"; active now and proposed cannot both be
     true of the same four things. The cell now says what is actually true:
     the pilots are open for partners, and none of them has been signed. */
  { k: 'Open for 2026', v: 'Four pilots, proposed', href: '/pilots/' },
];
---
<Base title="Institute" description="How the Lion Forum Institute works: short pilots, measured outcomes, published results.">
  <!-- ── The room ────────────────────────────────────────────────────
       The page's one exception, and it is a photograph rather than a
       typographic trick: a long table with chairs down both sides, a flag on
       the axis, mirrored doors left and right. It is the bridge, photographed
       — so it is given the whole first screen at full bleed and the statement
       is set INTO it, low left, where the frame's own floor is empty.
       It used to be a 622×336 card in the right column under a spec table. -->
  <section class="ihero">
    <Figure
      src="/media/institute.jpg" alt="" ratio="auto" loading="eager"
      grade={0.52} focal="50% 44%" zoom={1.06} lift={1.05} vig={0.34}
      scrim="bottom" reach={1} rise={0.78} ink={1.06}
      credit="Library of Congress" creditPos="bottom-right"
      class="ihero__bg" sizes="100vw" />

    <div class="shell ihero__in">
      <p class="eyebrow ihero__k">How we work</p>
      <p class="bridge ihero__bridge">A pilot needs money, a technology, and a real place to run.</p>
      <h1 class="display display--poster ihero__h">We sit between the builders and the institutions.</h1>
    </div>
  </section>

  <!-- The spec, as a rail across the page rather than a card beside it. -->
  <section class="ispec">
    <!-- The wipe lives on a wrapper, not on the <dl>. Its finished state is a
         permanent clip-path on whatever carries it, and .link's underline hangs
         below the anchor's content box — on the <dl> the clip ate it. -->
    <div class="shell ispec__wrap" data-wipe="left" data-delay="120">
      <dl class="ispec__in">
        {spec.map((s) => (
          <div class="ispec__c">
            <dt class="label ispec__k">{s.k}</dt>
            <dd class="ispec__v">{s.href ? <a class="link tap" href={s.href}>{s.v}</a> : s.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── The one idea on the page ────────────────────────────────────
       Two field labels on one register, two arms centred on the hub's
       axis, two rails of identical length, and the connectors last:
       left arm, right arm, rails, hub, connectors. -->
  <section class="on-panel ibridge" id="bridge">
    <div class="shell ibridge__in">
      <p class="eyebrow ibridge__k" data-reveal>The bridge</p>
      <div class="brg" data-reveal>
        <div class="brg__arm brg__arm--a">
          <span class="brg__rail brg__rail--a" aria-hidden="true"><i></i></span>
          <p class="label label--brass brg__k brg__k--a" style="--d:0ms">Who builds it</p>
          <ul class="brg__list brg__list--a" role="list">
            {builds.map((b, i) => <li class="bridge bridge--fg bridge--lift" style={`--d:${90 + i * 70}ms`}>{b}</li>)}
          </ul>
        </div>

        <div class="brg__arm brg__arm--b">
          <span class="brg__rail brg__rail--b" aria-hidden="true"><i></i></span>
          <p class="label label--brass brg__k brg__k--b" style="--d:230ms">Who runs it</p>
          <ul class="brg__list brg__list--b" role="list">
            {runs.map((r, i) => <li class="bridge bridge--fg bridge--lift" style={`--d:${320 + i * 70}ms`}>{r}</li>)}
          </ul>
        </div>

        <span class="brg__hub on-plate">
          <span class="brg__dot" aria-hidden="true"></span>
          <span class="display brg__hub-t">The Institute</span>
        </span>
      </div>
    </div>
  </section>

  <!-- ── The page turned over ────────────────────────────────────────
       One sentence, full bleed, on cream. The system keeps exactly one of
       these per page and this is what it is for: the diagram above states
       the arrangement, this states why it has to exist. -->
  <section class="on-cream iclaim">
    <p class="display display--feature iclaim__t shell" data-settle="0.62">Neither side can run the pilot alone.</p>
  </section>

  <!-- ── How a pilot runs ────────────────────────────────────────────
       A ledger, not a card row: three full-width entries, one rule each. -->
  <section class="imeth">
    <div class="shell imeth__in">
      <div class="imeth__head">
        <p class="eyebrow imeth__k" data-reveal>The method</p>
        <h2 class="display display--head lines">Every pilot runs the same way.</h2>
      </div>

      <ol class="ledger" data-seq="110" data-seq-from="60">
        {method.map((m) => (
          <li data-reveal>
            <span class="index ledger__n">{m.index}</span>
            <div class="ledger__b">
              <h3 class="ledger__t display display--sub">{m.title}</h3>
              <p class="ledger__p">{m.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  /* ── The room ─────────────────────────────────────────────────────
     Full bleed, one screen, type set low-left into the photograph's own
     empty floor. The scrim is directional and reaches the full width, so
     the corner credit is protected too. */
  .ihero {
    position: relative;
    isolation: isolate; overflow: hidden;
    min-height: min(94svh, 50rem);
    display: grid; align-items: end;
    padding-block: calc(var(--nav-h) + 1rem) clamp(2rem, 4.5vh, 3.4rem);
  }
  :global(.ihero__bg) { position: absolute; inset: 0; aspect-ratio: auto; z-index: -1; }

  .ihero__in { width: 100%; display: grid; justify-items: start; }
  .ihero__k { opacity: 0; animation: iheroIn 640ms var(--ease-out) 140ms forwards; }
  .ihero__bridge {
    /* 32ch broke the line after "money, a", hanging an article off the end
       of line 1 at every width balance would still pick. The article is
       bound to its noun in the markup (nbsp), and so is the last word. */
    max-width: 30ch;
    margin-block: clamp(0.5rem, 1.2vh, 0.9rem) clamp(0.8rem, 1.8vh, 1.4rem);
    opacity: 0; animation: iheroIn 720ms var(--ease-out) 240ms forwards;
  }
  /* The statement is inked in top-down over the picture, the same load-timed
     mask the homepage banner uses — an observer-driven reveal cannot be
     trusted at the very top of a page. */
  .ihero__h {
    line-height: 0.95; letter-spacing: -0.028em;
    max-width: min(15ch, 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 0 58%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0 58%, transparent 100%);
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
    -webkit-mask-position: 0 0; mask-position: 0 0;
    -webkit-mask-size: 100% 0%; mask-size: 100% 0%;
    animation: iheroInk 1000ms var(--ease-out) 300ms forwards;
  }
  @keyframes iheroInk { to { -webkit-mask-size: 100% 190%; mask-size: 100% 190%; } }
  @keyframes iheroIn { from { opacity: 0; transform: translate3d(0, 12px, 0); } to { opacity: 1; transform: none; } }

  /* ── The spec, as a rail ──────────────────────────────────────────
     Four cells across the full measure under one rule. Horizontal, so the
     page's second register is not a second column. */
  .ispec { padding-block: clamp(1.4rem, 2.4vw, 2.4rem) clamp(2.5rem, 4vw, 4rem); }
  /* 6px of room under the rail so the clip-path the wipe leaves behind
     clears the underline the anchor hangs below its content box. */
  .ispec__wrap { padding-bottom: 6px; }
  .ispec__in {
    margin: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.6rem);
    border-top: 1px solid var(--rule);
  }
  /* gap clears a.tap's 8px block padding, so the focus ring on the one
     link in the rail cannot cut through the label above it. */
  .ispec__c { padding-top: clamp(0.7rem, 1.2vw, 1.1rem); display: grid; gap: 0.7rem; align-content: start; }
  .ispec__k { white-space: nowrap; }
  .ispec__v {
    margin: 0; font-size: var(--step-lede);
    line-height: 1.25; letter-spacing: -0.006em; color: var(--fg);
  }
  /* One cell of the four is a link. At rest it is brass — the only lit
     value in the rail — so it is findable before a pointer ever arrives;
     hover and focus draw the underline. */
  .ispec__v :global(a) { color: var(--brass); }

  /* ── THE SPAN ─────────────────────────────────────────────────────
     The only composition on this site that is not flush-left under a
     full-width rule: centred, symmetric, bounded, on its own ground, given
     a whole screen. The institute's entire claim is that it sits BETWEEN
     two parties, and a left-aligned band cannot say between.

     Value is elevation, drawn literally: the band is .on-panel (L* 9) set
     into the page (L* 3), and the hub is .on-plate (L* 15) resting on it. */
  .ibridge {
    border-block: 1px solid var(--rule);
    padding-block: clamp(3.5rem, 1rem + 5vw, 7rem);
  }
  /* No forced screen height. A fixed 80svh held a 704px room around a 250px
     object; the room now follows the object, and the eyebrow sits on the
     composition's own axis, one short measure above it, so the label titles
     the diagram instead of pointing at it from the far left. */
  .ibridge__in {
    display: grid; justify-items: center;
    gap: clamp(1.4rem, 2.4vw, 2.2rem);
  }
  .ibridge__k { justify-self: center; text-align: center; }
  .brg { width: 100%; }
  .brg {
    --brg-gap: clamp(1.6rem, 3.2vw, 3.4rem);
    --hub-w: clamp(13rem, 26vw, 24rem);
    position: relative;
    display: grid;
    /* min-content floor on the hub track: the plate is never narrower than
       the word it holds, at any width, so the serif can take the rung above
       the arms without a band where it breaks out of its own border. */
    grid-template-columns: minmax(0, 1fr) minmax(min-content, var(--hub-w)) minmax(0, 1fr);
    /* One row. Each arm is a single box — its own label stacked on its own
       list — so the arm's height IS its content and the rail drawn inside it
       is a stated length: top at the label's cap, bottom at the last item's
       baseline. Both arms are centred on the hub's axis, so the two rails
       differ only by the count of items they carry. */
    align-items: center;
    column-gap: var(--brg-gap);
    row-gap: clamp(0.5rem, 1.4vw, 1.1rem);
  }
  .brg__arm {
    position: relative;
    display: flex; flex-direction: column;
    /* the rail's two end insets: half-leading off the label's box at the top,
       descender off the last line's box at the bottom, so the drawn line
       begins on a cap and ends on a baseline. */
    --rail-cap: 0.24em;
    --rail-base: 0.26em;
  }
  .brg__arm { grid-row: 1; }
  .brg__arm--a { grid-column: 1; align-items: flex-end; }
  .brg__arm--b { grid-column: 3; align-items: flex-start; }
  .brg[data-reveal] { opacity: 1; transform: none; transition: none; }

  .brg__list {
    margin: 0; padding: 0; width: 100%;
    display: flex; flex-direction: column;
    gap: clamp(0.5rem, 1.4vw, 1.1rem);
  }
  .brg__list--a { align-items: flex-end; }
  .brg__list--b { align-items: flex-start; }
  .brg__k, .brg__list li {
    transition:
      opacity var(--dur-hover) var(--ease-out) var(--d, 0ms),
      transform 460ms var(--ease-out) var(--d, 0ms);
  }
  .brg.is-in .brg__k, .brg.is-in .brg__list li { opacity: 1; transform: none; }

  .brg__k { margin-bottom: clamp(0.5rem, 1.1vw, 0.9rem); }
  .brg__k--a { text-align: right; padding-right: clamp(1rem, 2vw, 1.8rem); }
  .brg__k--b { padding-left: clamp(1rem, 2vw, 1.8rem); }

  /* The two arms are the page's body, not its caption — but they are still a
     DIAGRAM, and they were set in hand-rolled Libre Franklin Light at
     --step-head: a 53px sans display voice that exists nowhere else on the
     site and outshouted the hub it is supposed to point at. .bridge--lift is
     the one sanctioned sans display rung (base.css says so, and names these
     arms), so the arms take it. The page's loudest object is now the cream
     claim below, which is the one thing this page is for. */
  .brg__list li {
    list-style: none;
    line-height: 1.14;
    max-width: none;
  }
  .brg__list--a li { text-align: right; padding-right: clamp(1rem, 2vw, 1.8rem); }
  .brg__list--b li { padding-left: clamp(1rem, 2vw, 1.8rem); }

  /* Rails: a measured length inside each arm — cap of that arm's label to the
     baseline of that arm's last item — drawn top-down after both arms land. */
  .brg__rail {
    position: absolute;
    top: var(--rail-cap); bottom: var(--rail-base);
    display: block; width: 1px;
  }
  .brg__rail--a { right: 0; }
  .brg__rail--b { left: 0; }
  .brg__rail i {
    display: block; width: 1px; height: 100%;
    background: var(--rule);
    transform-origin: top;
    /* scaleY(0) lives in the html.js block below: .brg.is-in is written by
       the reveal engine, so with JS off the rails must start drawn. */
    transition: transform 460ms var(--ease-out) var(--d, 0ms);
  }
  .brg__rail--a i { --d: 660ms; }
  .brg__rail--b i { --d: 720ms; }
  .brg.is-in .brg__rail i { transform: none; }

  /* The hub is an OBJECT: plate ground, edges you could point at, its name in
     the serif at the poster rung. The two connectors run from each rail and
     TOUCH it — a half-connected diagram reads as timidity. */
  .brg__hub {
    /* The plate's midline is the arms' midline, which is now also the rails'
       midline: both arms are single centred boxes, so the connectors leave
       the plate level with the middle of both drawn lines. */
    grid-column: 2; grid-row: 1; align-self: center;
    position: relative;
    display: grid; justify-items: center; gap: clamp(0.8rem, 1.5vw, 1.2rem);
    padding: clamp(1.8rem, 3.2vw, 3rem) clamp(1rem, 2vw, 1.8rem);
    border: 1px solid color-mix(in srgb, var(--brass) 46%, transparent);
    transition: opacity 520ms var(--ease-out) 860ms, transform 520ms var(--ease-out) 860ms;
  }
  .brg.is-in .brg__hub { opacity: 1; transform: none; }

  /* ── The one place the diagram's hidden state is declared ──────────
     Every part of the bridge arrives on `.brg.is-in`, and only the reveal
     engine sets that class. Gated on `html.js` (written synchronously in
     Base.astro's <head>) so a page without JS gets the finished diagram
     rather than three invisible columns. */
  html.js .brg__k,
  html.js .brg__list li { opacity: 0; transform: translate3d(0, 8px, 0); }
  html.js .brg__hub { opacity: 0; transform: translate3d(0, 6px, 0); }
  html.js .brg__rail i { transform: scaleY(0); }
  .brg__hub::before, .brg__hub::after {
    content: ''; position: absolute; top: 50%;
    width: calc(var(--brg-gap) + 1px); height: 1px;
    background: var(--brass);
    transition: transform 460ms var(--ease-out) 1080ms;
  }
  .brg__hub::before { right: 100%; transform: scaleX(0); transform-origin: left; }
  .brg__hub::after { left: 100%; transform: scaleX(0); transform-origin: right; }
  .brg.is-in .brg__hub::before, .brg.is-in .brg__hub::after { transform: none; }

  .brg__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--brass); }
  /* The hub was set at --step-sub, the SAME rung as the arms it is meant to
     be the answer to: eleven cream words at 33.8px around one serif phrase
     at 33.8px reads as a list with a box in it. One rung up. */
  .brg__hub-t {
    font-size: var(--step-head);
    white-space: nowrap; line-height: 1; color: var(--fg); text-align: center;
  }

  /* ── The claim, on cream ──────────────────────────────────────── */
  .iclaim { padding-block: clamp(4rem, 2rem + 6vw, 8rem); }
  .iclaim__t {
    margin: 0 auto; max-width: 20ch; text-align: center;
    line-height: 1.04; color: var(--fg);
    --settle-shift: 2.4vh;
  }

  /* ── The method, as a ledger ──────────────────────────────────── */
  .imeth {
    padding-block: clamp(2.75rem, 1.5rem + 3vw, 4.5rem) clamp(3.5rem, 2rem + 3.5vw, 5.5rem);
  }
  .imeth__in { display: grid; gap: clamp(1.75rem, 3.2vw, 2.8rem); }
  .imeth__head { display: grid; gap: clamp(0.9rem, 1.8vw, 1.5rem); }
  .imeth .display--head { max-width: 16ch; }
  .imeth__head h2 :global(.line > span) { transition-duration: 1450ms; }

  .ledger { list-style: none; margin: 0; padding: 0; }
  .ledger li {
    display: grid;
    grid-template-columns: clamp(2.4rem, 4vw, 3.8rem) minmax(0, 1fr);
    column-gap: clamp(0.9rem, 2vw, 1.8rem);
    align-items: start;
    padding-block: clamp(1.1rem, 2.1vw, 2rem);
    border-top: 1px solid var(--rule);
  }
  .ledger li:last-child { border-bottom: 1px solid var(--rule); }
  .ledger li[data-reveal] { --reveal-y: 8px; transition-duration: 440ms, 560ms; }
  .ledger__n { padding-top: 0.55em; }
  .ledger__b { display: grid; gap: clamp(0.3rem, 0.7vw, 0.55rem); }
  .ledger__t { font-weight: 320; }
  .ledger__p { color: var(--fg-mute); font-size: var(--step-body); max-width: 34ch; }

  /* Between the breakpoint and ~1180px the arms at --step-sub no longer fit
     their column and "Technology companies" / "Community organizations" broke
     to two lines. They step down one rung — to the default .bridge size the
     lift class is measured against — and the diagram stays four single lines
     against three. */
  @media (min-width: 861px) and (max-width: 1400px) {
    .brg { --brg-gap: clamp(1rem, 2.4vw, 3.4rem); }
    .brg__list li { font-size: var(--step-bridge); }
  }
  /* Below ~1000px even the min-content plate eats the arms' column. The hub
     takes the rung below — still a size, a family, a plate and a dot above
     the arms, and now nothing on the diagram breaks to two lines. */
  @media (min-width: 861px) and (max-width: 1000px) {
    .brg__hub-t { font-size: var(--step-sub); }
    /* and the plate stops reserving 26vw it does not need */
    .brg { --hub-w: min-content; }
  }

  @media (max-width: 900px) {
    .ispec__in { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: clamp(1rem, 3vw, 1.4rem); }
    .ispec__c { border-top: none; }
  }

  @media (max-width: 860px) {
    /* The corner credit is two lines at this width; the statement has to
       finish above it, not through it. */
    .ihero { min-height: min(92svh, 42rem); padding-bottom: clamp(3.4rem, 12vw, 4.4rem); }
    .ihero__h { max-width: 100%; }
    .ihero__bridge { max-width: 28ch; }

    .ibridge { padding-block: clamp(2.75rem, 10vw, 4rem) clamp(3.5rem, 12vw, 5rem); }
    /* No forced screen height on a phone: the diagram is the tallest object
       on the route once it runs vertically. */
    .ibridge__in { justify-items: stretch; gap: clamp(1.8rem, 7vw, 2.6rem); }
    .ibridge__k { justify-self: start; text-align: left; }
    /* The diagram survives the breakpoint. One brass rail runs the full
       height of the left gutter, both arms hang off it, and the hub is
       notched onto it — two sides meeting at one point, drawn vertically. */
    .brg {
      --brg-gut: clamp(1.4rem, 6vw, 2.2rem);
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: clamp(0.2rem, 1.2vw, 0.5rem);
      padding-left: var(--brg-gut);
    }
    /* The arms stop being boxes here: label, list, hub and list run as one
       vertical column and the single rail is measured against .brg. */
    .brg__arm {
      position: static; display: contents;
    }
    .brg__hub { grid-row: auto; }
    .brg__rail {
      position: absolute; left: 0; right: auto; top: 0; bottom: 0;
      justify-self: start;
    }
    .brg__rail--b { display: none; }
    .brg__rail--a i {
      background: color-mix(in srgb, var(--brass) 58%, transparent);
      --d: 120ms;
    }
    .brg__k, .brg__list { grid-column: 1; }
    .brg__list { align-items: stretch; gap: clamp(0.2rem, 1.2vw, 0.5rem); }
    .brg__list li { text-align: left; }
    .brg__k--a, .brg__k--b { padding-left: 0; padding-right: 0; text-align: left; }
    .brg__list--a li, .brg__list--b li {
      padding-left: 0; padding-right: 0; text-align: left;
      text-wrap: initial;
    }
    .brg__k--a { order: 1; }
    .brg__list--a { order: 2; }
    .brg__hub { order: 3; }
    .brg__k--b { order: 4; }
    .brg__list--b { order: 5; }

    .brg__hub {
      grid-column: 1;
      justify-self: start; align-self: auto;
      margin-block: clamp(1.4rem, 6vw, 2rem);
      display: inline-flex; align-items: center; justify-content: flex-start; gap: 0.8rem;
      padding: clamp(0.9rem, 3.4vw, 1.2rem) clamp(1.1rem, 4vw, 1.5rem);
    }
    /* The notch: one connector running left, from the hub back to the rail. */
    .brg__hub::after { content: none; }
    .brg__hub::before {
      content: ''; right: 100%; width: var(--brg-gut);
      transform: scaleX(0); transform-origin: right;
    }
    .brg.is-in .brg__hub::before { transform: none; }
    .iclaim__t { text-align: left; margin-inline: 0; max-width: 16ch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ihero__k, .ihero__bridge { opacity: 1 !important; animation: none !important; }
    .ihero__h { -webkit-mask-image: none; mask-image: none; animation: none !important; }
    .brg__k, .brg__list li, .brg__hub { opacity: 1 !important; transform: none !important; transition-duration: 1ms !important; }
    .brg__list { justify-content: center; }
    .brg__rail i, .brg__hub::before, .brg__hub::after { transform: none !important; transition-duration: 1ms !important; }
  }
</style>
