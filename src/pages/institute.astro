---
import Base from '../layouts/Base.astro';
import { method } from '../data/site.js';

const builds = ['Technology companies', 'Founders', 'Research labs'];
const runs = ['Health systems', 'Universities', 'Community organizations', 'Government'];

/* The hero's caption card. Four hairline-ruled rows pinned to the right plate
   edge — the second thing you read after the statement, and the thing that
   makes the right half of the first screen carry information. */
const spec = [
  { k: 'Horizon', v: '3–12 months' },
  { k: 'Scope', v: 'One problem, one owner' },
  { k: 'Partners', v: 'Two sides, one table' },
  { k: 'Active now', v: 'Four pilots, 2026', href: '/pilots/' },
];
---
<Base title="Institute" description="How the Lion Forum Institute works: short pilots, real partners, published results.">
  <!-- ── Hero plate ──────────────────────────────────────────────────
       Five ranked objects, every one pinned to an edge of the plate:
       kicker, statement, standfirst, caption card, and the rule that
       closes the plate. The standfirst is the middle rank the page
       used to be missing entirely. -->
  <section class="ihead">
    <div class="shell ihead__in">
      <p class="label ihead__k" data-reveal>The Institute</p>

      <div class="ihead__lead">
        <h1 class="display ihead__h lines">We sit between the builders and the institutions.</h1>
        <p class="ihead__stand" data-reveal="440">
          A pilot needs money, a technology, and a real place to run.
          We bring the three together, then measure.
        </p>
      </div>

      <dl class="spec" data-reveal="260">
        {spec.map((s) => (
          <div class="spec__row">
            <dt class="label spec__k">{s.k}</dt>
            <dd class="spec__v">{s.href ? <a class="link" href={s.href}>{s.v}</a> : s.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── The one idea on the page ────────────────────────────────────
       One shared five-row baseline grid: both arms sit on the same rows,
       both rails run the same length, and the connectors are the last
       thing to arrive — left arm, right arm, rails, connectors, thesis. -->
  <section class="ibridge">
    <div class="shell">
      <div class="brg" data-reveal>
        <span class="brg__rail brg__rail--a" aria-hidden="true"><i></i></span>
        <p class="label label--brass brg__k brg__k--a" style="--d:0ms">Who builds it</p>
        <ul class="brg__list brg__list--a" role="list">
          {builds.map((b, i) => <li style={`--d:${90 + i * 90}ms`}>{b}</li>)}
        </ul>

        <span class="brg__rail brg__rail--b" aria-hidden="true"><i></i></span>
        <p class="label label--brass brg__k brg__k--b" style="--d:450ms">Who runs it</p>
        <ul class="brg__list brg__list--b" role="list">
          {runs.map((r, i) => <li style={`--d:${540 + i * 90}ms`}>{r}</li>)}
        </ul>

        <span class="brg__hub">
          <span class="brg__dot" aria-hidden="true"></span>
          <span class="label brg__hub-t">The Institute</span>
        </span>
      </div>

      <p class="brg__thesis" data-reveal="180">Neither side can run the pilot alone.</p>
    </div>
  </section>

  <!-- ── How a pilot runs ────────────────────────────────────────────
       A ledger, not a card row: three full-width entries, one rule each.
       /partner/ runs three parallel doors as columns; these are three
       steps in order, so they are set as a sequence. -->
  <section class="on-cream imeth">
    <div class="shell imeth__in">
      <div class="imeth__head">
        <p class="label imeth__k" data-reveal>The method</p>
        <h2 class="display display--l lines">Every pilot runs the same way.</h2>
      </div>

      <ol class="ledger">
        {method.map((m, i) => (
          <li data-reveal={String(60 + i * 110)}>
            <span class="ledger__n tnum">{m.index}</span>
            <h3 class="ledger__t display display--m">{m.title}</h3>
            <p class="ledger__p">{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────
     Two columns. The statement and its standfirst hold the left plate;
     the caption card holds the right one, so no half of the first
     screen is carrying a single sentence on its own. */
  .ihead {
    padding-block: calc(var(--nav-h) + clamp(4.5rem, 3rem + 3.4vw, 6.5rem)) clamp(1.25rem, 1.4vw, 1.5rem);
  }
  .ihead__in {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    column-gap: clamp(2rem, 5vw, 5rem);
    row-gap: clamp(1.4rem, 2.4vw, 2.2rem);
    align-items: start;
  }
  .ihead__k { grid-column: 1 / -1; margin-bottom: clamp(0.4rem, 1vw, 1rem); }

  .ihead__lead { grid-column: 1; display: grid; gap: clamp(1.5rem, 2.6vw, 2.5rem); }
  /* One hero size for the whole site — matches /partner/. Local, because the
     token scale has no step between --step-xl and --step-hero. */
  .ihead__h {
    font-size: clamp(3.1rem, 1rem + 6.3vw, 7rem);
    line-height: 0.94; letter-spacing: -0.028em;
    max-width: 14ch;
  }
  .ihead__h :global(.line) { padding-bottom: 0.08em; margin-bottom: -0.08em; }

  /* The missing middle rank: ~19px on a fixed short measure, left-flush with
     the statement, sitting between the 11px kicker and the 100px display. */
  .ihead__stand {
    font-size: clamp(1.02rem, 0.9rem + 0.5vw, 1.2rem);
    line-height: 1.5;
    font-weight: 360;
    max-width: 38ch;
    color: color-mix(in srgb, var(--cream) 74%, transparent);
    text-wrap: pretty;
  }

  /* ── Caption card ──
     Hairline rows across the full right column, label left, value right. */
  .spec {
    grid-column: 2; margin: 0;
    align-self: start;
    padding-top: clamp(0.5rem, 1.4vw, 1.3rem);
  }
  .spec__row {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: clamp(0.8rem, 2vw, 1.6rem);
    padding-block: clamp(0.62rem, 1.1vw, 0.95rem);
    border-top: 1px solid var(--rule);
  }
  .spec__row:last-child { border-bottom: 1px solid var(--rule); }
  .spec__k { color: var(--fg-faint); white-space: nowrap; }
  .spec__v {
    margin: 0; text-align: right;
    font-size: clamp(0.95rem, 0.88rem + 0.3vw, 1.12rem);
    line-height: 1.25; letter-spacing: -0.006em;
    color: var(--fg);
  }
  .spec__v :global(a:hover) { color: var(--brass); }

  /* ── The bridge ───────────────────────────────────────────────────
     One grid: row 1 is both arm labels, rows 2–5 are the names. Both
     rails span 1 / -1, so they are the same length and terminate on the
     grid rather than in mid-air. */
  .ibridge {
    padding-block: clamp(2.5rem, 1rem + 2.6vw, 4rem) clamp(4.5rem, 2rem + 5vw, 9rem);
  }
  .brg {
    --brg-gap: clamp(2rem, 5vw, 5rem);
    --hub-w: clamp(9.5rem, 13vw, 12rem);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--hub-w) minmax(0, 1fr);
    column-gap: var(--brg-gap);
    row-gap: clamp(0.45rem, 1vw, 0.85rem);
  }
  /* The whole diagram is staged from one observer so the order is exact.
     Neutralise the generic reveal on the wrapper; the children carry it. */
  .brg[data-reveal] { opacity: 1; transform: none; transition: none; }

  .brg__list { display: contents; }
  .brg__k, .brg__list li {
    opacity: 0; transform: translate3d(0, 12px, 0);
    transition:
      opacity 620ms var(--ease-out) var(--d, 0ms),
      transform 860ms var(--ease-out) var(--d, 0ms);
  }
  .brg.is-in .brg__k, .brg.is-in .brg__list li { opacity: 1; transform: none; }

  .brg__k { grid-row: 1; margin-bottom: clamp(0.35rem, 0.9vw, 0.7rem); }
  .brg__k--a { grid-column: 1; text-align: right; padding-right: clamp(1rem, 2vw, 1.8rem); }
  .brg__k--b { grid-column: 3; padding-left: clamp(1rem, 2vw, 1.8rem); }

  .brg__list li {
    list-style: none;
    font-size: var(--step-m); line-height: 1.16; color: var(--fg);
  }
  .brg__list--a li { grid-column: 1; text-align: right; padding-right: clamp(1rem, 2vw, 1.8rem); }
  .brg__list--b li { grid-column: 3; padding-left: clamp(1rem, 2vw, 1.8rem); }
  .brg__list--a li:nth-child(1), .brg__list--b li:nth-child(1) { grid-row: 2; }
  .brg__list--a li:nth-child(2), .brg__list--b li:nth-child(2) { grid-row: 3; }
  .brg__list--a li:nth-child(3), .brg__list--b li:nth-child(3) { grid-row: 4; }
  .brg__list--a li:nth-child(4), .brg__list--b li:nth-child(4) { grid-row: 5; }

  /* Rails: identical length, drawn top-down, after both arms have landed. */
  .brg__rail { grid-row: 1 / -1; display: block; width: 1px; }
  .brg__rail--a { grid-column: 1; justify-self: end; }
  .brg__rail--b { grid-column: 3; justify-self: start; }
  .brg__rail i {
    display: block; width: 1px; height: 100%;
    background: var(--rule);
    transform: scaleY(0); transform-origin: top;
    transition: transform 720ms var(--ease-out) var(--d, 0ms);
  }
  .brg__rail--a i { --d: 900ms; }
  .brg__rail--b i { --d: 990ms; }
  .brg.is-in .brg__rail i { transform: none; }

  /* Hub + the two connectors, which draw inward from each rail to the box.
     Local delays; no motion primitive added. */
  .brg__hub {
    grid-column: 2; grid-row: 1 / -1; align-self: center;
    position: relative;
    display: grid; justify-items: center; gap: 0.7rem;
    padding: clamp(1rem, 1.9vw, 1.6rem) clamp(0.9rem, 1.8vw, 1.5rem);
    border: 1px solid color-mix(in srgb, var(--brass) 46%, transparent);
    background: color-mix(in srgb, var(--brass) 6%, var(--ink-900));
    opacity: 0;
    transition: opacity 700ms var(--ease-out) 1080ms;
  }
  .brg.is-in .brg__hub { opacity: 1; }
  .brg__hub::before, .brg__hub::after {
    content: ''; position: absolute; top: 50%;
    width: var(--brg-gap); height: 1px;
    background: var(--brass);
    transition: transform 520ms var(--ease-out) 1180ms;
  }
  .brg__hub::before { right: 100%; transform: scaleX(0); transform-origin: left; }
  .brg__hub::after { left: 100%; transform: scaleX(0); transform-origin: right; }
  .brg.is-in .brg__hub::before, .brg.is-in .brg__hub::after { transform: none; }

  .brg__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brass); }
  .brg__hub-t { color: var(--fg); letter-spacing: 0.16em; white-space: nowrap; }

  /* The section's thesis, so it outranks the names it explains. */
  .brg__thesis {
    margin: clamp(2.5rem, 4.5vw, 3.6rem) auto 0;
    max-width: 26ch; text-align: center;
    font-family: var(--serif); font-weight: 320;
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.7rem);
    line-height: 1.2; letter-spacing: -0.014em;
    color: var(--fg);
  }

  /* ── The method, as a ledger ──────────────────────────────────── */
  .imeth {
    padding-block: clamp(2.75rem, 1.5rem + 3vw, 4.5rem) clamp(3.5rem, 2rem + 3.5vw, 5.5rem);
  }
  .imeth__in { display: grid; gap: clamp(1.75rem, 3.2vw, 2.8rem); }
  .imeth__head { display: grid; gap: clamp(0.9rem, 1.8vw, 1.5rem); }
  .imeth__k { color: var(--fg-faint); }
  .imeth .display--l { max-width: 16ch; }

  .ledger { list-style: none; margin: 0; padding: 0; }
  .ledger li {
    display: grid;
    grid-template-columns: clamp(2.8rem, 5vw, 5rem) minmax(0, 7fr) minmax(0, 5fr);
    column-gap: clamp(1rem, 2.4vw, 2.4rem);
    align-items: baseline;
    padding-block: clamp(1rem, 1.9vw, 1.75rem);
    border-top: 1px solid var(--rule);
  }
  .ledger li:last-child { border-bottom: 1px solid var(--rule); }
  .ledger__n {
    font-family: var(--serif); font-weight: 300;
    font-size: clamp(1.2rem, 0.95rem + 0.8vw, 1.7rem);
    line-height: 1; color: var(--brass);
  }
  .ledger__t { font-weight: 320; }
  .ledger__p { color: var(--fg-mute); font-size: var(--step-xs); max-width: 30ch; }

  @media (max-width: 900px) {
    .ledger li { grid-template-columns: clamp(2.4rem, 8vw, 3.4rem) minmax(0, 1fr); row-gap: 0.4rem; }
    .ledger__p { grid-column: 2; }
  }

  @media (max-width: 860px) {
    .ihead { padding-block-start: calc(var(--nav-h) + 4.75rem); }
    .ihead__in { grid-template-columns: 1fr; }
    .ihead__lead { grid-column: 1; gap: clamp(1.2rem, 5vw, 1.8rem); }
    .ihead__h { max-width: 100%; }
    .ihead__stand { max-width: 34ch; }
    .spec { grid-column: 1; padding-top: clamp(0.4rem, 3vw, 1rem); }

    /* One spine down the left edge instead of two rails and a gap. */
    .ibridge { padding-block: clamp(2rem, 6vw, 3rem) clamp(3.5rem, 12vw, 5rem); }
    .brg {
      --brg-gap: clamp(1.8rem, 8vw, 3rem);
      grid-template-columns: minmax(0, 1fr);
      row-gap: clamp(0.35rem, 1.6vw, 0.6rem);
    }
    .brg__rail { display: none; }
    .brg__k, .brg__list li { grid-column: 1; grid-row: auto; text-align: left; }
    .brg__k--a, .brg__k--b { padding-left: 0; padding-right: 0; }
    .brg__list--a li, .brg__list--b li {
      padding-left: 0; padding-right: 0;
      grid-row: auto;
    }
    .brg__k--b { margin-top: clamp(1.6rem, 7vw, 2.4rem); }
    .brg__hub {
      grid-column: 1; grid-row: auto; justify-self: start; align-self: auto;
      margin-block: calc(var(--brg-gap) + 0.4rem);
    }
    .brg__hub::before, .brg__hub::after {
      top: auto; left: clamp(1.6rem, 6vw, 2.4rem); right: auto;
      width: 1px; height: var(--brg-gap);
    }
    .brg__hub::before { bottom: 100%; transform: scaleY(0); transform-origin: bottom; }
    .brg__hub::after { top: 100%; transform: scaleY(0); transform-origin: top; }
    .brg__thesis { margin-inline: 0; text-align: left; max-width: 22ch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brg__k, .brg__list li, .brg__hub { opacity: 1 !important; transform: none !important; transition-duration: 1ms !important; }
    .brg__rail i, .brg__hub::before, .brg__hub::after { transform: none !important; transition-duration: 1ms !important; }
  }
</style>
