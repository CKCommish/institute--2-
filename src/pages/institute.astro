---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { method } from '../data/site.js';

const builds = ['Technology companies', 'Founders', 'Research labs'];
const runs = ['Health systems', 'Universities', 'Community organizations', 'Government'];

/* The hero's caption card. Four hairline-ruled rows pinned to the right plate
   edge — the second thing you read after the statement, and the thing that
   makes the right half of the first screen carry information. */
const spec = [
  { k: 'Horizon', v: '3–12 months' },
  { k: 'Scope', v: 'One problem, one owner' },
  { k: 'Partners', v: 'Two sides, one table' },
  { k: 'Active now', v: 'Four pilots, 2026', href: '/pilots/' },
];
---
<Base title="Institute" description="How the Lion Forum Institute works: short pilots, real partners, published results.">
  <!-- ── Hero plate ──────────────────────────────────────────────────
       The plate climbs one rung at a time — eyebrow, bridge clause, then
       the statement — instead of jumping 12px to 107px with nothing in
       between. Right plate: the spec, then the media chip. -->
  <section class="ihead">
    <div class="shell ihead__in">
      <p class="eyebrow ihead__k" data-reveal>How we work</p>
      <p class="bridge ihead__bridge" data-reveal="120">
        A pilot needs money, a technology, and a real place to run.
      </p>

      <div class="ihead__lead">
        <h1 class="display display--poster ihead__h lines">We sit between the builders and the institutions.</h1>
        <a class="cue tap ihead__cue" href="#bridge" data-reveal="620">
          <span class="label">The bridge</span><i class="cue__line" aria-hidden="true"></i>
        </a>
      </div>

      <div class="ihead__side">

      <!-- Territory, not a sentence: the spec is a place on the plate, so it
           uncovers along its own axis instead of lifting in row by row. -->
      <dl class="spec" data-wipe="left" data-delay="260">
        {spec.map((s) => (
          <div class="spec__row">
            <dt class="label spec__k">{s.k}</dt>
            <dd class="spec__v">{s.href ? <a class="link tap" href={s.href}>{s.v}</a> : s.v}</dd>
          </div>
        ))}
      </dl>

      <!-- Corner media, cropped to a detail so it reads as a chip pinned to
           the plate edge rather than a second wide frame. -->
      <!-- An empty meeting room with an American flag, set beside "We sit
           between the builders and the institutions" and above a diagram
           whose hub reads THE INSTITUTE, is one caption away from claiming to
           be the Institute's own room. It is not. refs/PHOTO-FACTS.md asks
           for the credit; every other photograph on the site carries one. -->
      <Figure
        src="/media/institute.jpg" alt="" ratio="2 / 1" ratioSm="3 / 2"
        grade={0.6} zoom={1.18} focal="50% 50%" enter="wipe" class="ichip"
        credit="Library of Congress" creditPos="bottom-right"
        sizes="(max-width: 860px) 92vw, 34vw" />

      </div>
    </div>
  </section>

  <!-- ── The one idea on the page ────────────────────────────────────
       One shared five-row baseline grid: both arms sit on the same rows,
       both rails run the same length, and the connectors are the last
       thing to arrive — left arm, right arm, rails, connectors, thesis. -->
  <section class="ibridge" id="bridge">
    <div class="shell">
      <div class="brg" data-reveal>
        <span class="brg__rail brg__rail--a" aria-hidden="true"><i></i></span>
        <p class="label label--brass brg__k brg__k--a" style="--d:0ms">Who builds it</p>
        <ul class="brg__list brg__list--a" role="list">
          {builds.map((b, i) => <li class="bridge bridge--lift bridge--fg" style={`--d:${80 + i * 80}ms`}>{b}</li>)}
        </ul>

        <span class="brg__rail brg__rail--b" aria-hidden="true"><i></i></span>
        <p class="label label--brass brg__k brg__k--b" style="--d:260ms">Who runs it</p>
        <ul class="brg__list brg__list--b" role="list">
          {runs.map((r, i) => <li class="bridge bridge--lift bridge--fg" style={`--d:${340 + i * 80}ms`}>{r}</li>)}
        </ul>

        <span class="brg__hub">
          <span class="brg__dot" aria-hidden="true"></span>
          <span class="label label--lit brg__hub-t">The Institute</span>
        </span>
      </div>

      <!-- The page's claim, and the one thing on it set at the series-breaking
           rung. Scroll-linked weight: it arrives slightly large and low and
           resolves as it reaches reading position. -->
      <p class="display display--feature brg__thesis" data-settle="0.62">Neither side can run the pilot alone.</p>
    </div>
  </section>

  <!-- ── How a pilot runs ────────────────────────────────────────────
       A ledger, not a card row: three full-width entries, one rule each.
       /partner/ runs three parallel doors as columns; these are three
       steps in order, so they are set as a sequence. -->
  <section class="on-cream imeth">
    <div class="shell imeth__in">
      <div class="imeth__head">
        <p class="eyebrow imeth__k" data-reveal>The method</p>
        <h2 class="display display--head lines">Every pilot runs the same way.</h2>
      </div>

      <ol class="ledger" data-seq="110" data-seq-from="60">
        {method.map((m) => (
          <li data-reveal>
            <span class="index ledger__n">{m.index}</span>
            <div class="ledger__b">
              <h3 class="ledger__t display display--sub">{m.title}</h3>
              <p class="ledger__p">{m.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────
     Two columns under a two-row header. The header (eyebrow + bridge)
     spans both plates, so the statement's cap-line and the spec's first
     rule still open on the same horizon. */
  .ihead {
    padding-block: calc(var(--nav-h) + var(--head-pad)) clamp(1.25rem, 1.4vw, 1.5rem);
  }
  .ihead__in {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    column-gap: clamp(2rem, 5vw, 5rem);
    row-gap: clamp(1.6rem, 2.8vw, 2.6rem);
    align-items: start;
  }
  .ihead__k { grid-column: 1 / -1; }
  /* The rung that was missing. It spans the plate but is measured short, so
     the right column stays clear of it. */
  .ihead__bridge {
    grid-column: 1 / -1;
    max-width: 34ch;
    margin-bottom: clamp(0.9rem, 2vw, 1.9rem);
  }

  /* The columns do NOT stretch to the taller of the two. Forcing the left
     plate to the media chip's depth stranded the scroll cue ~290px under the
     statement, alone, bounded only by the viewport edge — a pause with one
     side. The cue now closes the block it belongs to. */
  .ihead__lead {
    grid-column: 1;
    display: flex; flex-direction: column;
    gap: clamp(1.5rem, 2.6vw, 2.5rem);
  }
  .ihead__side {
    grid-column: 2;
    display: flex; flex-direction: column;
    gap: clamp(1.6rem, 3vw, 2.8rem);
  }
  /* --step-poster: the poster line of an inner page. The homepage hero is the
     one banner on the site and this now sits a rung under it, where it
     belongs — it used to be set larger than the hero it reports to. */
  .ihead__h {
    line-height: 0.94; letter-spacing: -0.028em;
    max-width: 14ch;
  }
  .ihead__h :global(.line) { padding-bottom: 0.08em; margin-bottom: -0.08em; }
  /* Motion is rank, not decoration. The statement rises long and slow; every
     supporting row arrives faster, tighter and closer behind it. Local
     overrides of the base durations — the engine is untouched. */
  .ihead__h :global(.line > span) { transition-duration: 1450ms; }
  .ihead__bridge, .ihead__cue { --reveal-y: 8px; transition-duration: 460ms, 560ms; }

  /* ── Caption card ──
     Hairline rows across the full right column, label left, value right.
     No padding on top: the first rule lands on the display's cap-line, so
     the right rail opens on the same horizon as the statement. */
  .spec { margin: 0; padding-top: 0; }
  .spec__row {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: clamp(0.8rem, 2vw, 1.6rem);
    padding-block: clamp(0.62rem, 1.1vw, 0.95rem);
    border-top: 1px solid var(--rule);
  }
  .spec__row:last-child { border-bottom: 1px solid var(--rule); }
  /* Off the 11.66px pile. Twenty-three elements on this page were sitting at
     the micro rung; the spec keys are page content, not chrome, so they move
     up to the .index size the ledger numerals already use. */
  /* The house .label geometry, full stop. It carried a local 13.1px/0.1em,
     which is the .index rung wearing a label's job — a fifth micro mark. */
  .spec__k { white-space: nowrap; }
  .spec__v {
    margin: 0; text-align: right;
    font-size: var(--step-lede);
    line-height: 1.25; letter-spacing: -0.006em;
    color: var(--fg);
  }
  .spec__v :global(a:hover) { color: var(--brass); }

  /* Media chip + scroll cue close the plate: one object pinned to each
     bottom corner, sharing a baseline. The cue is the same object as the two
     hero screens — word, then a 34px hairline with one brass sweep in it. */
  .ichip { margin-top: auto; }
  /* Placement only — the mark is the shared .cue primitive. */
  .ihead__cue { align-self: flex-start; }

  /* ── The bridge ───────────────────────────────────────────────────
     One grid: row 1 is both arm labels, rows 2–5 are the names. Both
     rails span 1 / -1, so they are the same length and terminate on the
     grid rather than in mid-air. */
  .ibridge {
    padding-block: clamp(2.5rem, 1rem + 2.6vw, 4rem) clamp(3rem, 1.5rem + 3.2vw, 5.5rem);
  }
  .brg {
    --brg-gap: clamp(2rem, 5vw, 5rem);
    --hub-w: clamp(9.5rem, 13vw, 12rem);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--hub-w) minmax(0, 1fr);
    /* Declared, not implicit: `1 / -1` on the rails and the hub only means
       "the whole diagram" if the explicit grid actually has these five rows. */
    grid-template-rows: auto repeat(4, auto);
    column-gap: var(--brg-gap);
    row-gap: clamp(0.45rem, 1vw, 0.85rem);
  }
  /* The whole diagram is staged from one observer so the order is exact.
     Neutralise the generic reveal on the wrapper; the children carry it. */
  .brg[data-reveal] { opacity: 1; transform: none; transition: none; }

  .brg__list { display: contents; }
  /* Short, close rises: these are the supporting rank. */
  .brg__k, .brg__list li {
    opacity: 0; transform: translate3d(0, 8px, 0);
    transition:
      opacity 380ms var(--ease-out) var(--d, 0ms),
      transform 460ms var(--ease-out) var(--d, 0ms);
  }
  .brg.is-in .brg__k, .brg.is-in .brg__list li { opacity: 1; transform: none; }

  .brg__k { grid-row: 1; margin-bottom: clamp(0.35rem, 0.9vw, 0.7rem); }
  .brg__k--a { grid-column: 1; text-align: right; padding-right: clamp(1rem, 2vw, 1.8rem); }
  .brg__k--b { grid-column: 3; padding-left: clamp(1rem, 2vw, 1.8rem); }

  /* The two arms are the site's other sans voice at the small display rung,
     so they take the same declared class the hero's clause takes rather than
     re-writing var(--step-sub) here. --step-sub is a serif rung; .bridge--lift
     is the only door through it. */
  .brg__list li {
    list-style: none;
    line-height: 1.16;
    color: var(--fg);
  }
  .brg__list--a li { grid-column: 1; text-align: right; padding-right: clamp(1rem, 2vw, 1.8rem); }
  .brg__list--b li { grid-column: 3; padding-left: clamp(1rem, 2vw, 1.8rem); }
  .brg__list--a li:nth-child(1), .brg__list--b li:nth-child(1) { grid-row: 2; }
  .brg__list--a li:nth-child(2), .brg__list--b li:nth-child(2) { grid-row: 3; }
  .brg__list--a li:nth-child(3), .brg__list--b li:nth-child(3) { grid-row: 4; }
  .brg__list--a li:nth-child(4), .brg__list--b li:nth-child(4) { grid-row: 5; }

  /* Rails: identical length, drawn top-down, after both arms have landed. */
  .brg__rail { grid-row: 1 / -1; display: block; width: 1px; }
  .brg__rail--a { grid-column: 1; justify-self: end; }
  .brg__rail--b { grid-column: 3; justify-self: start; }
  .brg__rail i {
    display: block; width: 1px; height: 100%;
    background: var(--rule);
    transform: scaleY(0); transform-origin: top;
    transition: transform 460ms var(--ease-out) var(--d, 0ms);
  }
  .brg__rail--a i { --d: 540ms; }
  .brg__rail--b i { --d: 590ms; }
  .brg.is-in .brg__rail i { transform: none; }

  /* Hub + the two connectors, which draw inward from each rail to the box.
     Local delays; no motion primitive added. */
  .brg__hub {
    grid-column: 2; grid-row: 1 / -1; align-self: center;
    position: relative;
    display: grid; justify-items: center; gap: 0.7rem;
    padding: clamp(1rem, 1.9vw, 1.6rem) clamp(0.9rem, 1.8vw, 1.5rem);
    border: 1px solid color-mix(in srgb, var(--brass) 46%, transparent);
    background: color-mix(in srgb, var(--brass) 6%, var(--ink-900));
    opacity: 0;
    transition: opacity 460ms var(--ease-out) 640ms;
  }
  .brg.is-in .brg__hub { opacity: 1; }
  .brg__hub::before, .brg__hub::after {
    content: ''; position: absolute; top: 50%;
    width: var(--brg-gap); height: 1px;
    background: var(--brass);
    transition: transform 420ms var(--ease-out) 720ms;
  }
  .brg__hub::before { right: 100%; transform: scaleX(0); transform-origin: left; }
  .brg__hub::after { left: 100%; transform: scaleX(0); transform-origin: right; }
  .brg.is-in .brg__hub::before, .brg.is-in .brg__hub::after { transform: none; }

  .brg__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brass); }
  .brg__hub-t { white-space: nowrap; }

  /* The series-breaker, used once on this page. A held pause above it, bounded
     by the diagram on one side and by the line itself on the other. */
  .brg__thesis {
    margin: var(--pause) auto 0;
    max-width: 18ch; text-align: center;
    line-height: 1.04;
    color: var(--fg);
    --settle-shift: 2.4vh;
  }

  /* ── The method, as a ledger ──────────────────────────────────── */
  .imeth {
    padding-block: clamp(2.75rem, 1.5rem + 3vw, 4.5rem) clamp(3.5rem, 2rem + 3.5vw, 5.5rem);
  }
  .imeth__in { display: grid; gap: clamp(1.75rem, 3.2vw, 2.8rem); }
  .imeth__head { display: grid; gap: clamp(0.9rem, 1.8vw, 1.5rem); }
  .imeth .display--head { max-width: 16ch; }
  .imeth__head h2 :global(.line > span) { transition-duration: 1450ms; }

  /* Two columns only. The gloss belongs under the title it glosses — a third
     column set at 11px on the far side of a 1300px row is decoration, not
     information. Same treatment on every width. */
  .ledger { list-style: none; margin: 0; padding: 0; }
  .ledger li {
    display: grid;
    grid-template-columns: clamp(2.4rem, 4vw, 3.8rem) minmax(0, 1fr);
    column-gap: clamp(0.9rem, 2vw, 1.8rem);
    align-items: start;
    padding-block: clamp(1.1rem, 2.1vw, 2rem);
    border-top: 1px solid var(--rule);
  }
  .ledger li:last-child { border-bottom: 1px solid var(--rule); }
  .ledger li[data-reveal] { --reveal-y: 8px; transition-duration: 440ms, 560ms; }
  /* Shared .index primitive; only the optical drop onto the row is local. */
  .ledger__n { padding-top: 0.55em; }
  .ledger__b { display: grid; gap: clamp(0.3rem, 0.7vw, 0.55rem); }
  .ledger__t { font-weight: 320; }
  .ledger__p { color: var(--fg-mute); font-size: var(--step-body); max-width: 34ch; }

  @media (max-width: 860px) {
    /* head offset comes from --head-pad; nothing local to override */
    .ihead__in { grid-template-columns: minmax(0, 1fr); row-gap: clamp(1.5rem, 6vw, 2.2rem); }
    .ihead__lead, .ihead__side { grid-column: 1; }
    .ihead__lead { gap: clamp(1.2rem, 5vw, 1.8rem); }
    .ihead__side { gap: clamp(1.4rem, 6vw, 2rem); }
    .ihead__h { max-width: 100%; }
    .ihead__bridge { max-width: 30ch; margin-bottom: clamp(0.3rem, 2vw, 0.8rem); }
    .spec { padding-top: 0; }
    /* The one row a reader will try to press. Its own box clears 44px. */
    .spec__v :global(a) { display: inline-block; padding-block: 0.7rem; }
    .spec__row { padding-block: 0.35rem; }
    .ichip { margin-top: 0; }
    .ihead__cue { display: none; }

    /* One column, and the node genuinely sits between the two lists rather
       than trailing them with a connector running off into empty space.
       `order` reorders the flow; the node becomes a full-width band bounded
       by two rules, which is what a hinge looks like without a diagram. */
    .ibridge { padding-block: clamp(2rem, 6vw, 3rem) clamp(3.5rem, 12vw, 5rem); }
    /* The diagram survives the breakpoint. One brass rail runs the full
       height of the left gutter, both arms hang off it, and the hub is
       notched onto it — two sides meeting at one point, drawn vertically.
       It used to delete the rails and the connectors and become three
       stacked lists with a section-header band in the middle. */
    .brg {
      --brg-gut: clamp(1.5rem, 7vw, 2.4rem);
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: clamp(0.35rem, 1.6vw, 0.6rem);
      padding-left: var(--brg-gut);
    }
    .brg__rail {
      position: absolute; left: 0; top: 0; bottom: 0;
      grid-row: auto; grid-column: auto;
      justify-self: start;
    }
    .brg__rail--b { display: none; }
    .brg__rail--a i {
      background: color-mix(in srgb, var(--brass) 58%, transparent);
      --d: 120ms;
    }
    .brg__k, .brg__list li { grid-column: 1; grid-row: auto; text-align: left; }
    .brg__k--a, .brg__k--b { padding-left: 0; padding-right: 0; }
    .brg__list--a li:nth-child(n), .brg__list--b li:nth-child(n) {
      padding-left: 0; padding-right: 0;
      grid-row: auto; grid-column: 1; text-align: left;
    }
    .brg__k--a { order: 1; }
    .brg__list--a li { order: 2; }
    .brg__hub { order: 3; }
    .brg__k--b { order: 4; }
    .brg__list--b li { order: 5; }

    .brg__hub {
      grid-column: 1; grid-row: auto;
      justify-self: start; align-self: auto;
      margin-block: clamp(1.5rem, 6.5vw, 2.2rem);
      display: inline-flex; align-items: center; justify-content: flex-start; gap: 0.7rem;
      padding: clamp(0.7rem, 3vw, 0.95rem) clamp(0.85rem, 3.6vw, 1.15rem);
      background: color-mix(in srgb, var(--brass) 8%, var(--ink-900));
    }
    /* The notch: one connector running left, from the hub back to the rail. */
    .brg__hub::after { content: none; }
    .brg__hub::before {
      content: ''; right: 100%; width: var(--brg-gut);
      transform: scaleX(0); transform-origin: right;
    }
    .brg.is-in .brg__hub::before { transform: none; }
    /* Below ~700px the feature rung stops reading as a break, so the break is
       carried by space and alignment instead. */
    .brg__thesis { margin-inline: 0; text-align: left; max-width: 14ch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brg__k, .brg__list li, .brg__hub { opacity: 1 !important; transform: none !important; transition-duration: 1ms !important; }
    .brg__rail i, .brg__hub::before, .brg__hub::after { transform: none !important; transition-duration: 1ms !important; }
  }
</style>
