---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { method } from '../data/site.js';

/* The prospectus names its two sides twice: in prose under WHAT WE DO
   ("leading founders and technology companies, universities and health
   systems, community partners, and local, state, and federal government")
   and as the two columns of its own org chart (TECHNOLOGY PARTNERS: AI LABS
   & MODEL DEVELOPERS / FOUNDERS & STARTUPS / TECHNOLOGY COMPANIES;
   IMPLEMENTATION PARTNERS: HEALTH SYSTEMS / UNIVERSITIES / COMMUNITY
   PARTNERS / GOVERNMENT). This page used to redraw the chart; wave 17
   replaced it with the prose — the same seven groups, in two sentences
   whose verbs carry what the chart's two column headings carried. The
   sentences are unchanged. What changed is where they sit: see the note
   above .ispec__say. */
const sides = [
  'Technology companies, founders and AI labs build it.',
  'Health systems, universities, community organizations and government run it.',
];

/* The spec used to be a card pinned to the right of the statement. It is now
   a rail: four hairline cells across the full width, directly under the
   photograph, so the first screen is a picture and the second thing you read
   is a horizontal register rather than a second column.

   FOCUS is the prospectus's own list and the site had never carried it: "We
   work on the critical issues at the center of American life – healthcare,
   education, workforce, and energy." It replaces "One problem, one owner",
   which was authored. Workforce appears nowhere else on the site. */
const spec = [
  { k: 'Horizon', v: '3–12 months' },
  { k: 'Focus', v: 'Health, education, workforce, energy' },
  /* THIS CELL USED TO READ "Partners / Two sides, one table" and it was one
     of five places this page stated its between-ness. It is now the one leg
     of the hero's own sentence — "a pilot needs money, a technology, and a
     real place to run" — that the page never answered. The two sentences
     below the rail answer the technology and the place; nothing answered the
     money. refs/PROSPECTUS.txt, HOW WE WORK: "We work with major foundations
     and private technology companies to fund our mission." It carries no
     href: /partner/ is already the nav's standing CTA, and a second link in
     this rail sets two underlined multi-line values side by side at 390 —
     the rail is a ledger, and only the pilots cell has ever been a door. */
  { k: 'Funding', v: 'Foundations and technology companies' },
  /* refs/PROSPECTUS.txt: "CURRENT PILOT PIPELINE — FOUR ACTIVE PILOTS —
     2026". This cell said "Four pilots, proposed" and /pilots/ tagged all
     four PROPOSED, which the canonical document contradicts. Both say
     active now. Neither says signed.

     AND IT WAS THE ONE PLACE THE COUNT STOOD BARE. The homepage's pilots
     scene, /partner/ and /pilots/ all carry the count AND the split — the
     prospectus says the Institute "is working with" 01–03 and "is
     exploring" 04 — so a reader who took this cell at face value met the
     qualification one click later and read it as a correction. The count
     does not fit beside the split in a value this wide, so it moves into
     the key, where the other three cells keep their register word: the
     cell now states the same two facts every other place on the site
     states, in the ledger's own compression. */
  { k: 'Four pilots for 2026', v: 'Three under way, one in exploration', href: '/pilots/' },
];
---
<Base title="Institute" description="How the Lion Forum Institute works: short pilots, measured outcomes, published results.">
  {/* ── The room ────────────────────────────────────────────────────
       The page's one exception, and it is a photograph rather than a
       typographic trick: a long table with chairs down both sides, a flag on
       the axis, mirrored doors left and right. It is the bridge, photographed
       — so it is given the whole first screen at full bleed and the statement
       is set INTO it, low left, where the frame's own floor is empty.
       It used to be a 622×336 card in the right column under a spec table. */}
  <section class="ihero">
    <Figure
      src="/media/institute.jpg" alt="" ratio="auto" loading="eager"
      grade={0.52} focal="50% 44%" zoom={1.06} lift={1.05} vig={0.34}
      scrim="bottom" reach={1} rise={0.78} ink={1.06}
      credit="Dallas, Texas" creditPos="bottom-right"
      class="ihero__bg" sizes="100vw" />

    <div class="shell ihero__in">
      <p class="eyebrow ihero__k">How we work</p>
      <p class="bridge ihero__bridge">A pilot needs money, a technology, and a real place to run.</p>
      <h1 class="display display--poster ihero__h">We sit between the builders and the institutions.</h1>
    </div>
  </section>

  {/* ── The two sides, under the rail ─────────────────────────────
       The spec rail and the two sentences are ONE scene now. They used to be
       two, and the second was a full ground change. */}
  <section class="ispec">
    <div class="shell ispec__in">
      <dl class="ispec__rail" data-wipe="left" data-delay="120">
        {spec.map((s) => (
          <div class="ispec__c">
            <dt class="label ispec__k">{s.k}</dt>
            <dd class="ispec__v">{s.href ? <a class="link tap" href={s.href}>{s.v}</a> : s.v}</dd>
          </div>
        ))}
      </dl>

      <div class="ispec__say">
        {sides.map((line, i) => (
          <p class="bridge bridge--fg bridge--lift ispec__s" data-reveal data-delay={140 + i * 140}>{line}</p>
        ))}
      </div>
    </div>
  </section>

  {/* ── The page turned over ────────────────────────────────────────
       One sentence, full bleed, on cream. The system keeps exactly one of
       these per page and this is what it is for — and it is now the page's
       ONLY change of ground: the rail scene above names the two sides, this
       states why neither of them is enough. */}
  <section class="on-cream iclaim">
    <p class="display display--feature iclaim__t shell" data-settle="0.62">Neither side can run the pilot alone.</p>
  </section>

  {/* ── How a pilot runs ────────────────────────────────────────────
       A ledger, not a card row: five full-width entries, one rule each, and
       the five entries are the prospectus's own sequence of verbs. Until
       wave 21 this was three rungs of caption, two of which restated the
       rail and the two sentences above them; the scene was the site's
       weakest and it was sitting on the one fact about the model the page
       never stated. src/data/site.js carries the sourcing.

       THE HELD-SPACE RULE (src/styles/tokens.css) on what follows it: the
       flat run between this ledger and the footer's first mark is 180px at
       1440 and 95px at 390, both over one --pause (118.39 / 56). It is
       COMPOSITION, not a hole, under clause 1 — the ledger's last rule is a
       full-measure object (1337px of 1338 at 1440, 348 at 390) lying on the
       band's top edge — and the footer's glow ramps into it from below.
       That was already true of the three-rung version; five rungs do not
       change it. It is not the reason this scene was weak. */}
  <section class="imeth">
    <div class="shell imeth__in">
      <div class="imeth__head">
        <p class="eyebrow imeth__k" data-reveal>The method</p>
        <h2 class="display display--head lines">Every pilot runs the same way.</h2>
      </div>

      <ol class="ledger" data-seq="110" data-seq-from="60">
        {method.map((m) => (
          <li data-reveal>
            <span class="index ledger__n">{m.index}</span>
            <h3 class="ledger__t display display--sub">{m.title}</h3>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  /* ── The room ─────────────────────────────────────────────────────
     Full bleed, one screen, type set low-left into the photograph's own
     empty floor. The scrim is directional and reaches the full width, so
     the corner credit is protected too. */
  .ihero {
    position: relative;
    isolation: isolate; overflow: hidden;
    min-height: min(94svh, 50rem);
    display: grid; align-items: end;
    padding-block: calc(var(--nav-h) + 1rem) clamp(2rem, 4.5vh, 3.4rem);
  }
  :global(.ihero__bg) { position: absolute; inset: 0; aspect-ratio: auto; z-index: -1; }

  .ihero__in { width: 100%; display: grid; justify-items: start; }
  .ihero__k { opacity: 0; animation: iheroIn 640ms var(--ease-out) 140ms forwards; }
  .ihero__bridge {
    max-width: 32ch;
    margin-block: clamp(0.5rem, 1.2vh, 0.9rem) clamp(0.8rem, 1.8vh, 1.4rem);
    opacity: 0; animation: iheroIn 720ms var(--ease-out) 240ms forwards;
  }
  /* The statement is inked in top-down over the picture, the same load-timed
     mask the homepage banner uses — an observer-driven reveal cannot be
     trusted at the very top of a page. */
  .ihero__h {
    line-height: 0.95; letter-spacing: -0.028em;
    max-width: min(15ch, 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 0 58%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0 58%, transparent 100%);
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
    -webkit-mask-position: 0 0; mask-position: 0 0;
    -webkit-mask-size: 100% 0%; mask-size: 100% 0%;
    animation: iheroInk 1000ms var(--ease-out) 300ms forwards;
  }
  @keyframes iheroInk { to { -webkit-mask-size: 100% 190%; mask-size: 100% 190%; } }
  @keyframes iheroIn { from { opacity: 0; transform: translate3d(0, 12px, 0); } to { opacity: 1; transform: none; } }

  /* ── The rail, and the two sides under it ────────────────────────
     Four cells across the full measure under one rule, then the two
     sentences. Horizontal first, so the page's second register is not a
     second column.

     THE TWO SENTENCES USED TO BE THEIR OWN SCENE — an .on-panel band between
     two rules, 444px of desktop screen for two paragraphs, with the right
     two-thirds of it empty. Before that it was a DIAGRAM, and wave 17 killed
     the diagram on the argument that the page stated one idea three times in
     four scenes. The replacement made it five and gave the weakest of the
     five the strongest container on the page. Counted at the pixels: the
     hero display states the Institute's POSITION, these two sentences state
     the MEMBERSHIP (all seven of the prospectus's stakeholder groups, which
     is the one thing the chart uniquely held), and the cream claim states the
     NECESSITY. Three registers, three claims, one turn of ground. The two
     restatements that carried nothing new are gone: the rail's "Two sides,
     one table", which said in four words what the sentences say in full
     forty pixels below it, and the band itself.

     Wave 11's proportions rule still governs and is the reason this is not a
     void: the scene is its content plus its own padding, and nothing here is
     sized to fill a screen. The prose keeps its --step-sub rung — with no
     ground to lift it, size is what ranks it above the rail's labels.

     (The one echo left on the page is method rung 02, "Who builds it. Who
     runs it.", six words 300px below these two sentences. It lives in
     src/data/site.js, outside this piece's files. See the handoff.) */
  .ispec { padding-block: clamp(1.4rem, 2.4vw, 2.4rem) clamp(3rem, 2rem + 3vw, 5.5rem); }
  .ispec__in { display: grid; gap: clamp(2.2rem, 4.4vw, 3.6rem); }
  .ispec__rail {
    margin: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.6rem);
    border-top: 1px solid var(--rule);
  }
  .ispec__c { padding-top: clamp(0.7rem, 1.2vw, 1.1rem); display: grid; gap: 0.45rem; align-content: start; }
  .ispec__k { white-space: nowrap; }
  .ispec__v {
    margin: 0; font-size: var(--step-lede);
    line-height: 1.25; letter-spacing: -0.006em; color: var(--fg);
  }
  .ispec__v :global(a:hover),
  .ispec__v :global(a:focus-visible) { color: var(--brass); }

  .ispec__say { display: grid; justify-items: start; gap: clamp(1.2rem, 2.2vw, 1.9rem); }
  /* A measure, so the two sentences read as a stacked pair of blocks rather
     than two rules of type running the full 1200px shell. */
  .ispec__s { max-width: 30ch; }

  /* ── The claim, on cream ──────────────────────────────────────── */
  .iclaim { padding-block: clamp(4rem, 2rem + 6vw, 8rem); }
  .iclaim__t {
    margin: 0 auto; max-width: 20ch; text-align: center;
    line-height: 1.04; color: var(--fg);
    --settle-shift: 2.4vh;
  }

  /* ── The method, as a ledger ──────────────────────────────────── */
  .imeth {
    padding-block: clamp(2.75rem, 1.5rem + 3vw, 4.5rem) clamp(3.5rem, 2rem + 3.5vw, 5.5rem);
  }
  .imeth__in { display: grid; gap: clamp(1.75rem, 3.2vw, 2.8rem); }
  .imeth__head { display: grid; gap: clamp(0.9rem, 1.8vw, 1.5rem); }
  .imeth .display--head { max-width: 16ch; }
  .imeth__head h2 :global(.line > span) { transition-duration: 1450ms; }

  .ledger { list-style: none; margin: 0; padding: 0; }
  .ledger li {
    display: grid;
    grid-template-columns: clamp(2.4rem, 4vw, 3.8rem) minmax(0, 1fr);
    column-gap: clamp(0.9rem, 2vw, 1.8rem);
    align-items: start;
    padding-block: clamp(1.1rem, 2.1vw, 2rem);
    border-top: 1px solid var(--rule);
  }
  .ledger li:last-child { border-bottom: 1px solid var(--rule); }
  .ledger li[data-reveal] { --reveal-y: 8px; transition-duration: 440ms, 560ms; }
  /* Each rung is one line now — the number and the verb, nothing under it.
     See the note on `method` in src/data/site.js for why there is no caption
     row: every caption this page could source is already on this page. The
     number is optically aligned to the single line rather than to a block. */
  .ledger__n { padding-top: 0.34em; }
  .ledger__t { font-weight: 320; margin: 0; max-width: 30ch; }

  @media (max-width: 900px) {
    .ispec__rail { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: clamp(1rem, 3vw, 1.4rem); }
    .ispec__c { border-top: none; }
    .ispec__v :global(a) { display: inline-block; padding-block: 0.5rem; }
  }

  @media (max-width: 860px) {
    /* The corner credit is two lines at this width; the statement has to
       finish above it, not through it. */
    .ihero { min-height: min(92svh, 42rem); padding-bottom: clamp(3.4rem, 12vw, 4.4rem); }
    .ihero__h { max-width: 100%; }
    .ihero__bridge { max-width: 28ch; }

    .ispec { padding-bottom: clamp(2.75rem, 10vw, 4rem); }
    .ispec__in { gap: clamp(1.8rem, 7vw, 2.6rem); }
    .ispec__s { max-width: 24ch; }
    .iclaim__t { text-align: left; margin-inline: 0; max-width: 16ch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ihero__k, .ihero__bridge { opacity: 1 !important; animation: none !important; }
    .ihero__h { -webkit-mask-image: none; mask-image: none; animation: none !important; }
  }
</style>
