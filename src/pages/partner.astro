---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { site, pilots } from '../data/site.js';

/* Same photograph as pilot 01, so it takes pilot 01's credit rather than a
   second string that can drift away from it. */
const health = pilots.find((p) => p.image.includes('pilot-health')) || pilots[0];

const roles = [
  { t: 'Fund it', p: 'Underwrite one pilot, end to end.' },
  { t: 'Build it', p: 'Bring the model, the product, or the team.' },
  { t: 'Run it', p: 'A health system, district, university, or agency.' },
];
---
<Base title="Partner" description="Partner on a 2026 pilot with the Lion Forum Institute.">
  <!-- ── The ask, once ────────────────────────────────────────────────
       ONE focal point. The page used to print the ask twice: a display line
       and, a row below it, the address at near-display size — two objects of
       near-equal optical weight and no single action. The line is now the
       one big thing; the address is the action under it, a rung down, on the
       rule. Eyebrow → bridge → poster, so the climb has a step in it. -->
  <section class="phead">
    <!-- The one photograph on this route, and the only warm, sunlit frame on
         the site: a child running at a Unified Special Olympics meet — pilot
         01, four rows below. It runs the full height of the first screen and
         bleeds off the right edge, so the ask is set against a person rather
         than against 640px of empty navy. -->
    <Figure
      src="/media/pilot-health-portrait.jpg" alt="" ratio="auto" loading="eager"
      grade={0.34} focal="46% 34%" zoom={1.04} lift={1.06} vig={0.3}
      scrim="bottom" align="right" reach={0.5} rise={0.42} ink={0.9}
      credit={health.credit} creditPos="bottom-right"
      class="phead__fig" sizes="(max-width: 860px) 100vw, 44vw" />
    <span class="phead__veil" aria-hidden="true"></span>

    <div class="shell phead__in">
      <p class="eyebrow" data-reveal>Work with us</p>
      <p class="bridge phead__bridge" data-reveal="120">
        Every pilot still needs money, a technology, or somewhere real to
        run it. Most need two of the three.
      </p>

      <div class="phead__lead">
        <h1 class="display display--poster phead__h lines">Partner on a pilot.</h1>

        <div class="ask">
          <span class="ask__rule" data-wipe="left" data-delay="420" aria-hidden="true"></span>

          <a class="ask__mail" href={`mailto:${site.email}`} data-reveal="520">
            <svg class="arrow ask__arrow" viewBox="0 0 22 10" aria-hidden="true">
              <path d="M16 1l5 4-5 4M21 5H0"/>
            </svg>
            <span class="ask__mail-t">{site.email}</span>
          </a>

          <p class="ask__sub" data-reveal="580">Name the pilot and the role. A person answers.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ── The payload, and now it is set as the payload ───────────────
       These four are what a partner is actually being asked to fund. They
       used to sit in a right-hand column at half the size of the line above
       them — the most concrete facts on the route, set as a sidebar. They
       are now the page's body: a band set into the page, four full-width
       rows, each name at the section-headline rung with the principal who
       owns it beside it. -->
  <section class="pfour" id="pilots">
    <div class="shell pfour__in">
      <div class="pfour__head">
        <p class="eyebrow" data-reveal>Open for 2026</p>
        <p class="bridge pfour__bridge" data-reveal="120">Four pilots, four partners already at the table.</p>
      </div>

      <ol class="pindex" data-seq="90" data-seq-from="40">
        {pilots.map((p) => (
          <li class="pindex__r" data-reveal>
            <a class="pindex__a" href={`/pilots/#${p.id}`}>
              <span class="index pindex__i">{p.index}</span>
              <span class="display display--head pindex__n">{p.title}</span>
              <span class="pindex__f">{p.partner}</span>
              <span class="pindex__g">{p.tagline}</span>
              <svg class="arrow pindex__arrow" viewBox="0 0 22 10" aria-hidden="true">
                <path d="M16 1l5 4-5 4M21 5H0"/>
              </svg>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- The one hard cut in the scroll: the ground changes and the three
       doors arrive. Numeral is the index, the verb is the content. -->
  <section class="on-panel proles">
    <div class="shell proles__in">
      <div class="proles__head">
        <p class="eyebrow" data-reveal>Three ways in</p>
        <h2 class="display display--head proles__h" data-settle="0.62">Every pilot needs all three.</h2>
      </div>
      <!-- The page's one spatial idea: three doors opening outward from a
           single point, as one gesture. Not three identical lift-fades. -->
      <ol class="proles__list" data-wipe="center" data-delay="120">
        {roles.map((r, i) => (
          <li>
            <span class="proles__rule" aria-hidden="true"></span>
            <span class="index proles__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display display--sub proles__t">{r.t}</h3>
            <p>{r.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

</Base>

<style>
  /* ── The ask ──────────────────────────────────────────────────────
     ONE column. The route used to run a 7/5 split with the four pilots
     stacked in the right rail — which is what made the most concrete facts
     on the page read as marginalia. The ask now takes the whole measure and
     stops; the pilots get their own band underneath, full width. */
  .phead {
    --fig-w: clamp(20rem, 42vw, 40rem);
    position: relative; isolation: isolate;
    min-height: min(94svh, 52rem);
    display: grid; align-content: end;
    padding-block: calc(var(--nav-h) + var(--head-pad)) clamp(3.5rem, 2rem + 3.4vw, 5.5rem);
  }
  /* The photograph holds the right two-fifths of the first screen, floor to
     bar, and bleeds off the edge of the page. It is not a card: it has no
     rule, no caption and no left margin between it and the type — the ask is
     simply set against it. The scrim protects the bar strip only; nothing is
     written on the picture, so the picture keeps its own light. */
  .phead :global(.phead__fig) {
    position: absolute; z-index: -1; aspect-ratio: auto;
    /* Figure paints `inset: 0` on every fill figure, so `left` has to be
       released explicitly or the column pins to the wrong wall. */
    top: 0; bottom: 0; right: 0; left: auto;
    width: var(--fig-w);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 16%);
    mask-image: linear-gradient(to right, transparent 0, #000 16%);
  }
  /* Inert on a wide screen: nothing is written on the picture there. Below
     860px the frame becomes the ground the ask sits on, and the foot has to
     carry cream type — so the ink arrives with the breakpoint, not before. */
  .phead__veil { display: none; position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .phead__in {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: clamp(1.2rem, 2.2vw, 2rem);
    justify-items: start;
    /* The type keeps clear of the picture: the measure ends where the
       photograph's left edge begins, plus a gutter. */
    padding-right: calc(var(--fig-w) - var(--gutter) + clamp(1.5rem, 3vw, 3rem));
  }
  .phead__bridge {
    max-width: 34ch;
    margin-bottom: clamp(0.9rem, 2vw, 1.9rem);
  }
  .phead__lead { display: flex; flex-direction: column; width: 100%; }

  /* --step-poster: the poster line of an inner page, matching /institute/.
     It can carry the rung now because the page has a body under it — four
     names at --step-head — instead of a sidebar it had to outshout. */
  .phead__h {
    line-height: 0.96; letter-spacing: -0.024em;
    max-width: 13ch;
  }
  .phead__h :global(.line) { padding-bottom: 0.08em; margin-bottom: -0.08em; }
  /* Motion as rank: the statement rises long and slow, everything under the
     rule arrives fast and tight behind it. */
  .phead__h :global(.line > span) { transition-duration: 1400ms; }
  .ask [data-reveal] { --reveal-y: 8px; transition-duration: 460ms, 560ms; }

  /* ONE focal point. The page prints the ask once, at --step-feature; the
     address is the ACTION under it, at the bridge rung, so 86px answers to
     27px instead of to a second 50px line on the same row. */
  /* The rule runs the full measure and the two halves of the ask hang off
     its ends — address at the left, instruction at the right. Without it the
     right two-fifths of the first screen was open navy running out into the
     viewport edge, which reads as absence rather than as a pause. A held
     pause has to be bounded on both sides; this is the second side. */
  /* The measure is narrower than it was — the photograph has the right two
     fifths — so the address and its instruction stack instead of sharing a
     row and breaking the address mid-domain. */
  .ask {
    padding-top: clamp(2.4rem, 1.4rem + 3.2vw, 4.4rem);
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: clamp(0.7rem, 1.4vw, 1.1rem);
    align-items: baseline;
  }
  .ask__rule {
    grid-column: 1 / -1;
    display: block; height: 1px; align-self: start;
    background: color-mix(in srgb, var(--brass) 50%, transparent);
    width: 100%; transform-origin: left;
    margin-bottom: clamp(0.95rem, 1.7vw, 1.5rem);
  }
  /* Real padding, not a .tap pseudo: the address is the page's one action and
     its own box has to clear the touch minimum. */
  .ask__mail {
    display: inline-flex; align-items: center; gap: clamp(0.8rem, 1.5vw, 1.2rem);
    max-width: 100%; padding-block: 0.35rem; margin-block: -0.35rem;
  }
  .ask__arrow { width: clamp(26px, 2.6vw, 34px); color: var(--brass); flex: none; }
  .ask__mail-t {
    font-family: var(--sans); font-weight: 400;
    font-size: var(--step-bridge);
    letter-spacing: -0.006em; line-height: 1.2;
    color: var(--fg);
    transition: color 380ms var(--ease-out);
    overflow-wrap: anywhere;
  }
  .ask__mail:hover .ask__mail-t { color: var(--brass); }
  .ask__mail:hover .ask__arrow { transform: translateX(9px); }
  .ask__sub {
    grid-column: 1; justify-self: start; text-align: left;
    color: var(--fg-meta); font-size: var(--step-body); max-width: 34ch;
  }

  /* ── The four, at full width ─────────────────────────────────────
     A band set into the page, and the only place on this route where the
     ground changes before the cream. Four rows, one rule each, the name at
     the section-headline rung: 53px, not 19px in a rail. */
  /* On the page's own ground now, not in a panel: the route's tonal event is
     the photograph above, and a band here would have made this page run the
     same three-act ground sequence as /institute/ in the same order. */
  .pfour {
    border-bottom: 1px solid var(--rule);
    padding-block: clamp(3rem, 1.6rem + 3.6vw, 5.5rem) clamp(3.5rem, 1.8rem + 4vw, 6rem);
  }
  .pfour__in { display: grid; gap: clamp(2rem, 3.4vw, 3.2rem); }
  .pfour__head { display: grid; gap: clamp(0.8rem, 1.6vw, 1.3rem); }
  .pfour__bridge { max-width: 32ch; }

  .pindex { list-style: none; margin: 0; padding: 0; }
  .pindex__r { border-top: 1px solid var(--rule); }
  .pindex__r:last-child { border-bottom: 1px solid var(--rule); }
  .pindex__r[data-reveal] { --reveal-y: 8px; transition-duration: 440ms, 560ms; }

  /* Name left, principal and one line right, arrow on the far edge. The row
     is the object; everything in it is baseline-aligned to the name. */
  .pindex__a {
    display: grid;
    grid-template-columns: max-content minmax(0, 6fr) minmax(0, 3fr) minmax(0, 4fr) max-content;
    column-gap: clamp(1rem, 2.6vw, 2.6rem);
    align-items: baseline;
    padding-block: clamp(1.1rem, 2.2vw, 2rem);
  }
  .pindex__i { padding-top: 0.35em; }
  .pindex__n {
    color: var(--fg); line-height: 1.02;
    transition: color 340ms var(--ease-out);
  }
  /* Inslee and Cardona are the most interesting words on the route. They no
     longer sit at 11px and 54%. */
  .pindex__f {
    font-size: var(--step-lede); line-height: 1.3; color: var(--fg);
  }
  .pindex__g {
    font-size: var(--step-body); line-height: 1.4; color: var(--fg-mute);
    max-width: 30ch;
  }
  .pindex__arrow { width: clamp(22px, 2vw, 28px); color: var(--brass); align-self: center; opacity: 0.55; transition: transform 460ms var(--ease-out), opacity 340ms var(--ease-out); }
  .pindex__a:hover .pindex__n { color: var(--brass); }
  .pindex__a:hover .pindex__arrow { transform: translateX(9px); opacity: 1; }

  /* ── Three ways in — the cream field ──
     The numeral indexes; it does not outrank. It is a tracked cap sitting on
     the column rule, and the verb underneath it carries the weight. */
  .proles {
    padding-block: clamp(3rem, 1.6rem + 3.6vw, 5.5rem) clamp(4rem, 2rem + 4.4vw, 6.5rem);
  }
  .proles__in { display: grid; gap: clamp(2.2rem, 3.8vw, 3.6rem); }
  .proles__head { display: grid; gap: clamp(0.9rem, 1.8vw, 1.5rem); }
  /* One rung under the H1: three columns at --step-sub under a --step-head
     line, which answers to the title rather than competing with it. */
  .proles__h { max-width: 14ch; line-height: 1.02; }
  .proles__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.75rem, 3.4vw, 3.4rem);
  }
  .proles__list li { display: grid; gap: clamp(0.55rem, 1vw, 0.9rem); align-content: start; }

  .proles__n { margin-bottom: clamp(0.15rem, 0.4vw, 0.35rem); }
  .proles__rule { display: block; height: 1px; background: var(--rule); margin-bottom: clamp(0.75rem, 1.4vw, 1.15rem); }
  .proles__t { font-weight: 320; line-height: 1.08; }
  .proles__list p { color: var(--fg-mute); font-size: var(--step-body); max-width: 28ch; }


  @media (max-width: 900px) {
    .proles__list { grid-template-columns: 1fr; gap: clamp(1.5rem, 5vw, 2rem); }
    /* The centre wipe is three doors opening outward from one point. With one
       column there is no outward: the mask just eats the first letter of every
       line for a second and a half. Re-anchor it to the left rule the rows
       already hang from. Only while it is still covered — `.is-in` still ends
       at inset(0 0 0 0). */
    .proles__list:not(.is-in) { clip-path: inset(0 100% 0 0); }
  }

  @media (max-width: 860px) {
    /* A 42vw column is 164px on a phone — a strip, not a photograph. It
       becomes the ground of the whole first screen instead, with the ask set
       into its foot. */
    .phead {
      min-height: 100svh;
      padding-block: calc(var(--nav-h) + var(--head-pad)) clamp(2.5rem, 9vw, 3.5rem);
    }
    .phead :global(.phead__fig) {
      inset: 0; width: auto;
      -webkit-mask-image: none; mask-image: none;
    }
    .phead__in { padding-right: var(--gutter); }
    .phead__veil {
      display: block;
      background: linear-gradient(180deg,
        color-mix(in srgb, var(--ink-900) 30%, transparent) 0%,
        color-mix(in srgb, var(--ink-900) 12%, transparent) 26%,
        color-mix(in srgb, var(--ink-900) 46%, transparent) 54%,
        color-mix(in srgb, var(--ink-900) 88%, transparent) 78%,
        color-mix(in srgb, var(--ink-900) 96%, transparent) 100%);
    }
    .phead__in { row-gap: clamp(1.5rem, 6vw, 2.2rem); }
    .phead__h { max-width: 14ch; }
    .phead__bridge { max-width: 30ch; margin-bottom: clamp(0.3rem, 2vw, 0.8rem); }
    .ask { padding-top: clamp(2rem, 8vw, 2.8rem); }

    /* Four columns collapse to two: the numeral keeps its gutter, everything
       else stacks under the name. The arrow goes — a row that fills the
       column IS the affordance at this width. */
    .pfour { padding-block: clamp(2.75rem, 10vw, 4rem) clamp(3.25rem, 12vw, 4.5rem); }
    .pindex__a {
      grid-template-columns: max-content minmax(0, 1fr);
      column-gap: clamp(0.8rem, 4vw, 1.2rem);
      row-gap: 0.3rem;
      align-items: start;
      padding-block: clamp(1rem, 4.4vw, 1.5rem);
    }
    .pindex__i { grid-row: 1; padding-top: 0.3em; }
    .pindex__n { grid-column: 2; }
    .pindex__f, .pindex__g { grid-column: 2; }
    .pindex__g { max-width: 34ch; }
    .pindex__arrow { display: none; }
    /* Below ~700px the feature rung stops reading as a break; space carries it. */
    .proles__h { max-width: 12ch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ask__mail-t, .ask__mail-arrow { transition-duration: 1ms; }
  }
</style>
