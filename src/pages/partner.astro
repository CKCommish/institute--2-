---
import Base from '../layouts/Base.astro';
import { site, pilots, model } from '../data/site.js';

/* THE THREE WAYS IN ARE DOORS, NOT DESCRIPTIONS.
   This is the conversion page and, until now, its one chooser was three
   inert paragraphs: no target, no hover, no focus ring, nothing to press.
   The page told a reader to "name the pilot and the role" and then made
   them type both into a blank message. Each role is now the same address
   with the role already in the subject line, so choosing IS the action.
   `s` is the subject; it is the only new string on the route and it never
   reaches the page as copy. Nothing is claimed, nothing is collected: one
   mailto, three doors into it. */
/* THE ACTION IS NAMED, ONCE PER DOOR.
   All three doors used to close on the same string — EMAIL US, at 11.66px,
   the smallest type in the scene and smaller than the decorative ordinal
   above it. On the one page whose job is to be chosen from, the thing you
   press was the last thing the eye reached in every column, and the three
   options were indistinguishable at the action level: the only difference
   was a subject line nobody can see. `a` is now the ask itself, in the same
   three words /pilots/ already uses for this content — funding, technology,
   somewhere to run it — and the subject is derived from it, so the label
   and what lands in the mail client are one string. */
const roles = [
  { t: 'Fund it', p: 'Underwrite one pilot, end to end.', a: 'Funding' },
  { t: 'Build it', p: 'Bring the model, the product, or the team.', a: 'Technology' },
  { t: 'Run it', p: 'A health system, district, university, or agency.', a: 'Somewhere to run it' },
];
const mailto = (subject) =>
  `mailto:${site.email}${subject ? `?subject=${encodeURIComponent(subject)}` : ''}`;

/* OPTICAL LEFT EDGE FOR THE PILOT INDEX.
   Four 53px serif titles stacked on one rail is the largest repeated left
   edge on the site, and metric flush is not visual flush there: a round cap
   set flush reads as indented, because only its middle touches the rail.
   Measured off the rendered face (Newsreader 320, ink extents sampled at
   16x), the left ink sidebearing at --step-head is 1.688px for the flat
   stems — H I P B D E F — 2.500px for the round C G O Q, and 2.188px for S.
   The nudge closes that gap and then adds the ~2% of cap height a round
   form has to hang past a stem to LOOK flush. Values are in em, so they
   scale with the step down to 28px on a phone. Anything not listed is a
   flat or diagonal stem and is already where it should be — A and M carry
   their own overhang in the metrics and must not be nudged twice. */
const OPTIC = { C: 0.028, G: 0.028, O: 0.028, Q: 0.028, S: 0.020 };
const optic = (t) => `--optic:${OPTIC[(t || '').trim()[0]] ?? 0}em`;
---
<Base title="Partner" description="Partner on a 2026 pilot with the Lion Forum Institute.">
  {/* ── The ask, once ────────────────────────────────────────────────
       ONE focal point, and it is the ACT, not the statement about the act.
       The screen holds four things and they are ranked: a quiet lead-in, the
       86px line that says what this is, a brass rule, and the address —
       drawn as a row between two brass hairlines, on a rung nothing else on
       the screen uses. The order a reader's eye takes them in is the order
       they are listed in only because the last one is the only object on the
       screen with edges — and those edges are the page's own measure. */}
  <section class="phead">
    {/* No photograph. This route used to run a full-height frame of a real
         child at a Special Olympics meet behind the ask — a person with no
         relationship to this institute, carrying no line and answering no
         question. That photograph does honest work on /pilots/, where it is
         the pilot it belongs to. Here it was ground. A closing ask does not
         need a picture; it needs one line, one address, and room. */}
    <div class="shell phead__in">
      <div class="phead__top" data-reveal>
        <p class="eyebrow">Work with us</p>
        {/* "Most need two of the three." was here, and it was a
             distribution invented over four pilots that have never run. It
             also contradicted this page's own headline 1,550px below ("Every
             pilot needs all three.") and /institute/ ("A pilot needs money, a
             technology, AND a real place to run."). The list is conjunctive
             on every other surface and in the data — all four `needs` blocks
             in site.js carry fund, build and run — so it is conjunctive
             here. */}
        <p class="bridge phead__bridge">
          Every pilot needs money, a technology, and somewhere real to run it.
        </p>
      </div>

      <div class="phead__lead">
        <h1 class="display display--poster phead__h lines">Partner on a pilot.</h1>

        <div class="ask">
          <span class="ask__rule" data-wipe="left" data-delay="420" aria-hidden="true"></span>

          {/* THE ACTION STANDS ON THE PAGE'S RAIL, LIKE EVERYTHING ELSE.
               It was a shrink-to-fit plate: 32.6px of horizontal padding
               inside a 1px border that sat on the rail, so the border was on
               51.4 and the ADDRESS — the one string this whole route exists
               to deliver — started at 84.0, the only element on /partner/
               that landed nowhere. Its right edge fell at 787.8, a number set
               by the length of an email string and by no column on the page,
               under a rule that ran to 1388.7.
               The plate ground is gone and the row is the object now: full
               measure, no horizontal padding, so the address's own sidebearing
               stands on 51.4 with the eyebrow, the 86px line, the caption and
               all four pilot ordinals, and the arrow ends on 1388.7 with the
               rule above it and the pilot arrows below it. Its edges are two
               brass hairlines at the page's own measure, and the hover wash
               fills rail to rail — the same grammar as the four pilot rows,
               at the action's rung. */}
          <a class="ask__mail" href={mailto()} data-reveal="520">
            <span class="ask__mail-t">{site.email}</span>
            <svg class="arrow ask__arrow" viewBox="0 0 22 10" aria-hidden="true">
              <path d="M16 1l5 4-5 4M21 5H0"/>
            </svg>
          </a>

          {/* The instruction and the cue are ONE ROW and they share a
               baseline. They were two boxes bottom-aligned, which is not the
               same thing: `.tap`'s negative margin sits under the cue's
               border box, so the two lines of 11–16px type were landing 8px
               apart. Grid baseline alignment reads the type, not the box. */}
          <p class="ask__sub" data-reveal="560">Name the pilot and the role. A person answers.</p>

          {/* The rule ran the full 1338px measure and ended in nothing: the
               ask hangs off its left end and the right two-thirds terminated
               at the viewport edge. A pause is only held when it is bounded
               on both sides. This is that second side, and it is the one
               object the first screen was actually missing — the fold gave a
               reader no signal that the page continued. House `.cue`, set at
               the sub's rung so nothing sits level with the address. */}
          <a class="cue tap ask__cue" href="#pilots" data-reveal="640">
            <span class="label">The four pilots</span>
            <i class="cue__line" aria-hidden="true"></i>
          </a>
        </div>
      </div>

    </div>
  </section>

  {/* ── The payload, and now it is set as the payload ───────────────
       These four are what a partner is actually being asked to fund. They
       used to sit in a right-hand column at half the size of the line above
       them — the most concrete facts on the route, set as a sidebar. They
       are now the page's body: a band set into the page, four full-width
       rows, each name at the section-headline rung with the principal who
       owns it beside it. */}
  <section class="pfour" id="pilots">
    <div class="shell pfour__in">
      <div class="pfour__head">
        {/* NO REVEAL ON THIS BLOCK, DELIBERATELY. It is the first thing
             under the fold, and the reveal observer discounts the bottom 12%
             of the viewport: at 1440x900 this block sat at y=805 — on screen,
             and at opacity 0 for ever, because nothing below the trigger line
             can trigger. Geometry alone cannot fix that, since the dead band
             scales with the window and this block does not. It is static;
             the four rows under it still arrive in sequence, which is the
             section's actual motion event. */}
        <div class="pfour__top">
          <p class="eyebrow">Open for 2026</p>
          {/* The eyebrow already says OPEN FOR 2026; this line used to open
               "Four pilots are open for 2026" and spend a line and a half
               saying it again. A bridge that repeats its own eyebrow carries
               nothing. It carries the one thing the index below cannot say
               for itself, and the one a reader must not get wrong: what the
               names in the second column ARE.

               It said "Each pilot is named for whoever proposed it." That
               asserted that a former U.S. Secretary of Education and a former
               Governor each brought a proposal to this Institute. No source
               says so — refs/BRIEF.md lists the pilots by those names and
               nothing more — and it pointed the initiative the opposite way
               from every other surface on the site (/pilots/ pilotTerms and
               the homepage both say partners are SOUGHT). This is now the
               same sentence those two already ship, word for word, so the
               three cannot drift apart again. */}
          <p class="lede pfour__bridge">Partners named are sought for 2026. None is signed.</p>
        </div>
      </div>

      <ol class="pindex" data-seq="90" data-seq-from="40">
        {pilots.map((p) => (
          <li class="pindex__r" data-reveal>
            <a class="pindex__a" href={`/pilots/#${p.id}`}>
              <span class="index pindex__i">{p.index}</span>
              <span class="display display--head pindex__n" style={optic(p.title)}>{p.title}</span>
              {/* WHOSE PILOT THIS IS, AND HOW FAR ALONG. Two of these four
                   values are living, identifiable public officials. In an
                   unlabelled second column on a page whose verb is "Partner
                   on a pilot.", a bare name asserts "this is the partner" —
                   the same assertion the deleted sentence made, relocated
                   into a layout slot. /pilots/ and /people/ already ship the
                   house remedy for exactly this data; this is that remedy, on
                   all four so the grammar stays one grammar. It stacks rather
                   than sitting inline: the row's height is set by the 53px
                   title beside it, so a second line in this cell costs the
                   index no height at all. */}
              <span class="pindex__f">
                <span class="pindex__who">{p.partner}</span>
                <span class="label pindex__q">Proposed</span>
              </span>
              <span class="pindex__g">{p.tagline}</span>
              <svg class="arrow pindex__arrow" viewBox="0 0 22 10" aria-hidden="true">
                <path d="M16 1l5 4-5 4M21 5H0"/>
              </svg>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* The one hard cut in the scroll: the ground changes and the three
       doors arrive. Numeral is the index, the verb is the content. */}
  {/* ── The model ────────────────────────────────────────────────────
       Four independent reviewers — a fact-checker, a foundation programme
       officer, the craft critic and a sceptical journalist — all said the
       same thing: there is no number anywhere on this site a funder can act
       on. "Underwrite one pilot, end to end" appeared four times and was the
       entire financial content. The prospectus had the answer all along; the
       site did not. It goes above the three doors, because the size of the
       commitment is what decides whether someone reads the doors at all. */}
  <section class="model" id="model">
    <div class="shell model__in">
      <div class="model__head">
        {/* The eyebrow IS this section's heading — it was a <p>, which put an
            h1→h3 jump in the outline. Same type, correct outline. */}
        <h2 class="eyebrow model__eyebrow" data-reveal>{model.label}</h2>
        <p class="bridge model__lead" data-reveal="90">{model.lead}</p>
      </div>

      <div class="model__figure" data-reveal="150">
        <span class="display display--feature model__amount">{model.amount}</span>
        <span class="model__cadence">{model.cadence}</span>
      </div>

      <ol class="model__split" data-seq="110" data-seq-from="60">
        {model.split.map((part) => (
          <li class="model__part" data-reveal>
            <span class="index model__part-n tnum">{part.amount}</span>
            <h3 class="model__part-t">{part.name}</h3>
            <p class="model__part-p">{part.text}</p>
          </li>
        ))}
      </ol>

      <p class="model__scale" data-reveal="240">{model.scale}</p>
    </div>
  </section>

  <section class="on-cream proles" id="ways">
    <div class="shell proles__in">
      <div class="proles__head">
        <p class="eyebrow" data-reveal>Three ways in</p>
        {/* The rung this scene was missing. base.css: "Every scene that
             opens with an eyebrow and a display line should carry one of
             these between them." Both other sections on this route do; this
             one jumped 11px → 53px. It also carries the instruction, which
             the headline underneath cannot: the headline states what a pilot
             needs, the bridge says what the reader is being asked to do. */}
        <p class="bridge proles__bridge" data-reveal="110">Pick the one you can do.</p>
        <h2 class="display display--head proles__h" data-settle="0.62">Every pilot needs all three.</h2>
      </div>
      {/* The page's one spatial idea: three doors opening outward from a
           single point, as one gesture. Not three identical lift-fades. */}
      {/* Anchored left, not centre. A centre wipe grows outward from the
           middle, so column 01's leading characters are the LAST thing to
           arrive: "Fund it" reads as "und it" for a third of the wipe. The
           rows hang off a left rule; the mask opens off the same edge. */}
      {/* The wipe moved off the <ol> and onto a wrapper with 6px of slack.
           `clip-path: inset(0)` clips to the BORDER box even when the mask is
           fully open, so a focus ring on the first or last door — 1.5px at
           3px offset — was being sliced by the mask that revealed it. The
           columns now have somewhere to put a ring. */}
      <div class="proles__wrap" data-wipe="left" data-delay="120">
        <ol class="proles__list">
          {roles.map((r, i) => (
            <li>
              <a class="door" href={mailto(`${r.a} — a 2026 pilot`)} data-door>
                <span class="door__rule" aria-hidden="true"></span>
                <span class="index door__n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="display display--sub door__t">{r.t}</h3>
                <p class="door__p">{r.p}</p>
                {/* The action, named and sized as one. It sits one rung
                     under the door's own title and above every other line in
                     the column, so the ladder inside a door now ends on the
                     thing you press instead of starting there. */}
                <span class="door__go">
                  <svg class="arrow door__arrow" viewBox="0 0 22 10" aria-hidden="true">
                    <path d="M16 1l5 4-5 4M21 5H0"/>
                  </svg>
                  <span class="door__go-t">Email us about {r.a.toLowerCase()}</span>
                </span>
                {/* The one thing a mailto cannot do is tell you it heard.
                     The page leaves the door marked, and the two you did not
                     take step back, so returning to this tab shows which of
                     the three was chosen. */}
                <span class="door__got" aria-hidden="true"><span class="door__got-t">Opening your mail app</span></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ── The ask ──────────────────────────────────────────────────────
     ONE column. The route used to run a 7/5 split with the four pilots
     stacked in the right rail — which is what made the most concrete facts
     on the page read as marginalia. The ask now takes the whole measure and
     stops; the pilots get their own band underneath, full width. */
  .phead {
    position: relative; isolation: isolate;
    /* Was min(94svh, 52rem) with the content bottom-aligned, which left the
       top 41% of the first screen empty — a hole where a photograph used to
       be, and it read as a loading state rather than as restraint. The block
       is now sized to the type it holds. */
    /* The floor is the type; the CEILING is the fold. At 1440x900 the ask
       used to close at y=632 and the next section's eyebrow opened at
       y=805 — inside the viewport and, because the reveal observer discounts
       the bottom 12% of the screen, at opacity 0 permanently at rest. 265px
       of the first screen was a dead band holding invisible type. The air
       below now belongs to THIS section (its own bottom margin, bounded by
       the cue), and /pilots/ opens under the fold where it can arrive. */
    min-height: min(calc(100svh - 2rem), 52rem);
    /* START, not END. The block already carried the house shelf in its
       padding-top and then bottom-aligned its content inside the frame, so
       the first line of this route landed at y=196 on desktop and y=200 on a
       phone while /pilots/ and /people/ — the site's other two text
       mastheads — both opened at 165 / 122. --head-pad exists so every inner
       page starts on one shelf; a page that pays the padding and then pushes
       past it is not on it. The frame still reserves the fold, so the pilots
       band below still opens under it. */
    display: grid; align-content: start;
    padding-block: calc(var(--nav-h) + var(--head-pad)) clamp(4rem, 2rem + 4.6vw, 7.5rem);
  }
  .phead__in {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: clamp(1.2rem, 2.4vw, 2.6rem);
    justify-items: start;
  }
  /* The open right third is held by the measures of the lines themselves —
     13ch on the poster, 34ch on the bridge — not by padding on the container.
     Padding stopped the brass rule 236px short of the right margin, ending it
     at the edge of a photograph that no longer exists. The rule now runs the
     full measure and the pause is bounded by it. */
  .phead__top { display: grid; row-gap: clamp(0.9rem, 1.8vw, 1.5rem); justify-items: start; }
  /* THE LEAD-IN IS A BRIDGE, AT THE BRIDGE'S RUNG. It used to be dropped to
     --step-lede to keep it off the address's size — and that was true when
     the address sat inside a shrink-to-fit plate at 26.56px. The address is
     sized to the measure now and renders at 40px, so the collision the drop
     was avoiding no longer exists, and the drop had made this the only
     .bridge on the site not set at --step-bridge: the one class whose job is
     to hand a reader from an 11px label up to a display line was rendering
     at three sizes across six routes. Back on its rung. The wider measure
     stays — it is what keeps the clause to two quiet lines. The screen still
     climbs 11.7 -> 26.6 -> 86 -> 40, with nothing on the action's size. */
  .phead__bridge {
    max-width: 52ch;
    margin-bottom: clamp(1.1rem, 2.6vw, 2.9rem);
  }
  .phead__lead { display: flex; flex-direction: column; width: 100%; }

  /* --step-poster: the poster line of an inner page, matching /institute/.
     It can carry the rung now because the page has a body under it — four
     names at --step-head — instead of a sidebar it had to outshout. */
  .phead__h {
    line-height: 0.96; letter-spacing: -0.024em;
    max-width: 13ch;
  }
  .phead__h :global(.line) { padding-bottom: 0.08em; margin-bottom: -0.08em; }
  /* Motion as rank: the statement rises long and slow, everything under the
     rule arrives fast and tight behind it. */
  .phead__h :global(.line > span) { transition-duration: 1400ms; }
  .ask [data-reveal] { --reveal-y: 8px; transition-duration: 460ms, 560ms; }

  /* THE ONE ACTION, AND IT IS SET LIKE ONE. Every size on this screen is
     measured against 40px now: the poster line at 86, the lead-in and the
     cue at 18.7, the instruction at 15.8, the labels at 11.7. Nothing else
     on the route is set at 40 and nothing on this screen is within a rung
     of it, so there is exactly one place for the eye to land second. */
  /* The rule runs the full measure and the two halves of the ask hang off
     its ends — address at the left, instruction at the right. Without it the
     right two-fifths of the first screen was open navy running out into the
     viewport edge, which reads as absence rather than as a pause. A held
     pause has to be bounded on both sides; this is the second side. */
  /* Address and instruction stack rather than sharing a row: the address is
     the action and nothing sits level with it. The second column holds the
     cue only, and it is aligned to the BOTTOM of the block — level with the
     instruction, two rungs under the address. */
  .ask {
    /* THE ACTION'S RUNG. The ladder holds --step-sub (33.8px at 1440), which
       is under the step this needs, and --step-head (53.1px), which is the
       size of the four pilot names below and would make the address a second
       headline. This is the one interpolation on the site and it exists
       because this page has exactly one thing to press: 40px at 1280 and up,
       0.47 of the poster line, 2.1x the supporting register, and no other
       element on the route is set at it. */
    --ask-step: clamp(0.88rem, 0.42rem + 2.6vw, 2.5rem);
    /* The beat before the ask. 63px of navy between the line and the rule
       read as a line-gap, not as a pause; the pause is the composition on a
       closing screen and it is now bounded by the rule under it. */
    padding-top: clamp(2.6rem, 1.4rem + 5.4vw, 7.5rem);
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    column-gap: var(--gutter);
    /* No row-gap: the brass rule is the action row's TOP EDGE, not a thing
       floating 60px above it. The air the ask needs is inside the row, where
       a hover wash and a keyboard ring can both see it; the supporting
       register below carries its own margin. */
    row-gap: 0;
  }
  .ask__rule {
    grid-column: 1 / -1; grid-row: 1;
    display: block; height: 1px; align-self: start;
    background: color-mix(in srgb, var(--brass) 50%, transparent);
    width: 100%; transform-origin: left;
  }
  /* THE ROW, AT THE MEASURE. Horizontal padding is the one thing this
     element may not have: it is what pushed the address 32.6px inboard of the
     rail every other element on the route stands on. So the row takes the
     full measure and pads only in the block direction — the identical
     construction to `.pindex__a` below, which pads block-only for the same
     reason ("that box's left edge is the same left edge the eyebrow, the
     bridge and the 86px line all stand on. Nothing on this page may break
     it."). The edges are still there and they are still pointable — they are
     the brass hairline above and its pair below, both at 1337px, both ending
     where the rule, the pilot rules and the door columns end. The hover wash
     is the ground the old plate held, and it now lands rail to rail. */
  .ask__mail {
    grid-column: 1 / -1; grid-row: 2;
    display: flex; align-items: center; justify-content: space-between;
    gap: clamp(1.4rem, 4vw, 4rem);
    width: 100%;
    padding-block: clamp(1.5rem, 0.7rem + 2.6vw, 3rem);
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 50%, transparent);
    transition: background-color var(--dur-hover) var(--ease-out);
  }
  /* Same trap as `.why__note` on the homepage: the line above resets
     transition-property to `background-color`, so `.ask [data-reveal]`'s
     `460ms, 560ms` could not re-time a reveal that no longer existed —
     it re-timed the HOVER instead, and the page's one action arrived as a
     hard cut while the cue and the instruction under it lifted. The reveal
     is restored at the ask's own tempo; the hover goes back on register. */
  /* `.ask [data-reveal]` above is (0,2,0) and so is `.ask__mail[data-reveal]`;
     the extra class settles it rather than leaving two equal rules to be
     ordered by whatever the bundler emits. */
  .ask .ask__mail[data-reveal] {
    transition:
      opacity 460ms var(--ease-out) var(--reveal-delay, 0ms),
      transform 560ms var(--ease-out) var(--reveal-delay, 0ms),
      background-color var(--dur-hover) var(--ease-out);
  }
  .ask__mail:hover,
  .ask__mail:focus-visible {
    background-color: color-mix(in srgb, var(--brass) 9%, transparent);
  }
  .ask__arrow { width: clamp(24px, 2.6vw, 34px); color: var(--brass); flex: none; }
  .ask__mail-t {
    font-family: var(--sans); font-weight: 400;
    font-size: var(--ask-step);
    letter-spacing: -0.014em; line-height: 1.12;
    color: var(--fg); min-width: 0;
    transition: color var(--dur-hover) var(--ease-out);
    overflow-wrap: anywhere;
  }
  .ask__mail:hover .ask__mail-t,
  .ask__mail:focus-visible .ask__mail-t { color: var(--brass); }
  .ask__mail:hover .ask__arrow,
  .ask__mail:focus-visible .ask__arrow { transform: translateX(9px); }
  /* --fg-meta is the micro register — "credits, counts, field names, footer.
     Never a whole sentence." (tokens.css). This is a whole sentence, and it
     is the sentence that makes a stranger send the email: somebody reads it,
     somebody replies. It sits at the supporting rung where it belongs. */
  .ask__sub {
    grid-column: 1; grid-row: 3; justify-self: start; align-self: baseline;
    text-align: left;
    color: var(--fg-mute); font-size: var(--step-body); max-width: 34ch;
    margin-top: clamp(1rem, 2.2vw, 2.1rem);
  }
  .ask__cue {
    grid-column: 2; grid-row: 3;
    justify-self: end; align-self: baseline;
    margin-top: clamp(1rem, 2.2vw, 2.1rem);
  }

  /* ── The four, at full width ─────────────────────────────────────
     A band set into the page, and the only place on this route where the
     ground changes before the cream. Four rows, one rule each, the name at
     the section-headline rung: 53px, not 19px in a rail. */
  /* On the page's own ground now, not in a panel: the route's tonal event is
     the photograph above, and a band here would have made this page run the
     same three-act ground sequence as /institute/ in the same order. */
  .pfour {
    border-bottom: 1px solid var(--rule);
    padding-block: clamp(3rem, 1.6rem + 3.6vw, 5.5rem) clamp(3.5rem, 1.8rem + 4vw, 6rem);
  }
  .pfour__in { display: grid; gap: clamp(2rem, 3.4vw, 3.2rem); }
  .pfour__head { display: grid; }
  .pfour__top { display: grid; gap: clamp(0.8rem, 1.6vw, 1.3rem); justify-items: start; }
  /* Same rung as the lead-in on the ask screen above it, and for the same
     reason. At 1440x1000 both are on one screen, and a section head sitting
     one scroll below the ask may not be set larger than the ask's own
     lead-in — the route would then climb backwards. --step-bridge survives
     on this page exactly once, on the cream act, where the page turns over. */
  /* .lede, not .bridge. This is a qualifier under an eyebrow, not the rung
     that hands a reader up to a display line — and set as a .bridge it had
     to be dropped to --step-lede by hand, which made .bridge the one closed
     class on the site rendering at three sizes. .lede IS that rung, already
     declared, already at --fg-mute. */
  .pfour__bridge { max-width: 46ch; }

  /* ONE SET OF COLUMN TRACKS FOR THE WHOLE INDEX — NOT ONE PER ROW.
     The tracks used to live on `.pindex__a`, so every row sized its own
     ordinal column from its own two digits. `.index` asks for tabular
     figures and the Google build of Libre Franklin ships no `tnum` table,
     so that request is a no-op and the ordinals measure 20.39 / 22.16 /
     22.55 / 22.77px. Every column to the right of them inherited the
     difference: the four 53px titles started at 109.19 / 110.95 / 111.34 /
     111.56, the partner names at 672.38 → 673.66, the glosses at 972.69 →
     973.42. Four ragged left edges on the one stack a stranger looks at
     longest, on a page where everything else holds 51.36 / 1388.64 exactly.
     The tracks are on the `ol` now and the rows are subgrids of it, so the
     ordinal track is measured ONCE — by the widest ordinal in the index —
     and all four rows resolve to the same five columns whatever the digits
     do. `.pindex__i` also carries a min-width in em of its own step, which
     pins that shared track to a figure-independent width and is what keeps
     the columns flush if subgrid is unavailable. */
  .pindex {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns:
      max-content minmax(0, 6fr) minmax(0, 3fr) minmax(0, 4fr) max-content;
    column-gap: clamp(1rem, 2.6vw, 2.6rem);
  }
  .pindex__r {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    border-top: 1px solid var(--rule);
  }
  .pindex__r:last-child { border-bottom: 1px solid var(--rule); }
  .pindex__r[data-reveal] { --reveal-y: 8px; transition-duration: 440ms, 560ms; }

  /* Name left, principal and one line right, arrow on the far edge. The row
     is the object; everything in it is baseline-aligned to the name. */
  /* THE ROW IS THE TARGET, SO THE ROW LIGHTS. A 1338px-wide link whose only
     hover state was the colour of the title in its left third gave a pointer
     sitting over the tagline — most of the row's width — no feedback at all,
     while the cursor was over a live link. The wash is a transient state, not
     a ground: 5% cream, one step off the page, and it is exactly the width the
     hairlines above and below it already declare. It bled 16px wider on each
     side first, to hold the type off its edge, and that put the lit box out of
     register with the two rules that bound it — the more expensive mistake,
     because that box's left edge is the same left edge the eyebrow, the bridge
     and the 86px line all stand on. Nothing on this page may break it. */
  .pindex__a {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding-block: clamp(1.1rem, 2.2vw, 2rem);
    transition: background-color var(--dur-hover) var(--ease-out);
  }
  .pindex__a:hover,
  .pindex__a:focus-visible { background-color: color-mix(in srgb, var(--cream) 5%, transparent); }
  /* 1.74em of the numeral's own step is the widest two-figure ordinal this
     index can hold, trailing letterspace included. Declaring it makes the
     shared track's width a property of the type, not of which digits
     happen to be in the list. */
  .pindex__i {
    padding-top: 0.35em;
    min-width: 1.74em;
    font-variant-numeric: tabular-nums;
  }
  /* --optic is set per row in the frontmatter: 0 for a flat stem, a hair of
     negative lead for a round cap so the four titles share a VISUAL left
     edge and not merely a metric one. */
  .pindex__n {
    color: var(--fg); line-height: 1.02;
    margin-left: calc(var(--optic, 0em) * -1);
    transition: color var(--dur-hover) var(--ease-out);
  }
  /* Inslee and Cardona are the most interesting words on the route. They no
     longer sit at 11px and 54%. */
  .pindex__f {
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 0.35em;
  }
  .pindex__who {
    font-size: var(--step-lede); line-height: 1.3; color: var(--fg);
  }
  /* Not a second brightness of .label: the house dim register, unchanged. */
  .pindex__q { color: var(--fg-meta); }
  .pindex__g {
    font-size: var(--step-body); line-height: 1.4; color: var(--fg-mute);
    max-width: 30ch;
  }
  .pindex__arrow { width: clamp(22px, 2vw, 28px); color: var(--brass); align-self: center; opacity: 0.55; transition: transform 460ms var(--ease-out), opacity var(--dur-hover) var(--ease-out); }
  /* A KEYBOARD GETS THE SAME ROW A POINTER GETS. The ring says "you are
     here"; it does not say "this row is the one that is live". Focus was
     drawing the ring and nothing else, so the two ways of reaching the same
     link resolved to two different-looking states. */
  .pindex__a:hover .pindex__n,
  .pindex__a:focus-visible .pindex__n { color: var(--brass); }
  .pindex__a:hover .pindex__arrow,
  .pindex__a:focus-visible .pindex__arrow { transform: translateX(9px); opacity: 1; }

  /* ── Three ways in — the page turned over ──
     The route's tonal event. It was a panel six points off the page ground,
     which is not a change of ground; the ask above it is now type on navy
     floor to bar, so the one 20+ L* step on this page happens here. */
  /*
     The numeral indexes; it does not outrank. It is a tracked cap sitting on
     the column rule, and the verb underneath it carries the weight. */
  /* Top padding clears the nav bar AND the tail of its scrim, so this
     section's own eyebrow can never be read through the bar at any scroll
     position. The bar inverts over cream, but the clearance is not left to
     where the page happens to stop. */
  .proles {
    padding-block: calc(var(--nav-h) + 3.5rem + clamp(2rem, 1.2rem + 2.4vw, 3.5rem)) clamp(4rem, 2rem + 4.4vw, 6.5rem);
  }
  .proles__in { display: grid; gap: clamp(2.2rem, 3.8vw, 3.6rem); }
  .proles__head { display: grid; gap: clamp(0.9rem, 1.8vw, 1.5rem); }
  /* One rung under the H1: three columns at --step-sub under a --step-head
     line, which answers to the title rather than competing with it. */
  .proles__bridge { max-width: 26ch; }
  .proles__h { max-width: 14ch; line-height: 1.02; }
  /* 6px of slack inside the mask so a focus ring on an edge column is not
     clipped by the wipe that revealed it; the negative margin gives it all
     back, so the columns sit exactly where they sat. */
  /* The BOTTOM slack is a different amount and a different reason. The
     receipt is position:absolute at top:100% — outside the door's own box
     and therefore outside this wrap, which data-wipe clips to. So the one
     element in the scene that reports "your choice registered" rendered at
     y 708-726 inside a wrap clipped at 703 and was invisible at every
     desktop width: present in the DOM, opacity 1, painted nowhere. It
     showed only under prefers-reduced-motion, where clip-path resolves to
     none — the single mode nobody tests. Give the mask enough room below
     to contain it, and hand the space straight back. */
  .proles__wrap { padding: 6px 6px 3.4rem; margin: -6px -6px calc(-3.4rem); }
  .proles__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.75rem, 3.4vw, 3.4rem);
  }
  .proles__list li { display: grid; }

  /* ── A door ───────────────────────────────────────────────────────
     The whole column is the target: rule, numeral, verb, line and the verb
     under it. Every state is drawn — none of it is left to the browser.

       rest     hairline rule, ink verb, the arrow already there
       hover    the rule fills brass off its left edge, the verb takes the
                accent, the arrow travels
       focus    the brass ring from base.css, around the whole column
       press    the house dip

     The rule fills rather than fades because a rule is territory, not a
     sentence — same reason the section arrives on a wipe and the words in
     the ask arrive on a lift. */
  .door {
    position: relative;
    display: flex; flex-direction: column; align-items: flex-start;
    height: 100%;
  }
  .door__rule {
    position: relative; overflow: hidden;
    display: block; height: 1px; width: 100%;
    background: var(--rule);
    margin-bottom: clamp(0.75rem, 1.4vw, 1.15rem);
  }
  .door__rule::after {
    content: ''; position: absolute; inset: 0;
    background: var(--brass);
    transform: scaleX(0); transform-origin: left;
    transition: transform 560ms var(--ease-out);
  }
  .door:hover .door__rule::after,
  .door:focus-visible .door__rule::after { transform: scaleX(1); }

  .door__n { margin-bottom: clamp(0.15rem, 0.4vw, 0.35rem); }
  .door__t {
    font-weight: 320; line-height: 1.08;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .door:hover .door__t,
  .door:focus-visible .door__t { color: var(--brass); }
  .door__p {
    color: var(--fg-mute); font-size: var(--step-body); max-width: 28ch;
    margin-top: clamp(0.55rem, 1vw, 0.9rem);
  }
  /* margin-top:auto pins the three verbs to one baseline across columns of
     unequal text length — the alternative is three action lines at three
     heights, which is what makes a set of choices look assembled rather than
     designed. */
  /* THE WHOLE ACTION LINE TRAVELS, NOT THE ARROW. Everywhere else on the site
     the arrow has open page to its right and slides into it. Here the word
     sits on that side, so an arrow moving 9px closed an 11px gap and drove
     its head into the E of EMAIL. The line advances as one object instead —
     which also puts it on the same vector as the rule filling above it, so
     hover is one gesture left-to-right rather than two unrelated ones. */
  .door__go {
    display: inline-flex; align-items: center; gap: 0.7rem;
    margin-top: auto; padding-top: clamp(1.1rem, 2vw, 1.7rem);
    transition: transform 460ms var(--ease-out);
  }
  .door:hover .door__go,
  .door:focus-visible .door__go { transform: translateX(8px); }
  .door__arrow { width: clamp(22px, 1.8vw, 26px); color: var(--brass); }
  /* NOT `.label`. That register is 11.66px / w500 / 1.4 tracking — credits
     and field names — and it was carrying the only act on the page. The ask
     is set in the sans at the lede rung: 19px at 1440, one rung under the
     33.8px door title and above the 15.8px sentence and the 13.1px ordinal,
     so the column reads title -> action -> sentence -> ordinal. */
  .door__go-t {
    font-family: var(--sans); font-size: var(--step-lede); font-weight: 400;
    line-height: 1.2; letter-spacing: -0.008em; color: var(--fg);
    transition: color var(--dur-hover) var(--ease-out);
  }

  /* THE SHARED ACTION LINE, 901-1129px. margin-top:auto aligns the three
     action BOXES at the bottom, which is exact while every label is one
     line. Door 03's label is the longest ("...somewhere to run it") and
     wraps to two lines in this band: its box grows upward by 21px and its
     arrow — vertically centred — drops to the middle of two lines, so the
     three arrows and the three first lines sit at three heights. That is
     precisely the failure this layout's own comment says the shared
     baseline exists to prevent.
     Reserve two lines for all three in the band, so the set stays one row
     whichever label wraps. Outside the band every label is one line and
     the reservation costs nothing. */
  @media (min-width: 901px) and (max-width: 1129px) {
    /* line-height is 1.2em, so two lines is 2.4em. */
    .door__go-t { display: block; min-height: 2.4em; }
  }
  .door:hover .door__go-t,
  .door:focus-visible .door__go-t { color: var(--brass); }

  /* The receipt. Zero-height at rest so it costs the three columns nothing
     and cannot be read or focused; it opens only on the door that was
     actually pressed. */
  .door__got {
    /* Out of flow: a receipt that changed the height of one column would
       shove the other two doors' action lines off the shared baseline the
       whole set is built on. */
    position: absolute; top: 100%; left: 0;
    margin-top: 0.7rem;
    /* Opens on grid-template-rows, not max-height. max-height is a layout
       property: animating it reflows on every frame. Out of flow on
       desktop that only cost this box, but the stacked layout below sets
       position: static — so in the one-column case it was reflowing every
       door under it, 320ms at a time, on the lowest-powered devices, on
       the page whose whole job is to be acted on. 0fr -> 1fr animates the
       track instead and needs no magic number standing in for the content
       height (the old 3em was one). */
    display: grid; grid-template-rows: 0fr;
    opacity: 0;
    font-family: var(--sans); font-size: var(--step-micro);
    letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500;
    color: var(--brass);
    transition: grid-template-rows 320ms var(--ease-out), opacity var(--dur-hover) var(--ease-out);
  }
  /* The clip has to live on the grid ITEM; a track animating to 0fr does
     not hide overflow by itself. min-height:0 stops the item claiming its
     min-content height and refusing to close. */
  .door__got-t { overflow: hidden; min-height: 0; }
  .proles__list[data-chosen] .door { opacity: 0.45; transition: opacity var(--dur-hover) var(--ease-out); }
  .proles__list[data-chosen] .door[data-chosen] { opacity: 1; }
  .door[data-chosen] .door__rule::after { transform: scaleX(1); }
  .door[data-chosen] .door__t,
  .door[data-chosen] .door__go-t { color: var(--brass); }
  .door[data-chosen] .door__got { grid-template-rows: 1fr; opacity: 1; }


  @media (max-width: 900px) {
    .proles__list { grid-template-columns: 1fr; gap: clamp(1.5rem, 5vw, 2rem); }
    /* Out of flow is a rule about COLUMNS: it exists so a receipt opening
       under one door cannot shove its neighbours' action lines off the
       shared baseline. In a single-column stack there are no neighbours to
       protect, and absolute positioning instead dropped the receipt onto
       the next door's opening hairline (receipt bottom 682 vs door top 678
       at 390) so the rule visibly restarted to the right of the words. In
       the stack it takes its own space. */
    .door__got { position: static; margin-top: 0.55rem; }
    /* Stacked, `margin-top:auto` has nothing to push against and the action
       line would sit tight under its sentence. Space carries it instead. */
    .door__go { padding-top: clamp(0.9rem, 3.4vw, 1.2rem); }
  }

  @media (max-width: 860px) {
    .phead {
      min-height: min(60svh, 32rem);
      padding-block: calc(var(--nav-h) + var(--head-pad)) clamp(2.5rem, 9vw, 3.5rem);
    }
    .phead__in { row-gap: clamp(1.5rem, 6vw, 2.2rem); }
    .phead__h { max-width: 14ch; }
    /* At 390 the measure carries the address at ~21px before the string has
       to break, so the lead-in drops the last rung with it. The action stays
       the largest thing on the screen that is not the title. */
    .phead__bridge {
      max-width: 38ch;
      margin-bottom: clamp(0.4rem, 2.4vw, 1rem);
    }
    .ask {
      /* The address is sized to the measure now, not to the room left inside
         a plate — dropping the horizontal padding gave the string back 27px
         at 390, so it takes a rung with it and still sets on one line. */
      --ask-step: clamp(0.9rem, 5.3vw, 1.5rem);
      padding-top: clamp(2rem, 8vw, 3.2rem);
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
    }
    /* Same construction as 1440, one column: the address's sidebearing on
       20.9 with the eyebrow, the title and the caption, the arrow on 369.1
       with the rule above it. There is no inline padding at any width — that
       padding is the whole defect this row had. */
    .ask__mail {
      padding-block: clamp(1.1rem, 5vw, 1.9rem);
      gap: clamp(0.5rem, 2.2vw, 1.1rem);
    }
    .ask__arrow { width: 20px; }
    /* The cue answers a question a phone does not ask: at 390px the next
       section is already on screen under the ask, so the fold carries its own
       continuation. Removed, not hidden off-screen — it takes its tab stop
       with it rather than leaving a focus target nobody can see. */
    .ask__cue { display: none; }

    /* Four columns collapse to two: the numeral keeps its gutter, everything
       else stacks under the name. The arrow goes — a row that fills the
       column IS the affordance at this width. */
    .pfour { padding-block: clamp(2.75rem, 10vw, 4rem) clamp(3.25rem, 12vw, 4.5rem); }
    /* The lead-in above follows the ask's down to --step-body here, for the
       same reason it followed it down at 1440: this line may not outrank the
       one on the screen the route exists for. */
    .pfour__bridge { max-width: 40ch; }
    /* Two columns now, and they are still declared once, on the `ol`. */
    .pindex {
      grid-template-columns: max-content minmax(0, 1fr);
      column-gap: clamp(0.8rem, 4vw, 1.2rem);
    }
    .pindex__a {
      row-gap: 0.3rem;
      align-items: start;
      padding-block: clamp(1rem, 4.4vw, 1.5rem);
    }
    .pindex__i { grid-row: 1; padding-top: 0.3em; }
    .pindex__n { grid-column: 2; }
    .pindex__f, .pindex__g { grid-column: 2; }
    /* Stacked, the qualifier costs nothing at 1440 because the 53px title
       sets the row height. Here the row has no such floor, so it goes
       inline on the middot — the same shape /pilots/ uses in its rail. */
    .pindex__f { flex-direction: row; align-items: baseline; gap: 0; }
    .pindex__q::before { content: '\00b7'; margin: 0 0.85ch; }
    .pindex__g { max-width: 34ch; }
    .pindex__arrow { display: none; }
    /* Below ~700px the feature rung stops reading as a break; space carries it. */
    .proles__h { max-width: 12ch; }
  }

  /* Under ~370px the string is the constraint, not the composition: the gap
     to the arrow closes so the address never breaks in two. The rails are
     not negotiable at any width, so nothing here touches the inline box. */
  @media (max-width: 370px) {
    .ask__mail { gap: 0.5rem; }
    .ask__arrow { width: 18px; }
  }

  /* Without subgrid the rows cannot read the `ol`'s tracks, so they get the
     same five (or two) columns declared on themselves. The ordinal track is
     the min-width above rather than `max-content`, which is what keeps all
     four rows flush even though the row can no longer see its siblings. */
  @supports not (grid-template-columns: subgrid) {
    .pindex__a {
      grid-template-columns:
        max-content minmax(0, 6fr) minmax(0, 3fr) minmax(0, 4fr) max-content;
      column-gap: clamp(1rem, 2.6vw, 2.6rem);
    }
    @media (max-width: 860px) {
      .pindex__a {
        grid-template-columns: max-content minmax(0, 1fr);
        column-gap: clamp(0.8rem, 4vw, 1.2rem);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ask__mail, .ask__mail-t, .ask__arrow,
    .pindex__a, .pindex__n, .pindex__arrow,
    .door__rule::after, .door__t, .door__go, .door__go-t, .door__got,
    .proles__list[data-chosen] .door {
      transition-duration: 1ms;
    }
    /* Every hover state still resolves — it just resolves at once. The rule
       fills, it does not travel; the arrow lights, it does not slide. */
    .door:hover .door__go, .door:focus-visible .door__go,
    .ask__mail:hover .ask__arrow,
    .pindex__a:hover .pindex__arrow,
    .pindex__a:focus-visible .pindex__arrow { transform: none; }
  }

  /* ── The model ──────────────────────────────────────────────────── */
  .model { padding-block: clamp(3.5rem, 7vw, 6.5rem); border-top: 1px solid var(--rule); }
  .model__in { display: grid; gap: clamp(1.75rem, 3.5vw, 3rem); }
  .model__head { display: grid; gap: clamp(0.9rem, 1.8vw, 1.4rem); }
  .model__eyebrow { font: inherit; margin: 0; }
  .model__lead { max-width: 46ch; }
  .model__figure { display: flex; align-items: baseline; gap: 0.6ch; }
  .model__amount { line-height: 0.92; letter-spacing: -0.028em; }
  .model__cadence {
    font-size: var(--step-lede, 1.19rem);
    color: var(--fg-mute);
  }
  .model__split {
    list-style: none; margin: 0; padding: clamp(1.25rem, 2.4vw, 1.9rem) 0 0;
    border-top: 1px solid var(--rule);
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .model__part { display: grid; gap: 0.55rem; align-content: start; }
  .model__part-n { font-size: var(--step-lede, 1.19rem); letter-spacing: 0.02em; }
  .model__part-t {
    font-family: var(--sans); font-size: var(--step-body, 1rem);
    font-weight: 500; letter-spacing: -0.004em; margin: 0;
  }
  .model__part-p { color: var(--fg-mute); font-size: var(--step-body, 1rem); max-width: 34ch; }
  .model__scale { color: var(--fg-meta); font-size: var(--step-body, 1rem); max-width: 52ch; }
  @media (max-width: 720px) { .model__split { grid-template-columns: 1fr; } }
</style>

<script>
  /* A mailto leaves no trace in the page: the tab does not navigate, so a
     reader who comes back has no way to see which door they took. This is
     the only feedback it can honestly give — the door that was pressed
     stays lit, the other two step back. No storage, no network, nothing
     claimed beyond "the mail app was asked to open". */
  const list = document.querySelector('.proles__list');
  list?.addEventListener('click', (e) => {
    const door = (e.target instanceof Element) && e.target.closest('[data-door]');
    if (!door) return;
    for (const d of list.querySelectorAll('[data-door]')) d.removeAttribute('data-chosen');
    door.setAttribute('data-chosen', '');
    list.setAttribute('data-chosen', '');
  });
</script>
