---
import Base from '../layouts/Base.astro';
import { site, pilots } from '../data/site.js';

const roles = [
  { t: 'Fund it', p: 'Underwrite one pilot, end to end.' },
  { t: 'Build it', p: 'Bring the model, the product, or the team.' },
  { t: 'Run it', p: 'A health system, district, university, or agency.' },
];
---
<Base title="Partner" description="Partner on a 2026 pilot with the Lion Forum Institute.">
  <!-- ── The ask, once ────────────────────────────────────────────────
       This page opens on the address and never shows it again. One rule
       carries the whole ask: the email sits on it, the open pilots hang
       from it. Display → email → index, in that order, with nothing
       floating free in the middle of the row. -->
  <section class="phead">
    <div class="shell phead__in">
      <p class="label" data-reveal>Work with us</p>

      <h1 class="display phead__h lines">Partner on a pilot.</h1>

      <div class="ask">
        <a class="ask__mail" href={`mailto:${site.email}`} data-reveal="360">
          <span class="ask__mail-t">{site.email}</span>
          <span class="ask__mail-arrow" aria-hidden="true">
            <span class="ask__mail-line"></span>
            <svg viewBox="0 0 11 12"><path d="M4 1.5 9.5 6 4 10.5" stroke="currentColor" stroke-width="1" fill="none"/></svg>
          </span>
        </a>

        <span class="label ask__l" data-reveal="440">Open pilots · 2026</span>

        <span class="ask__rule" data-reveal="400" aria-hidden="true"></span>

        <p class="ask__sub" data-reveal="500">Name the pilot and the role. A person answers.</p>

        <ul class="ask__index">
          {pilots.map((p, i) => (
            <li data-reveal={String(500 + i * 60)}>
              <span class="index">{p.index}</span><span class="ask__index-n">{p.title}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- The one hard cut in the scroll: the ground changes and the three
       doors arrive. Numeral is the index, the verb is the content. -->
  <section class="on-cream proles">
    <div class="shell proles__in">
      <p class="label" data-reveal>Three ways in</p>
      <ol class="proles__list">
        {roles.map((r, i) => (
          <li data-reveal={String(80 + i * 90)}>
            <span class="proles__rule" aria-hidden="true"></span>
            <span class="index proles__n">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="proles__t">{r.t}</h2>
            <p>{r.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

</Base>

<style>
  .phead {
    padding-block: calc(var(--nav-h) + var(--head-pad)) clamp(3.5rem, 2rem + 3.4vw, 5.5rem);
  }
  .phead__in { display: grid; }
  .phead__in > .label { margin-bottom: clamp(0.7rem, 1.5vw, 1.5rem); }

  /* One hero size for the whole site, sitting between --step-xl (footer close)
     and --step-hero (homepage). Local: the token scale has no step here. */
  .phead__h {
    font-size: clamp(3.1rem, 1rem + 6.3vw, 7rem);
    line-height: 0.94; letter-spacing: -0.028em;
    max-width: 13ch;
  }
  .phead__h :global(.line) { padding-bottom: 0.08em; margin-bottom: -0.08em; }
  /* Motion as rank: the statement rises long and slow, everything under the
     rule arrives fast and tight behind it. Local override of the base
     durations — no change to the engine. */
  .phead__h :global(.line > span) { transition-duration: 1400ms; }
  .ask [data-reveal] { --reveal-y: 8px; transition-duration: 460ms, 560ms; }

  /* ── The ask ──
     Two rows split by one hairline. Above it: the address and the label
     that names what hangs below. Below it: the gloss and the open pilots. */
  .ask {
    margin-top: clamp(2.4rem, 1.4rem + 3.2vw, 4.4rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
  }
  .ask__mail {
    grid-column: 1; grid-row: 1;
    display: inline-flex; align-items: center;
    gap: clamp(0.9rem, 2vw, 1.6rem);
    padding-bottom: clamp(0.45rem, 0.9vw, 0.75rem);
    max-width: 100%;
  }
  .ask__mail-t {
    font-family: var(--sans); font-weight: 350;
    font-size: clamp(1.25rem, 0.68rem + 2.45vw, 3.1rem);
    letter-spacing: -0.018em; line-height: 1.06;
    color: var(--cream);
    transition: color 380ms var(--ease-out);
    overflow-wrap: anywhere;
  }
  .ask__mail-arrow {
    display: flex; align-items: center;
    width: clamp(22px, 3.4vw, 54px); height: 12px; color: var(--brass); flex: none;
    transition: transform 560ms var(--ease-out);
  }
  .ask__mail-line { flex: 1 1 auto; height: 1px; background: currentColor; }
  .ask__mail svg { width: 11px; height: 12px; margin-left: -1px; flex: none; }
  .ask__mail:hover .ask__mail-t { color: var(--brass); }
  .ask__mail:hover .ask__mail-arrow { transform: translateX(9px); }

  .ask__l {
    grid-column: 2; grid-row: 1;
    justify-self: end; align-self: end;
    color: var(--fg-faint);
    padding-bottom: clamp(0.7rem, 1.3vw, 1.05rem);
    white-space: nowrap;
  }

  /* The one rule on the page. Everything in the ask is measured from it. */
  .ask__rule {
    grid-column: 1 / -1; grid-row: 2;
    display: block; height: 1px;
    background: color-mix(in srgb, var(--brass) 50%, transparent);
    transform-origin: left;
  }

  .ask__sub {
    grid-column: 1; grid-row: 3; align-self: start;
    margin-top: clamp(0.95rem, 1.7vw, 1.45rem);
    color: var(--fg-mute); font-size: var(--step-xs); max-width: 44ch;
  }

  /* Hung from the rule, not floating opposite the address: one rank down in
     size, aligned to the same right edge as the label above it. */
  .ask__index {
    grid-column: 2; grid-row: 3; align-self: start;
    list-style: none; margin: clamp(0.85rem, 1.5vw, 1.25rem) 0 0; padding: 0;
    display: grid; grid-template-columns: max-content max-content;
    justify-content: end;
    column-gap: clamp(0.7rem, 1.2vw, 1rem);
    row-gap: clamp(0.18rem, 0.5vw, 0.4rem);
  }
  .ask__index li { display: contents; }
  .ask__index .index { align-self: baseline; }
  .ask__index-n {
    font-size: clamp(1rem, 0.9rem + 0.42vw, 1.25rem);
    line-height: 1.3; letter-spacing: -0.004em;
    color: var(--fg-mute);
  }

  /* ── Three ways in — the cream field ──
     The numeral indexes; it does not outrank. It is a tracked cap sitting on
     the column rule, and the verb underneath it carries the weight. */
  .proles {
    padding-block: clamp(3rem, 1.6rem + 3.6vw, 5.5rem) clamp(4rem, 2rem + 4.4vw, 6.5rem);
  }
  .proles__in { display: grid; gap: clamp(2rem, 3.4vw, 3.2rem); }
  .proles__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.75rem, 3.4vw, 3.4rem);
  }
  .proles__list li {
    display: grid; gap: clamp(0.55rem, 1vw, 0.9rem);
    align-content: start;
  }
  /* Shared .index primitive; only the gap under it is local. */
  .proles__n { margin-bottom: clamp(0.15rem, 0.4vw, 0.35rem); }
  /* The rule caps the column; the numeral sits on it and the verb owns the
     rest. The index never outranks the thing it indexes. */
  .proles__rule { display: block; height: 1px; background: var(--rule); margin-bottom: clamp(0.75rem, 1.4vw, 1.15rem); }
  .proles__t {
    font-family: var(--serif); font-weight: 320;
    font-size: clamp(1.5rem, 1.1rem + 1.35vw, 2.15rem);
    line-height: 1.08; letter-spacing: -0.015em;
  }
  .proles__list p { color: var(--fg-mute); font-size: var(--step-xs); max-width: 28ch; }
  .proles__list [data-reveal] { --reveal-y: 8px; transition-duration: 460ms, 620ms; }

  @media (max-width: 900px) {
    .proles__list { grid-template-columns: 1fr; gap: clamp(1.5rem, 5vw, 2rem); }
  }

  @media (max-width: 860px) {
    .phead { padding-block: calc(var(--nav-h) + var(--head-pad)) clamp(2.5rem, 9vw, 3.5rem); }
    .phead__h { max-width: 100%; }

    .ask { grid-template-columns: minmax(0, 1fr); }
    /* The address must never break across lines — it is the whole ask. */
    .ask__mail { grid-column: 1; grid-row: 1; gap: 0.65rem; }
    .ask__mail-arrow { width: 18px; }
    .ask__l {
      grid-column: 1; grid-row: 4;
      justify-self: start; align-self: start;
      padding-bottom: 0; margin-top: clamp(2.2rem, 8vw, 2.8rem);
    }
    .ask__rule { grid-row: 2; }
    .ask__sub { grid-column: 1; grid-row: 3; }
    .ask__index {
      grid-column: 1; grid-row: 5;
      justify-content: start; margin-top: clamp(0.7rem, 3vw, 1rem);
      row-gap: clamp(0.25rem, 1.2vw, 0.45rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ask__mail-t, .ask__mail-arrow { transition-duration: 1ms; }
  }
</style>
