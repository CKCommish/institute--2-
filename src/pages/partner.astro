---
import Base from '../layouts/Base.astro';
import { site, pilots } from '../data/site.js';

const roles = [
  { t: 'Fund it', p: 'Underwrite one pilot, end to end.' },
  { t: 'Build it', p: 'Bring the model, the product, or the team.' },
  { t: 'Run it', p: 'A health system, district, university, or agency.' },
];
---
<Base title="Partner" description="Partner on a 2026 pilot with the Lion Forum Institute.">
  <!-- ── The ask, once ────────────────────────────────────────────────
       ONE focal point. The page used to print the ask twice: a display line
       and, a row below it, the address at near-display size — two objects of
       near-equal optical weight and no single action. The line is now the
       one big thing; the address is the action under it, a rung down, on the
       rule. Eyebrow → bridge → poster, so the climb has a step in it. -->
  <section class="phead">
    <div class="shell phead__in">
      <p class="eyebrow" data-reveal>Work with us</p>
      <p class="bridge phead__bridge" data-reveal="120">
        Every pilot still needs money, a technology, or somewhere real to
        run it. Most need two of the three.
      </p>

      <div class="phead__lead">
        <h1 class="display display--feature phead__h lines">Partner on a pilot.</h1>

        <div class="ask">
          <span class="ask__rule" data-wipe="left" data-delay="420" aria-hidden="true"></span>

          <a class="ask__mail" href={`mailto:${site.email}`} data-reveal="520">
            <svg class="arrow ask__arrow" viewBox="0 0 22 10" aria-hidden="true">
              <path d="M16 1l5 4-5 4M21 5H0"/>
            </svg>
            <span class="ask__mail-t">{site.email}</span>
          </a>

          <p class="ask__sub" data-reveal="580">Name the pilot and the role. A person answers.</p>
        </div>
      </div>

      <!-- The payload, and it is set as the payload. The four pilots and the
           people who own them are the only concrete facts on this route, so
           they are the largest reading matter on it: titles at --step-sub,
           owners at body weight in full cream. The slogan answers to them.
           The column head shares the eyebrow's line, so the plate is bounded
           at the top instead of opening on 200px of empty navy. -->
      <div class="phead__side">
        <p class="label pindex__k" data-reveal="160">Four pilots, open for 2026</p>
        <ul class="pindex" data-wipe="left" data-delay="300">
          {pilots.map((p, i) => (
            <li class:list={['pindex__r', { 'is-turn': i === 2 }]}>
              <a class="pindex__a" href="/pilots/">
                <span class="index pindex__i">{p.index}</span>
                <span class="display display--sub pindex__n">{p.title}</span>
                <span class="pindex__f">{p.partner}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- The one hard cut in the scroll: the ground changes and the three
       doors arrive. Numeral is the index, the verb is the content. -->
  <section class="on-cream proles">
    <div class="shell proles__in">
      <div class="proles__head">
        <p class="eyebrow" data-reveal>Three ways in</p>
        <h2 class="display display--head proles__h" data-settle="0.62">Every pilot needs all three.</h2>
      </div>
      <!-- The page's one spatial idea: three doors opening outward from a
           single point, as one gesture. Not three identical lift-fades. -->
      <ol class="proles__list" data-wipe="center" data-delay="120">
        {roles.map((r, i) => (
          <li>
            <span class="proles__rule" aria-hidden="true"></span>
            <span class="index proles__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display display--sub proles__t">{r.t}</h3>
            <p>{r.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

</Base>

<style>
  /* ── The ask ──────────────────────────────────────────────────────
     Two plates under a two-row header, exactly as /institute/: eyebrow and
     bridge span the width so the poster line and the pilot ledger open on
     the same horizon. */
  .phead {
    padding-block: calc(var(--nav-h) + var(--head-pad)) clamp(3.5rem, 2rem + 3.4vw, 5.5rem);
  }
  .phead__in {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    column-gap: clamp(2rem, 5vw, 5rem);
    row-gap: clamp(1.6rem, 2.8vw, 2.6rem);
    align-items: stretch;
  }
  .phead__in > .eyebrow { grid-column: 1; grid-row: 1; }
  .phead__bridge {
    grid-column: 1; grid-row: 2;
    max-width: 34ch;
    margin-bottom: clamp(0.9rem, 2vw, 1.9rem);
  }
  .phead__lead { grid-column: 1; grid-row: 3; display: flex; flex-direction: column; }
  /* Starts on the eyebrow's row, not 200px below it. */
  .phead__side {
    grid-column: 2; grid-row: 1 / span 3;
    display: flex; flex-direction: column; justify-content: flex-start;
    gap: clamp(0.7rem, 1.2vw, 1rem);
  }

  /* --step-feature: the series-breaker, used once on the page, and it is the
     page's own title. At --step-head it was outranked by the cream section's
     headline lower down — a page whose H1 is smaller than a subhead. The
     breaker moved up here and the cream head stepped down to --step-head.
     Still well under the poster rung, so the pilot ledger keeps its weight. */
  .phead__h {
    line-height: 0.96; letter-spacing: -0.024em;
    max-width: 13ch;
  }
  .phead__h :global(.line) { padding-bottom: 0.08em; margin-bottom: -0.08em; }
  /* Motion as rank: the statement rises long and slow, everything under the
     rule arrives fast and tight behind it. */
  .phead__h :global(.line > span) { transition-duration: 1400ms; }
  .ask [data-reveal] { --reveal-y: 8px; transition-duration: 460ms, 560ms; }

  /* ONE focal point. The page prints the ask once, at --step-feature; the
     address is the ACTION under it, at the bridge rung, so 86px answers to
     27px instead of to a second 50px line on the same row. */
  .ask {
    margin-top: auto;
    padding-top: clamp(2.4rem, 1.4rem + 3.2vw, 4.4rem);
    display: grid; justify-items: start;
  }
  .ask__rule {
    display: block; height: 1px; align-self: start;
    background: color-mix(in srgb, var(--brass) 50%, transparent);
    width: 100%; transform-origin: left;
    margin-bottom: clamp(0.95rem, 1.7vw, 1.5rem);
  }
  /* Real padding, not a .tap pseudo: the address is the page's one action and
     its own box has to clear the touch minimum. */
  .ask__mail {
    display: inline-flex; align-items: center; gap: clamp(0.8rem, 1.5vw, 1.2rem);
    max-width: 100%; padding-block: 0.35rem; margin-block: -0.35rem;
  }
  .ask__arrow { width: clamp(26px, 2.6vw, 34px); color: var(--brass); flex: none; }
  .ask__mail-t {
    font-family: var(--sans); font-weight: 400;
    font-size: var(--step-bridge);
    letter-spacing: -0.006em; line-height: 1.2;
    color: var(--fg);
    transition: color 380ms var(--ease-out);
    overflow-wrap: anywhere;
  }
  .ask__mail:hover .ask__mail-t { color: var(--brass); }
  .ask__mail:hover .ask__arrow { transform: translateX(9px); }
  .ask__sub {
    margin-top: clamp(0.7rem, 1.3vw, 1.05rem);
    color: var(--fg-meta); font-size: var(--step-body); max-width: 44ch;
  }

  /* ── The four doors, by name ──
     Hairline-ruled rows on the right plate — the same object as the spec
     card on /institute/, so the two inner heroes share one construction. */
  .pindex { list-style: none; margin: 0; padding: 0; }
  .pindex__r { border-top: 1px solid var(--rule); }
  .pindex__r:last-child { border-bottom: 1px solid var(--rule); }
  /* The caesura. Four rows at one pitch is a tick; a breath at the halfway
     mark makes it a list of two pairs. The rule there carries brass. */
  .pindex__r.is-turn {
    border-top-color: color-mix(in srgb, var(--brass) 42%, transparent);
    margin-top: clamp(0.9rem, 2.2vw, 1.8rem);
  }
  .pindex__a {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: clamp(0.8rem, 1.6vw, 1.2rem);
    row-gap: 0.2rem;
    align-items: baseline;
    padding-block: clamp(0.75rem, 1.5vw, 1.25rem);
  }
  .pindex__i { align-self: baseline; }
  /* A pilot's name is set in the serif everywhere it appears on this site —
     the home list, all four cards on /pilots/. It was the one place it was a
     sans line, which made the same four objects read as a different class of
     thing on this route. .display--sub, like everything else. */
  .pindex__n {
    color: var(--fg);
    transition: color 340ms var(--ease-out);
  }
  /* Inslee and Cardona are the most interesting words on the route. They no
     longer sit at 11px and 54%. */
  .pindex__f {
    grid-column: 2;
    font-size: var(--step-body); line-height: 1.3;
    color: var(--fg);
  }
  .pindex__a:hover .pindex__n { color: var(--brass); }
  .pindex__k { color: var(--fg-meta); }

  /* ── Three ways in — the cream field ──
     The numeral indexes; it does not outrank. It is a tracked cap sitting on
     the column rule, and the verb underneath it carries the weight. */
  .proles {
    padding-block: clamp(3rem, 1.6rem + 3.6vw, 5.5rem) clamp(4rem, 2rem + 4.4vw, 6.5rem);
  }
  .proles__in { display: grid; gap: clamp(2.2rem, 3.8vw, 3.6rem); }
  .proles__head { display: grid; gap: clamp(0.9rem, 1.8vw, 1.5rem); }
  /* One rung under the H1: three columns at --step-sub under a --step-head
     line, which answers to the title rather than competing with it. */
  .proles__h { max-width: 14ch; line-height: 1.02; }
  .proles__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.75rem, 3.4vw, 3.4rem);
  }
  .proles__list li { display: grid; gap: clamp(0.55rem, 1vw, 0.9rem); align-content: start; }

  .proles__n { margin-bottom: clamp(0.15rem, 0.4vw, 0.35rem); }
  .proles__rule { display: block; height: 1px; background: var(--rule); margin-bottom: clamp(0.75rem, 1.4vw, 1.15rem); }
  .proles__t { font-weight: 320; line-height: 1.08; }
  .proles__list p { color: var(--fg-mute); font-size: var(--step-body); max-width: 28ch; }


  @media (max-width: 900px) {
    .proles__list { grid-template-columns: 1fr; gap: clamp(1.5rem, 5vw, 2rem); }
    /* The centre wipe is three doors opening outward from one point. With one
       column there is no outward: the mask just eats the first letter of every
       line for a second and a half. Re-anchor it to the left rule the rows
       already hang from. Only while it is still covered — `.is-in` still ends
       at inset(0 0 0 0). */
    .proles__list:not(.is-in) { clip-path: inset(0 100% 0 0); }
  }

  @media (max-width: 860px) {
    .phead { padding-block: calc(var(--nav-h) + var(--head-pad)) clamp(2.5rem, 9vw, 3.5rem); }
    .phead__in { grid-template-columns: minmax(0, 1fr); row-gap: clamp(1.5rem, 6vw, 2.2rem); }
    .phead__lead, .phead__side { grid-column: 1; }
    .phead__h { max-width: 14ch; }
    .phead__in > .eyebrow, .phead__bridge, .phead__lead, .phead__side {
      grid-column: 1; grid-row: auto;
    }
    .phead__bridge { max-width: 30ch; margin-bottom: clamp(0.3rem, 2vw, 0.8rem); }
    .ask { padding-top: clamp(2rem, 8vw, 2.8rem); }
    /* Below ~700px the feature rung stops reading as a break; space carries it. */
    .proles__h { max-width: 12ch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ask__mail-t, .ask__mail-arrow { transition-duration: 1ms; }
  }
</style>
