---
/* SCRATCH ROUTE — not part of the site.

   The leading underscore keeps Astro from routing this file at all, so it
   never appears in `dist/`. To look at it: copy it to `src/pages/lab.astro`,
   build, shoot it, then delete the copy.

       cp src/pages/_lab.astro src/pages/lab.astro
       npx astro build --outDir dist-motion
       BASE=http://127.0.0.1:4407 node tools/capture-motion.mjs \
         http://127.0.0.1:4407/lab/ /tmp/lab-motion desktop
       rm src/pages/lab.astro

   What it is for: HeldScene cannot be judged from a still. A held scene that
   looks composed at rest can be dead in motion, and one that reads in motion
   can look like an accident in a screenshot. This route puts the component
   between two ordinary navy scenes so the arc can be measured against the
   ground it is supposed to be an event against — `tools/tone-meter.mjs` on
   this route is the number that matters.
   ------------------------------------------------------------------- */
import Base from '../layouts/Base.astro';
import HeldScene from '../components/HeldScene.astro';
import { forum } from '../data/site.js';

/* Lab copy. Real pages take beats from src/data/site.js. */
const beats = [
  'Founders, investors and officials, in one room.',
  { line: 'One weekend a year.', note: 'Kennedy Compound, Hyannis Port' },
  'The Institute leaves with partners.',
];
---
<Base title="Lab">
  <section class="lab lab--before">
    <div class="shell">
      <p class="eyebrow">Before</p>
      <p class="bridge">Ordinary page ground, so the arc has something to be an event against.</p>
    </div>
  </section>

  <HeldScene
    src={forum.image}
    alt=""
    eyebrow="The Lion Forum"
    credit={forum.credit}
    focal="52% 50%"
    focalSm="56% 46%"
    beats={beats}
    hold={2.5}
    arc="lift"
  >
    <a slot="coda" class="label label--lit lab__cta" href="/forum/">
      How the Forum works
      <svg class="arrow" viewBox="0 0 22 10" aria-hidden="true"><path d="M16 1l5 4-5 4M21 5H0" stroke="currentColor" stroke-width="1" fill="none"/></svg>
    </a>
  </HeldScene>

  <section class="lab lab--after on-panel">
    <div class="shell">
      <p class="eyebrow">After</p>
      <p class="bridge">A band set into the page, at the re-spaced <code>.on-panel</code> value.</p>
    </div>
  </section>

  <section class="lab">
    <div class="shell">
      <p class="eyebrow">And back</p>
      <p class="bridge">Page ground again.</p>
    </div>
  </section>
</Base>

<style>
  .lab { padding-block: var(--scene-pad); }
  .lab .bridge { margin-top: var(--stack-2); }
  .lab__cta { display: inline-flex; align-items: center; gap: 0.9ch; }
  .lab__cta:hover :global(.arrow) { transform: translateX(4px); }
</style>
