---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { pilots } from '../data/site.js';

/* ONE card, four times.
   Round 2 shipped four bespoke scene envelopes and the scroll had no beat you
   could predict — pilot 02's photo band carried no type at all and read as a
   spacer. This is a single system now: full-bleed band, number + partner at
   the top-left inset, sector + horizon flush right on the same baseline, the
   name and its one line set into the foot of the photograph, and one
   three-column Problem / Approach / Goal strip hung off the image edge.
   Nothing alternates. The photographs and the running index carry the
   variation; the frame does not. Cream is reserved for the Partner CTA. */
/* Per-frame grade only — the navy multiply that pulls each photograph into
   the palette. Structure is identical across all four; the maternal frame is
   a warm interior and needs more of it to sit in the same colour family. */
const grades = {
  'healthy-athletes': 0.64,
  'clean-data-centers': 0.58,
  'infant-mortality': 0.74,
  'career-pathways': 0.62,
};
const focals = {
  'healthy-athletes': '50% 34%',
  'clean-data-centers': '50% 58%',
  'infant-mortality': '46% 42%',
  'career-pathways': '50% 46%',
};
---
<Base title="Pilots" description="Four pilots in 2026: health, energy, maternal health, and education.">
  <section class="phead">
    <div class="shell phead__in">
      <p class="label phead__eyebrow" data-reveal>Four pilots · 2026</p>
      <h1 class="display display--hero phead__h lines">Proof, one problem at a time.</h1>

      <span class="phead__rule" aria-hidden="true"></span>

      <p class="phead__lede" data-reveal="440">
        One measurable outcome each. The result is published either way.
      </p>

      <nav class="phead__index" aria-label="The four pilots">
        <ol>
          {pilots.map((p, i) => (
            <li data-reveal={String(500 + i * 80)}>
              <a class="pc" href={`#${p.id}`}>
                <span class="index pc__i">{p.index}</span>
                <span class="display pc__t">{p.title}</span>
                <span class="pc__lead" aria-hidden="true"></span>
                <span class="label pc__f">{p.field}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </section>

  {pilots.map((p, i) => (
    <article class="pcard" id={p.id} aria-labelledby={`${p.id}-h`}>
      <div class="pcard__band">
        <Figure
          src={p.image}
          alt=""
          ratio="auto"
          grade={grades[p.id] ?? 0.6}
          focal={focals[p.id] || '50% 50%'}
          parallax={5}
          loading={i === 0 ? 'eager' : 'lazy'}
        />

        <p class="shell pcard__rail" data-reveal>
          <span class="index pcard__i">{p.index}</span>
          <span class="pcard__partner">{p.partner}</span>
          <span class="pcard__field">{p.field} · {p.horizon}</span>
        </p>

        <div class="shell pcard__say">
          <h2 class="display pcard__t lines" id={`${p.id}-h`}>{p.title}</h2>
          <p class="pcard__tag" data-reveal="160">{p.tagline}</p>
        </div>
      </div>

      <dl class="shell pcard__spec">
        <div data-reveal="80"><dt class="label">Problem</dt><dd>{p.problem}</dd></div>
        <div data-reveal="150"><dt class="label">Approach</dt><dd>{p.approach}</dd></div>
        <div data-reveal="220"><dt class="label">Goal</dt><dd>{p.goal}</dd></div>
      </dl>
    </article>
  ))}
</Base>

<style>
  /* ── Nav guard, local to this page ─────────────────────────────────
     Nav.astro is not this piece's file. But /pilots/ scrolls 80–100px cream
     display type straight under the bar, four times, and the shared edgeless
     fade cannot mask type at that size. So this page carries a stronger band
     of its own: solid for the full height of the bar, then a 2.4rem fade.
     The :has() guard keeps this rule inert on every page but this one. */
  :global(header.nav.is-scrolled:has(~ main .pcard))::before {
    background: linear-gradient(
      to bottom,
      var(--nav-scrim) 0%,
      var(--nav-scrim) var(--nav-h),
      color-mix(in srgb, var(--nav-scrim) 34%, transparent) calc(var(--nav-h) + 1.4rem),
      color-mix(in srgb, var(--nav-scrim) 0%, transparent) calc(var(--nav-h) + 2.4rem)
    );
  }

  /* ── Masthead ──────────────────────────────────────────────────────
     Statement full width; below the rule, a short lede on the left and the
     contents on the right — both hung off the rule, sharing one top edge.
     The head is sized so the first photograph's edge cuts the first screen. */
  .phead { padding-block: calc(var(--nav-h) + clamp(3rem, 6.5vw, 6rem)) clamp(2rem, 4.5vw, 3.5rem); }
  .phead__in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
    column-gap: clamp(2rem, 5vw, 5rem);
    row-gap: var(--stack-2);
    align-items: start;
  }
  .phead__eyebrow { grid-column: 1 / -1; color: var(--cream); }
  /* 8em holds "Proof, one problem" on line one and refuses "at". Set in em so
     the break survives the fluid hero scale. */
  .phead__h { grid-column: 1 / -1; max-width: 8em; text-wrap: initial; }

  .phead__rule {
    grid-column: 1 / -1;
    height: 1px; background: var(--rule);
    margin-top: clamp(1.25rem, 3vw, 2.25rem);
  }

  /* hangs off the rule at the same height as the contents' first row */
  .phead__lede {
    grid-column: 1;
    align-self: start;
    padding-top: clamp(0.7rem, 1.4vw, 1rem);
    font-size: clamp(1.02rem, 0.94rem + 0.36vw, 1.24rem);
    line-height: 1.5;
    color: var(--fg-mute);
    max-width: 26ch;
    text-wrap: pretty;
  }

  .phead__index { grid-column: 2; }
  .phead__index ol { list-style: none; margin: 0; padding: 0; }

  /* number · title · hairline leader · field */
  .pc {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, auto) minmax(1.25rem, 1fr) auto;
    align-items: baseline;
    gap: 0.9rem;
    padding-block: clamp(0.7rem, 1.4vw, 1rem);
    border-bottom: 1px solid var(--rule-soft);
  }
  .phead__index li:first-child .pc { border-top: 1px solid var(--rule-soft); }
  .pc__t {
    font-size: var(--step-m);
    line-height: 1.05;
    letter-spacing: -0.014em;
    white-space: nowrap;
    color: color-mix(in srgb, var(--cream) 82%, transparent);
    transition: color 320ms var(--ease-out), transform 520ms var(--ease-out);
  }
  .pc__lead {
    height: 0;
    align-self: baseline;
    border-bottom: 1px solid var(--rule-soft);
    transition: border-color 380ms var(--ease-out);
  }
  .pc__f { color: var(--fg-faint); transition: color 320ms var(--ease-out); }
  @media (hover: hover) {
    .pc:hover .pc__t { color: var(--cream); transform: translateX(0.2rem); }
    .pc:hover .pc__lead { border-color: color-mix(in srgb, var(--brass) 62%, transparent); }
    .pc:hover .pc__f { color: var(--brass); }
  }
  .pc:focus-visible { outline-offset: 6px; }

  /* ══ THE CARD ══════════════════════════════════════════════════════
     Band → spec strip. Four times, identically. The image edge is the
     divider between cards; there is no padded gap between them. */
  .pcard { scroll-margin-top: calc(var(--nav-h) + 0.5rem); }

  .pcard__band {
    position: relative;
    isolation: isolate;
    min-height: clamp(320px, 58vh, 36rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  /* Figure ships a bottom ink ramp for the title; the top rail needs its own,
     because a bright sky swallows a 0.7rem tracked label. ~180px at 35–60%. */
  .pcard__band::before {
    content: ''; position: absolute; inset: 0 0 auto 0; z-index: 0;
    height: clamp(7rem, 20vh, 11.5rem);
    background: linear-gradient(to bottom,
      color-mix(in srgb, var(--ink-900) 72%, transparent) 0%,
      color-mix(in srgb, var(--ink-900) 40%, transparent) 46%,
      transparent 100%);
    pointer-events: none;
  }

  /* Bottom ramp for the name. Figure ships a `scrim="bottom"` ramp, but it
     goes to solid ink over the last 16% and turned the foot of every band
     into a black slab; this is the same idea, shallower, so the photograph
     still reaches its own edge and the seam with the spec strip is a real
     picture edge rather than a fade-out. Local by design. */
  .pcard__band::after {
    content: ''; position: absolute; inset: auto 0 0 0; z-index: 0;
    height: 58%;
    background: linear-gradient(to top,
      color-mix(in srgb, var(--ink-900) 84%, transparent) 0%,
      color-mix(in srgb, var(--ink-900) 58%, transparent) 30%,
      color-mix(in srgb, var(--ink-900) 20%, transparent) 62%,
      transparent 100%);
    pointer-events: none;
  }

  /* padding lives on the children: the fill Figure is positioned against the
     band's padding box, so padding here would inset the photograph. */
  .pcard__rail, .pcard__say { position: relative; z-index: 1; }

  /* number + partner at the left inset, sector + horizon flush right,
     one shared baseline, one tracking. This is the card's nameplate. */
  .pcard__rail {
    grid-row: 1;
    margin: 0;
    padding-top: clamp(1.35rem, 2.6vw, 2.25rem);
    display: flex;
    align-items: baseline;
    gap: 1.15ch;
    font-family: var(--sans);
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1;
  }
  .pcard__i { letter-spacing: 0.18em; }
  .pcard__partner { color: var(--cream); }
  .pcard__field {
    margin-left: auto;
    text-align: right;
    color: color-mix(in srgb, var(--cream) 70%, transparent);
    white-space: nowrap;
  }

  /* the name and its one line, set into the foot of the photograph */
  .pcard__say {
    grid-row: 3;
    padding-bottom: clamp(1.75rem, 3.4vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 18.5rem);
    column-gap: clamp(2rem, 5vw, 5rem);
    row-gap: 0.8rem;
    align-items: end;
  }
  .pcard__t {
    font-size: clamp(2rem, 1.05rem + 4.2vw, 5rem);
    line-height: 0.96;
    letter-spacing: -0.026em;
    text-wrap: initial;
  }
  .pcard__tag {
    padding-bottom: 0.4em;
    font-size: var(--step-s);
    line-height: 1.45;
    color: color-mix(in srgb, var(--cream) 78%, transparent);
    text-wrap: pretty;
  }

  /* ── The spec strip ────────────────────────────────────────────────
     One object, on every card. Three columns, one line each, hung off the
     image edge by a single full-width hairline. */
  .pcard__spec {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding-bottom: clamp(2.25rem, 4.4vw, 3.75rem);
  }
  .pcard__spec > div {
    display: grid; gap: 0.6rem; align-content: start;
    padding: clamp(1rem, 2vw, 1.5rem) clamp(1rem, 2.4vw, 2.25rem) 0 0;
    border-top: 1px solid var(--rule);
  }
  .pcard__spec > div + div {
    border-left: 1px solid var(--rule-soft);
    padding-left: clamp(1rem, 2.4vw, 2.25rem);
  }
  .pcard__spec dt { color: var(--brass); }
  .pcard__spec dd {
    margin: 0;
    color: var(--fg-mute);
    font-size: var(--step-xs);
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* ── Narrow ───────────────────────────────────────────────────────── */
  @media (max-width: 1080px) {
    .phead__in { grid-template-columns: minmax(0, 1fr); }
    .phead__lede { max-width: 34ch; padding-top: clamp(0.5rem, 2vw, 1rem); }
    .phead__index { grid-column: 1; max-width: 34rem; }
  }

  @media (max-width: 760px) {
    .pcard__band { min-height: clamp(300px, 46vh, 28rem); }
    .pcard__say { grid-template-columns: minmax(0, 1fr); align-items: start; row-gap: 0.6rem; }
    .pcard__t { font-size: clamp(2.15rem, 1.2rem + 4.6vw, 3rem); }
    .pcard__tag { padding-bottom: 0; max-width: 34ch; }
    .pcard__rail { gap: 0.9ch; letter-spacing: 0.14em; }
    .pcard__spec { grid-template-columns: minmax(0, 1fr); }
    .pcard__spec > div { padding-right: 0; padding-bottom: 1rem; border-top-color: var(--rule-soft); }
    .pcard__spec > div:first-child { border-top-color: var(--rule); }
    .pcard__spec > div + div { border-left: 0; padding-left: 0; }
    .pc { grid-template-columns: 2rem minmax(0, auto) minmax(1rem, 1fr) auto; gap: 0.7rem; }
    .pc__t { font-size: clamp(1.2rem, 1rem + 2.4vw, 1.6rem); }
  }

  @media (max-width: 430px) {
    .pcard__rail { font-size: 0.62rem; letter-spacing: 0.12em; }
  }

  @media (max-width: 420px) {
    .pc__f { display: none; }
    .pc { grid-template-columns: 2rem minmax(0, 1fr); }
    .pc__lead { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc__t, .pc__lead, .pc__f { transition-duration: 1ms; }
  }
</style>
