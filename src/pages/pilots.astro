---
import Base from '../layouts/Base.astro';
import PilotCard from '../components/pilots-card.astro';
import PilotDetail from '../components/pilots-detail.astro';
import { pilots, pilotTerms } from '../data/site.js';

/* ROUND 8 — THE PAGE A FUNDER CAN ACT ON.

   Rounds 1–7 were judged on craft and won on craft. Nobody was ever asked
   the only question this page has to answer: a programme officer lands
   here — does she leave knowing enough to decide whether to fund one of
   these? She did not. Two viewport-heights per pilot bought about
   twenty-five words: a title, a tagline, one line of problem, one line of
   approach, one goal. Not who builds it, not who runs it, not where, not
   what stage it is at, not what is being asked of her.

   What changed, and why:

   1. TWO LAYERS, which is what the brief asked for all along ("Cards
      first. Detail on click or a short dedicated block."). The compressed
      card discipline — problem / approach / goal, one line each — is kept
      exactly, ON THE CARD, four-up so the four can be compared in one
      glance. The detail block underneath is the thing the cap was always a
      summary of, and it was never built.

   2. THE TERMS, ONCE. Duration, status and the ask are true of all four,
      so they are stated once under the masthead rule instead of four times
      down the page. That is also where the page's most important sentence
      now lives, at reading size: what stage these four are actually at.

   3. THE TWELVE-MONTH AXIS IS CUT. It was the best-drawn object on the
      site and it encoded exactly one fact — ninety days is a quarter of
      twelve months — which the sentence beside it stated in words. It
      spent ~200px of the page's best space repeating itself, and it split
      the goal sentence in half so the eye had to jump a chart to finish
      reading. There is no per-pilot schedule data to make it carry
      anything else: all four horizons are the same 3–12 months. An
      information graphic that restates its own caption is decoration. The
      space is now the "what it still needs" plate on pilot 01, which
      carries three facts a funder can act on.

   4. THE PHOTOGRAPHS ARE BANDS. Full bleed, 16/5.5, about 260px at 1440 —
      a quarter of what a card used to spend. Pilot 01's frame is re-cut
      (see refs/PHOTO-FACTS.md): a real, identifiable seven-year-old used
      to fill 1440 × 780 under a Special Olympics headline she has no
      relationship to.

   5. THE NAV. See the guard at the top of the stylesheet. */

/* Per-frame crops. Three of the four masters are 3:2 and the plate is 3:2,
   so they are shown whole and the focal is the centre. Pilot 01's master is
   the 3:1 band cut from the foot of the Army frame (see PHOTO-FACTS), so it
   is the one that needs a horizontal anchor: 38% keeps the stride in the
   plate and leaves the open track under the credit. */
const focals = {
  'healthy-athletes': '38% 50%',
  'clean-data-centers': '50% 50%',
  'infant-mortality': '50% 50%',
  'career-pathways': '50% 50%',
};
const focalsSm = {
  'healthy-athletes': '34% 50%',
};
const grades = {
  'healthy-athletes': 0.34,
  'clean-data-centers': 0.5,
  'infant-mortality': 0.42,
  'career-pathways': 0.56,
};
---
<Base title="Pilots" description="Four active pilots for 2026: what each one is, who it is for, and where a partner comes in.">
  <section class="phead">
    <div class="shell phead__in">
      <p class="eyebrow phead__eyebrow" data-reveal>Four active pilots · 2026</p>
      {/* the rung between an 11px label and the poster line: without it the
           display type reads as merely large */}
      {/* WAVE 25. This carried BOTH clauses of the prospectus's model —
           "Measurable results in months. The lessons go to the world." — at
           19px, as a rung between an 11px label and the poster line. The
           second clause is the largest claim this institute makes and it was
           furniture. It is now the page's turn, at --step-feature, 760px
           below (see .pturn). What stays here is the promise this page can
           keep locally; what is paid at the turn is what the four of them
           are for. The two halves are never on screen together. */}
      <p class="bridge phead__bridge" data-reveal="90">
        Measurable results in months.
      </p>
      <h1 class="display display--poster phead__h lines">Proof, one problem at a time.</h1>

      <span class="phead__rule" aria-hidden="true" data-wipe="left" data-delay="240"></span>

      {/* THE TERMS, ONCE, AND ABOVE THE FOLD.
           Every one of these is true of all four pilots, so the old page's
           choice — repeat the duration on four rails and say the status in
           an 11px word — cost four times the ink and told a reader less.
           Three keys at one serif rung, hung off the masthead rule. The
           middle one is the sentence a funder must not be able to miss, and
           it is now the prospectus's own: FOUR ACTIVE PILOTS for 2026, with
           the fourth still in exploration. */}
      <dl class="terms" data-seq="110" data-seq-from="380">
        {pilotTerms.map((t) => (
          <div class="terms__i" data-reveal>
            <dt class="label terms__t">{t.term}</dt>
            <dd class="terms__d">
              <span class="display display--sub terms__k">{t.key}</span>
              <span class="terms__x">{t.text}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ── LAYER ONE: THE CARDS ─────────────────────────────────────────
       A band set into the page, four cells on one grid. This is the layer
       the brief's one-line-per-field cap governs, and it is the only place
       on the site where all four arguments can be read against each other
       without scrolling. */}
  <section class="pgrid on-panel" aria-labelledby="pgrid-h">
    <div class="shell pgrid__in">
      <div class="pgrid__head">
        <p class="eyebrow" data-reveal>01 — 04</p>
        <h2 class="display display--sub pgrid__h" id="pgrid-h" data-reveal="70">
          The problem, the approach, and the goal.
        </h2>
      </div>

      <div class="pgrid__grid" data-seq="90" data-seq-from="60">
        {pilots.map((p) => (
          <div class="pgrid__cell" data-reveal>
            <PilotCard pilot={p} />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── THE TURN ─────────────────────────────────────────────────────

       WAVE 25. THIS PAGE HAD NO SERIES-BREAKER, AND THAT IS THE WHOLE
       DIAGNOSIS. tokens.css: "--step-feature exists to be used ONCE on a
       page... Four identical blocks at --step-head is a metronome; three at
       --step-head and one at --step-feature is a rhythm." /pilots/ ran
       86 (the h1) · 53 · 53 · 53 · 53 (four dossier titles) · 34 (this
       turn) and never once used the rung the scale keeps for the one thing
       a page is FOR. Every other route spends it: /institute/ on "Neither
       side can run the pilot alone.", /people/ on "Sixteen put forward. The
       board is not yet seated.", /forum/ on its role note. Measured, the
       missing moment on this route was not a hole in a column — it was an
       unused rung, and the reviewer's "four near-identical slabs" is what a
       metronome sounds like from outside.

       The rung goes HERE and not at the foot, because this is already the
       page's one change of ground, full bleed, with a table above it and
       four dossiers below — the hinge, and the site's other two turns sit on
       exactly such a hinge. What it used to carry was a CONTENTS LINE ("What
       each one is, who it is for, and where a partner comes in.") set at
       --step-sub: the page's best 241px spent naming the labels of the
       blocks directly beneath it, which those blocks already carry in brass.
       Nothing is lost by cutting it — it survives verbatim as this route's
       meta description, which is where a table of contents belongs.

       What it carries now was already on the page: the second clause of the
       masthead bridge, refs/PROSPECTUS.txt's own "We then share those
       lessons with the world". No new fact, no new colour, no new size — the
       rung existed and was empty. Set alone, on the page's own rail, with
       the h1 ("Proof, one problem at a time.") 1,500px above it, the two
       lines are the whole model: one problem at a time, and then everybody
       gets it. The eyebrow is gone: a label over a claim makes the claim a
       section head. /institute/'s turn carries no eyebrow either.

       The terms ledger 1,300px above still carries "The lessons from each
       pilot go to the world." at 16px under SHARED, and that echo is
       deliberate and has a precedent: /people/ sets "Sixteen put forward.
       The board is not yet seated." at this same rung and then repeats both
       halves in its 16/00 ledger. A claim at --step-feature and the same
       fact as a labelled row are two registers, not a duplication — the
       ledger is checkable, the claim is quotable. What was NOT kept twice is
       the masthead bridge, which used to carry this exact sentence at 19px
       and now carries only its first clause. */}
  <section class="pturn on-cream">
    <div class="shell pturn__in">
      <p class="display display--feature pturn__b" data-settle="0.62">
        The lessons go to the world.
      </p>
    </div>
  </section>

  {pilots.map((p, i) => (
    <PilotDetail
      pilot={p}
      focal={focals[p.id] || '50% 50%'}
      focalSm={focalsSm[p.id]}
      grade={grades[p.id] ?? 0.5}
      loading={i === 0 ? 'eager' : 'lazy'}
    />
  ))}
</Base>

<style>
  /* ── Nav guard, DELETED ────────────────────────────────────────────
     This page used to shorten the bar's tail and steepen its mask by hand,
     because a half-faded 53px serif title reads as a ghost rather than as
     something occluded. That was the right observation and the wrong
     place: it is not a property of this page's display type, it is the
     half-lit-band rule, and Nav.astro now states it once for the whole
     site. The override had drifted into an exact copy of the shared values
     and was the same rule typed twice, waiting to disagree with itself.
     See the band note on `.nav::before` in Nav.astro. */

  /* ── Masthead ──────────────────────────────────────────────────────
     eyebrow → bridge → banner, then the rule, then the terms every one of
     the four is offered on. */
  .phead { padding-block: calc(var(--nav-h) + var(--head-pad)) clamp(2rem, 4.5vw, 3.5rem); }
  .phead__in {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--stack-2);
  }
  .phead__bridge { max-width: 30ch; }
  /* 8em holds "Proof, one problem" on line one and refuses "at". Set in em so
     the break survives the fluid hero scale. */
  .phead__h {
    max-width: 8em;
    text-wrap: initial;
    margin-top: clamp(0.4rem, 1.2vw, 1rem);
  }

  .phead__rule {
    height: 1px; background: var(--rule);
    margin-top: clamp(1.5rem, 3.4vw, 2.75rem);
    margin-bottom: calc(var(--stack-2) * -1 + clamp(0.9rem, 2vw, 1.6rem));
  }

  /* ── The terms ─────────────────────────────────────────────────── */
  .terms {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 3.4vw, 3.5rem);
    row-gap: clamp(1.5rem, 3vw, 2.25rem);
    align-items: start;
  }
  .terms__i { display: grid; gap: clamp(0.6rem, 1.2vw, 0.9rem); }
  .terms__t { color: var(--fg-meta); }
  .terms__d { margin: 0; display: grid; gap: clamp(0.35rem, 0.8vw, 0.6rem); }
  .terms__k {
    color: var(--fg);
    line-height: 1.05;
    letter-spacing: -0.014em;
    font-variant-numeric: lining-nums;
  }
  .terms__x {
    color: var(--fg-mute);
    font-size: var(--step-body);
    line-height: 1.5;
    max-width: 32ch;
    text-wrap: pretty;
  }

  /* ── The card band ─────────────────────────────────────────────── */
  .pgrid {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2.5rem, 5vw, 4.5rem);
  }
  .pgrid__head { margin-bottom: clamp(1.75rem, 3.4vw, 3rem); display: grid; gap: var(--stack-1); }
  .pgrid__h { margin: 0; max-width: 30ch; line-height: 1.15; }

  /* ONE GRID, NOT FOUR STACKS. The cards carry EIGHT named rows — rail,
     who, name, tag, problem, approach, goal, door — and every one of them
     is shared across all four cells by `subgrid`. It used to be six, with
     the three fields folded into a single "fields" row, and that one
     shortcut cost the layer its reason to exist: inside that row each card
     laid its own fields out, so a three-line PROBLEM (03) pushed its
     APPROACH 15px below its neighbours' and the four GOALs landed on four
     different lines. A comparison grid whose rows do not line up is four
     stacks wearing a table's clothes. The three fields are now three
     tracks of this grid, carried down through .pgrid__cell → .card →
     .card__f, and a reader can run an eye across PROBLEM, then APPROACH,
     then GOAL, which is the only thing this band is for. */
  .pgrid__grid {
    /* the gutter, stated once. It was written out as the same clamp in four
       places — the gap and three rule offsets — which is three chances for
       the rules to stop sitting on the centre line of the bay. */
    --gutter-col: clamp(1.25rem, 2.6vw, 2.5rem);
    --bay: calc(var(--gutter-col) / 2);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(7, auto);
    column-gap: var(--gutter-col);
    row-gap: 0;
    /* ONE rule across the whole band, not four segments with gaps in them.
       Four columns under four separate rules read as four objects; one rule
       with four columns hanging off it reads as one table, which is what
       this is — and it rhymes with the full-width masthead rule above. */
    border-top: 1px solid var(--rule);
  }
  /* the hairlines are the grid, not the cells: the band's own top rule,
     and one between each pair of columns */
  .pgrid__cell {
    position: relative;
    grid-row: span 7;
    display: grid;
    grid-template-rows: subgrid;
    /* how far this column's hover hairline may run past its own edge before
       it meets the vertical rule. Only the four-up band has a continuous
       top rule to run along, so everywhere else this stays 0 and the wipe
       is exactly the column. */
    --bay-l: 0px;
    --bay-r: 0px;
  }
  @media (min-width: 1181px) {
    .pgrid__cell { --bay-l: var(--bay); --bay-r: var(--bay); }
    .pgrid__cell:first-child { --bay-l: 0px; }
    .pgrid__cell:last-child  { --bay-r: 0px; }
  }
  /* The verticals hang from the band's rule and are released at the foot of
     it. They used to stop dead in open ground under the last row, which
     reads as a rule that ran out rather than one that ended; a closing
     horizontal would have boxed the band and put a second full-width rule
     next to the cream turn below. So they are masked out over their last
     eighth — the stop is designed, and the eye leaves the table downward. */
  .pgrid__cell + .pgrid__cell::after {
    content: ''; position: absolute; top: 0; bottom: 0;
    left: calc(var(--bay) * -1);
    width: 1px; background: var(--rule-soft);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 87%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 87%, transparent 100%);
  }

  /* ── The turn into the detail layer ────────────────────────────── */
  /* The band grew with the type it holds: a 67px line needs more room above
     and below it than a 34px one, or the change of ground reads as a stripe
     rather than as a pause. The measure is set to break nothing — the line
     is 28 characters and holds on one line at every width down to 320. */
  .pturn { padding-block: clamp(3.25rem, 6.4vw, 5.75rem); }
  .pturn__in { display: grid; }
  .pturn__b { max-width: 30ch; margin: 0; line-height: 1.05; text-wrap: initial; }

  /* the first dossier lands off a cream edge: it needs its own shelf */
  .pturn + :global(.pd) { padding-top: clamp(2.25rem, 4.5vw, 4rem); }

  /* the footer opens with 10.5rem of ground, which is right after a scene
     that ends on display type and wrong after a plate. Page-scoped. */
  :global(main:has(.pd) + footer.foot) {
    padding-top: clamp(3.25rem, 1.6rem + 4vw, 6rem);
  }

  /* ── Narrow ───────────────────────────────────────────────────────── */
  @media (max-width: 1180px) {
    .pgrid__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 0; }
    /* Once the band wraps, the pairs still share their seven tracks — 01/02
       against one armature, 03/04 against the next — but the second pair
       sits below a rule the container cannot draw. So the rule goes back
       onto the cells, where there is one per row of cards. */
    .pgrid__grid { border-top: 0; }
    .pgrid__cell { border-top: 1px solid var(--rule); }
    /* On a two-up grid the vertical rule belongs between the columns only:
       cell 3 opens a new row, so its rule would hang in open ground at the
       left edge of the band. So the base rule is hidden and restored on the
       even cells — and BOTH selectors must carry the same adjacent-sibling
       shape, because Astro scopes every compound with its own attribute and
       a lone ':nth-child(even)' therefore loses the cascade to
       '.pgrid__cell + .pgrid__cell'. Every even cell has a preceding
       sibling, so the '+' costs nothing and buys the specificity. */
    .pgrid__cell + .pgrid__cell::after { display: none; }
    .pgrid__cell + .pgrid__cell:nth-child(even)::after { display: block; }
  }

  @media (max-width: 860px) {
    .terms { grid-template-columns: minmax(0, 1fr); row-gap: clamp(1.25rem, 3vw, 1.75rem); }
    .terms__i {
      grid-template-columns: minmax(0, 8rem) minmax(0, 1fr);
      column-gap: clamp(1rem, 2.4vw, 1.75rem);
      align-items: baseline;
    }
    .terms__x { max-width: 40ch; }
  }

  @media (max-width: 620px) {
    .pgrid__grid { grid-template-columns: minmax(0, 1fr); }
    .pgrid__cell + .pgrid__cell:nth-child(even)::after { display: none; }
    .terms__i { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
  }
</style>
