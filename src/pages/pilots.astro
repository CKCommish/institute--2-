---
import Base from '../layouts/Base.astro';
import PilotCard from '../components/pilots-card.astro';
import { pilots } from '../data/site.js';

/* Round 7. The four pilots were four unrelated objects — a full-bleed frame
   over a cream chart, an inset plate bleeding off the left edge, a frame with
   the fields burned onto it, a boxed argument read backwards — and a reader
   had to learn where PROBLEM / APPROACH / GOAL live four times. They are one
   anatomy now (see pilots-card.astro), ranked 1–4: frame height and the rung
   the name is set at descend one step per pilot, the series opens on cream
   and closes on a plate, and pilot 01's GOAL — the same field, in the same
   place — is the one amplification, set through the twelve-month axis. */
const rank = {
  'healthy-athletes': 1,
  'clean-data-centers': 2,
  'infant-mortality': 3,
  'career-pathways': 4,
};

const grades = {
  'healthy-athletes': 0.30,
  'clean-data-centers': 0.50,
  'infant-mortality': 0.40,
  'career-pathways': 0.58,
};
/* Every frame is now written on at the top edge and along the foot, so every
   crop keeps its subject in the open middle band. */
/* The infant-mortality master was re-cropped (wave 5) to end before the second
   adult in the USDA frame; site.js still names the older workaround file. */
const images = {
  'infant-mortality': '/media/pilot-maternal.jpg',
};

/* A credit says what the PHOTOGRAPH is. site.js gives 03 a rights-holder
   ("U.S. Department of Agriculture") instead of a fact about the frame; the
   fact is in CONTENT-NOTES.md. site.js belongs to another piece, so the
   correction is named here, like the master swap above. The alt goes with it:
   this is the one frame carrying a private individual's face at full scale,
   and it must not be marked decorative under a mortality headline. */
const credits = {
  'infant-mortality': 'Family child care home · USDA',
};
const alts = {
  'infant-mortality':
    'A mother holds her infant against her shoulder in the doorway of a family child care home.',
};

const focals = {
  'healthy-athletes': '50% 34%',
  'clean-data-centers': '50% 52%',
  'infant-mortality': '50% 40%',
  'career-pathways': '50% 46%',
};
---
<Base title="Pilots" description="Four pilots in 2026: health, energy, maternal health, and education.">
  <section class="phead">
    <div class="shell phead__in">
      <p class="eyebrow phead__eyebrow" data-reveal>Four pilots · 2026</p>
      <!-- the rung between an 11px label and the poster line: without it the
           display type reads as merely large -->
      <p class="bridge phead__bridge" data-reveal="90">
        One measurable outcome each. The result is published either way.
      </p>
      <h1 class="display display--poster phead__h lines">Proof, one problem at a time.</h1>

      <span class="phead__rule" aria-hidden="true" data-wipe="left" data-delay="240"></span>

      <!-- Left column is anchored to the BOTTOM of the contents. The air above
           the figure is a pause held between the rule and the numeral, not a
           place the copy ran out. -->
      <div class="phead__left">
        <p class="phead__fig" data-reveal="620">
          <span class="display phead__fig-n">3–12</span>
          <span class="label phead__fig-l">Months, start to published result</span>
        </p>
      </div>

      <nav class="phead__index" aria-label="The four pilots" data-seq="80" data-seq-from="420">
        <ol>
          {pilots.map((p) => (
            <li data-reveal>
              <a class="pc" href={`#${p.id}`}>
                <span class="index pc__i">{p.index}</span>
                <span class="display pc__t">{p.title}</span>
                <span class="pc__lead" aria-hidden="true"></span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </section>

  {pilots.map((p, i) => (
    <PilotCard
      pilot={p}
      rank={rank[p.id] ?? 3}
      src={images[p.id]}
      credit={credits[p.id]}
      alt={alts[p.id] ?? ''}
      grade={grades[p.id] ?? 0.6}
      focal={focals[p.id] || '50% 50%'}
      parallax={i === 0 ? 7 : 5}
      loading={i === 0 ? 'eager' : 'lazy'}
    />
  ))}
</Base>

<style>
  /* ── Nav guard, local to this page ─────────────────────────────────
     Nav.astro is not this piece's file. But /pilots/ scrolls 55–90px cream
     display type straight under the bar, and the shared edgeless fade cannot
     mask type at that size. So this page carries a stronger band of its own:
     solid for the full height of the bar, then a 2.4rem fade. The :has()
     guard keeps this rule inert on every page but this one. */
  :global(header.nav.is-scrolled:has(~ main .pcard))::before {
    background: linear-gradient(
      to bottom,
      var(--nav-scrim) 0%,
      var(--nav-scrim) var(--nav-h),
      color-mix(in srgb, var(--nav-scrim) 34%, transparent) calc(var(--nav-h) + 1.4rem),
      color-mix(in srgb, var(--nav-scrim) 0%, transparent) calc(var(--nav-h) + 2.4rem)
    );
  }

  /* Same guard, other end: the footer opens with 10.5rem of ground, which is
     right after a scene that ends on a line of display type — and wrong after
     a one-line GOAL, where it read as running out of content. Page-scoped. */
  :global(main:has(.pcard) + footer.foot) {
    padding-top: clamp(2.75rem, 1.2rem + 3.6vw, 5rem);
  }

  /* ── Masthead ──────────────────────────────────────────────────────
     eyebrow → bridge → banner, then the rule, then the horizon figure on the
     left and the contents on the right, both hung off it. */
  .phead { padding-block: calc(var(--nav-h) + var(--head-pad)) clamp(2rem, 4.5vw, 3.5rem); }
  .phead__in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
    column-gap: clamp(2rem, 5vw, 5rem);
    row-gap: var(--stack-2);
    align-items: start;
  }
  .phead__eyebrow { grid-column: 1 / -1; }
  .phead__bridge { grid-column: 1 / -1; max-width: 30ch; }
  /* 8em holds "Proof, one problem" on line one and refuses "at". Set in em so
     the break survives the fluid hero scale. */
  .phead__h {
    grid-column: 1 / -1;
    max-width: 8em;
    text-wrap: initial;
    margin-top: clamp(0.4rem, 1.2vw, 1rem);
  }

  .phead__rule {
    grid-column: 1 / -1;
    height: 1px; background: var(--rule);
    margin-top: clamp(1.25rem, 3vw, 2.25rem);
    /* both columns hang off THIS line — pull the next grid row up against it
       so the numeral and the contents share one horizon */
    margin-bottom: calc(var(--stack-2) * -1);
  }

  /* hung off the rule, level with the first row of the contents. The air
     below it is closed by pilot 01's photograph, not by the viewport edge. */
  /* The quantity used to hang off the top of the rule with the whole rest of
     the column left open beneath it — and what was beneath it was not a
     margin, it was 865px of nothing running into the top of a photograph. An
     unbounded void is not a pause. So the numeral is set on the BOTTOM of
     the spread instead, level with the last line of the contents: the air is
     now held BETWEEN two marks, the hairline above and the numeral below,
     which is the only kind of silence this system allows. */
  .phead__left {
    grid-column: 1;
    align-self: end;
    padding-bottom: clamp(0.1rem, 0.6vw, 0.4rem);
  }

  /* the one measurable frame every pilot shares, pulled out of the card
     rails (where it repeated four times) and set once, at size */
  .phead__fig { margin: 0; display: grid; gap: clamp(0.5rem, 1vw, 0.8rem); }
  /* --step-poster put the duration figure at exactly the headline's rung, so
     the masthead opened with two 86px objects and neither led. A stat is
     evidence for the sentence above it, not a second sentence: --step-head,
     one rung down, which is also where the contents list beside it sits. */
  .phead__fig-n {
    font-size: var(--step-head);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--fg);
    font-variant-numeric: lining-nums;
  }
  .phead__fig-l { line-height: 1.5; }

  /* Both columns are hung off the SAME line at the bottom of the spread: the
     numeral's caption and the index's last hairline end exactly level. They
     used to end 19px apart, which reads as two columns that happen to stop
     near each other rather than one object. */
  .phead__index { grid-column: 2; align-self: end; padding-top: 0; }
  .phead__index ol { list-style: none; margin: 0; padding: 0; }

  /* number · title · hairline leader · field */
  .pc {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, auto) minmax(1.25rem, 1fr);
    align-items: baseline;
    gap: 0.9rem;
    padding-block: clamp(0.7rem, 1.4vw, 1rem);
    border-bottom: 1px solid var(--rule-soft);
  }
  .pc__t {
    font-size: var(--step-sub);
    line-height: 1.05;
    letter-spacing: -0.014em;
    white-space: nowrap;
    color: var(--fg-mute);
    transition: color 320ms var(--ease-out), transform 520ms var(--ease-out);
  }
  .pc__lead {
    height: 0;
    align-self: baseline;
    border-bottom: 1px solid var(--rule-soft);
    transition: border-color 380ms var(--ease-out);
  }
  @media (hover: hover) {
    .pc:hover .pc__t { color: var(--fg); transform: translateX(0.2rem); }
    .pc:hover .pc__lead { border-color: color-mix(in srgb, var(--brass) 62%, transparent); }
  }
  .pc:focus-visible { outline-offset: 6px; }

  /* ── Narrow ───────────────────────────────────────────────────────── */
  @media (max-width: 1080px) {
    .phead__in { grid-template-columns: minmax(0, 1fr); }
    .phead__left { align-self: start; padding-bottom: 0; padding-top: clamp(0.8rem, 2vw, 1.15rem); }
    .phead__fig {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
      gap: 0 0.9rem;
    }
    .phead__fig-l { max-width: 24ch; }
    .phead__index { grid-column: 1; align-self: start; max-width: 34rem; margin-top: clamp(1.25rem, 4vw, 2.25rem); }
    .phead__rule { margin-bottom: 0; }
  }

  @media (max-width: 760px) {
    .pc { grid-template-columns: 2rem minmax(0, auto) minmax(1rem, 1fr); gap: 0.7rem; }
    .pc__t { font-size: clamp(1.2rem, 1rem + 2.4vw, 1.6rem); }
  }

  @media (max-width: 560px) {
    .phead__fig { grid-template-columns: minmax(0, 1fr); gap: 0.55rem; }
    .phead__fig-l { max-width: none; }
  }

  @media (max-width: 420px) {
    .pc { grid-template-columns: 2rem minmax(0, 1fr); }
    .pc__lead { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc__t, .pc__lead { transition-duration: 1ms; }
  }
</style>
