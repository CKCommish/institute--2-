---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { pilots } from '../data/site.js';
---
<Base title="Pilots" description="Four pilots in 2026: health, energy, maternal health, and education.">
  <section class="phead">
    <div class="shell phead__in">
      <p class="label" data-reveal>Four pilots · 2026</p>
      <h1 class="display display--hero lines">Proof, one problem at a time.</h1>
      <p class="lede" data-reveal="520">Each pilot runs three to twelve months against a single measurable outcome. The result is published either way.</p>
    </div>
  </section>

  {pilots.map((p, i) => (
    <section class="pdetail" id={p.id}>
      <div class="shell pdetail__in">
        <div class="pdetail__media" data-reveal>
          <Figure src={p.image} alt="" ratio="4 / 5" grade={0.34} parallax={4} />
        </div>
        <div class="pdetail__body">
          <p class="label pdetail__meta" data-reveal><span class="index">{p.index}</span> {p.partner}</p>
          <h2 class="display display--xl lines">{p.title}</h2>
          <p class="pdetail__tag" data-reveal="380">{p.tagline}</p>
          <dl class="pdetail__dl" data-reveal="480">
            <div><dt class="label">Problem</dt><dd>{p.problem}</dd></div>
            <div><dt class="label">Approach</dt><dd>{p.approach}</dd></div>
            <div><dt class="label">Goal</dt><dd>{p.goal}</dd></div>
          </dl>
        </div>
      </div>
    </section>
  ))}
</Base>

<style>
  .phead { padding-block: calc(var(--nav-h) + clamp(5rem, 12vw, 10rem)) clamp(3rem, 7vw, 6rem); }
  .phead__in { display: grid; gap: var(--stack-2); }
  .phead .display { max-width: 14ch; }
  .pdetail { padding-block: clamp(3rem, 7vw, 6rem); border-top: 1px solid var(--rule); }
  .pdetail__in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .pdetail__body { display: grid; gap: clamp(1rem, 2vw, 1.5rem); }
  .pdetail__meta { display: flex; align-items: baseline; gap: 0.9ch; }
  .pdetail__tag { font-size: clamp(1.05rem, 0.98rem + 0.4vw, 1.3rem); color: color-mix(in srgb, var(--cream) 78%, transparent); max-width: 30ch; }
  .pdetail__dl { display: grid; gap: 1.25rem; margin: 0; padding-top: 0.75rem; border-top: 1px solid var(--rule); }
  .pdetail__dl > div { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 1.25rem; align-items: baseline; }
  .pdetail__dl dd { margin: 0; color: var(--fg-mute); font-size: var(--step-xs); max-width: 46ch; }
  @media (max-width: 860px) {
    .pdetail__in { grid-template-columns: 1fr; }
    .pdetail__dl > div { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
