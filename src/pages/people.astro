---
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { founders, board } from '../data/site.js';
import { cohortsOf, boardBridge, mastheadBridge } from '../components/people-cohorts.js';

/* ── Portrait drop-in slot ────────────────────────────────────────────
   We hold no rights-cleared portraits of the founders, so the page is
   built to be complete without them. Drop either file into public/media/

       public/media/founder-mckelvy.jpg
       public/media/founder-olanoff.jpg     (.jpeg / .png / .webp also work)

   and that founder's record switches from the two-column register
   (name | credentials) to a three-column one (portrait | name | credentials)
   with no other change. While a file is absent nothing is rendered in its
   place — the record is a typographic entry, not a frame waiting for an
   image, so the empty state is designed air and never a broken box. It also
   keeps the console clean: no request is made for a file that is not there. */
const EXTS = ['.jpg', '.jpeg', '.png', '.webp'];
function resolvePortrait(p) {
  if (!p) return null;
  const stem = p.replace(/\.(jpe?g|png|webp)$/i, '');
  for (const ext of EXTS) {
    const rel = `${stem}${ext}`;
    try {
      if (fs.existsSync(fileURLToPath(new URL(`../../public${rel}`, import.meta.url)))) return rel;
    } catch { /* unresolvable path — treat as absent */ }
  }
  return null;
}

const people = founders.map((f, i) => ({
  ...f,
  index: String(i + 1).padStart(2, '0'),
  portraitSrc: resolvePortrait(f.portrait),
  credentials: f.detail.replace(/\.\s*$/, '').split(/\.\s+/),
}));
const [lead, second] = people;

/* Both founders carry the identical two affiliations. Printing them twice
   made the least distinguishing text the loudest text in each record, so
   they are stated once, above the register, and each record then carries
   only what separates the two men. */
const sharedAffiliation = 'Both are Founding Partners of K. Ventures and of The Lion Forum.';

/* The 11.7px rung that hands a reader from an 86px name down to an 18.7px
   credential line. Without it the record jumps two rungs and reads as two
   objects at opposite walls. */
const beforeLabel = 'Before the institute';

/* The roster is a plate of three columns, not a table of sixteen rows.
   Grouping, order and the two head clauses live in people-cohorts.js. */
const cohorts = cohortsOf(board);

const boardCount = board.length;
const founderCount = String(founders.length).padStart(2, '0');
---
<Base title="People" description="The founders and prospective board of the Lion Forum Institute.">

  <!-- ── Masthead ─────────────────────────────────────────────────── -->
  {/* eyebrow → bridge → display. The bridge is the rung that lets an
      11px label introduce an 86px line; without it the label is orphaned
      and the display type reads as merely large. */}
  <section class="pm">
    <div class="shell pm__in">
      <p class="eyebrow" data-reveal>People</p>
      <p class="bridge pm__bridge" data-reveal="110">{mastheadBridge}</p>
      <div class="pm__main">
        <h1 class="display display--poster pm__h lines">The people accountable for the work.</h1>
        <nav class="pm__idx" aria-label="On this page">
          <a class="pm__idx-i" href="#founders" data-reveal="320">
            <span class="pm__idx-n tnum">{founderCount}</span>
            <span class="label pm__idx-l">Founders</span>
          </a>
          <a class="pm__idx-i" href="#board" data-reveal="400">
            <span class="pm__idx-n tnum">{boardCount}</span>
            <span class="label pm__idx-l">Prospective board</span>
          </a>
        </nav>
      </div>
      <hr class="rule pm__rule" data-wipe="left" data-delay="120" />
    </div>
  </section>

  <!-- ── Founders ─────────────────────────────────────────────────── -->
  {/* Two records, deliberately unequal. The first is a plate: its own
      ground, a brass hairline, a feature-rung name, and its credentials
      carried down the ladder — label (11.7) → line (18.7) — on a mid-grid
      column joined to the name by a vertical rule, so name and credentials
      are one object rather than two walls with a void between them. The
      second record is the light one: a single band, a head-rung name, its
      credentials set as one run. The section has a rhythm, not a repeat. */}
  <section class="fs" id="founders" aria-labelledby="founders-h">
    <div class="shell fs__head">
      <h2 class="eyebrow" id="founders-h" data-reveal>Founders</h2>
      <p class="bridge fs__note" data-reveal="110">{sharedAffiliation}</p>
    </div>

    <div class="fplate" data-wipe="left">
      <div class="shell">
        <article class="fr fr--lead">
          <div class="fr__row">
            <div class="fr__lead">
              <p class="fr__meta">
                <span class="index tnum">{lead.index}</span>
                <span class="label">{lead.role}</span>
              </p>
              <h3 class="display display--poster fr__name" data-settle="0.62">{lead.name}</h3>
            </div>
            <div class="fr__cred">
              <p class="label label--lit fr__credhead">{beforeLabel}</p>
              <ul class="fr__list">
                {lead.credentials.map((c) => <li>{c}</li>)}
              </ul>
            </div>
          </div>
        </article>
      </div>
    </div>

    <div class="shell">
      <article class="fr fr--min">
        <hr class="rule" data-wipe="left" data-delay="80" />
        <div class="fr__row fr__row--min" data-wipe="left" data-delay="160">
          <div class="fr__lead">
            <p class="fr__meta">
              <span class="index tnum">{second.index}</span>
              <span class="label">{second.role}</span>
            </p>
            <h3 class="display display--head fr__name">{second.name}</h3>
          </div>
          <div class="fr__cred">
            <p class="label label--lit fr__credhead">{beforeLabel}</p>
            <p class="fr__run">{second.credentials.join(' · ')}</p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ── Prospective board ────────────────────────────────────────── -->
  {/* The roster's problem was never the names, it was the form: sixteen
      rows at one pitch make a reader process a directory before they can
      feel a room. So the calibre is stated once, in the bridge, and the
      names are set as a plate — three constituencies side by side, bounded
      top and bottom by a rule, six rows deep instead of sixteen. Each
      column wipes down as a territory, so the section arrives in three
      moves rather than in sixteen identical blinks. */}
  <section class="scene on-cream bd" id="board" aria-labelledby="board-h">
    <div class="shell">
      <header class="bd__head">
        <p class="eyebrow" data-reveal>Prospective board</p>
        {/* The scene opens on a ruled line rather than on a label, so the
            air to the right of the bridge is a bounded field and not the
            page running out. */}
        <hr class="rule bd__rule" data-wipe="left" data-delay="60" />
        <p class="bridge bd__bridge" data-reveal="110">{boardBridge}</p>
        {/* The claim runs the full measure and the tally is set on the foot
            of its short last line, so the two masses close the scene's width
            between them instead of leaving the margin to do it. */}
        <div class="bd__claim">
          <h2 class="display display--feature bd__h lines" id="board-h">Advising the pilots. Opening the doors they need.</h2>
          <p class="bd__tally" data-reveal="260">
            <span class="index tnum">{boardCount}</span>
            <span class="label">Names put forward</span>
          </p>
        </div>
      </header>

      <div class="plate" data-settle="0.72">
        <span class="plate__edge" data-wipe="center" aria-hidden="true"></span>
        <div class="plate__cols">
          {cohorts.map((c, ci) => (
            <section class:list={['col', `col--${ci}`]} data-wipe="top" data-delay={String(140 + ci * 130)} aria-labelledby={c.id}>
              <h3 class="col__head" id={c.id}>
                <span class="index tnum">{c.count}</span>
                <span class="label">{c.label}</span>
              </h3>
              <p class="col__def">{c.def}</p>
              <ul class="col__list">
                {c.people.map((p) => (
                  <li class="ent">
                    <span class="ent__n">{p.name}</span>
                    <span class="ent__t">{p.line}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>

      <p class="label bd__foot" data-reveal="140">Membership is prospective · Titles for identification</p>
    </div>
  </section>
</Base>

<style>
  /* ── Masthead ───────────────────────────────────────────────────── */
  .pm { padding-block: calc(var(--nav-h) + var(--head-pad)) 0; }
  .pm__in { display: grid; }
  .pm__bridge {
    margin-top: clamp(0.9rem, 1.6vw, 1.35rem);
    max-width: 30ch;
  }
  .pm__main {
    margin-top: clamp(2rem, 4.2vw, 3.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(2rem, 5vw, 5.5rem);
    align-items: end;
  }
  .pm__h { max-width: 21ch; text-wrap: pretty; }
  /* motion.js builds .line at runtime, so it never carries the scope hash. */
  .pm__h :global(.line) { padding-bottom: 0.07em; margin-bottom: -0.07em; }

  /* Contents index: the only navigable object on the screen, hung on the
     right edge and set on the display's last baseline. */
  .pm__idx {
    display: grid;
    align-content: end;
    min-width: clamp(13rem, 20vw, 19.5rem);
    padding-bottom: 0.3em;
  }
  .pm__idx-i {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: clamp(1rem, 2vw, 1.75rem);
    align-items: baseline;
    padding-block: clamp(0.7rem, 1.3vw, 1rem);
    border-top: 1px solid var(--rule);
  }
  .pm__idx-n {
    font-family: var(--serif);
    font-weight: 300;
    font-size: var(--step-sub);
    line-height: 0.9;
    letter-spacing: -0.025em;
    color: var(--brass);
  }
  .pm__idx-l {
    line-height: 1.2;
    text-align: right;
    transition: color 380ms var(--ease-out);
  }
  @media (hover: hover) {
    .pm__idx-i:hover .pm__idx-l { color: var(--fg); }
  }
  .pm__rule { margin-top: clamp(2.5rem, 5vw, 4.25rem); }

  /* ── Founders ───────────────────────────────────────────────────── */
  /* Opens tight — its head sits on the masthead's rule, so the first screen
     ends on the register rather than on air. */
  .fs {
    padding-block: clamp(1.35rem, 2.6vw, 2.6rem) clamp(0.5rem, 1.2vw, 1.25rem);
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }
  .fs__head {
    display: grid;
    justify-items: start;
    row-gap: clamp(0.85rem, 1.6vw, 1.3rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.6rem);
  }
  /* The one affiliation both founders share, stated once, at the bridge
     rung — it is the scene's connective tissue, not a footnote in the far
     corner, so it sits on the same left rail as everything under it. */
  .fs__note { max-width: 34ch; }

  /* The plate. The page's one figure/ground event: a band of lighter ink
     bled to the viewport edge with a brass hairline on its top, so the
     founders band is a place and not a stretch of empty measure. */
  .fplate {
    background: var(--ink-700);
    border-top: 1px solid var(--brass);
    margin-bottom: clamp(1.5rem, 3vw, 2.75rem);
  }

  .fr__row {
    display: grid;
    grid-template-columns: minmax(0, 6.4fr) minmax(0, 5.6fr);
    column-gap: clamp(2rem, 4.5vw, 5rem);
    row-gap: clamp(1.25rem, 2.4vw, 2rem);
    align-items: start;
    padding-block: clamp(2.25rem, 5vw, 4.5rem);
  }
  /* The connective tissue the record was missing: a hairline down the
     mid-grid axis, so the name and its credentials are two halves of one
     object instead of two masses at opposite walls. */
  .fr--lead .fr__cred {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-left: 1px solid color-mix(in srgb, var(--cream) 26%, transparent);
    padding-left: clamp(1.5rem, 3vw, 2.75rem);
    margin-left: calc(-1 * clamp(1rem, 2.2vw, 2.5rem));
  }

  .fr__meta {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: clamp(0.85rem, 1.6vw, 1.35rem);
  }
  .fr--lead .fr__name {
    line-height: 0.98;
    letter-spacing: -0.026em;
    max-width: 12ch;
    --settle-scale: 0.93;
    --settle-shift: 5vh;
    --settle-origin: 0% 100%;
  }
  .fr--min .fr__name { max-width: 16ch; }

  .fr__credhead {
    padding-bottom: clamp(0.85rem, 1.7vw, 1.25rem);
    margin-bottom: clamp(0.9rem, 1.8vw, 1.35rem);
    border-bottom: 1px solid var(--rule);
  }
  .fr--lead .fr__credhead { border-bottom-color: color-mix(in srgb, var(--cream) 26%, transparent); }
  .fr__list {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    gap: 0.42rem;
    font-size: var(--step-lede);
    line-height: 1.4;
    color: var(--fg-mute);
  }
  .fr--lead .fr__list { color: var(--fg); }
  .fr__run {
    font-size: var(--step-lede);
    line-height: 1.45;
    color: var(--fg-mute);
    max-width: 34ch;
    text-wrap: pretty;
  }

  /* The second record is the light one: half the depth, no ground, a name
     one rung down and its credentials as a single run. */
  .fr__row--min { padding-block: clamp(1.5rem, 3vw, 2.6rem) clamp(1.75rem, 3.4vw, 3rem); }
  .fr--min .fr__cred { padding-top: 0.35rem; }

  /* ── Prospective board ──────────────────────────────────────────── */
  .bd {
    padding-block: clamp(5rem, 2.5rem + 8vw, 10rem) clamp(3rem, 5vw, 5.5rem);
    scroll-margin-top: var(--nav-h);
  }
  .bd__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(2rem, 5vw, 5.5rem);
  }
  .bd__head > .eyebrow { grid-column: 1; }
  .bd__rule,
  .bd__bridge,
  .bd__claim { grid-column: 1 / -1; }
  .bd__rule { margin-top: clamp(1rem, 1.8vw, 1.5rem); }
  .bd__bridge {
    margin-top: clamp(1.4rem, 2.6vw, 2.2rem);
    max-width: 44ch;
  }
  /* The claim is a two-mass row: the sentence takes the whole measure and
     wraps onto a short second line; the tally sits on that line's foot at
     the right edge, so the width is closed by a mark and not by the page
     margin. This is the one scene on the page whose armature is not a left
     rail with a micro-label parked in the far corner. */
  .bd__claim {
    margin-top: clamp(1.6rem, 3.2vw, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(1.5rem, 3.5vw, 4rem);
    align-items: end;
  }
  .bd__h {
    max-width: none;
    text-wrap: wrap;
    --settle-shift: 2.2vh;
    --settle-origin: 0% 100%;
    /* The one display line in this scene gets the slowest, latest ramp on
       the page — motion sorts the hierarchy instead of dimming it evenly. */
    --dur-3: 1400ms;
  }
  .bd__head { align-items: baseline; }
  .bd__tally {
    display: grid;
    justify-items: end;
    row-gap: 0.3rem;
    text-align: right;
    padding-bottom: 0.28em;
  }
  .bd__h :global(.line) { padding-bottom: 0.09em; margin-bottom: -0.09em; }
  .bd__h :global(.line > span) { transition-delay: calc(var(--line-delay, 0ms) + 120ms); }

  /* ── The plate ──────────────────────────────────────────────────── */
  /* A held rest between the claim and the roster. It is bounded on both
     sides — the display line above, the plate's own rule below — so it
     reads as an interval and not as a page that ran out. */
  .plate {
    margin-top: var(--pause);
    display: grid;
    /* The page's one weight vector, on the object the page is about. The
       default amplitude is under the perceptual threshold, so the plate
       arrives visibly low and heavy and settles onto its reading line. */
    --settle-scale: 0.965;
    --settle-shift: 7vh;
    --settle-origin: 50% 0%;
  }
  .plate__edge { display: block; height: 1px; background: var(--mark); }
  .plate__cols {
    display: grid;
    /* Column width tracks the size of the constituency, so the plate has a
       measure instead of three identical bays. */
    grid-template-columns: 6fr 5fr 5fr;
    column-gap: clamp(1.75rem, 3.6vw, 4.25rem);
    /* Bays close at their own depth. Six names and five names are not the
       same object and the plate says so, instead of ruling a straight line
       under two cells of nothing. */
    align-items: stretch;
  }
  /* The block padding sits on the columns, not on the row, so the rules
     between them run edge to edge and the plate closes. */
  /* Each bay closes on its own foot rather than on one straight rule far
     below the shortest column — the step is the plate telling you the
     constituencies are not the same size. */
  .col {
    align-self: stretch;
    padding-block: clamp(2.25rem, 4.4vw, 4rem) clamp(2.25rem, 4.4vw, 4rem);
    border-bottom: 1px solid var(--mark);
  }
  /* Column rules, the way a broadsheet sets them: they run the full depth
     of the plate, so the three constituencies are bays rather than three
     lists that happen to sit near each other. */
  .col + .col {
    border-left: 1px solid var(--mark);
    padding-left: clamp(1.75rem, 3.6vw, 4.25rem);
    margin-left: calc(-1 * clamp(0.5rem, 1vw, 1.1rem));
  }
  /* If the script never runs, nothing may stay under its mask. */
  :global(html:not(.js)) .col,
  :global(html:not(.js)) .fr__row,
  :global(html:not(.js)) .fplate,
  :global(html:not(.js)) .fr .rule,
  :global(html:not(.js)) .plate__edge { clip-path: none; }

  .col__head {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    font-weight: 400;
    margin-bottom: clamp(0.5rem, 0.9vw, 0.75rem);
  }
  .col__def {
    font-size: var(--step-body);
    line-height: 1.4;
    color: var(--fg-mute);
    max-width: 24ch;
    text-wrap: pretty;
    padding-bottom: clamp(1.1rem, 2.1vw, 1.75rem);
  }

  /* The rule runs the full column, not the width of the sentence above it,
     so the three heads sit on one shelf across the plate. */
  .col__list {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    row-gap: clamp(1.15rem, 2.2vw, 2rem);
    padding-top: clamp(1.25rem, 2.3vw, 1.9rem);
    border-top: 1px solid var(--rule);
  }
  .ent { display: grid; row-gap: 0.3rem; }
  /* The first name in each bay leads it, one rung up. Sixteen names at one
     weight made a cabinet secretary and an investor the same object. */
  .ent:first-child .ent__n {
    font-size: var(--step-head);
    line-height: 1.0;
    letter-spacing: -0.02em;
  }
  .ent:first-child { row-gap: 0.42rem; padding-bottom: 0.35rem; }
  .ent__n {
    font-family: var(--serif);
    font-weight: 340;
    font-size: var(--step-sub);
    line-height: 1.06;
    letter-spacing: -0.016em;
    color: var(--fg);
    text-wrap: balance;
  }
  /* Sixteen role lines needed to be quieter than the names, but the way they
     got there was a fourth micro register: 11.7px at 500 with 0.02em and no
     uppercase, i.e. the .label rung wearing sentence case and carrying a
     whole clause — the one thing base.css says a label never does. The rank
     is carried by INK and by the serif/sans split instead, at the body rung
     the rest of the site reads supporting copy in. */
  .ent__t {
    font-size: var(--step-body);
    font-weight: 370;
    line-height: 1.35;
    color: var(--fg-meta);
    text-wrap: pretty;
  }

  .bd__foot {
    justify-self: end;
    text-align: right;
    padding-top: clamp(1.1rem, 2vw, 1.6rem);
    line-height: 1.5;
    text-wrap: balance;
  }

  /* ── Narrow ─────────────────────────────────────────────────────── */
  @media (max-width: 1180px) {
    /* Three columns stop holding a name and its title at 33px. The plate
       becomes three stacked bands, each running its own names two-up, so
       it is still a block to glance at rather than a queue to read. */
    .plate__cols {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
    }
    .col { align-self: auto; padding-block: clamp(1.6rem, 3.4vw, 2.5rem); }
    .col + .col { border-left: 0; padding-left: 0; margin-left: 0; border-top: 1px solid var(--rule); }
    .col__head { margin-bottom: 0.45rem; }
    .col__def { max-width: 40ch; }
    .col__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 4vw, 3.5rem);
    }
  }
  @media (max-width: 980px) {
    /* Both records stack. The lead record keeps its plate and its hairline
       moves from the side of the credentials to their head, so the rung
       ladder survives the fold. */
    .fr__row { grid-template-columns: minmax(0, 1fr); }
    .fr--lead .fr__cred {
      border-left: 0;
      padding-left: 0;
      margin-left: 0;
      border-top: 1px solid color-mix(in srgb, var(--cream) 20%, transparent);
      padding-top: clamp(1.25rem, 3vw, 1.75rem);
    }
    .fr--lead .fr__name { max-width: none; }
    .fr__run { max-width: none; }
  }
  @media (max-width: 860px) {
    /* Masthead stacks: the contents index sits under the display line and
       runs the full measure, so it stays an object rather than a scrap. */
    .pm__main { grid-template-columns: minmax(0, 1fr); row-gap: clamp(1.9rem, 6vw, 2.75rem); }
    .pm__idx { min-width: 0; padding-bottom: 0; }
  }
  @media (max-width: 760px) {
    /* At this width the claim is a stack, and both display lines are
       balanced so neither closes on a one-word orphan. */
    .bd__claim { grid-template-columns: minmax(0, 1fr); row-gap: clamp(1.1rem, 3.4vw, 1.6rem); }
    .bd__tally { justify-items: start; text-align: left; padding-bottom: 0; }
    .bd__h, .pm__h { text-wrap: balance; }
    .ent:first-child .ent__n { line-height: 1.02; }
  }
  @media (max-width: 700px) {
    .bd__head { grid-template-columns: minmax(0, 1fr); }
    .fs__note { max-width: 30ch; }
    /* Below ~700 the display range compresses and the feature rung stops
       reading as a break, so the lead record carries its weight with ground
       and space instead: a deeper plate, a name that owns the measure. */
    .fplate .fr__row { padding-block: clamp(1.9rem, 7vw, 2.6rem) clamp(2.1rem, 8vw, 3rem); }
  }
  @media (max-width: 620px) {
    /* One name per line, and the pitch tightens so sixteen entries stay a
       block a thumb can pass rather than a scroll of its own. */
    .col__list {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.05rem;
      padding-top: 1.1rem;
    }
    .ent { row-gap: 0.18rem; }
    .bd__foot { justify-self: start; text-align: left; }
    /* The masthead line was breaking into four ragged lines at 390. Given
