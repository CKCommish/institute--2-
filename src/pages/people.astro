---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import Portrait from '../components/people-portrait.astro';
import { founders, board } from '../data/site.js';
import { cohortsOf, standingOf, boardBridge, mastheadBridge } from '../components/people-cohorts.js';

/* We hold no rights-cleared portraits of either founder, and the page is
   built to be complete without them: a record here is a typographic entry,
   not a frame waiting for an image, so there is no empty box to fill and no
   request made for a file that is not there. If portraits are cleared later
   they belong in both bays of the diptych or in neither — the parity of the
   two records is the point of this scene. */

const people = founders.map((f) => ({
  ...f,
  credentials: f.detail.replace(/\.\s*$/, '').split(/\.\s+/),
}));

/* Both founders carry the identical two affiliations. Printing them twice
   made the least distinguishing text the loudest text in each record, so
   they are stated once, above the register, and each record then carries
   only what separates the two men. */
const sharedAffiliation = 'Both are Founding Partners of K. Ventures and of The Lion Forum.';

/* The micro rung that hands a reader from a 53px name down to a 19px
   credential line, and — set identically in both bays — the thing that makes
   the two records visibly the same kind of object. */
const beforeLabel = 'Before the institute';

/* Grouping, order and the two head clauses live in people-cohorts.js. */
const cohorts = cohortsOf(board);

/* The one fact that has to survive sixteen photographs. */
const standing = standingOf(board);

const boardCount = board.length;
const founderCount = String(founders.length).padStart(2, '0');
---
<Base title="People" description="The founders and prospective board of the Lion Forum Institute.">

  <!-- ── Masthead ─────────────────────────────────────────────────── -->
  {/* eyebrow → bridge → display. The bridge is the rung that lets an
      11px label introduce an 86px line; without it the label is orphaned
      and the display type reads as merely large. */}
  <section class="pm">
    <div class="shell pm__in">
      <p class="eyebrow" data-reveal>People</p>
      <p class="bridge pm__bridge" data-reveal="110">{mastheadBridge}</p>
      <div class="pm__main">
        <h1 class="display display--poster pm__h lines">The people accountable for the work.</h1>
        {/* The only navigable object on this screen. It used to be a count
            and a label on a ruled row and nothing else — no mark saying it
            could be followed, no closure at the right end on a phone, and a
            colour change as its whole hover. It is a control now: count,
            name, and the house arrow turned down the page, on a row that is
            bounded at both ends at every width. */}
        <nav class="pm__idx" aria-label="On this page">
          <a class="pm__idx-i" href="#founders" data-reveal="320">
            <span class="pm__idx-n tnum">{founderCount}</span>
            <span class="label pm__idx-l">Founders</span>
            <svg class="arrow arrow--down pm__idx-a" viewBox="0 0 22 10" aria-hidden="true"><path d="M16 1l5 4-5 4M21 5H0" stroke="currentColor" stroke-width="1" fill="none"/></svg>
          </a>
          <a class="pm__idx-i" href="#board" data-reveal="400">
            <span class="pm__idx-n tnum">{boardCount}</span>
            <span class="label pm__idx-l">Prospective board</span>
            <svg class="arrow arrow--down pm__idx-a" viewBox="0 0 22 10" aria-hidden="true"><path d="M16 1l5 4-5 4M21 5H0" stroke="currentColor" stroke-width="1" fill="none"/></svg>
          </a>
        </nav>
      </div>
      <hr class="rule pm__rule" data-wipe="left" data-delay="120" />
    </div>
  </section>

  <!-- ── Founders ─────────────────────────────────────────────────── -->
  {/* Two co-founders, one title, one treatment. The page previously gave the
      first name a plate, a feature rung and a settle, and the second a band
      and a single run — on a page headed "the people accountable for the
      work", that composition said one of them was more accountable. They now
      sit as a diptych on one band: same ground, same rung, same credential
      ladder, same motion, one hairline between them. The only thing that
      differs is how many lines a name takes, which is a fact about the name.

      The band is also the page's second armature. Everything else here opens
      flush-left under a full-width rule; this is a two-up spread with a spine
      down the middle, so the founders read as a pair and not as a list of
      two. */}
  <section class="fs on-panel" id="founders" aria-labelledby="founders-h">
    <div class="shell">
      <div class="fs__head">
        <h2 class="eyebrow" id="founders-h" data-reveal>Founders</h2>
        <p class="bridge fs__note" data-reveal="110">{sharedAffiliation}</p>
      </div>

      <hr class="rule fs__rule" data-wipe="left" data-delay="60" />

      <div class="dip">
        {people.map((f) => (
          <article class="fr" data-reveal="140">
            <div class="fr__id">
              <p class="fr__meta">
                <span class="label">{f.role}</span>
              </p>
              <h3 class="display display--head fr__name">{f.name}</h3>
            </div>
            <div class="fr__cred">
              <p class="label label--lit fr__credhead">{beforeLabel}</p>
              <ul class="fr__list">
                {f.credentials.map((c) => <li>{c}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Prospective board ────────────────────────────────────────── -->
  {/* The roster's problem was never the names, it was the form: sixteen
      rows at one pitch make a reader process a directory before they can
      feel a room. So the calibre is stated once, in the bridge, and the
      names are set as a plate — three constituencies on three shared column
      tracks, bounded top and bottom by a rule, two rows deep per band
      instead of sixteen. Each band wipes down as a territory, so the section
      arrives in three moves rather than in sixteen identical blinks. */}
  {/* THE SEAM, AND THE PAGE'S ONE LOUD SENTENCE.

      The photograph is an empty meeting room — the room this roster is being
      assembled to fill — and it is the only place on the page a picture can
      arrive without interrupting a reading: the turn from navy to cream. The
      room is not the Institute's; the credit says whose it is, per
      refs/PHOTO-FACTS.md.

      What is set into it is the qualification, ONCE, at the size of a
      headline. This is the whole answer to sixteen faces. A reader meets the
      roster through this screen — the masthead's index now lands here, not on
      the cream field — so the last thing they read before the first face is
      an empty room and the sentence "The board is not yet seated." An empty room is not
      an illustration of that sentence, it is the evidence for it, which is
      why the sentence goes HERE and not above the grid.

      It takes --step-feature, the series-breaker, and it is the only thing on
      the page at that rung: the claim below ("Advising the pilots we run…")
      was there and has been dropped to --step-head, because on a page that
      now shows sixteen photographs, the loudest line cannot be the one
      describing what these people would do. Both clauses are within two
      characters of each other, which per the note on .bd__h below is the
      condition under which `text-wrap: balance` breaks a two-line display at
      the full stop instead of mid-clause.

      There used to be a 245px "16" set here instead. It is not coming back:
      it was twice --step-banner, so the loudest object on the whole site sat
      on an inner page; it repeated a number the masthead already states; and
      a display numeral centred on sixteen chairs in a room the Institute does
      not own is exactly the reading refs/PHOTO-FACTS.md exists to prevent. A
      sentence with a number in it does the same work and can be argued with,
      which a numeral cannot. */}
  <section class="seam" id="board" aria-labelledby="board-h">
    <Figure
      src="/media/institute.jpg" alt="An empty committee room: sixteen chairs set around a long table beneath a flag."
      ratio="auto" ratioSm="3 / 4" grade={0.45} lift={1.1}
      zoom={1.02} focal="50% 52%" zoomSm={1.28} focalSm="50% 56%"
      scrim="bottom" rise={0.62} reach={1} ink={1} vig={0.3} enter="wipe"
      credit="Library of Congress" creditPos="bottom-right" />

    <div class="shell seam__in">
      <p class="eyebrow" data-reveal>Prospective board</p>
      <h2 class="display display--feature seam__h lines" id="board-h">{standing.line}</h2>
    </div>
  </section>

  <section class="scene on-cream bd" aria-labelledby="board-h">
    <div class="shell">
      <header class="bd__head">
        {/* The scene opens on a ruled line rather than on a label — the label
            is on the photograph above, where it was set into the room. */}
        <hr class="rule bd__rule" data-wipe="left" data-delay="60" />
        <p class="bridge bd__bridge" data-reveal="110">{boardBridge}</p>
        {/* The one deliberate departure from x=51 on this page. Every other
            line here opens on the left rule; the claim starts a column in
            and runs past the right one, so the page's loudest sentence is
            the one thing that does not obey its grid. */}
        {/* TWO SENTENCES, TWO LINES, AND THE COPY IS CUT TO MAKE THAT TRUE.
            "Advising the pilots. Opening the doors they need." set at the
            series-breaker rung and given the whole measure put seven words
            on line one and the word "need." alone on line two — a one-word
            widow at 67px, on the loudest line of the page, at every width
            from 860 up. It could not be fixed with a measure: the second
            sentence is WIDER than the first sentence plus the next word, so
            there is no column in which a greedy line breaks at the full
            stop. The sentences had to be made the same length. Three words
            of fact do it — the institute runs the pilots — and now the two
            clauses are within 100px of each other at every width, which is
            the condition under which `text-wrap: balance` breaks a two-line
            display at the punctuation instead of in the middle of a
            clause. */}
        <div class="bd__claim">
          <p class="display display--head bd__h lines">Advising the pilots we run. Opening the doors they need.</p>
        </div>
      </header>

      {/* THE ROSTER, ON ONE GRID.

          It used to be a run: every entry only as wide as the office it
          carried, each with its own left hairline, wrapping greedily. The
          argument was that the calibre of the room would read as the area it
          covered. What it actually produced was three unrelated layouts — a
          six-deep stacked list for Policy, and two wrapped fields whose
          hairlines landed at seven different x-values (51, 382, 392, 415,
          446, 813, 836) for what the eye reads as ONE repeated column edge,
          with a right rag from 637px to 1304px inside a 1389px measure. Two
          rules that miss each other by 33px do not read as a rag. They read
          as a mistake.

          So the roster is a plate. Three tracks, one fixed gutter, the same
          three x-values in every row of every group, filled column-major so
          a reader takes a column at a time. The column rule is the left edge
          of a RECORD — it is drawn on the entry, exactly as tall as the entry
          box, so a rule can only ever exist beside a name. The tracks are
          fixed, so every rule still lands on one of the same three x-values;
          what it can no longer do is outlive the last name in its column.
          Nobody is ranked: one name register, one title register, sixteen
          entries the same. The difference between the constituencies is
          stated in the head above each band, in words, which is where a
          difference belongs. */}
      <div class="wall">
        {/* THE STANDING RAIL — the plate's own column head, and the second of
            the page's two answers to sixteen faces.

            The sentence on the photograph is read once, on the way in. The
            roster is eight rows deep on a desktop and sixteen on a phone, so
            a reader is inside it long after that screen has gone, and a
            reader who arrives from a search result or a shared anchor may
            never have seen it at all. This row is what stands with them: two
            counts in the register the page already uses for counts (06
            POLICY, 02 FOUNDERS), spread to the two ends of the plate so the
            pair reads as a tally and not as a caption. 00 is written as a
            zero rather than as the word "none" for the same reason 06 is not
            written "six" — a numeral is read before it is parsed, and this
            is the number the page most needs read.

            It is inside the plate, under its top rule and above the first
            band, so it belongs to the roster as a piece of its structure. A
            marker riding each of sixteen entries would be sixteen times
            quieter and would rank nobody; a marker on the sheet ranks the
            sheet. */}
        <p class="wall__state" data-reveal>
          <span class="wall__st">
            <span class="index tnum">{standing.put}</span>
            <span class="label label--lit">{standing.putLabel}</span>
          </span>
          <span class="wall__st">
            <span class="index tnum">{standing.accepted}</span>
            <span class="label label--lit">{standing.acceptedLabel}</span>
          </span>
        </p>
        {cohorts.map((c, ci) => (
          <section class="co" data-wipe="top" data-delay={String(140 + ci * 130)} aria-labelledby={c.id}>
            <h3 class="co__head" id={c.id}>
              <span class="co__mark">
                <span class="index tnum">{c.count}</span>
                <span class="label">{c.label}</span>
              </span>
              <span class="co__def">{c.def}</span>
            </h3>
            {/* Column-major fill needs a row count, and the row count is a
                function of how many tracks are showing. All three are
                declared here and the stylesheet picks one per breakpoint,
                so the fill order survives the fold instead of silently
                becoming row-major. */}
            <ul class="co__field" style={`--rows-3:${Math.ceil(c.people.length / 3)};--rows-2:${Math.ceil(c.people.length / 2)};--rows-1:${c.people.length}`}>
              {c.people.map((p) => (
                <li class="ent">
                  {/* alt="" ON PURPOSE. The name and the title sit as text
                      one gap to the right of this picture; an alt repeating
                      them makes a screen reader say "Gina Raimondo" twice and
                      tells it nothing the record does not already carry. The
                      photograph is an identification mark on a record that is
                      complete without it — which is also why the founders can
                      stand here with no portrait at all. */}
                  <Portrait class="ent__p" src={p.portrait} alt="" />
                  <span class="ent__b">
                    <span class="ent__n">{p.name}</span>
                    <span class="ent__t">{p.line}</span>
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      {/* "Membership is prospective" used to be half of this line, at 11px,
          at the bottom of the page, which is where a qualification goes when
          nobody has decided where it belongs. It is now the sentence on the
          photograph and the zero on the rail. What is left here is the one
          thing that genuinely is a footnote: these titles identify the person
          and are not offices held on the institute's behalf. */}
      <p class="label bd__foot" data-reveal="140">Titles for identification only</p>
    </div>
  </section>
</Base>

<style>
  /* ── THE SECOND RAIL ─────────────────────────────────────────────
     Two things on this page set a micro-label and a clause on ONE line:
     the founders band (Founders → "Both are Founding Partners of …") and
     every band head on the wall (06 · Policy → "They have governed at
     scale."). They were laid out independently — the first as an auto
     column plus a 5vw gap, the second as a flex row with two gaps — so
     the four clauses opened at x = 203, 182, 190 and 200. Four axes for
     one relationship, and three of them were a function of how many
     letters are in the word "Practice", which is not a design decision.

     One measured column instead. Left of the rail is the label; on the
     rail is the clause. The width is set to clear the longest mark the
     page sets — 06 + PRACTICE — at every viewport where a clause still
     sits beside it, and the value is declared once, here, so the axis
     cannot drift the next time a head is written. */
  .fs, .bd { --rail-2: clamp(7.5rem, 3.95rem + 6.05vw, 9.4rem); }

  /* ── Masthead ───────────────────────────────────────────────────── */
  /* --head-pad IS the shelf. It was being multiplied by 0.72 here to buy
     back vertical space, which put this page's first line 29px higher than
     /pilots/'s and gave the site a second answer to "where does a page start
     under the bar". A fraction of a shared token is a new token. If a page
     needs to be shorter it takes it out of its own stack, not out of the
     one measurement every route is supposed to agree on. */
  .pm { padding-block: calc(var(--nav-h) + var(--head-pad)) 0; }
  .pm__in { display: grid; }
  .pm__bridge {
    margin-top: clamp(0.9rem, 1.6vw, 1.35rem);
    max-width: 30ch;
  }
  .pm__main {
    margin-top: clamp(1.7rem, 3.2vw, 2.9rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(2rem, 5vw, 5.5rem);
    /* The index is stretched, not bottom-hung: it is locked to the display
       block's own two horizontals (see .pm__idx). */
    align-items: stretch;
  }
  .pm__h { max-width: 21ch; text-wrap: pretty; }
  /* motion.js builds .line at runtime, so it never carries the scope hash. */
  .pm__h :global(.line) { padding-bottom: 0.07em; margin-bottom: -0.07em; }

  /* Contents index: the only navigable object on the screen, hung on the
     right edge and set on the display's last baseline. */
  /* ONE LOCKUP, NOT TWO MASSES SET BY EYE. The index used to be hung on the
     bottom of the row and given a 0.3em shim, which put its top hairline 35px
     below the display's cap-line and its bottom hairline 15px below the last
     baseline — four candidate anchors, no hits. It is now bound to the display
     block's own two horizontals: the box top IS the cap-line (the display's
     first line box opens on its cap), and the bottom is pulled up off the
     h1's box by exactly the descent + half-leading + the .line shim, so the
     final hairline lands on the last baseline. That trailing distance is a
     fixed fraction of the poster size (line-height is a ratio), so the lock
     holds at every width the two sit side by side. The two rows then divide
     the interval equally instead of being sized by their own padding. */
  .pm__idx {
    display: grid;
    align-content: stretch;
    grid-auto-rows: 1fr;
    min-width: clamp(13rem, 20vw, 19.5rem);
    margin-bottom: calc(var(--step-poster) * 0.26);
  }
  .pm__idx-i {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    column-gap: clamp(1rem, 2vw, 1.75rem);
    align-items: baseline;
    /* The row is now as tall as its share of the lockup, so its type is
       centred in that band rather than pinned under the hairline. */
    align-content: center;
    padding-block: clamp(0.7rem, 1.3vw, 1rem);
    border-top: 1px solid var(--rule);
    transition: border-color var(--dur-hover) var(--ease-out);
  }
  /* Closed at the bottom as well as the top: two hairlines with type hanging
     off the underside of the second is a stack that was cut off, not an
     object. Both rows now have a floor, and the numerals, names and arrows
     all range on the same three axes. */
  .pm__idx-i:last-child { border-bottom: 1px solid var(--rule); }
  .pm__idx-n {
    font-family: var(--serif);
    font-weight: 300;
    font-size: var(--step-sub);
    line-height: 0.9;
    letter-spacing: -0.025em;
    color: var(--brass);
  }
  /* The name sits against the numeral rather than against the far edge:
     the row is closed by the arrow now, so the two marks that belong
     together — 02 and FOUNDERS — no longer stand 200px apart. */
  .pm__idx-l {
    line-height: 1.2;
    transition: color var(--dur-hover) var(--ease-out);
  }
  /* The house arrow, turned down the page, because that is where these two
     links go. Set at --mark: it is a glyph, not a word. */
  .pm__idx-a {
    --idx-arrow: 1.15rem;
    width: var(--idx-arrow);
    /* base.css caps every svg at max-width:100%, and 100% of a track that
       the pull below has already narrowed is a smaller arrow — the cap and
       the pull chase each other until the glyph has lost a quarter of its
       width. The arrow is 18px by declaration, not by whatever its column
       happens to measure. */
    max-width: none;
    align-self: center;
    justify-self: end;
    color: var(--mark);
    /* Turned a quarter, the arrow keeps its untransformed box for layout,
       so the ink — 8 of the viewBox's 10 units — ends up ((22 − 8) ÷ 22) ÷ 2
       of the box short of the column edge that every other mark on this
       page ranges to. Exactly that much, taken back. */
    margin-right: calc(var(--idx-arrow) * -0.318);
    transition: transform 460ms var(--ease-out), color var(--dur-hover) var(--ease-out);
  }
  /* Hover lights the row's own two hairlines — its top rule and the rule
     under it, which is the next row's top rule — so the thing that responds
     is the row, not a word inside it. */
  @media (hover: hover) {
    .pm__idx-i:hover,
    .pm__idx-i:hover + .pm__idx-i { border-top-color: var(--mark); }
    .pm__idx-i:last-child:hover { border-bottom-color: var(--mark); }
  }
  /* Keyboard gets the identical row treatment — the same hover/focus parity
     the homepage ledger and the /partner/ rows already keep. Outside the
     hover query, because a keyboard exists on touch devices too. */
  .pm__idx-i:focus-visible,
  .pm__idx-i:focus-visible + .pm__idx-i { border-top-color: var(--mark); }
  .pm__idx-i:last-child:focus-visible { border-bottom-color: var(--mark); }
  .pm__idx-i:hover .pm__idx-l,
  .pm__idx-i:focus-visible .pm__idx-l { color: var(--fg); }
  .pm__idx-i:hover .pm__idx-a,
  .pm__idx-i:focus-visible .pm__idx-a { color: var(--brass); transform: rotate(90deg) translateX(3px); }
  .pm__rule { margin-top: clamp(2rem, 3.8vw, 3.2rem); }

  /* ── Founders ───────────────────────────────────────────────────── */
  /* A band set into the page, full-bleed, opening on the masthead's rule so
     the first screen closes on the register rather than on air. */
  .fs {
    padding-block: clamp(2.25rem, 4vw, 4rem) clamp(2.5rem, 5vw, 4.75rem);
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }
  .fs__head {
    display: grid;
    grid-template-columns: var(--rail-2) minmax(0, 1fr);
    align-items: baseline;
  }
  /* The one affiliation both founders share, stated once at the bridge rung
     so neither record carries the least distinguishing text twice. */
  .fs__note { max-width: 34ch; }
  .fs__rule { margin-top: clamp(1.1rem, 2.2vw, 1.9rem); }

  /* The diptych. Two equal bays, one spine. */
  .dip {
    /* Declared once, because three things have to agree on them: the inset
       of the second bay, the pull that keeps the two bays equal, and the
       spine itself. --cred-gap is the air above the credential rule, and the
       spine has to cross exactly that much to stay one line. */
    --bay-pad: clamp(1rem, 2.5vw, 2.75rem);
    --cred-gap: clamp(1.1rem, 2.2vw, 1.8rem);
    margin-top: clamp(2rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 5vw, 5.5rem);
    /* Three shared rows — rank, name, credentials. The two records sit on
       the same three lines whatever the names do, which is the parity
       made visible rather than asserted. */
    grid-template-rows: auto auto;
    align-items: start;
  }
  .dip > .fr {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    align-content: start;
  }
  /* The spine sits on the axis between the two records, and the two records
     are the same width. The pull-left and the push-right have to be the SAME
     number for that to be true: they were 36px and 72px, so the second
     founder's column was 36px narrower than the first's and his record stood
     twice as far off the spine as hers. "Two equal bays" has to be measured,
     not asserted. */
  .dip > .fr + .fr {
    padding-left: var(--bay-pad);
    margin-left: calc(-1 * var(--bay-pad));
  }

  /* THE SPINE IS THE SECOND RECORD'S EDGE, NOT THE SECOND COLUMN'S.
     It used to be the article's border-left, and an article is as tall as
     its grid row — which is set by the LONGER name. So the rule opened at
     the top of a three-line name in the left bay and ran 108px before the
     right bay had put down a single mark. A pair that is bottom-aligned on
     purpose then read as a pair that had failed to align.

     The rule is hung off the record instead, in two segments that meet: the
     first spans the rank-and-name block plus the air above the credential
     rule (and the hairline itself, hence the +1px), the second spans the
     credential block. Together they are one unbroken line that starts on
     Judd Olanoff's first mark and ends on his last, and there is no width
     at which it can outrun him. */
  .dip > .fr + .fr .fr__id,
  .dip > .fr + .fr .fr__cred { position: relative; }
  .dip > .fr + .fr .fr__id::before,
  .dip > .fr + .fr .fr__cred::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--bay-pad));
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule);
  }
  .dip > .fr + .fr .fr__id::before {
    bottom: auto;
    height: calc(100% + var(--cred-gap) + 1px);
  }

  .fr__meta {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: clamp(0.85rem, 1.6vw, 1.35rem);
  }
  /* ONE LINE, CROSSING THE SPREAD. Both names are set on the same hairline
     rather than hung from the same ceiling: the rule is the floor of the
     name row in both bays, and each name grows UP off it by however many
     lines it needs. A three-line name and a one-line name then differ where
     a reader reads air — above — instead of leaving a 402x108 hole under
     the shorter one. Nothing about the two records differs by choice. */
  /* Rank line and name travel together and stand on the rule: a one-line
     name and a three-line name are two records on one baseline, not one
     record with a hole under it. */
  .fr__id { align-self: end; }
  .fr__name { max-width: 13ch; text-wrap: balance; }
  .fr__cred {
    border-top: 1px solid var(--rule);
    margin-top: var(--cred-gap);
    padding-top: clamp(0.9rem, 1.7vw, 1.35rem);
  }
  .fr__credhead {
    margin-bottom: clamp(0.85rem, 1.7vw, 1.3rem);
  }
  .fr__list {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    gap: 0.42rem;
    font-size: var(--step-lede);
    line-height: 1.4;
    color: var(--fg-mute);
  }

  /* ── The seam ───────────────────────────────────────────────────── */
  /* The page turns over here, and the turn is a photograph. It counts as one
     of the page's three ground changes (tokens.css, rule 4), which is why
     the founders band and this frame and the cream field are all there is. */
  .seam {
    position: relative;
    display: grid;
    align-content: end;
    /* A FULL-VIEWPORT EVENT. This band was 490px on a 3944px page — a 2.94:1
       strip, sized like a divider. The one asset here that typography cannot
       reproduce now gets a whole screen, and the room is shown at 1.02 zoom
       so it holds its own scale instead of being cropped to a letterbox. */
    min-height: clamp(30rem, 96vh, 60rem);
    isolation: isolate;
    background: var(--ink-900);
  }
  /* THE ANCHOR MOVED. #board used to sit on the cream field, so the
     masthead's "16 PROSPECTIVE BOARD" jumped a reader straight into sixteen
     photographs and past the only place the page says the board is not yet seated.
     It is on this section now: the link lands on the empty room with the
     sentence set into it, and the roster is what comes after. A full-bleed
     frame takes no stop — the bar is meant to sit over its top edge. */
  .seam { scroll-margin-top: 0; }
  .seam__in {
    position: relative;
    z-index: 3;
    padding-block: clamp(1.6rem, 3vw, 2.6rem);
    display: grid;
    justify-items: start;
    row-gap: clamp(0.9rem, 1.8vw, 1.5rem);
  }
  /* THE SENTENCE. Flush left in the scrim's deep zone at the foot of the
     frame — the align='left' ramp in Figure.astro is heavy exactly here,
     which is why the type is here and not centred on the room's axis. The
     measure is cut so the two clauses stack one per line at every width the
     line needs two: a break at the full stop is the whole point of it. */
  .seam__h {
    max-width: 19ch;
    text-wrap: balance;
    --settle-shift: 2.4vh;
    --settle-origin: 0% 100%;
    --dur-3: 1400ms;
  }
  .seam__h :global(.line) { padding-bottom: 0.09em; margin-bottom: -0.09em; }

  /* ── Prospective board ──────────────────────────────────────────── */
  .bd {
    /* The photograph above is the break; the cream field does not need to
       open on 10rem of nothing as well. */
    padding-block: clamp(3rem, 1.5rem + 4.5vw, 6rem) clamp(3rem, 5vw, 5.5rem);
  }
  /* #board moved up to the seam, so this field no longer takes a scroll
     stop: the roster is reached THROUGH the photograph and its sentence, not
     past them. That is the point of moving the anchor. */
  .bd__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(2rem, 5vw, 5.5rem);
  }
  .bd__head > .eyebrow { grid-column: 1; }
  .bd__rule,
  .bd__bridge,
  .bd__claim { grid-column: 1 / -1; }
  .bd__rule { margin-top: clamp(1rem, 1.8vw, 1.5rem); }
  .bd__bridge {
    margin-top: clamp(1.4rem, 2.6vw, 2.2rem);
    /* The clause runs the measure. Held at 44ch it set in three short lines
       with an 800px void beside them; the void was the scene's weakest
       object and the clause is its payload, so the clause gets the width. */
    max-width: 74ch;
  }
  /* The claim is a two-mass row: the sentence takes the whole measure and
     wraps onto a short second line; the tally sits on that line's foot at
     the right edge, so the width is closed by a mark and not by the page
     margin. This is the one scene on the page whose armature is not a left
     rail with a micro-label parked in the far corner. */
  .bd__claim {
    margin-top: clamp(1.6rem, 3.2vw, 2.75rem);
    /* Returned to the left rule. It used to hang at x=296, an edge nothing
       else on the page shared, so it read as an arbitrary indent rather than
       as a decision. The page gets one grid break and the photograph has it. */
    margin-left: 0;
  }
  /* DROPPED ONE RUNG, ON PURPOSE. It held --step-feature when the roster was
     sixteen names and the loudest thing on the page could safely be what the
     board would do. With sixteen faces under it that line is the page's
     biggest unearned claim, so the series-breaker moved to the sentence on
     the photograph and this took --step-head. The two-clause balance the
     copy was cut for still holds — the clauses are the same length, so it
     breaks at the full stop at whatever rung it is set. */
  .bd__h {
    max-width: none;
    text-wrap: balance;
    --settle-shift: 2.2vh;
    --settle-origin: 0% 100%;
    --dur-3: 1250ms;
  }
  .bd__head { align-items: baseline; }
  .bd__h :global(.line) { padding-bottom: 0.09em; margin-bottom: -0.09em; }
  .bd__h :global(.line > span) { transition-delay: calc(var(--line-delay, 0ms) + 120ms); }

  /* ── The wall ───────────────────────────────────────────────────── */
  /* Three bands, each a constituency, all three standing on ONE set of
     column tracks. The bands differ in what their heads say and in nothing
     else: same tracks, same gutter, same rules, same two registers. */
  .wall {
    margin-top: clamp(2.5rem, 5vw, 5rem);
    border-top: 1px solid var(--mark);
    /* THE ONE PLACE THE ROSTER'S GEOMETRY IS DECLARED. Every band reads
       --cols, --gut and --rows from here, so all three bands stand on the
       same tracks and a rule cannot land at a fourth x-value. --rows is
       written as a pointer into the three counts each field carries, so
       changing the column count at a breakpoint changes the fill with it. */
    --cols: 3;
    --gut: clamp(1.4rem, 2.6vw, 2.6rem);
    /* Everything inside the plate hangs off its column rule by the same
       measure — the band head included. The plate's own left edge is the
       page's left rule, so the vertical rules and the horizontal band rules
       start on one x and the whole roster reads as a ruled sheet rather than
       as text with lines near it. */
    --tick: clamp(0.8rem, 1.15vw, 1.15rem);
    /* THE PORTRAIT IS A COLUMN INSIDE THE RECORD, and its width is declared
       here with the rest of the plate's geometry so every one of the sixteen
       is the same object. 69px at 1440 makes an 86px plate at 4:5 — about the
       height of a name and its title line, which is the size at which a face
       is a face and sixteen of them are still a list. Bigger and the section
       becomes a wall of headshots; smaller and it is an avatar. */
    --pw: clamp(3.5rem, 4.8vw, 4.9rem);
    --pgap: clamp(0.7rem, 1.05vw, 1.1rem);
    /* How far back the whole set is held off the page. See people-portrait
       .astro: cream over the picture, doing two jobs at once — sixteen source
       backgrounds brought into one band, and the band kept a step under the
       ink of the names it belongs to. */
    --pp-veil: 0.2;
  }
  /* The plate's column head. Same two-part mark as a band head — an index
     numeral and a micro label — but spread to the plate's two edges instead
     of hung on the second rail, so it reads as a tally across the sheet and
     never as a fourth constituency. It indents by --tick like everything
     else inside the plate; its right mark closes on the plate's right edge. */
  .wall__state {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.9rem clamp(1.5rem, 4vw, 4rem);
    padding: clamp(0.85rem, 1.5vw, 1.25rem) 0 clamp(0.95rem, 1.6vw, 1.35rem);
    padding-left: var(--tick);
    border-bottom: 1px solid var(--rule);
  }
  .wall__st { display: flex; align-items: baseline; gap: 0.85rem; }

  .co {
    padding-block: clamp(1.9rem, 3.6vw, 3.1rem);
    border-bottom: 1px solid var(--rule);
  }
  .co:last-child { border-bottom-color: var(--mark); }
  /* If the script never runs, nothing may stay under its mask. */
  :global(html:not(.js)) .co,
  :global(html:not(.js)) .fr,
  :global(html:not(.js)) .fs__rule,
  :global(html:not(.js)) .wall { clip-path: none; }

  /* THE SECOND RAIL, USED. Count and label are one mark and they hold the
     left rule; the clause opens on the rail. The head is a grid rather than
     a flex row precisely so the clause's x does not depend on how long the
     word "Practice" is. */
  .co__head {
    display: grid;
    grid-template-columns: var(--rail-2) minmax(0, 1fr);
    padding-left: var(--tick);
    align-items: baseline;
    font-weight: 400;
    margin-bottom: clamp(1.25rem, 2.4vw, 2rem);
  }
  .co__mark {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    /* THE COUNT IS INK HERE, NOT BRASS. .index is the brass register, and on
       a cream ground brass resolves to --brass-deep — a fourth value that is
       neither the sanctioned #C4A469 nor an ink, invented only because true
       brass on cream measures 2.0 : 1 and cannot carry 13px of text. The
       palette is closed at three, so the count drops into the same ink as
       the label it belongs to and the mark reads as one object. Brass on
       this page stays where it is legible: the masthead, on navy. */
    /* The rail is measured for "06 Practice" at every width it is used at;
       if a longer label is ever added, it stops the mark rather than
       silently pushing the clause off the rail. */
    min-width: 0;
  }
  /* The count keeps the index register's brass. `.on-cream` already remaps
     --brass to --brass-deep for exactly this, and #7E6431 on #F2EDE3 measures
     4.79 : 1 — over the 4.5 floor at 13px. /forum/ and /partner/ both let the
     remap do its work on their cream grounds; this page was the one that
     opted out, so a reader met the same numeral in two colours. */
  .co__def {
    font-size: var(--step-body);
    line-height: 1.4;
    color: var(--fg-mute);
  }

  /* THE PLATE. Three tracks, one gutter, declared once on the wall so every
     band inherits the same geometry and no band can invent its own. The
     column count is the only thing a breakpoint changes; the row count
     follows it so the fill stays column-major at every width. */
  .co__field {
    /* The pointer has to be resolved on the element that carries the three
       counts — a custom property is substituted where it is DECLARED, so
       --rows: var(--rows-3) written on .wall would resolve against .wall,
       where --rows-3 does not exist, and take grid-template-rows down with
       it. It is declared here, beside the inline counts. */
    --rows: var(--rows-3);
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-template-rows: repeat(var(--rows), auto);
    column-gap: var(--gut);
    row-gap: clamp(1.35rem, 2.3vw, 2.15rem);
  }

  /* THE COLUMN RULES. They used to be painted on this field as a repeating
     gradient across its full height — one continuous edge per track, drawn
     on the period (100% + gutter) / cols so a hairline landed on every track
     origin. It is the right geometry and the wrong object. Two of the three
     constituencies hold five names, so on three tracks the last cell of the
     third column is EMPTY, and the field's rule ran 93px down past Helen
     Zhang and past Kyla Scanlon into nothing — twice, in the section that is
     the whole payload of the page. A hairline beside no name is not a
     column edge, it is a bug with a straight edge.

     So the rule is drawn on the entry instead: an absolutely positioned
     hairline on the entry's own left edge, top to bottom of its row box.
     The old argument against this — that an entry's border stops where the
     entry stops, so a reader sees seven edges where the grid has three —
     was an argument against the OLD roster, which was a wrapped run of
     shrink-to-fit entries. On fixed tracks every entry starts on one of the
     same three x-values, so the rules still stack into three edges; the only
     thing that changes is that an edge now ends with its last name. */
  /* Name over office, top-aligned in the track: a person is a name and one
     title line — the brief's whole allowance, and the photograph does not
     buy a third mark. Rows are as tall as their tallest entry and every
     entry starts at the top of its row, so the pictures range across a row
     even when one office takes two lines and its neighbour takes one. */
  /* TWO COLUMNS, NOT A CARD. The picture is the record's left column and the
     name and title are its right one; the column rule that opens the record
     runs down the outside of the picture, so a reader sees a ruled file with
     a photograph attached to it rather than a tile with a caption. That is
     the whole difference between a docket and a board page, and it is the
     difference the page has to make: nobody on this sheet has agreed to
     serve. The picture is top-aligned in the row, so all three (or two, or
     one) portraits in a row open on the same line whatever their names do. */
  .ent {
    position: relative;
    display: grid;
    grid-template-columns: var(--pw) minmax(0, 1fr);
    column-gap: var(--pgap);
    align-content: start;
    padding-left: var(--tick);
  }
  /* The name and its title are ONE object beside the picture, not two rows of
     a grid the picture also sits in. Written as two cells of .ent they were
     spaced by a track the 86px portrait was setting, which put 30px of air
     between a name and the title that belongs to it — the two marks a reader
     has to read as one. They stack in their own box, on their own leading. */
  .ent__p { align-self: start; }
  .ent__b { display: grid; align-content: start; row-gap: 0.12em; min-width: 0; }
  /* The rule itself: not a border, because a border sits inside the padding
     and would push every name 1px off the track origin the band head is
     already ranged on. An absolutely positioned hairline on the entry's own
     left edge, floor to ceiling of its row box — the entry is stretched to
     its row, so the three rules of a row open and close on the same two
     y-values and the plate still reads as one ruled sheet. */
  /* AND IT IS DASHED, WHICH IS THE ONLY THING ON THIS PAGE DRAWN THAT WAY.
     Every other hairline the site owns is solid: the founders' spine, the
     band separators, the plate's own top and bottom edge. Sixteen records
     open on a broken line instead. It is not decoration and it is not a
     texture — it is the difference between a record that is closed and a
     record that is not, drawn in the one vocabulary this page already has,
     and it works at a glance and without a word being read. A reader who
     never reaches the sentence on the photograph and never parses the 00 on
     the rail still sees that these sixteen files are open and the two above
     them are not.

     Dash and gap are set in absolute px, not in a fraction of the row: the
     entries are different heights, and a dash scaled to its own row would
     make sixteen different rules. */
  .ent::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background-image: linear-gradient(to bottom, var(--rule) 0 5px, transparent 5px 10px);
    background-size: 1px 10px;
    background-repeat: repeat-y;
  }
  .ent__n {
    font-family: var(--serif);
    font-weight: 340;
    font-size: var(--step-sub);
    line-height: 1.06;
    letter-spacing: -0.017em;
    color: var(--fg);
    text-wrap: balance;
  }
  /* One register for all sixteen. The old wall set the first band two rungs
     up and let the run's rag do the rest, which ranked a constituency by
     type size on a page that has no standing to rank one. What separates
     Policy from Capital is written in the head above the band. */
  .ent__t {
    font-size: var(--step-body);
    font-weight: 400;
    line-height: 1.4;
    color: var(--fg-mute);
    text-wrap: pretty;
  }

  .bd__foot {
    justify-self: end;
    text-align: right;
    padding-top: clamp(1.1rem, 2vw, 1.6rem);
    line-height: 1.5;
    text-wrap: balance;
  }

  /* ── Narrow ─────────────────────────────────────────────────────── */
  /* THE ONLY THING A BREAKPOINT CHANGES ABOUT THE ROSTER. Column count and
     the row count that keeps the fill column-major; the gutter, the rules,
     the indent and both registers are the same object at every width. At
     980 a track is 284px and a two-line office is the worst case; below it
     three tracks start breaking names, so the plate goes to two, then to
     one at 620. */
  /* The folds moved out from 980/620 to 1140/680: a record is ~85px wider
     than it was, because it now opens with a picture. Same rule as before —
     three tracks hold while a two-line office still fits beside a face. */
  @media (max-width: 1140px) { .wall { --cols: 2; } .co__field { --rows: var(--rows-2); } }
  @media (max-width: 680px) { .wall { --cols: 1; } .co__field { --rows: var(--rows-1); } }

  @media (max-width: 1180px) {
    .bd__bridge { max-width: 52ch; }
  }
  @media (max-width: 980px) {
    /* The diptych folds into two stacked bays. The spine becomes the rule
       between them, so the pair survives the fold as a pair. */
    .dip { grid-template-columns: minmax(0, 1fr); row-gap: 0; }
    /* Folded, the spine is the horizontal rule between the stacked bays —
       so the vertical one is not drawn at all, rather than left to collapse
       to a stub. */
    .dip > .fr + .fr .fr__id::before,
    .dip > .fr + .fr .fr__cred::before { content: none; }
    .dip > .fr + .fr {
      padding-left: 0;
      margin-left: 0;
      border-top: 1px solid var(--rule);
      padding-top: clamp(2rem, 4.5vw, 3rem);
      margin-top: clamp(2rem, 4.5vw, 3rem);
    }
    .fr__name { max-width: 18ch; }
    .fs__head { grid-template-columns: minmax(0, 1fr); row-gap: 0.9rem; }
  }
  @media (max-width: 860px) {
    /* Masthead stacks: the contents index sits under the display line and
       runs the full measure, so it stays an object rather than a scrap. */
    .pm__main { grid-template-columns: minmax(0, 1fr); row-gap: clamp(1.9rem, 6vw, 2.75rem); }
    .pm__idx { min-width: 0; margin-bottom: 0; grid-auto-rows: auto; }
  }
  @media (max-width: 760px) {
    /* At this width the claim is a stack, and both display lines are
       balanced so neither closes on a one-word orphan. */
    .bd__claim { margin-left: 0; margin-right: 0; }
    .bd__h, .pm__h { text-wrap: balance; }
  }
  @media (max-width: 700px) {
    .bd__head { grid-template-columns: minmax(0, 1fr); }
    .fs__note { max-width: 30ch; }
    /* Below this the rail is narrower than the clause needs, so the clause
       leaves it and takes its own row under the mark — the same fold the
       founders head already makes at 980. */
    .co__head { grid-template-columns: minmax(0, 1fr); row-gap: 0.6rem; }
    .co__def { max-width: 40ch; }
  }
  @media (max-width: 620px) {
    /* A 34vw band is 130px on a phone: the room stops being a room. The
       seam keeps a readable frame instead of a stripe. */
    .seam { min-height: min(92vh, 42rem); }
    /* At 390 the line needs two lines and the break has to land on the full
       stop. 13ch put "forward." on the second line and made three; the
       measure has to be wider than the LONGER clause (20 characters), not
       narrower than it, and `text-wrap: balance` then has exactly one place
       to break. */
    .seam__h { max-width: 21ch; }
    /* The frame's credit sits in the bottom-right corner and the sentence's
       second line now reaches into it at this width. The type gives way, not
       the credit: refs/PHOTO-FACTS.md is why the credit is there at all. */
    .seam__in { padding-bottom: clamp(2.9rem, 9vw, 3.6rem); }
    /* ONE TRACK. Two 163px columns at 390 put "Tess deBlanc-Knowles" on two
       lines and "First Chief Technology Officer of the United States" on
       four, which is not a denser roster, it is a narrower one. The plate
       becomes a single track. The name keeps its register — sixteen people
       set the same way is the point of the plate and a breakpoint is not a
       reason to rank them differently — and the rule follows the column
       count on its own, because it is drawn from --cols. */
    .co__field { row-gap: 1.15rem; }
    .bd__foot { justify-self: start; text-align: left; }
    /* The masthead line was breaking into four ragged lines at 390. Given
       its own tighter measure and a wrap it can balance, it sets in three. */
    .pm__h { max-width: 14ch; line-height: 0.98; }
    .pm__idx-i { column-gap: 1rem; }
  }

  /* The claim used to need a rung rescue here — at --step-feature its second
     clause outran a 440px column and broke mid-sentence. It sits at
     --step-head at every width now, so the rescue is the default and the
     override is gone. */

  @media (prefers-reduced-motion: reduce) {
    .bd__h :global(.line > span) { transition-delay: 0ms; }
    .pm__idx-i, .pm__idx-l, .pm__idx-a { transition-duration: 1ms; }
    /* The arrow lights, it does not slide. It keeps its quarter-turn. */
    .pm__idx-i:hover .pm__idx-a,
    .pm__idx-i:focus-visible .pm__idx-a { transform: rotate(90deg); }
  }
</style>
