---
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { founders, board } from '../data/site.js';
import { cohortsOf } from '../components/people-cohorts.js';

/* ── Portrait drop-in slot ────────────────────────────────────────────
   We hold no rights-cleared portraits of the founders, so the page is
   built to be complete without them. Drop either file into public/media/

       public/media/founder-mckelvy.jpg
       public/media/founder-olanoff.jpg     (.jpeg / .png / .webp also work)

   and that founder's record switches from the two-column register
   (name | credentials) to a three-column one (portrait | name | credentials)
   with no other change. While a file is absent nothing is rendered in its
   place — the record is a typographic entry, not a frame waiting for an
   image, so the empty state is designed air and never a broken box. It also
   keeps the console clean: no request is made for a file that is not there. */
const EXTS = ['.jpg', '.jpeg', '.png', '.webp'];
function resolvePortrait(p) {
  if (!p) return null;
  const stem = p.replace(/\.(jpe?g|png|webp)$/i, '');
  for (const ext of EXTS) {
    const rel = `${stem}${ext}`;
    try {
      if (fs.existsSync(fileURLToPath(new URL(`../../public${rel}`, import.meta.url)))) return rel;
    } catch { /* unresolvable path — treat as absent */ }
  }
  return null;
}

const people = founders.map((f, i) => ({
  ...f,
  index: String(i + 1).padStart(2, '0'),
  portraitSrc: resolvePortrait(f.portrait),
  credentials: f.detail.replace(/\.\s*$/, '').split(/\.\s+/),
}));

/* Both founders carry the identical two affiliations. Printing them twice
   made the least distinguishing text the loudest text in each record, so
   they are stated once, above the register, and each record then carries
   only what separates the two men. */
const sharedAffiliation = 'Both are Founding Partners of K.\u00A0Ventures and of The Lion\u00A0Forum.';

/* Cohorts live in src/components/people-cohorts.js so this page and the
   homepage scene group the roster identically. Each cohort arrives split
   into a lead entry and the rest. */
const cohorts = cohortsOf(board);

const boardCount = board.length;
const founderCount = String(founders.length).padStart(2, '0');
---
<Base title="People" description="The founders and prospective board of the Lion Forum Institute.">

  <!-- ── Masthead ─────────────────────────────────────────────────── -->
  <section class="pm">
    <div class="shell pm__in">
      <p class="label" data-reveal>People</p>
      {/* The display holds the left measure; the contents index holds the
          right and sits on the display's baseline, so the top screen has an
          object in both halves instead of one line and a void. */}
      <div class="pm__main">
        <h1 class="display display--hero pm__h lines">The people accountable for the work.</h1>
        <nav class="pm__idx" aria-label="On this page">
          <a class="pm__idx-i" href="#founders" data-reveal="240">
            <span class="pm__idx-n tnum">{founderCount}</span>
            <span class="pm__idx-l">Founders</span>
          </a>
          <a class="pm__idx-i" href="#board" data-reveal="320">
            <span class="pm__idx-n tnum">{boardCount}</span>
            <span class="pm__idx-l">Prospective board</span>
          </a>
        </nav>
      </div>
      <hr class="rule pm__rule" data-reveal="400" />
    </div>
  </section>

  <!-- ── Founders ─────────────────────────────────────────────────── -->
  <section class="fs" id="founders" aria-labelledby="founders-h">
    <div class="shell">
      <header class="rg__head fs__head">
        <h2 class="label rg__eyebrow" id="founders-h" data-reveal>Founders</h2>
        <p class="fs__note" data-reveal="140">{sharedAffiliation}</p>
      </header>

      {people.map((p) => (
        <article class:list={['fr', { 'fr--portrait': p.portraitSrc }]} data-reveal="60">
          <hr class="rule" />
          <div class="fr__row">
            {p.portraitSrc && (
              <div class="fr__portrait">
                <Figure src={p.portraitSrc} alt={p.name} ratio="4 / 5" grade={0.34} />
              </div>
            )}
            <div class="fr__lead">
              <p class="fr__meta">
                <span class="index tnum">{p.index}</span>
                <span class="label label--brass">{p.role}</span>
              </p>
              <h3 class="display fr__name">{p.name}</h3>
            </div>
            {/* What separates the two men, set at reading size and hung on
                the right edge — the shared affiliation is stated once above. */}
            <ul class="fr__cred">
              {p.credentials.map((c) => <li>{c}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Prospective board ────────────────────────────────────────── -->
  <section class="scene on-cream bd" id="board" aria-labelledby="board-h">
    <div class="shell">
      <header class="rg__head bd__head">
        <p class="label rg__eyebrow" data-reveal>Prospective board</p>
        <p class="stat stat--end rg__tally" data-reveal="220">
          <span class="stat__n tnum">{boardCount}</span>
          <span class="stat__l">Names put forward</span>
        </p>
        <h2 class="display display--l bd__h lines" id="board-h">Advising the pilots. Opening the doors they need.</h2>
      </header>

      {/* Two tiers inside every cohort: one lead entry at display scale, then
          the rest as a ruled register. Sixteen peers at one size is a
          directory; a lead plus a register is a masthead. */}
      {cohorts.map((c, ci) => (
        <section class:list={['cg', `cg--${ci}`]} aria-labelledby={c.id}>
          <span class="cg__rule" data-reveal={String(ci * 70)} aria-hidden="true"></span>
          <div class="cg__body">
            <h3 class="cg__rail" id={c.id} data-reveal={String(ci * 70 + 55)}>
              <span class="cg__n tnum">{String(c.people.length).padStart(2, '0')}</span>
              <span class="cg__l">{c.label}</span>
              <span class="cg__def">{c.def}</span>
            </h3>
            <div class="cg__col">
              <article class="pl" data-reveal={String(ci * 70 + 120)}>
                <h4 class="display pl__n">{c.lead.name}</h4>
                <p class="pl__t">{c.lead.line}</p>
              </article>
              <ul class="cg__list">
                {c.rest.map((p, i) => (
                  <li class="pn" data-reveal={String(ci * 70 + 230 + i * 62)}>
                    <span class="pn__n">{p.name}</span>
                    <span class="pn__t">{p.line}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      ))}

      <span class="cg__rule" data-reveal aria-hidden="true"></span>
      <p class="bd__foot" data-reveal="70">Membership is prospective · Titles for identification</p>
    </div>
  </section>
</Base>

<style>
  /* ── Masthead ───────────────────────────────────────────────────── */
  /* Sized so the statement and the contents land inside the first screen. */
  .pm {
    padding-block: calc(var(--nav-h) + var(--head-pad)) 0;
  }
  .pm__in { display: grid; gap: clamp(2rem, 5vw, 4rem); }
  .pm__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(2rem, 5vw, 5.5rem);
    align-items: end;
  }
  .pm__h { max-width: 13ch; }
  /* motion.js builds .line at runtime, so it never carries the scope hash. */
  .pm__h :global(.line) { padding-bottom: 0.07em; margin-bottom: -0.07em; }

  /* Contents index: the only navigable object on the screen, hung on the
     right edge and set on the display's last baseline. */
  .pm__idx {
    display: grid;
    align-content: end;
    min-width: clamp(13rem, 20vw, 19.5rem);
    padding-bottom: 0.3em;
  }
  .pm__idx-i {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: clamp(1rem, 2vw, 1.75rem);
    align-items: baseline;
    padding-block: clamp(0.7rem, 1.3vw, 1rem);
    border-top: 1px solid var(--rule);
  }
  .pm__idx-n {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.35rem, 1.05rem + 1vw, 1.9rem);
    line-height: 0.9;
    letter-spacing: -0.025em;
    color: var(--brass);
  }
  .pm__idx-l {
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: 0.155em;
    text-transform: uppercase;
    line-height: 1.2;
    color: var(--fg-mute);
    text-align: right;
    transition: color 380ms var(--ease-out);
  }
  @media (hover: hover) {
    .pm__idx-i:hover .pm__idx-l { color: var(--fg); }
  }

  /* ── The two registers share one head lockup ────────────────────── */
  /* Founders and Prospective board open the same way — eyebrow at the left
     of the measure, a right-hand anchor — so the page reads as a pair of
     registers rather than two unrelated sections. */
  .rg__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    column-gap: clamp(1.5rem, 3vw, 3.5rem);
  }
  .rg__eyebrow { grid-column: 1; grid-row: 1; }
  .rg__tally { grid-column: 2; grid-row: 1 / span 2; }

  .stat { display: grid; gap: 0.5rem; }
  .stat--end { text-align: right; justify-items: end; }
  .stat__n {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.5rem, 1.08rem + 1.45vw, 2.4rem);
    line-height: 0.9;
    letter-spacing: -0.025em;
  }
  .stat__l {
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: 0.155em;
    text-transform: uppercase;
    color: var(--fg-mute);
    line-height: 1;
  }

  /* ── Founders: the register at full scale ───────────────────────── */
  /* Opens tight — its head sits on the masthead's rule, so the first screen
     ends on the register rather than on air. The cream flip below is the
     page's one big change of gear, and it gets all the room instead. */
  .fs {
    padding-block: clamp(1.35rem, 2.6vw, 2.6rem) clamp(0.5rem, 1.2vw, 1.25rem);
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }
  .fs__head { margin-bottom: clamp(1.75rem, 3.4vw, 3rem); }
  /* The one affiliation both founders share, stated once. It opens the
     right-hand column that the credential lines below continue. */
  .fs__note {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    text-align: right;
    max-width: 26ch;
    font-size: var(--step-xs);
    line-height: 1.5;
    color: var(--fg-mute);
    text-wrap: pretty;
  }

  .fr__row {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    grid-template-areas: 'lead cred';
    column-gap: clamp(1.5rem, 3vw, 3.5rem);
    row-gap: clamp(1rem, 2vw, 1.75rem);
    padding-block: clamp(1.75rem, 4vw, 3.5rem) clamp(2.25rem, 5.5vw, 5rem);
  }
  .fr--portrait .fr__row {
    grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
    grid-template-areas: 'portrait lead cred';
  }
  /* The cream flip below supplies the air, so the closing record does not
     also carry a five-rem foot. */
  .fr:last-child .fr__row { padding-bottom: clamp(1.5rem, 3vw, 2.9rem); }
  .fr__portrait { grid-area: portrait; align-self: start; }
  .fr__lead { grid-area: lead; }

  .fr__meta {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: clamp(0.85rem, 1.6vw, 1.35rem);
  }
  .fr__name {
    /* Second-tier display size — local to this piece; the page's one
       hero-scale moment is the masthead. */
    font-size: clamp(2rem, 1.05rem + 3.1vw, 3.9rem);
    line-height: 1;
    letter-spacing: -0.024em;
    max-width: 16ch;
  }

  /* Credentials at reading size, hung on the right edge and set flush with
     the foot of the name — the differentiating line, not a footnote. */
  .fr__cred {
    grid-area: cred;
    align-self: end;
    list-style: none; margin: 0; padding: 0;
    display: grid;
    gap: 0.3rem;
    justify-self: end;
    text-align: right;
    font-size: var(--step-s);
    line-height: 1.45;
    color: var(--fg-mute);
    padding-bottom: 0.12em;
  }

  /* ── Prospective board ──────────────────────────────────────────── */
  /* Opens wide — this is the page's second beat and the only cream ground.
     Closes tighter than it opens: the last rule and its note are the ending,
     so there is no dead cream between them and the footer. */
  .bd {
    padding-block: clamp(5rem, 2.5rem + 8vw, 10rem) clamp(3rem, 5vw, 5.5rem);
    scroll-margin-top: var(--nav-h);
  }
  .bd__head { margin-bottom: clamp(2.25rem, 4.5vw, 4rem); }
  .bd__h {
    grid-column: 1;
    grid-row: 2;
    margin-top: var(--stack-2);
    max-width: 20ch;
    /* The one display line in this scene gets the slowest, latest ramp on
       the page — motion sorts the hierarchy instead of dimming it evenly. */
    --dur-3: 1400ms;
  }
  .bd__h :global(.line) { padding-bottom: 0.09em; margin-bottom: -0.09em; }
  .bd__h :global(.line > span) { transition-delay: calc(var(--line-delay, 0ms) + 120ms); }

  /* Structural rules. They wipe in from the left rather than fading, so
     the frame of the section arrives before its contents. */
  .cg__rule {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--rule);
    opacity: 1;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 820ms var(--ease-io) var(--reveal-delay, 0ms);
    will-change: transform;
  }
  .cg__rule.is-in { transform: scaleX(1); }

  .cg__body {
    display: grid;
    grid-template-columns: minmax(0, 2.7fr) minmax(0, 9.3fr);
    column-gap: clamp(1.5rem, 3vw, 3.5rem);
  }

  /* The three cohorts decelerate: Policy is the widest-set and the tallest,
     Practice the tightest, so the section has a rhythm and an ending rather
     than three equal slabs. --pn-lead scales the register's row rhythm with
     the block padding, 1.5× down to 1×. */
  .cg--0 .cg__body { padding-block: clamp(1.9rem, 3.7vw, 3.3rem) clamp(3rem, 6.1vw, 5.4rem); --pn-lead: 0.86rem; }
  .cg--1 .cg__body { padding-block: clamp(1.6rem, 3.1vw, 2.7rem) clamp(2.25rem, 4.5vw, 4rem);  --pn-lead: 0.7rem; }
  .cg--2 .cg__body { padding-block: clamp(1.3rem, 2.5vw, 2.2rem) clamp(1.6rem, 3.2vw, 2.8rem); --pn-lead: 0.57rem; }

  /* Per-cohort rail: count, constituency, and one line saying what the
     cohort is for — an authored margin, not leftover gutter. Sticky, so it
     holds beside its own names for the length of the block. */
  .cg__rail {
    position: sticky;
    top: calc(var(--nav-h) + clamp(1.25rem, 3vw, 2.5rem));
    align-self: start;
    display: grid;
    gap: clamp(0.6rem, 1vw, 0.85rem);
    font-weight: 400;
  }
  .cg__n {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.5rem, 1.08rem + 1.45vw, 2.4rem);
    line-height: 0.9;
    letter-spacing: -0.025em;
  }
  .cg__l {
    font-family: var(--sans);
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--brass);
  }
  .cg__def {
    font-family: var(--sans);
    font-size: var(--step-xs);
    font-weight: 370;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.45;
    color: var(--fg-mute);
    max-width: 22ch;
    text-wrap: pretty;
  }

  /* ── Tier one: the cohort's lead entry ──────────────────────────── */
  .pl {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(1.5rem, 3vw, 3rem);
    align-items: baseline;
    padding-bottom: clamp(0.9rem, 1.7vw, 1.5rem);
    border-bottom: 1px solid var(--rule);
    --reveal-y: 12px;
  }
  .pl__n {
    /* Sits a clear step under the section's display line — the leads are
       landmarks inside the index, not three more headlines. */
    font-size: clamp(1.85rem, 1.05rem + 2.1vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.021em;
  }
  .pl__t {
    font-size: var(--step-s);
    line-height: 1.4;
    color: var(--fg-mute);
    text-align: right;
    white-space: nowrap;
  }

  /* ── Tier two: the register ─────────────────────────────────────── */
  .cg__list { list-style: none; margin: 0; padding: 0; display: grid; }
  .pn {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    column-gap: clamp(1.25rem, 3vw, 3rem);
    align-items: baseline;
    padding-block: var(--pn-lead, 0.7rem);
    border-bottom: 1px solid var(--rule-soft);
    /* Small items move a shorter distance than the display line. */
    --reveal-y: 8px;
  }
  .pn:last-child { border-bottom: 0; }
  .pn__n {
    font-family: var(--serif);
    font-weight: 340;
    font-size: clamp(1.15rem, 0.98rem + 0.5vw, 1.38rem);
    line-height: 1.15;
    letter-spacing: -0.012em;
  }
  /* Second gear inside the row: the name lands, then the title settles
     beside it. Motion ranks the pair instead of gating both at once. */
  .pn__t {
    font-size: var(--step-xs);
    line-height: 1.4;
    color: var(--fg-mute);
    text-align: right;
    text-wrap: pretty;
    opacity: 0;
    transform: translate3d(0, 4px, 0);
    transition:
      opacity var(--dur-2) var(--ease-out) calc(var(--reveal-delay, 0ms) + 90ms),
      transform var(--dur-3) var(--ease-out) calc(var(--reveal-delay, 0ms) + 90ms),
      color 420ms var(--ease-out);
  }
  .pn.is-in .pn__t { opacity: 1; transform: none; }
  :global(html:not(.js)) .pn__t { opacity: 1; transform: none; }
  @media (hover: hover) {
    .pn:hover .pn__t { color: var(--fg); }
  }

  .bd__foot {
    padding-top: clamp(1.1rem, 2vw, 1.6rem);
    font-size: var(--step-label);
    letter-spacing: 0.135em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--fg-faint);
  }

  /* ── Narrow ─────────────────────────────────────────────────────── */
  @media (max-width: 1080px) {
    .pl__t { white-space: normal; }
  }
  @media (max-width: 980px) {
    .fr__row,
    .fr--portrait .fr__row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'lead' 'cred';
      row-gap: clamp(1.05rem, 3.4vw, 1.6rem);
    }
    .fr--portrait .fr__row { grid-template-areas: 'portrait' 'lead' 'cred'; }
    .fr__portrait { max-width: 240px; }
    .fr__name { max-width: none; }
    .fr__cred { justify-self: start; text-align: left; align-self: start; }

    /* The rail becomes a sticky banner — count, constituency and definition
       held under the nav while its own names scroll past. On a phone the
       sixteen names run two viewports; this is the fixed reference point
       that tells you which third of the board you are in. */
    .cg__body { grid-template-columns: 1fr; }
    .cg__rail {
      position: sticky;
      top: calc(var(--nav-h) - 1px);
      z-index: 3;
      background: var(--bg);
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 0.9rem;
      row-gap: 0.15rem;
      align-items: baseline;
      padding-block: 0.7rem 0.62rem;
      border-bottom: 1px solid var(--rule);
      margin-bottom: clamp(1rem, 3vw, 1.5rem);
    }
    .cg__n { grid-row: 1 / span 2; font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.9rem); }
    .cg__def { max-width: none; }
  }
  @media (max-width: 880px) {
    /* Name over title once the two columns stop fitting side by side. */
    .pl, .pn { grid-template-columns: 1fr; }
    .pl { row-gap: 0.3rem; padding-bottom: clamp(0.8rem, 3vw, 1.1rem); }
    .pl__t, .pn__t { text-align: left; max-width: none; }
    .pn { row-gap: 0.22rem; }
  }
  @media (max-width: 860px) {
    /* Masthead stacks: the contents index sits under the display line and
       runs the full measure, so it stays an object rather than a scrap. */
    .pm__main { grid-template-columns: minmax(0, 1fr); row-gap: clamp(1.9rem, 6vw, 2.75rem); }
    .pm__idx { min-width: 0; padding-bottom: 0; }
  }
  @media (max-width: 700px) {
    /* The head stacks: the tally lifts onto the eyebrow's baseline and the
       display line takes the whole measure instead of a 175px column. */
    .rg__head {
      align-items: baseline;
      column-gap: 1.1rem;
      row-gap: 0.95rem;
    }
    .rg__tally { grid-row: 1; align-self: baseline; }
    .fs__note {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: start;
      text-align: left;
      max-width: 34ch;
    }
    /* With the whole measure to itself the one display line on this screen
       can be set larger than the shared step and still break on its own
       clauses: "Advising the pilots. / Opening the doors / they need."
       The size meets --step-l again at 700px, so nothing jumps. */
    .bd__h {
      grid-column: 1 / -1;
      margin-top: 0;
      max-width: none;
      font-size: clamp(2.2125rem, 2.66rem - 1.15vw, 2.35rem);
      text-wrap: pretty;
    }

    /* Cohort spacing keeps decelerating on the phone. */
    .cg--0 .cg__body { padding-block: 0 2.9rem; --pn-lead: 0.78rem; }
    .cg--1 .cg__body { padding-block: 0 2.1rem; --pn-lead: 0.64rem; }
    .cg--2 .cg__body { padding-block: 0 1.4rem; --pn-lead: 0.52rem; }
    .cg--0 .cg__rail { margin-top: 2.4rem; }
    .cg--1 .cg__rail { margin-top: 1.75rem; }
    .cg--2 .cg__rail { margin-top: 1.2rem; }
    .pl__n { font-size: clamp(2rem, 1.5rem + 2vw, 2.45rem); }
  }
  @media (max-width: 480px) {
    /* Closing note holds one line at 390px rather than orphaning a word. */
    .bd__foot { font-size: 0.64rem; letter-spacing: 0.07em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cg__rule { transform: none; transition-duration: 1ms; }
    .bd__h :global(.line > span) { transition-delay: 0ms; }
    .pn__t { opacity: 1; transform: none; transition-duration: 1ms; }
  }
</style>
