---
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { founders, board } from '../data/site.js';

/* ── Portrait drop-in slot ────────────────────────────────────────────
   We hold no rights-cleared portraits of the founders, so the page is
   built to be complete without them. Drop either file into public/media/

       public/media/founder-mckelvy.jpg
       public/media/founder-olanoff.jpg     (.jpeg / .png / .webp also work)

   and that founder's record switches from the two-column register
   (name | facts) to a three-column one (portrait | name | facts) with no
   other change. While a file is absent nothing is rendered in its place —
   the record is a typographic entry, not a frame waiting for an image, so
   the empty state is designed air and never a broken box. It also keeps
   the console clean: no request is made for a file that is not there. */
const EXTS = ['.jpg', '.jpeg', '.png', '.webp'];
function resolvePortrait(p) {
  if (!p) return null;
  const stem = p.replace(/\.(jpe?g|png|webp)$/i, '');
  for (const ext of EXTS) {
    const rel = `${stem}${ext}`;
    try {
      if (fs.existsSync(fileURLToPath(new URL(`../../public${rel}`, import.meta.url)))) return rel;
    } catch { /* unresolvable path — treat as absent */ }
  }
  return null;
}

const people = founders.map((f, i) => ({
  ...f,
  index: String(i + 1).padStart(2, '0'),
  portraitSrc: resolvePortrait(f.portrait),
  credentials: f.detail.replace(/\.\s*$/, '').split(/\.\s+/),
}));
---
<Base title="People" description="The founders and prospective board of the Lion Forum Institute.">

  <!-- ── Masthead ─────────────────────────────────────────────────── -->
  <section class="pm">
    <div class="shell pm__in">
      <p class="label" data-reveal>People</p>
      <h1 class="display display--hero pm__h lines">The people accountable for the work.</h1>
      <div class="pm__foot" data-reveal="280">
        <hr class="rule" />
        <div class="pm__stats">
          <p class="stat">
            <span class="stat__n tnum">02</span>
            <span class="stat__l">Founders</span>
          </p>
          <p class="stat stat--end">
            <span class="stat__n tnum">16</span>
            <span class="stat__l">Prospective board</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Founders ─────────────────────────────────────────────────── -->
  <section class="fs" aria-labelledby="founders-h">
    <div class="shell">
      <h2 class="sr-only" id="founders-h">Founders</h2>
      {people.map((p, i) => (
        <article class:list={['fr', { 'fr--portrait': p.portraitSrc }]} data-reveal={String(60 + i * 110)}>
          <hr class="rule" />
          <div class="fr__row">
            {p.portraitSrc && (
              <div class="fr__portrait">
                <Figure src={p.portraitSrc} alt={p.name} ratio="4 / 5" grade={0.34} />
              </div>
            )}
            <div class="fr__lead">
              <p class="fr__meta">
                <span class="index tnum">{p.index}</span>
                <span class="label label--brass">{p.role}</span>
              </p>
              <h2 class="display fr__name">{p.name}</h2>
            </div>
            <div class="fr__facts">
              <ul class="fr__aff">
                {p.lines.map((l) => <li>{l}</li>)}
              </ul>
              <p class="fr__cred">
                {p.credentials.map((c, n) => (
                  <>
                    {n > 0 && <span class="fr__cred-s" aria-hidden="true">·</span>}
                    <span class="fr__cred-i">{c}</span>
                  </>
                ))}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Prospective board ────────────────────────────────────────── -->
  <section class="scene on-cream bd" aria-labelledby="board-h">
    <div class="shell">
      <header class="bd__head">
        <p class="label" data-reveal>Prospective board</p>
        <h2 class="display display--l bd__h lines" id="board-h">Advising the pilots. Opening the doors they need.</h2>
      </header>

      <div class="bd__body">
        <aside class="bd__rail" data-reveal="120">
          <p class="bd__count tnum">16</p>
          <p class="bd__note">Membership is prospective.<br />Titles for identification.</p>
        </aside>

        <ul class="roster">
          {board.map((b, i) => (
            <li data-reveal={String(Math.min(i, 9) * 55)}>
              <span class="roster__n">{b.name}</span>
              <span class="roster__t">{b.line}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Masthead ───────────────────────────────────────────────────── */
  /* Sized so the statement and both counts land inside the first screen. */
  .pm {
    padding-block: calc(var(--nav-h) + clamp(4.25rem, 9.5vw, 8rem)) clamp(2rem, 3.5vw, 3rem);
  }
  .pm__in { display: grid; gap: clamp(2rem, 5vw, 4rem); }
  .pm__h { max-width: 13ch; }
  .pm__foot { display: grid; gap: clamp(0.9rem, 1.6vw, 1.5rem); }
  .pm__stats { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; }
  .stat { display: grid; gap: 0.5rem; }
  .stat--end { text-align: right; justify-items: end; }
  .stat__n {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.5rem, 1.08rem + 1.45vw, 2.4rem);
    line-height: 0.9;
    letter-spacing: -0.025em;
  }
  .stat__l {
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: 0.155em;
    text-transform: uppercase;
    color: var(--fg-mute);
    line-height: 1;
  }

  /* ── Founders: the register at full scale ───────────────────────── */
  /* The last record already carries deep bottom padding, so the section
     needs far less than a full --scene-pad before the cream edge. */
  .fs { padding-block: clamp(3rem, 7vw, 7rem) clamp(2rem, 4.5vw, 4.5rem); }

  .fr__row {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    column-gap: clamp(1.5rem, 3vw, 3.5rem);
    align-items: start;
    padding-block: clamp(1.75rem, 4vw, 3.5rem) clamp(2.25rem, 5.5vw, 5rem);
  }
  .fr--portrait .fr__row {
    grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
  }
  .fr__portrait { align-self: start; }

  .fr__meta {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: clamp(0.85rem, 1.6vw, 1.35rem);
  }
  .fr__name {
    /* Second-tier display size — local to this piece; the page's one
       hero-scale moment is the masthead. */
    font-size: clamp(2rem, 1.05rem + 3.1vw, 3.9rem);
    line-height: 1;
    letter-spacing: -0.024em;
    max-width: 16ch;
  }

  .fr__facts { display: grid; gap: clamp(0.95rem, 1.7vw, 1.4rem); padding-top: 0.45rem; }
  .fr__aff {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 0.4rem;
    font-size: var(--step-xs);
    color: var(--fg-mute);
  }
  /* Flex-wrapped so the block breaks between credentials, never inside one. */
  .fr__cred {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: 0.5rem;
    font-size: var(--step-label);
    letter-spacing: 0.115em;
    text-transform: uppercase;
    line-height: 1.45;
    color: var(--fg-faint);
  }
  .fr__cred-i { white-space: nowrap; }
  .fr__cred-s {
    padding-inline: 0.5em;
    color: color-mix(in srgb, var(--brass) 60%, transparent);
  }

  /* ── Prospective board: the same register, sixteen entries ──────── */
  .bd__head { display: grid; gap: var(--stack-2); margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  .bd__h { max-width: 20ch; }

  .bd__body {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    column-gap: clamp(1.5rem, 3vw, 3.5rem);
  }
  .bd__rail {
    position: sticky;
    top: calc(var(--nav-h) + clamp(1.5rem, 4vw, 3rem));
    align-self: start;
    display: grid;
    gap: clamp(0.9rem, 1.6vw, 1.35rem);
  }
  .bd__count {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.4rem, 1.4rem + 3.1vw, 4rem);
    line-height: 0.82;
    letter-spacing: -0.035em;
  }
  .bd__note {
    font-size: var(--step-label);
    letter-spacing: 0.115em;
    text-transform: uppercase;
    line-height: 1.95;
    color: var(--fg-faint);
    /* No measure cap — the <br /> sets the break and the rail sets the width. */
  }

  .roster { list-style: none; margin: 0; padding: 0; }
  .roster li {
    display: grid;
    grid-template-columns: minmax(0, 0.66fr) minmax(0, 1fr);
    column-gap: clamp(1rem, 2.2vw, 2.25rem);
    align-items: baseline;
    padding-block: clamp(0.8rem, 1.5vw, 1.2rem);
    border-top: 1px solid var(--rule);
    transition: border-color 420ms var(--ease-out);
  }
  .roster li:last-child { border-bottom: 1px solid var(--rule); }
  .roster__n {
    font-family: var(--serif);
    font-weight: 340;
    font-size: clamp(1.32rem, 0.95rem + 0.95vw, 1.72rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .roster__t {
    font-size: var(--step-xs);
    line-height: 1.42;
    color: var(--fg-mute);
    transition: color 420ms var(--ease-out);
  }
  @media (hover: hover) {
    .roster li:hover { border-top-color: color-mix(in srgb, var(--brass) 70%, transparent); }
    .roster li:hover .roster__t { color: var(--fg); }
  }

  /* ── Narrow ─────────────────────────────────────────────────────── */
  @media (max-width: 980px) {
    .fr__row,
    .fr--portrait .fr__row { grid-template-columns: 1fr; row-gap: clamp(1.25rem, 4vw, 2rem); }
    .fr__portrait { max-width: 240px; }
    .fr__name { max-width: none; }
    /* Stacked, like the affiliations above it — no separator can dangle
       at a line end once the facts column runs full width. */
    .fr__cred { flex-direction: column; align-items: flex-start; row-gap: 0.35rem; }
    .fr__cred-s { display: none; }

    .bd__body { grid-template-columns: 1fr; row-gap: clamp(1.75rem, 5vw, 2.75rem); }
    .bd__rail {
      position: static;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 0 clamp(1rem, 3vw, 1.5rem);
    }
    .bd__note { max-width: 30ch; }
  }
  @media (max-width: 620px) {
    /* Stacked rows need the name to stay clearly dominant over the title. */
    .roster li { grid-template-columns: 1fr; row-gap: 0.22rem; padding-block: 0.95rem; }
    .roster__t { font-size: 0.86rem; }
  }
</style>
