    .frole__ctaRule, .frole__ctaText::after,
    .frole__ctaText :global(.arrow) { transition-duration: 1ms; }
    .frole__cta:hover .frole__ctaRule,
    .frole__cta:focus-visible .frole__ctaRule { width: clamp(34px, 5vw, 72px); }
    .frole__cta:hover :global(.arrow),
    .frole__cta:focus-visible :global(.arrow) { transform: none; }
  }
