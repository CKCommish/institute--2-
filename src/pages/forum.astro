---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { forum, site } from '../data/site.js';

const inquire = `mailto:${site.email}?subject=${encodeURIComponent('The Lion Forum')}`;

/* The claim turns on two verbs. Setting just those two in the serif italic
   (.em, a base.css primitive) gives one display line two voices, which is
   the difference between a sentence that is large and a sentence that is
   composed. The copy itself stays one plain string in src/data/site.js. */
const claim = forum.line
  .replace(/\bbuild\b/, '<em>build</em>')
  .replace(/\bdecide\b/, '<em>decide</em>');
---
{/*
  FOUR BEATS, AND NO TWO OF THEM ARE DRAWN THE SAME WAY.

    1  masthead    the photograph wide, type stacked in one corner of it
    2  the claim    type only, flush left, nothing beside it
    3  the plate    the SAME photograph cut to a 16:5.5 band — masts and
                    breakwater, the sky gone — held for two thirds of a
                    viewport and carrying exactly one line
    4  the role     type in a rail, the page's one ask under it at the
                    bridge rung, so the close is an arrival and not a footnote

  Each beat also owns a different motion primitive, so motion ranks the page
  by kind and not only by delay: the masthead lifts its lines on load, the
  claim SETTLES under scroll and its two italic verbs arrive 200ms behind the
  roman so the hinge of the sentence is its own event, the plate WIPES open on
  both axes and then APPROACHES (1.055 → 1.000, scroll-linked), the role
  reveals. One photograph, seen twice — wide, then close.

  THE PAGE HAS TWO RAILS, NOT ONE. It used to run entirely down x=51 — 14 of
  29 marks on one edge and a 460px column on the right empty for 3151px of
  scroll. Now the beat numerals hang on the FAR edge of the measure with the
  hairline spanning between, the plate's one mark sits on that same right
  edge, and the ask right-aligns to it. §4's role sentence went flush under
  its eyebrow: the one moment the page changes axis is the moment it asks,
  not its quietest aside.

  The type ladder, top to bottom: 126 banner · 86 poster · 53 head ·
  26.6 bridge and numerals · 16 body · 11.7 micro. The 13.1px index rung is
  gone — at 13.1 it read as the 13.6px wordmark and added nothing 44px from
  the eyebrow it indexed.

  Micro type: SEVEN marks, three registers — three .eyebrow (one per scene),
  the photograph's .label credit, the scroll cue. There were twenty-five.
*/}
<Base title="Forum" description="The Lion Forum: an invitation-only convening at the Kennedy Compound, Hyannis Port.">
  <!-- 1 ── the masthead. Kicker, dateline, name: the ladder the hero was
       missing, so 11.7px never stands directly against 126px again.

       TWO LOCATION STRINGS, TWO JOBS, and they are not allowed to collapse
       into one. "Kennedy Compound, Hyannis Port" describes the CONVENING, so
       it sits inside the display stack, in the bridge voice, one line under
       the name. "Block Island, Rhode Island" describes the PHOTOGRAPH, so it
       sits in the opposite corner in the dim credit register that every
       full-bleed scene on this site uses. See refs/PHOTO-FACTS.md. -->
  <section class="fh">
    <Figure src={forum.image} alt="" ratio="auto" grade={0.6}
            focal="40% 50%" focalSm="26% 50%"
            parallax={6} scrim="bottom" loading="eager"
            credit={forum.credit} creditPos="top-right" class="fh__bg" />

    <div class="shell fh__in">
      <div class="fh__lock">
        <span class="fh__tick" aria-hidden="true"></span>
        <p class="eyebrow fh__brow">{forum.access}</p>
        <p class="bridge fh__place">{forum.place}</p>
        <h1 class="display display--banner fh__h lines">{forum.name}</h1>

        <div class="fh__bar">
          <span class="fh__rule" aria-hidden="true"></span>
          <a class="cue tap fh__cue" href="#fsay-h">
            <span class="label">Scroll</span><i class="cue__line" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 ── the claim. Flush left, nothing in a margin beside it, and the
       only thing on the page that moves with the scroll rather than at it. -->
  <section class="fsay" aria-labelledby="fsay-h">
    <div class="shell">
      <div class="frow">
        <span class="frow__rule" aria-hidden="true" data-wipe="left"></span>
        <span class="fnum" data-reveal="220">01</span>
      </div>

      <div class="fsay__head">
        <p class="eyebrow">The convening</p>
      </div>

      <p class="bridge fsay__who" data-reveal="120">{forum.who}</p>

      <div class="fsay__claim" data-reveal>
        <h2 class="display display--poster fsay__p" id="fsay-h" data-settle="0.52" set:html={claim}></h2>
      </div>
    </div>
  </section>

  <!-- 3 ── the plate. The same harbour, cut hard: a 16:5.5 band on the
       masts and the breakwater with the sky taken off it, so the page carries
       two photographic weights rather than one drawn twice. It is shorter
       than a viewport on purpose — a pause bounded by the claim above and the
       ask below, never by a screen edge — and it carries one mark, the bridge
       rung set low against the water, which is what turns held space into a
       held breath. It opens on both axes, then closes the last five percent
       of its scale as you scroll it, so the band reads as an approach. -->
  <div class="fplate" data-wipe="center-y">
    <div class="fplate__frame" data-settle="0.42">
      <Figure src={forum.image} alt="A harbour at dusk: a moored sailboat and its mast against a stone breakwater."
              ratio="auto" grade={0.52} grain={0.85}
              focal="21% 92%" zoom={4.2}
              focalSm="23% 93%" zoomSm={4.6}
              parallax={5} sizes="100vw" />
    </div>
    <p class="bridge fplate__note">{forum.caption}</p>
  </div>

  <!-- 4 ── the role, and the one ask. The mark sits BESIDE the sentence here
       and above it in beat 2, so the two type beats are not one drawing. -->
  <section class="frole" aria-labelledby="frole-h">
    <div class="shell">
      <div class="frow">
        <span class="frow__rule" aria-hidden="true" data-wipe="left"></span>
        <span class="fnum" data-reveal="220">02</span>
      </div>

      <div class="frole__in" data-seq="150" data-seq-from="60">
        <p class="eyebrow" data-reveal>The Institute&rsquo;s role</p>

        <h2 class="display display--head frole__p" id="frole-h" data-reveal>{forum.role}</h2>
      </div>

      <a class="frole__cta" href={inquire} data-reveal="240">
        <span class="frole__ctaRule" aria-hidden="true"></span>
        <span class="bridge frole__ctaText">
          {forum.cta}
          <svg class="arrow" viewBox="0 0 22 10" aria-hidden="true"><path d="M16 1l5 4-5 4M21 5H0" stroke="currentColor" stroke-width="1" fill="none"/></svg>
        </span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* The bar is not this page's to edit, but the hero display and the §2 claim
     both pass directly under it. Local hardening of the scrim the nav owns. */
  :global(.nav.is-scrolled)::before {
    height: calc(var(--nav-h) + 4.4rem);
    background: linear-gradient(to bottom,
      var(--nav-scrim, #050D16) 0%,
      var(--nav-scrim, #050D16) 44%,
      color-mix(in srgb, var(--nav-scrim, #050D16) 58%, transparent) 72%,
      transparent 100%);
  }

  /* ── 1. The masthead ─────────────────────────────────────────────── */
  .fh {
    position: relative;
    min-height: 100svh;
    display: grid;
    isolation: isolate;
  }
  .fh__bg { position: absolute; inset: 0; aspect-ratio: auto; z-index: -1; }
  .fh__in {
    width: 100%;
    display: grid;
    align-items: end;
    padding-block: var(--nav-h) clamp(1.5rem, 2.6vw, 2.6rem);
  }
  /* One object, not four corner stickers: tick, kicker, dateline, name and
     hairline all share the display's left rail, and the hairline ends where
     the name ends — fit-content measures the h1 for us. */
  .fh__lock { align-self: end; width: fit-content; max-width: 100%; }

  /* brass tick — a graphic anchor above the stack, no words spent */
  .fh__tick {
    display: block;
    width: 1px; height: clamp(30px, 4.4vw, 54px);
    background: linear-gradient(to bottom, transparent, var(--brass));
    margin-bottom: clamp(0.9rem, 1.6vw, 1.6rem);
  }

  .fh__brow { margin-bottom: clamp(0.75rem, 1.2vw, 1.1rem); }

  /* THE BRIDGE. The event's location, in the display stack with the name and
     in the page's mid voice — never in the credit register, which belongs to
     the photograph and says Block Island. */
  .fh__place {
    max-width: 26ch;
    margin-bottom: clamp(0.5rem, 1vw, 0.9rem);
  }
  .fh__h { max-width: 13ch; }

  .fh__bar {
    margin-top: clamp(1.6rem, 3.2vw, 2.9rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.25rem, 4vw, 3.5rem);
  }

  /* Local motion primitive: the masthead sits above motion.js's reveal
     rootMargin, so a scroll trigger can never fire here. Load-timed instead,
     same easings, no observer. */
  .fh__rule {
    display: block; height: 1px; width: 100%;
    background: var(--mark);
    transform: scaleX(0); transform-origin: left;
    animation: fhDraw 1150ms var(--ease-io) 460ms forwards;
  }
  .fh__tick, .fh__brow, .fh__place, .fh__cue {
    opacity: 0;
    animation: fhIn var(--dur-2) var(--ease-out) forwards;
  }
  .fh__tick  { animation-delay: 140ms; }
  .fh__brow  { animation-delay: 260ms; }
  .fh__place { animation-delay: 380ms; }
  .fh__cue   { animation-delay: 760ms; }
  @keyframes fhIn   { from { opacity: 0; transform: translate3d(0, 12px, 0); } to { opacity: 1; transform: none; } }
  @keyframes fhDraw { to { transform: scaleX(1); } }

  /* The shared .cue primitive from base.css. It used to be a <span>, i.e. a
     word that says Scroll and cannot be followed; it is a link now, like the
     other two on the site. */

  /* ── 2. The claim ────────────────────────────────────────────────── */
  /* The pause at the foot of this beat is bounded on both sides — the claim
     above it, the plate below it — which is the only way held space reads as
     confidence instead of as a hole. */
  .fsay { padding-block: clamp(3rem, 2rem + 4.4vw, 6.5rem) var(--pause); }
  /* THE MEASURED ROW. The page's width was carrying nothing: 14 of 29 marks
     began at the same x and a 460px column on the right was empty for the
     whole scroll. The beat numerals are the one element here whose job is
     positional, so they now hang on the RIGHT edge of the measure and the
     hairline runs the full width between the rail and them. The rule stops
     being a decorative underline and starts being a span with a mark at each
     end — which is the only thing that makes 1338px read as a measure. */
  /* The wipe belongs to the RULE, not to the row. It used to sit on .frow,
     which meant (a) the numeral at the far end of a 1337px measure was still
     being uncovered a second and a half after the rule started, arriving as a
     vertical slice of a glyph rather than as a numeral, and (b) the row kept
     `clip-path: inset(0)` at rest, which permanently shaved the numeral's
     optical overhang off. Territory wipes; the mark arrives. */
  .frow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    column-gap: clamp(1.25rem, 4vw, 3.25rem);
  }
  .frow__rule {
    display: block; height: 1px; width: 100%;
    background: var(--rule);
    margin-bottom: 0.34em;
  }
  /* Brass tabular numerals at the BRIDGE rung, not the 13px index one. At 13px
     they sat 0.5px from the wordmark — two sizes reading as one — and 44px from
     the eyebrow they indexed, adding nothing. At 26.6px on the far edge they
     are the page's right-hand rail. Numerals only; never a word. */
  .fnum {
    font-family: var(--sans);
    font-size: var(--step-bridge);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    color: var(--brass);
    margin-right: -0.14em;
  }
  .fsay__head {
    display: flex;
    align-items: baseline;
    gap: clamp(0.9rem, 1.6vw, 1.5rem);
    padding-top: clamp(0.9rem, 1.5vw, 1.35rem);
  }
  /* head + bridge are ONE object — the kicker — so the beat is two marks in
     a column, not three scattered ones. The interval that matters is the one
     under them, before the claim. */
  .fsay__who { margin-top: clamp(0.85rem, 1.5vw, 1.35rem); }
  /* The wrapper carries the reveal so the two italic verbs can hang off its
     .is-in; the h2 itself carries the settle. Two elements, two transforms,
     no fight. */
  .fsay__claim { --reveal-y: 0px; }
  /* THE HINGE. "build" and "decide" are the only two words in the sentence
     that are not roman, and they are the whole claim: they arrive 210ms after
     the line they sit in, so the page's best sentence has an event of its own
     rather than one more staggered fade. */
  /* Bound to --settle, not to .is-in: the hinge is now scroll-linked and
     REVERSIBLE, so a reader who scrubs back over the claim can find the
     two-holes-in-the-sentence moment again instead of it living once for
     500ms. Each verb has its own threshold on the same ramp, so they still
     arrive behind the roman and behind each other. */
  .fsay__p :global(em) {
    display: inline-block;
    --hinge: clamp(0, calc((var(--settle, 1) - 0.42) / 0.34), 1);
    /* floored, not zeroed: at rest the verbs are present but unresolved, so
       a still of this page is a whole sentence at two brightnesses rather
       than a sentence with two words missing. The event is the resolve. */
    opacity: calc(0.26 + 0.74 * var(--hinge));
    transform: translate3d(0, calc((1 - var(--hinge)) * 0.16em), 0);
  }
  .fsay__p :global(em:last-of-type) {
    --hinge: clamp(0, calc((var(--settle, 1) - 0.60) / 0.34), 1);
  }

  .fsay__p {
    max-width: 17ch;
    margin-top: clamp(2rem, 4.2vw, 3.6rem);
    /* the settle grows from the baseline the reader is already on */
    --settle-origin: 0% 100%;
    --settle-scale: 0.945;
    --settle-shift: 4vh;
  }

  /* ── 3. The plate ────────────────────────────────────────────────── */
  /* A BAND, not a screen. Roughly 16:5.5 at 1440 and always shorter than the
     viewport, so the pause is bounded by the claim above and the ask below
     rather than by two screen edges — which was the same held-space failure
     the rest of the site was fixing, relocated to a photograph. The crop is
     hard (zoom 2.0 on the masts) so this is a different photographic weight
     from the wide masthead, not the same frame drawn twice. */
  .fplate {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: clamp(400px, 62svh, 600px);
  }
  /* THE APPROACH. Scroll-linked, reversible: the band sits 5.5% large while
     it is arriving and closes to 1.000 at reading position, so the duration
     of the pause is something the reader is doing rather than watching. */
  .fplate__frame {
    position: absolute;
    inset: 0;
    --settle-scale: 1.055;
    --settle-shift: 0vh;
    --settle-origin: 50% 50%;
  }
  /* ONE MARK ON THE WATER. The bridge rung, set low-left against the horizon
     at the meta brightness so it holds the space without competing with the
     claim it follows. It is not a caption of place — the photograph's own
     credit is in the masthead and says Block Island. */
  /* The plate's one mark sits on the RIGHT edge, against the rail the
     numerals established, so the photograph is not a third thing hung off
     x=51. It is not a caption of place — the photograph's credit is in the
     masthead and says Block Island. */
  .fplate__note {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(1.4rem, 3.4vw, 2.9rem);
    z-index: 2;
    margin: 0;
    max-width: 18ch;
    text-align: right;
    color: var(--fg);
    text-shadow: 0 1px 18px rgba(3, 9, 16, 0.85);
  }

  /* ── 4. The role, and the ask ────────────────────────────────────── */
  /* The close is tight on purpose: the footer's own rule is the next mark,
     so the space under the ask stays bounded instead of trailing off. */
  .frole { padding-block: clamp(3rem, 2rem + 4.4vw, 6.5rem) clamp(2rem, 1.2rem + 2vw, 3.2rem); }
  /* The indent used to be spent HERE, on the page's quietest beat, while the
     ask fell back onto the rail with everything else. Swapped: the role sits
     flush under its eyebrow like every other beat, and the one moment the
     page changes axis is the moment it asks. */
  .frole__in {
    display: grid;
    row-gap: clamp(0.85rem, 1.5vw, 1.35rem);
    justify-items: start;
    padding-top: clamp(0.9rem, 1.5vw, 1.35rem);
  }
  .frole__p {
    max-width: 24ch;
    color: var(--fg);
    text-wrap: pretty;
    margin-top: -0.14em;
  }

  /* The one ask on the page. It is the .label register at link brightness —
     a state, not a fourth micro scale. */
  /* THE ARRIVAL. Right-aligned against the far edge of the measure — the one
     mark on the page that does not begin at the rail, so "Inquire about the
     Forum" arrives instead of continuing. It lands on the same edge the two
     brass numerals and the plate's note established, so the change of axis is
     a return to something already drawn, not a stray. */
  .frole__cta {
    display: grid;
    gap: clamp(0.7rem, 1.1vw, 1rem);
    justify-items: end;
    justify-self: end;
    text-align: right;
    /* the extra block padding is the finger, not the layout: it lifts the
       11px anchor to a real hit box without moving the rule */
    padding-block: 0.4rem 0.6rem;
    margin-top: clamp(2.4rem, 6vw, 5rem);
    color: var(--fg);
  }
  /* The ask sits at the BRIDGE rung, not in the micro register: it is the
     page's arrival and it must outrank the small links in the footer below
     instead of tying with them. No new size — the rung is already on the
     page twice. */
  .frole__ctaText {
    color: var(--fg);
    display: inline-flex; align-items: baseline; gap: 0.6ch;
    position: relative;
    max-width: none;
    text-transform: none;
  }
  .frole__ctaText :global(.arrow) { width: 0.72em; align-self: center; transition: transform 520ms var(--ease-out); }
  .frole__ctaRule {
    display: block; height: 1px; width: clamp(34px, 5vw, 72px);
    background: var(--brass);
    transition: width 520ms var(--ease-out);
  }
  .frole__cta:hover .frole__ctaRule { width: clamp(54px, 9vw, 132px); }
  .frole__cta:hover :global(.arrow) { transform: translateX(4px); }
  /* local hover rule — the shared .link underline assumes inline-block */
  .frole__ctaText::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -0.24em; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: right;
    transition: transform 520ms var(--ease-out);
  }
  .frole__cta:hover .frole__ctaText::after { transform: scaleX(1); transform-origin: left; }

  /* ── Mobile ──────────────────────────────────────────────────────── */
  @media (max-width: 860px) {
    .fh__lock { width: auto; }
    .fh__place { max-width: 20ch; }

    .fsay { padding-block: clamp(2.5rem, 8vw, 3.5rem) clamp(2.75rem, 10vw, 4.5rem); }
    .fsay__p { max-width: 13ch; }

    /* On a phone the band gets proportionally taller — a 16:5.5 strip at
       390px is 71px of photograph — but it still stops short of the viewport
       so the pause stays bounded by marks on both sides inside one scroll. */
    .fplate { height: clamp(340px, 52svh, 460px); }
    .fplate__note { max-width: 14ch; }

    .frole { padding-block: clamp(2.5rem, 8vw, 3.5rem) clamp(3rem, 10vw, 4.5rem); }
    .frole__p { max-width: 22ch; }
    /* Below 860 the measure is too narrow for a second axis to read as a
       decision, so the ask carries its arrival with space and the brass rule
       instead, back on the rail. */
    .frole__cta {
      justify-items: start; justify-self: start; text-align: left;
      margin-top: clamp(1.9rem, 7vw, 2.6rem);
    }
    .fplate__note { text-align: left; left: var(--gutter); right: auto; }
  }
  @media (max-width: 620px) {
    .fh__h { max-width: 9ch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fh__rule { animation: none; transform: scaleX(1); }
    .fh__tick, .fh__brow, .fh__place, .fh__cue { animation: none; opacity: 1; }
    .fsay__p :global(em) { opacity: 1; transform: none; }
    .fsay__p :global(em), .fsay__p :global(em:last-of-type) { --hinge: 1; }
  }
</style>
