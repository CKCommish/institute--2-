---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { forum, pilots, site } from '../data/site.js';

/* The room plate names the file it wants first and falls back to the interior
   in public/media/ — Figure takes the first candidate that is on disk. */
const roomPlate = [forum.imageDetail, '/media/forum-room.jpg', '/media/institute.jpg'];
/* The coda is the water again, but taken as a horizon band rather than a
   screen: a different shape and a different crop, so it reads as a close and
   not as a repeat. A dedicated dusk frame takes over the moment it lands. */
const codaPlate = ['/media/forum-water.jpg', '/media/forum-dusk.jpg', forum.image];

/* The three constituencies, enumerated. They belong in src/data/site.js, but
   that file may not be restructured this round, so the list is held here and
   the sentence it glosses stays in the data. */
const room = ['Founders', 'Investors', 'Elected officials'];

const inquire = `mailto:${site.email}?subject=${encodeURIComponent('The Lion Forum')}`;
---
<Base title="Forum" description="The Lion Forum: an invitation-only convening at the Kennedy Compound, Hyannis Port.">
  <!-- 1 ── full bleed. One lockup in one corner: tick, name, place, hairline. -->
  <section class="fh">
    <Figure src={forum.image} alt="" ratio="auto" grade={0.6} parallax={6} scrim="bottom" loading="eager" class="fh__bg" />

    <div class="shell fh__in">
      <div class="fh__foot">
        <div class="fh__lock">
          <div class="fh__tick" aria-hidden="true"></div>
          <h1 class="display display--hero fh__h lines">{forum.name}</h1>
          <p class="fh__place">{forum.place}</p>

          <div class="fh__bar">
            <span class="fh__rule" aria-hidden="true"></span>
            <div class="fh__cells">
              <span class="label fh__cell fh__cell--b">{forum.access}</span>
              <span class="label fh__cell fh__cue">
                Scroll<i class="fh__cueLine" aria-hidden="true"></i>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 ── the sentence, subordinate to the name, with the room enumerated
       under it on the hero's hairline again. -->
  <section class="fsec fsay">
    <div class="shell">
      <div class="fsec__ruleWrap" data-reveal><span class="fsec__rule"></span></div>

      <div class="fgrid fsec__in">
        <p class="frail">
          <span class="index frail__no">01</span>
          <span class="label frail__k">The convening</span>
        </p>

        <div class="fsay__body">
          <p class="display display--l fsay__p lines">{forum.line}</p>

          <div class="fsay__ledger">
            <span class="fsay__hair" data-reveal="380" aria-hidden="true"></span>
            <ul class="fsay__cells">
              {room.map((r, i) => (
                <li class="fsay__cell" data-reveal={String(440 + i * 150)}>
                  <span class="index fsay__no">{String(i + 1).padStart(2, '0')}</span>
                  <span class="label fsay__name">{r}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 ── the room. The tallest object on the page; the rail beside it holds
       the section mark at its left edge and the caption down its right. -->
  <section class="fsec fplate">
    <figure class="shell">
      <div class="fsec__ruleWrap" data-reveal="40"><span class="fsec__rule"></span></div>

      <div class="fgrid fsec__in fplate__in">
        <figcaption class="fplate__cap">
          <p class="frail">
            <span class="index frail__no">02</span>
            <span class="label frail__k">The room</span>
          </p>

          <span class="fplate__vline" data-reveal="360" aria-hidden="true"></span>
          <span class="cap fplate__text" data-reveal="460">{forum.caption}</span>
        </figcaption>

        <div class="fplate__frame">
          <Figure src={roomPlate} alt="" ratio="auto" grade={0.72} parallax={7}
                  focal="50% 46%" enter="wipe" sizes="(max-width: 860px) 100vw, 66vw" />
        </div>
      </div>
    </figure>
  </section>

  <!-- 4 ── the Institute's relationship, on the page's own grid: the mark in
       the rail, the sentence and the slate it puts in the room in the field. -->
  <section class="fsec frole">
    <div class="shell">
      <div class="fsec__ruleWrap" data-reveal="40"><span class="fsec__rule"></span></div>

      <div class="fgrid fsec__in">
        <p class="frail">
          <span class="index frail__no">03</span>
          <span class="label frail__k">The Institute's role</span>
        </p>

        <div class="frole__body">
          <p class="frole__p lines">{forum.role}</p>

          <div class="fled">
            <p class="label fled__k" data-reveal="200">The 2026 pilots</p>
            <ul class="fled__rows">
              {pilots.map((p, i) => (
                <li class="fled__row" data-reveal={String(280 + i * 150)}>
                  <span class="index fled__no">{p.index}</span>
                  <span class="fled__partner">{p.partner}</span>
                  <span class="label fled__title">{p.title}</span>
                  <span class="label fled__field">{p.field}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- the coda: the water again, held as a horizon band, with the page's
         one quiet ask standing in its corner. -->
    <div class="fcoda">
      <Figure src={codaPlate} alt="" ratio="auto" grade={0.8} parallax={7}
              focal="50% 72%" zoom={1.8} scrim="bottom" sizes="100vw" />

      <div class="shell fcoda__in">
        <a class="fcoda__cta" href={inquire}>
          <span class="fcoda__rule" aria-hidden="true"></span>
          <span class="fcoda__text">
            {forum.cta}
            <svg class="arrow" viewBox="0 0 22 10" aria-hidden="true"><path d="M16 1l5 4-5 4M21 5H0" stroke="currentColor" stroke-width="1" fill="none"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The bar is not this page's to edit, but on this page the hero display and
     the §2 ledger both pass directly under it. Local hardening of the scrim
     the nav already owns: taller, and opaque across the bar's own row. */
  :global(.nav.is-scrolled)::before {
    height: calc(var(--nav-h) + 4.4rem);
    background: linear-gradient(to bottom,
      var(--nav-scrim, #050D16) 0%,
      var(--nav-scrim, #050D16) 44%,
      color-mix(in srgb, var(--nav-scrim, #050D16) 58%, transparent) 72%,
      transparent 100%);
  }

  /* Three ranks of small type, not two. `--step-s` sets the ledger value
     (~19px), `.cap` is the photograph's own sentence-case voice (~13.5px) and
     the global `.label` is the tracked marker (~11.7px). Local because the
     middle rank is a Forum/Figure idea. */
  .cap {
    font-family: var(--sans);
    font-size: clamp(0.78rem, 0.74rem + 0.16vw, 0.845rem);
    font-weight: 380;
    letter-spacing: 0.008em;
    line-height: 1.4;
    text-transform: none;
    color: color-mix(in srgb, var(--cream) 66%, transparent);
  }

  /* ── The page grid ───────────────────────────────────────────────
     One measure for every beat below the hero: a 3-column caption rail,
     one gutter, a 9-column field. Nothing on this page starts anywhere else. */
  .fgrid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    column-gap: clamp(1rem, 4vw, 4rem);
    align-items: start;
  }

  /* Each beat opens with one hairline across the whole measure, and hangs its
     index + name from it in the rail. Three identical heads, three sections. */
  .fsec__ruleWrap { --reveal-y: 0px; display: block; }
  .fsec__rule {
    display: block; height: 1px; width: 100%;
    background: var(--rule);
    transform: scaleX(0); transform-origin: left;
    transition: transform 1000ms var(--ease-io) 40ms;
  }
  .fsec__ruleWrap.is-in .fsec__rule { transform: scaleX(1); }
  .fsec__in { padding-top: clamp(0.9rem, 1.5vw, 1.35rem); }

  .frail {
    display: flex;
    align-items: baseline;
    gap: clamp(0.9rem, 1.6vw, 1.5rem);
    align-self: start;
  }

  /* ── 1. Hero ─────────────────────────────────────────────────────── */
  .fh {
    position: relative;
    min-height: 100svh;
    display: grid;
    isolation: isolate;
  }
  .fh__bg { position: absolute; inset: 0; aspect-ratio: auto; z-index: -1; }
  .fh__in {
    width: 100%;
    display: grid;
    align-items: end;
    padding-block: var(--nav-h) clamp(1.5rem, 2.6vw, 2.6rem);
  }

  .fh__foot { align-self: end; }
  /* One object, not two corner stickers: the tick, the name, the place and the
     hairline all share the display's left rail, and the hairline ends where
     the display ends — fit-content on the lockup measures the h1 for us. */
  .fh__lock { width: fit-content; max-width: 100%; }

  /* brass tick — a graphic anchor above the name, no words spent */
  .fh__tick {
    width: 1px; height: clamp(34px, 5vw, 62px);
    background: linear-gradient(to bottom, transparent, var(--brass));
    margin-bottom: clamp(1rem, 1.8vw, 1.8rem);
  }

  .fh__h { max-width: 13ch; }

  /* The rank the ladder was missing: one step between the 134px name and the
     11.7px markers, carrying the only fact the hero needs — where it is. */
  .fh__place {
    font-family: var(--serif);
    font-size: var(--step-m);
    line-height: 1.16;
    font-weight: 300;
    letter-spacing: -0.008em;
    color: color-mix(in srgb, var(--cream) 66%, transparent);
    margin-top: clamp(0.7rem, 1.2vw, 1.1rem);
  }

  .fh__bar { margin-top: clamp(1.9rem, 4vw, 3.4rem); }

  /* Local motion primitive: the hero sits above motion.js's reveal rootMargin
     (-12%), so scroll-triggered reveal never fires here. This block is a
     load-time entrance instead — same easings, no observer. */
  .fh__rule {
    display: block; height: 1px; width: 100%;
    background: color-mix(in srgb, var(--cream) 26%, transparent);
    transform: scaleX(0); transform-origin: left;
    animation: fhDraw 1150ms var(--ease-io) 420ms forwards;
  }
  .fh__tick, .fh__cell, .fh__place {
    opacity: 0;
    animation: fhIn var(--dur-2) var(--ease-out) forwards;
  }
  .fh__tick { animation-delay: 140ms; }
  .fh__place { animation-delay: 520ms; }
  .fh__cell:nth-child(1) { animation-delay: 700ms; }
  .fh__cell:nth-child(2) { animation-delay: 780ms; }
  @keyframes fhIn  { from { opacity: 0; transform: translate3d(0, 12px, 0); } to { opacity: 1; transform: none; } }
  @keyframes fhDraw { to { transform: scaleX(1); } }

  .fh__cells {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: clamp(1.25rem, 4vw, 3.5rem);
    padding-top: clamp(0.85rem, 1.4vw, 1.15rem);
  }
  .fh__cell--b { color: var(--brass); }

  .fh__cue { display: inline-flex; align-items: center; gap: 0.85em; }
  /* Same cue as the homepage hero: a 34px hairline with one brass sweep. Two
     hero screens on one site do not get two scroll affordances. */
  .fh__cueLine {
    position: relative; display: block;
    width: 34px; height: 1px; overflow: hidden;
    background: color-mix(in srgb, var(--cream) 34%, transparent);
    align-self: center;
  }
  .fh__cueLine::after {
    content: ''; position: absolute; inset: 0;
    background: var(--brass);
    transform: translateX(-100%);
    animation: fhCue 2800ms var(--ease-io) infinite;
  }
  @keyframes fhCue {
    0%   { transform: translateX(-100%); }
    55%  { transform: translateX(100%); }
    100% { transform: translateX(100%); }
  }

  /* ── 2. The sentence + the room, enumerated ──────────────────────── */
  /* Half a viewport, not a whole one: this beat is the hero's subordinate. */
  .fsay { padding-block: clamp(2.75rem, 1.9rem + 3.6vw, 5.25rem) clamp(2.25rem, 1.6rem + 2.8vw, 4rem); }
  .fsay__p { max-width: 21ch; margin-top: -0.16em; }
  /* The shared .lines mask (base.css) clips descenders at this size. Give the
     mask box room locally and lengthen the travel to keep it hidden. The spans
     are built at runtime, so they need :global(). The +180ms offset ranks this
     behind the label: motion.js writes --line-delay per line, we add to it. */
  .fsay__p :global(.line) { padding-bottom: 0.16em; margin-bottom: -0.16em; }
  .fsay__p :global(.line > span) {
    transform: translate3d(0, 130%, 0);
    transition-delay: calc(var(--line-delay, 0ms) + 180ms);
  }
  .fsay__p.is-in :global(.line > span) { transform: none; }

  /* The second object, so a full screen is not spent on one sentence: the
     hero's hairline row, repeated, carrying who is in the room. */
  .fsay__ledger { margin-top: clamp(2rem, 3.4vw, 3.25rem); }
  .fsay__hair {
    --reveal-y: 0px;
    display: block; height: 1px; width: 100%;
    background: var(--rule);
    transform-origin: left;
    transition: transform 950ms var(--ease-io), opacity 1ms;
  }
  .fsay__hair:not(.is-in) { transform: scaleX(0); }
  .fsay__cells {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-top: clamp(0.9rem, 1.3vw, 1.15rem);
  }
  .fsay__cell { display: flex; align-items: baseline; gap: 0.9em; }
  .fsay__no { opacity: 0.85; }
  .fsay__name { color: color-mix(in srgb, var(--cream) 74%, transparent); }

  /* ── 3. The room ─────────────────────────────────────────────────── */
  .fplate { padding-block: clamp(0.75rem, 1.6vw, 2rem) clamp(2rem, 3.6vw, 4rem); }
  .fplate__in { align-items: stretch; }
  /* The one object on the page that is neither full-bleed nor a paragraph:
     held to the 9-column measure and taken to nearly the full viewport, so
     the scroll changes width, height and tempo all at once. */
  .fplate__frame {
    position: relative;
    isolation: isolate;
    height: clamp(500px, 80svh, 800px);
  }
  /* The rail is inhabited twice: the section mark on its left edge, and a
     full-height hairline with the caption set along it on its right, flush to
     the frame. It is a column, not a reserved margin. */
  .fplate__cap {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    justify-items: end;
    gap: clamp(0.85rem, 1.4vw, 1.4rem);
  }
  .fplate__cap .frail { justify-self: start; }
  .fplate__vline {
    --reveal-y: 0px;
    display: block; width: 1px; height: 100%; align-self: stretch;
    background: linear-gradient(to bottom,
      color-mix(in srgb, var(--cream) 22%, transparent),
      color-mix(in srgb, var(--cream) 6%, transparent));
    transform-origin: top;
    transition: transform 1100ms var(--ease-io), opacity 1ms;
  }
  .fplate__vline:not(.is-in) { transform: scaleY(0); }
  .fplate__text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    --reveal-y: 0px;
    white-space: nowrap;
  }

  /* ── 4. Role, the slate, and the coda ────────────────────────────── */
  .frole { padding-block: clamp(2rem, 3.4vw, 4rem) 0; }
  .frole__body { display: grid; gap: clamp(2.2rem, 4vw, 3.6rem); }
  .frole__p {
    font-family: var(--serif);
    font-size: var(--step-m);
    line-height: 1.24;
    font-weight: 300;
    letter-spacing: -0.011em;
    color: color-mix(in srgb, var(--cream) 88%, transparent);
    max-width: 30ch;
    text-wrap: pretty;
    margin-top: -0.14em;
  }
  .frole__p :global(.line) { padding-bottom: 0.14em; margin-bottom: -0.14em; }
  .frole__p :global(.line > span) {
    transform: translate3d(0, 120%, 0);
    transition-delay: calc(var(--line-delay, 0ms) + 160ms);
  }
  .frole__p.is-in :global(.line > span) { transform: none; }

  /* The page's second enumeration, on the §2 ledger's own pattern: hairline
     rows, a tracked marker and a reading-size value. What the sentence above
     it means, stated rather than described. */
  .fled__k { color: var(--fg-faint); }
  .fled__rows {
    list-style: none; margin: 0; padding: 0;
    margin-top: clamp(0.8rem, 1.2vw, 1.1rem);
    border-top: 1px solid var(--rule);
  }
  .fled__row {
    display: grid;
    /* Two anchored edges, nothing floating between them: the partner reads off
       the field's left rail, the pilot and its subject stack against its right. */
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: baseline;
    column-gap: clamp(0.9rem, 2.4vw, 2.4rem);
    padding-block: clamp(0.8rem, 1.35vw, 1.1rem);
    border-bottom: 1px solid var(--rule-soft);
  }
  .fled__no { opacity: 0.9; }
  .fled__partner {
    font-size: var(--step-s);
    font-weight: 380;
    line-height: 1.2;
    color: color-mix(in srgb, var(--cream) 92%, transparent);
  }
  .fled__title { text-align: right; color: color-mix(in srgb, var(--cream) 58%, transparent); }
  .fled__field { min-width: 5.6rem; text-align: right; color: var(--fg-faint); }

  /* The beat the reader leaves on is a picture: the water again, taken as a
     band across the whole page rather than a second screen of it. */
  .fcoda {
    position: relative;
    isolation: isolate;
    height: clamp(250px, 34svh, 400px);
    margin-top: clamp(2.5rem, 4vw, 4.5rem);
  }
  .fcoda__in {
    position: absolute; inset: auto 0 0 0; z-index: 7;
    padding-bottom: clamp(1.4rem, 2.6vw, 2.6rem);
  }
  /* The one ask on the page, standing on the same left rail as everything
     else, inside the last picture. It never stacks above the footer's ask. */
  .fcoda__cta {
    display: grid;
    gap: clamp(0.7rem, 1.1vw, 1rem);
    justify-items: start;
    font-size: var(--step-label); letter-spacing: 0.145em;
    text-transform: uppercase; font-weight: 500;
    color: var(--cream);
  }
  .fcoda__rule {
    display: block; height: 1px; width: clamp(30px, 4vw, 58px);
    background: var(--brass);
    transition: width 520ms var(--ease-out);
  }
  .fcoda__cta:hover .fcoda__rule { width: clamp(48px, 7vw, 96px); }
  .fcoda__text { display: inline-flex; align-items: center; gap: 0.9ch; position: relative; }
  .fcoda__cta:hover :global(.arrow) { transform: translateX(4px); }
  /* local hover rule — the shared .link underline assumes inline-block */
  .fcoda__text::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -0.45em; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: right;
    transition: transform 520ms var(--ease-out);
  }
  .fcoda__cta:hover .fcoda__text::after { transform: scaleX(1); transform-origin: left; }

  /* ── Mobile ──────────────────────────────────────────────────────── */
  @media (max-width: 860px) {
    .fgrid { grid-template-columns: minmax(0, 1fr); row-gap: clamp(1.25rem, 4vw, 2rem); }
    .fh__lock { width: auto; }

    .fsay__p { max-width: 15ch; }
    .fsay__cells { grid-template-columns: minmax(0, 1fr); gap: 0; }
    /* one ledger line per row, each on its own rule */
    .fsay__cell {
      justify-content: start;
      gap: 1.4em;
      padding-block: clamp(0.6rem, 2.4vw, 0.9rem);
      border-bottom: 1px solid var(--rule-soft);
    }

    /* On a phone the 9-column trick is gone, so the plate takes its contrast
       the other way: edge to edge, and still by far the tallest beat. */
    .fplate { padding-block: clamp(0.5rem, 2vw, 1.5rem) clamp(2rem, 6vw, 3rem); }
    .fplate__in { row-gap: clamp(0.9rem, 3vw, 1.2rem); }
    .fplate__frame {
      height: clamp(440px, 76svh, 720px);
      margin-inline: calc(var(--gutter) * -1);
    }
    .fplate__cap {
      grid-template-rows: none;
      grid-template-columns: minmax(0, auto) minmax(0, 1fr);
      align-items: baseline;
      justify-items: start;
      column-gap: clamp(1rem, 4vw, 2rem);
    }
    .fplate__vline { display: none; }
    .fplate__text { writing-mode: horizontal-tb; transform: none; white-space: normal; justify-self: end; text-align: right; }

    .frole { padding-block: clamp(2.25rem, 7vw, 3rem) 0; }
    .frole__p { max-width: 22ch; }
    /* index + partner and the field on one line, the pilot beneath it */
    .fled__row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: 'no partner field' '. title title';
      row-gap: 0.35rem;
      padding-block: clamp(0.7rem, 2.6vw, 0.95rem);
    }
    .fled__no { grid-area: no; }
    .fled__partner { grid-area: partner; }
    .fled__title { grid-area: title; text-align: left; }
    .fled__field { grid-area: field; min-width: 0; }

    .fcoda { height: clamp(240px, 40svh, 340px); }
  }
  @media (max-width: 620px) {
    .fh__h { max-width: 9ch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fsec__rule { transition-duration: 1ms; }
    .fh__rule { animation: none; transform: scaleX(1); }
    .fh__tick, .fh__cell, .fh__place { animation: none; opacity: 1; }
    .fh__cueLine::after { animation: none; transform: none; opacity: .5; }
    .fsay__hair, .fplate__vline { transition-duration: 1ms; transform: none; }
    .fsay__p :global(.line > span), .frole__p :global(.line > span) { transition-delay: 0ms; }
  }
</style>
