---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { forum, site } from '../data/site.js';

const inquire = `mailto:${site.email}?subject=${encodeURIComponent('The Lion Forum')}`;

/* ── THE SLOTS ──────────────────────────────────────────────────────
   Every photograph on this page is a STAND-IN. The Forum is an
   invitation-only convening at the Kennedy Compound and we have no picture
   of it; what runs today is a harbour at dusk on Block Island, chosen
   honestly and credited accurately. Five real Lion Forum frames exist, the
   client owns them, and they have not arrived.

   So the page resolves each photographic beat at build time. Drop a file at
   the path named in `forum.photos` and that beat takes it, with its own
   framing, its own alt and its own credit rule; drop nothing and the page
   renders exactly as it does now. There is no empty slot, no broken image
   and no placeholder anywhere in either state — the room band simply does
   not exist until there is something to put in it.

   Same existence test Figure runs internally, hoisted here because the PAGE
   has to know which frame won in order to choose the framing for it. */
const onDisk = (p) => {
  if (typeof p !== 'string' || !p.startsWith('/')) return false;
  try { if (fs.existsSync(new URL(`../../public${p}`, import.meta.url))) return true; } catch { /* build */ }
  try { return fs.existsSync(`${process.cwd()}/public${p}`); } catch { return false; }
};
const P = forum.photos;

/* SLOT 1 — THE MASTHEAD, and the one arrival decision worth understanding.

   The display stack hangs off the RIGHT rail today because THIS photograph
   has an empty right half — open water and sky for 540px while the sloop and
   the breakwater keep the left 62%. That is a response to one frame, not a
   rule, and it is the wrong default for a picture nobody here has seen: a
   lawn, a flagpole and a harbour could put its subject anywhere. When the
   real frame lands the stack therefore returns to the LEFT rail, which is
   where every other page on this site opens and which no composition can
   collide with badly, and the ramp comes back with it. Re-hang it right only
   after looking at the picture and finding the same empty half. */
const mast = onDisk(P.lawn.src)
  ? { ...P.lawn, hang: 'left', grade: 0.6,
      focal: '50% 55%', focalSm: '50% 55%',
      align: 'left', reach: 0.72, rise: 0.62 }
  : { src: forum.image, alt: '', credit: forum.credit, hang: 'right', grade: 0.6,
      focal: '40% 50%', focalSm: '26% 50%',
      align: 'right', reach: 0.60, rise: 0.62 };

/* SLOT 2 — THE PLATE, AND IT IS EMPTY TODAY. Like the room band below it.

   THE CROP DID NOT WORK AND THE MEASUREMENT SAYS SO. The plate used to run
   the masthead's own photograph at zoom 3.6 on the argument that a hard crop
   makes it "arrive as a different subject". It does not: at 3.6 the band
   still holds the sloop, the breakwater, the light tower and the horizon —
   every object in the wide frame — so a reader 2,000px down the page meets
   the same harbour a second time and reads it as the same harbour. The
   Forum's ONE photograph was running three times across the site, twice on
   the page about the Forum. A crop is not a second photograph.

   And there is no crop of this negative that would be one. It is a harbour:
   boats, breakwater, tower, water, sky. Cut tighter and the plate becomes an
   abstract of water, which is decoration, which is worse. refs/BRIEF.md sizes
   this page at "One photograph, one paragraph, sponsor relationship" — one is
   the number, and until a SECOND frame exists the page runs one.

   So the plate is now a slot on exactly the same terms as the room: it
   renders when `forum.photos.stage` is on disk and it does not exist in the
   built HTML until then. The stage frame is a different photograph of a
   different thing, shown whole, and it is the picture this beat was always
   asking for. The ledger runs straight into the cream close meanwhile — the
   L* 15 → L* 92 step is unchanged, and it lands on flat navy, which is a
   harder edge than a photograph's own dark foot ever was. */
const plate = onDisk(P.stage.src)
  ? { ...P.stage, grade: 0.5, grain: 0.85,
      zoom: 1, focal: '50% 48%', zoomSm: 1.5, focalSm: '50% 48%' }
  : null;

/* SLOT 3 — THE ROOM. Column-wide plates, no page type on them, no names
   under them. refs/PHOTO-FACTS.md: scale is part of the claim, and these are
   the frames with identifiable people in them. Absent today, so §01 runs
   straight into §02 exactly as it does now.

   The set is cut to one ratio (4/5) so three frames from one evening read as
   three frames from one evening. A slot may carry its own `ratio` if the
   picture that actually arrives cannot survive that crop — the reception is
   the likely one — but change it after looking at the frame, not before. */
const room = [P.podium, P.notebook, P.reception].filter((f) => onDisk(f.src));

/* The claim turns on two verbs. Setting just those two in the serif italic
   (.em, a base.css primitive) gives one display line two voices, which is
   the difference between a sentence that is large and a sentence that is
   composed. The copy itself stays one plain string in src/data/site.js. */
const claim = forum.line
  .replace(/\bbuild\b/, '<em>build</em>')
  .replace(/\bdecide\b/, '<em>decide</em>');
---
{/*
  FOUR BEATS IN THE BUILD, AND NO TWO OF THEM ARE DRAWN THE SAME WAY. Two
  more are wired and empty. The page has ONE photograph today because there
  IS one photograph today.

    1  masthead   the photograph wide. Slot: forum.photos.lawn, standing in
                   today with the Block Island frame, whose empty right half
                   is why the name hangs off the right rail
   01  the claim   type only, flush left, nothing beside it
   (—) the room    NOT IN THE BUILD. One to three column-wide Lion Forum
                   plates showing the claim above. Renders only when a file
                   is on disk; there is none
   02  the ledger  the reading size, and the page's first change of axis:
                   three terms hanging right-aligned against three sentences
   (—) the plate   NOT IN THE BUILD EITHER, AND THAT IS THE CHANGE. Slot:
                   forum.photos.stage — the Lion Forum stage, whole, in a
                   band shorter than a viewport carrying no type. It used to
                   stand in with a 3.6x crop of the MASTHEAD'S OWN frame; see
                   below
   03  the close   THE PAGE TURNED OVER — the role on the right, and in the
                   rail beside it the fourth question answered

  EVERY PHOTOGRAPH HERE IS A STAND-IN AND THE PAGE KNOWS IT. We have no
  picture of an invitation-only convening at the Kennedy Compound; the client
  owns five frames of one and has not sent them. Each photographic beat is
  therefore a NAMED SLOT resolved against the filesystem at build time (see
  the frontmatter and `forum.photos`): drop the file in, and the masthead,
  the plate and the room band take it with their own framing, their own alt
  and their own credit rule. Drop nothing, as today, and the page renders
  with no gap, no placeholder and no broken image anywhere in it. When the
  real frames land, refs/PHOTO-FACTS.md says the Block Island stand-in comes
  OFF the site rather than staying on as decoration.

  THE STAND-IN GETS ONE APPEARANCE PER PAGE. It is the only Forum photograph
  that exists, so it is going to be on /forum/ and it is going to be on the
  homepage's held scene. What it cannot be is on /forum/ TWICE — which it was,
  as the masthead and again as the plate, which is how one picture came to run
  three times across a six-page site. The plate now waits for a picture of its
  own. refs/BRIEF.md sizes this page at "One photograph, one paragraph,
  sponsor relationship"; one is the number.

  THE FOURTH QUESTION. A programme officer arrives wanting to know what this
  convening is, who is in it, what the Institute's relationship to it is, and
  how one might be invited. §02 answers the first two, §03's sentence answers
  the third, and the fourth was never answered at all: the page ended on a
  mailto whose label did not say whether it was an application. It is
  answered in §03's rail, in the smallest voice on the section — and it says
  only what the brief supports, which is that the room is invited and the
  Institute is in it. Not who writes the list, not what happens after you
  write. Neither of those is known here. How often it sits IS known — the
  prospectus says "Each year" — and the ledger's Format row says so.

  THE FRAME HAD AN EMPTY HALF AND THE PAGE WAS NOT USING IT. The sloop, its
  two masts and the breakwater all live in the left 62% of the masthead; the
  right 540px was open water and sky carrying nothing, while the display stack
  sat at x=51 with the forward mast passing through the "T" of "The". That is
  a collision, not an interlock. The name now hangs off the RIGHT rail in the
  water, two lines deep, and the subject keeps its own third; the scrim is
  MIRRORED to match (align="right"), so the ink is laid where the words are
  and the boat keeps its light. The kicker and the dateline came out of the
  stack — at 55–60% of the frame they sat on L* 62 sky, four points past what
  the micro register can carry — and are now the left end of the foot band,
  where the ramp is at full weight. Small and dark at the lower left, enormous
  and light at the upper right, one rule running between them.

  THE EXCEPTION, AND THERE IS ONLY ONE ON THE PAGE GROUND. Everything between
  the claim and the close is cream type on navy opening flush at x=51. The
  close is full-bleed cream arriving directly off that navy: L* 15 → L* 92,
  the largest tonal step the system owns, spent once, on the only thing a
  foundation officer came to this page to find out — what the Institute's
  relationship to this convening actually is. It is also the one beat that
  does not begin at the rail: the eyebrow holds a narrow left rail, the
  sentence starts at ~34% at --step-feature and runs into the right-hand
  column the rest of the page leaves empty. Restraint plus one exception is
  composition. (The step used to be measured off the plate's dark foot. With
  the plate empty it is measured off flat page navy instead, which is the same
  L* and a harder edge — the curtain retracting off a flat ground is a
  cleaner event than one retracting off a photograph.)

  GROUND BUDGET: hero photograph · cream. Two today, three the ceiling — the
  third is the plate, and it is held open for the picture that earns it, not
  spent on a second pass over the picture above. Which is also why the
  ledger's .on-panel band came off: a 13-point step on a 255 scale was
  spending a ground event and reading as nothing.

  THE PLATE WAS THE PAGE'S BEST IDEA AND IT WAS NOT TRUE. "One photograph,
  seen twice — wide, then close" is a good line and it does not survive being
  looked at. The band ran at zoom 3.6 on 28%/77% of the masthead's own frame
  and the claim in this comment was that the horizon, the sky, the breakwater
  and the tower were all out of it. They are not: a reviewer measured the
  render and found the same sloop, the same breakwater and the same tower on
  the same water, two thousand pixels below where the reader last saw them.
  It read as the masthead at a longer lens, because that is what it was.
  There is no crop of a harbour that is a second photograph of a convening.
  The beat is now a slot and it is empty; the frontmatter carries the rest.

  THE ASK IS SINGULAR. It used to be made twice within 330px — here, and again
  in the footer's secondary door, which on this route is a link to this page.
  The footer's is suppressed on /forum/ only.

  TWO LOCATION STRINGS, TWO JOBS, TWO CORNERS. "Kennedy Compound, Hyannis
  Port" describes the CONVENING: it sits in the masthead's foot band at the
  bridge rung, lower left, plain sentence case. "Block Island, Rhode Island"
  describes the PHOTOGRAPH: it sits in the opposite corner, upper right, in
  the dim tracked credit register every full-bleed frame on this site uses.
  Diagonally opposite, in two different voices, so a reader cannot collapse
  one into the other. That separation is load-bearing while the picture is a
  harbour 200 miles from the place the page names. See refs/PHOTO-FACTS.md.

  Motion ranks the page by KIND, not only by delay: the masthead lifts its
  lines on load, the claim SETTLES under scroll and its two italic verbs
  arrive behind the roman so the hinge of the sentence is its own event, the
  cream close CUTS OVER (a navy curtain retracting off the ground itself),
  the ledger reveals. The plate's wipe-and-approach is written and waits with
  the plate.

  THIS PAGE'S DISPLAY LADDER, top to bottom: 86 poster (the name) · 53 head
  (the claim) · 67 feature (the close, on cream). Three lines, three rungs.
  It used to be 86 · 86 · 67 — two poster blocks two screens apart with
  nothing between them, which is a size repeated, not a ladder, and which no
  other page on this site does. Every other route here opens at poster and
  never returns to it.

  The site ladder those rungs are drawn from: 126 banner · 86 poster · 67
  feature · 53 head · 34 sub · 26.6 bridge · 19 lede · 16 body · 13.1 index ·
  11.7 micro.
*/}<Base title="Forum" description="The Lion Forum: an annual invitation-only convening at the Kennedy Compound, Hyannis Port." preloadItalic>
  {/* 1 ── the masthead. Kicker, dateline, name: the ladder the hero was
       missing, so 11.7px never stands directly against 126px again.

       TWO LOCATION STRINGS, TWO JOBS, and they are not allowed to collapse
       into one. "Kennedy Compound, Hyannis Port" describes the CONVENING, so
       it sits inside the display stack, in the bridge voice, one line under
       the name. "Block Island, Rhode Island" describes the PHOTOGRAPH, so it
       sits in the opposite corner in the dim credit register that every
       full-bleed scene on this site uses. See refs/PHOTO-FACTS.md. */}
  <section class:list={['fh', mast.hang === 'right' && 'fh--hangR']}>
    {/* The credit is not optional on the stand-in, it is that frame's whole
        problem. The event line below reads as a caption the moment it is the
        only place-name on the picture, and the picture is a harbour on Block
        Island, 200 miles from Hyannis Port. Credit top-right, opposite the
        event line in the foot band: two location strings, two corners, two
        registers, so a reader cannot collapse them. refs/PHOTO-FACTS.md.

        The lawn frame is the one slot where the two strings agree, and it is
        still labelled — a corner label on an owned photograph is a location,
        not an attribution, and this is the claim the page has never been
        able to make. Confirm the frame is the Compound before shipping it. */}
    <Figure src={mast.src} alt={mast.alt} ratio="auto" grade={mast.grade}
            focal={mast.focal} focalSm={mast.focalSm}
            parallax={6} scrim="bottom" align={mast.align} reach={mast.reach} rise={mast.rise}
            loading="eager"
            credit={mast.credit} creditPos="top-right"
            class="fh__bg" />

    <div class="shell fh__in">
      <div class="fh__lock">
        <h1 class="display display--poster fh__h lines">{forum.name}</h1>
      </div>

      <div class="fh__bar">
        <div class="fh__meta">
          <p class="eyebrow fh__brow">{forum.access}</p>
          <p class="bridge fh__place">{forum.place}</p>
        </div>
        <span class="fh__rule" aria-hidden="true"></span>
        {/* Points at the SECTION, not its heading. The h2 carries
             data-settle, so it is transformed while it arrives and the
             browser scrolls to a position it is no longer at — the claim
             landed 33px above the viewport top, under the fixed bar. The
             section is untransformed and is what "Scroll" means anyway. */}
        <a class="cue tap fh__cue" href="#fsay">
          <span class="label">Scroll</span><i class="cue__line" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  {/* §01 ── the claim. Flush left, nothing in a margin beside it, and the
       only thing on the page that moves with the scroll rather than at it.

       IT IS NOT AT THE MASTHEAD'S SIZE ANY MORE, and that is the ladder.
       This page used to set two blocks at --step-poster — 86px here and 86px
       on the masthead, two screens apart with nothing between them — which no
       other page on this site does, and which left /forum/ as the one route
       with three display lines and only two rungs. The name is the page's
       largest voice because it is the page's subject; the claim is a beat
       INSIDE a section, which is --step-head everywhere else on the site; and
       the close on cream keeps --step-feature. 86 · 53 · 67, in that order:
       the page opens loud, drops into its own substance, and lifts back on
       the turn to cream. The sentence loses nothing it was carrying — the
       hinge, the measure and the settle are all still here, and at this size
       the two italic verbs actually read as italics rather than as two large
       shapes. */}
  <section class="fsay" id="fsay" aria-labelledby="fsay-h">
    <div class="shell">
      <div class="frow">
        <span class="frow__rule" aria-hidden="true" data-wipe="left"></span>
        <span class="index fnum" data-reveal="220">01</span>
      </div>

      <div class="fsay__head">
        <p class="eyebrow">The convening</p>
      </div>

      <p class="bridge fsay__who" data-reveal="120">{forum.who}</p>

      <div class="fsay__claim" data-reveal>
        <h2 class="display display--head fsay__p" id="fsay-h" data-settle="0.52" set:html={claim}></h2>
      </div>
    </div>
  </section>

  {/* ── THE ROOM. A SLOT THAT IS EMPTY TODAY AND RENDERS NOTHING.

       The claim above says the people who build sit with the people who
       decide. This is the one beat that could show it, and it can only be
       shown with photographs the Institute owns. Until a file lands in
       /media/, this element does not exist in the built HTML at all — the
       claim runs straight into the ledger the way it does now — and the
       day one lands it appears here, between the sentence and its
       explanation, which is where a picture of the room belongs.

       COLUMN-WIDE PLATES, and that is a rule, not a layout preference.
       refs/PHOTO-FACTS.md: scale is part of the claim a photograph makes
       about the people in it, and these are the three frames with
       identifiable guests. They are set at the size of a plate in a page,
       no page type over them, no names under them, one to three of them
       in a row. Do not promote one of these to full bleed. */}
  {room.length > 0 && (
    <section class="froom" aria-label="The Lion Forum">
      <div class="shell">
        <ul class="froom__list" data-seq="140" data-seq-from="40" role="list"
            style={`--n:${room.length};--nsm:${Math.min(room.length, 2)}`}>
          {room.map((f) => (
            <li class="froom__item" data-reveal>
              <Figure src={f.src} alt={f.alt} ratio={f.ratio || '4 / 5'}
                      grade={0.5} vig={0.18} scrim="none"
                      credit={f.credit} creditPos="bottom-left"
                      sizes="(max-width: 860px) 92vw, 30vw" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* §02 ── THE LEDGER, and the page's one change of axis.

       This page sold the Forum with four slogans and a mailto. A programme
       officer who wanted to know what the convening actually IS had nothing
       on it to read: five sizes in main and not one of them a reading size.
       This beat is the reading size, and it is the only thing on the page
       that does not begin at the left rail.

       Three entries, one sentence each — the brief's supporting-line limit
       spent, once, on the page's actual job. The terms hang right-aligned in
       the left column against the sentences, so the block reads as a ledger
       and its axis sits near 38% of the measure. Every other beat here opens
       flush at the rail; this one does not, which is the whole point.

       It sits on the page ground. It used to be an .on-panel band, but a
       13-point step on a 255 scale is not a tonal event and it was costing
       one of the page's three ground changes; the rules do the ranking and
       the change of value is spent on §03 instead. The hairlines are pulled
       back to the text measure — they used to over-span the sentences under
       them by 419px in all four rows. */}
  <section class="fbrief" aria-labelledby="fbrief-h">
    <div class="shell">
      <div class="frow">
        <span class="frow__rule" aria-hidden="true" data-wipe="left"></span>
        <span class="index fnum" data-reveal="220">02</span>
      </div>

      <div class="fdef fbrief__top" data-reveal>
        <p class="eyebrow fdef__t">{forum.brief.eyebrow}</p>
        <p class="lede fbrief__lede" id="fbrief-h">{forum.brief.lede}</p>
      </div>

      <dl class="fdefs" data-seq="120" data-seq-from="40">
        {forum.brief.rows.map((r) => (
          <div class="fdef fdef--row" data-reveal>
            <dt class="label fdef__t">{r.term}</dt>
            <dd class="fdef__d">{r.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ── THE PLATE. A SECOND SLOT THAT IS EMPTY TODAY AND RENDERS NOTHING.

       The Lion Forum stage frame, whole: a band shorter than a viewport,
       carrying no type at all, bounded by the ledger above and the cream
       below so the pause is never bounded by a screen edge. It opens on both
       axes, then closes the last five percent of its scale as you scroll it.

       It used to run the MASTHEAD'S OWN photograph at a 3.6x crop, on the
       argument that the crop made it arrive as a different subject. Measured,
       it did not — the band still held the sloop, the breakwater, the tower
       and the horizon, so the Forum's one picture ran twice on the page about
       the Forum and a third time on the homepage. A crop is not a second
       photograph, and this negative has no crop that would be one. The beat
       waits for a real second frame rather than faking one; see the
       frontmatter. */}
  {plate && (
    <div class="fplate" data-wipe="center-y">
      <div class="fplate__frame" data-settle="0.42">
        <Figure src={plate.src} alt={plate.alt}
                ratio="auto" grade={plate.grade} grain={plate.grain}
                focal={plate.focal} zoom={plate.zoom}
                focalSm={plate.focalSm} zoomSm={plate.zoomSm}
                scrim="bottom-left" ink={0.7} vig={0.25}
                credit={plate.credit} creditPos="bottom-left"
                parallax={5} sizes="100vw" />
      </div>
    </div>
  )}

  {/* §03 ── THE CLOSE, and the page's one exception.

       Everything above this line is cream type on navy, opening flush at the
       left rail. This is the page turned over: full-bleed cream, arriving
       directly off that navy, so the largest tonal step available on the
       site — L* 15 to L* 92 — lands on the one thing a programme officer came
       here to find out, which is what the Institute's relationship to this
       convening actually is. (It used to arrive off the plate's dark foot.
       Same L*, and off flat ground the curtain below has a cleaner edge to
       retract from.)

       It is also the one beat that does not begin at x=51. The rule and the
       numeral quote the page's own row construction so the break is a return
       and not a stray; below it the composition shifts right, the sentence is
       set at --step-feature — the top of this page's three-rung ladder below
       the masthead, 86 · 53 · 67, and the only place either the cream or this
       rung is spent — and it runs into the 460px of right-hand column the
       rest of the page left empty.

       The footer's quieter "Inquire about the Lion Forum" door is suppressed
       on this route — it points at this page, and this page has just asked. */}
  <section class="on-cream frole" aria-labelledby="frole-h" data-settle="0.86">
    <span class="frole__cut" aria-hidden="true"></span>
    <div class="shell frole__shell">
      <div class="frow">
        <span class="frow__rule" aria-hidden="true" data-wipe="left"></span>
        <span class="index fnum" data-reveal="220">03</span>
      </div>

      <div class="frole__grid">
        <p class="eyebrow frole__brow" data-reveal>The Institute&rsquo;s role</p>

        {/* THE FOURTH QUESTION, AND THE RAIL THAT WAS EMPTY UNDER IT.

             A programme officer arrives wanting four answers: what this is,
             who is in it, what the Institute's relationship to it is, and
             how one might be invited. The ledger takes the first two, the
             sentence beside this takes the third, and the fourth was simply
             never answered — the page ended on a mailto whose label did not
             say whether it was an application.

             It is answered here, in the rail, in the smallest voice on the
             section, hung at the foot of it so it sits on the CTA's line
             and the two ends of the diagonal are the quiet fact and the
             loud door. The left column carried one eyebrow and 700px of
             cream; the indent is still the composition, the void was not.

             It states only what the brief supports. It does not say who
             writes the guest list, what a sponsor's say over it is, how
             often the Forum meets, or what happens after you write. */}
        <div class="frole__invite" data-reveal="300">
          <span class="frole__inviteRule" aria-hidden="true"></span>
          <p class="label frole__inviteT">{forum.invite.term}</p>
          {forum.invite.lines.map((l) => <p class="frole__inviteL">{l}</p>)}
        </div>

        <div class="frole__body" data-seq="150" data-seq-from="60">
          <h2 class="display display--feature frole__p" id="frole-h" data-reveal>{forum.role}</h2>
          <p class="frole__note" data-reveal="120">{forum.roleNote}</p>

          {/* ONE DOOR, and it now carries the address it opens. The ask was
               a verb over a mailto: nothing on the page said where an
               inquiry went, and a reader who wanted to write from something
               other than a mail client had nothing to copy. The address is
               inside the same <a>, one rung down, so this is still a single
               link and not a second ask 40px under the first. */}
          <a class="frole__cta" href={inquire} data-reveal="240">
            <span class="frole__ctaRule" aria-hidden="true"></span>
            <span class="bridge frole__ctaText">
              {forum.cta}
              <svg class="arrow" viewBox="0 0 22 10" aria-hidden="true"><path d="M16 1l5 4-5 4M21 5H0" stroke="currentColor" stroke-width="1" fill="none"/></svg>
            </span>
            <span class="label frole__ctaMail">{site.email}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  /* The bar is not this page's to edit, but the hero display and the §01 claim
     both pass directly under it. Local hardening of the scrim the nav owns. */
  :global(.nav.is-scrolled)::before {
    height: calc(var(--nav-h) + 4.4rem);
    background: linear-gradient(to bottom,
      var(--nav-scrim, #050D16) 0%,
      var(--nav-scrim, #050D16) 44%,
      color-mix(in srgb, var(--nav-scrim, #050D16) 58%, transparent) 72%,
      transparent 100%);
  }

  /* ── 1. The masthead ─────────────────────────────────────────────── */
  .fh {
    position: relative;
    min-height: 100svh;
    display: grid;
    isolation: isolate;
  }
  .fh__bg { position: absolute; inset: 0; aspect-ratio: auto; z-index: -1; }
  .fh__in {
    width: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    align-content: end;
    padding-block: var(--nav-h) clamp(1.5rem, 2.6vw, 2.6rem);
  }
  /* TYPE SET INTO THE NEGATIVE SPACE, not at the rail.

     This photograph has an empty half. The sloop, its two masts and the
     breakwater all live in the left 62%; the right 540px is open water,
     horizon and sky carrying nothing. The display stack used to sit at
     x=51, which put 126px serif directly across the rigging — the forward
     mast passed through the "T" of "The". A collision, not an interlock.

     The stack now hangs off the RIGHT rail, in the water, and the picture's
     subject is left alone in its own third. It is the only beat on the page
     that does not open at x=51, and the only place on the site where a
     photograph's composition, rather than the grid, decides where type goes.
     The scrim is mirrored to match (align="right" on the Figure) so the ink
     is laid where the words actually are and the sloop keeps its light. */
  /* The default is the rail, like every other page here. `.fh--hangR` is the
     stand-in's exception and travels with the stand-in: the day the Forum's
     own frame lands, the class is not emitted and the stack comes home. */
  .fh__lock {
    align-self: end;
    justify-self: start;
    width: fit-content;
    max-width: min(100%, 42ch);
    text-align: left;
  }
  .fh--hangR .fh__lock { justify-self: end; }

  /* brass tick — a graphic anchor above the stack, no words spent */
  .fh__tick {
    display: block;
    width: 1px; height: clamp(30px, 4.4vw, 54px);
    background: linear-gradient(to bottom, transparent, var(--brass));
    margin-bottom: clamp(0.9rem, 1.6vw, 1.6rem);
  }

  /* THE BRIDGE. The event's location, in the display stack with the name and
     in the page's mid voice — never in the credit register, which belongs to
     the photograph and says Block Island. */
  /* 9ch turns the name over after "Lion", so the name is a two-line block
     ~470px wide that sits entirely in the open water at the right of the
     frame. The picture's subject keeps its own third and the page's largest
     type stands in the empty one — neither is in front of the other. */
  .fh__h { max-width: 9ch; }

  /* The bar left the lock: it now spans the full shell, so the rule runs the
     whole horizon from the empty left rail to the cue, and the display block
     hanging above its right end is measured by it. */
  /* THE FOOT BAND. The kicker and the dateline used to sit above the name,
     which put 12px micro-caps and a 27px bridge line at 55–60% of the frame
     — over open sky at L* 57–62, four points past what the register can
     carry, and the meter said so. They belong in the deep zone or nowhere.
     They are now the left end of the bar strip at the foot of the frame,
     where the ramp is at full weight: the fact of the convening set small
     and dark under the name set enormous and light, a diagonal across the
     harbour with the rule running between them. */
  .fh__bar {
    grid-row: 2;
    margin-top: clamp(1.6rem, 3.2vw, 2.9rem);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.25rem, 2.6vw, 2.4rem);
  }
  .fh__meta { display: grid; gap: 0.35rem; }
  .fh__brow, .fh__place { margin: 0; max-width: none; }

  /* Local motion primitive: the masthead sits above motion.js's reveal
     rootMargin, so a scroll trigger can never fire here. Load-timed instead,
     same easings, no observer. */
  .fh__rule {
    display: block; height: 1px; width: 100%;
    background: var(--mark);
    transform: scaleX(0); transform-origin: left;
    animation: fhDraw 1150ms var(--ease-io) 460ms forwards;
  }
  .fh__tick, .fh__brow, .fh__place, .fh__cue {
    opacity: 0;
    animation: fhIn var(--dur-2) var(--ease-out) forwards;
  }
  .fh__tick  { animation-delay: 140ms; }
  .fh__brow  { animation-delay: 260ms; }
  .fh__place { animation-delay: 380ms; }
  .fh__cue   { animation-delay: 760ms; }
  @keyframes fhIn   { from { opacity: 0; transform: translate3d(0, 12px, 0); } to { opacity: 1; transform: none; } }
  @keyframes fhDraw { to { transform: scaleX(1); } }

  /* The shared .cue primitive from base.css. It used to be a <span>, i.e. a
     word that says Scroll and cannot be followed; it is a link now, like the
     other two on the site. */

  /* ── 2. The claim ────────────────────────────────────────────────── */
  /* The pause at the foot of this beat is bounded on both sides — the claim
     above it, the ledger's rule and numeral below it — which is the only way
     held space reads as confidence instead of as a hole. It used to be
     bounded by the plate; the bound is what matters, not which beat supplies
     it, and a rule with a numeral on its end is a harder stop than a
     photograph's top edge. */
  .fsay { padding-block: clamp(3rem, 2rem + 4.4vw, 6.5rem) var(--pause); }
  /* THE MEASURED ROW. The page's width was carrying nothing: 14 of 29 marks
     began at the same x and a 460px column on the right was empty for the
     whole scroll. The beat numerals are the one element here whose job is
     positional, so they now hang on the RIGHT edge of the measure and the
     hairline runs the full width between the rail and them. The rule stops
     being a decorative underline and starts being a span with a mark at each
     end — which is the only thing that makes 1338px read as a measure. */
  /* The wipe belongs to the RULE, not to the row. It used to sit on .frow,
     which meant (a) the numeral at the far end of a 1337px measure was still
     being uncovered a second and a half after the rule started, arriving as a
     vertical slice of a glyph rather than as a numeral, and (b) the row kept
     `clip-path: inset(0)` at rest, which permanently shaved the numeral's
     optical overhang off. Territory wipes; the mark arrives. */
  .frow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    column-gap: clamp(1.25rem, 4vw, 3.25rem);
  }
  .frow__rule {
    display: block; height: 1px; width: 100%;
    background: var(--rule);
    margin-bottom: 0.34em;
  }
  /* The house .index primitive — the site's one brass tabular numeral. This
     page used to set its own at 26.6px, which was a second index construction
     invented for one page and the only place the ladder forked. The rail the
     numerals anchor is positional, not typographic: it is the RIGHT edge of
     the measure, and the hairline spanning to it is what makes the numeral
     read as a mark on a measure rather than as a size. */
  .fnum {
    margin-right: -0.18em;
    margin-bottom: 0.1em;
  }
  .fsay__head {
    display: flex;
    align-items: baseline;
    gap: clamp(0.9rem, 1.6vw, 1.5rem);
    padding-top: clamp(0.9rem, 1.5vw, 1.35rem);
  }
  /* head + bridge are ONE object — the kicker — so the beat is two marks in
     a column, not three scattered ones. The interval that matters is the one
     under them, before the claim. */
  .fsay__who { margin-top: clamp(0.85rem, 1.5vw, 1.35rem); }
  /* The wrapper carries the reveal so the two italic verbs can hang off its
     .is-in; the h2 itself carries the settle. Two elements, two transforms,
     no fight. */
  .fsay__claim { --reveal-y: 0px; }
  /* THE HINGE. "build" and "decide" are the only two words in the sentence
     that are not roman, and they are the whole claim: they arrive 210ms after
     the line they sit in, so the page's best sentence has an event of its own
     rather than one more staggered fade. */
  /* Bound to --settle, not to .is-in: the hinge is now scroll-linked and
     REVERSIBLE, so a reader who scrubs back over the claim can find the
     two-holes-in-the-sentence moment again instead of it living once for
     500ms. Each verb has its own threshold on the same ramp, so they still
     arrive behind the roman and behind each other. */
  .fsay__p :global(em) {
    display: inline-block;
    --hinge: clamp(0, calc((var(--settle, 1) - 0.42) / 0.34), 1);
    /* floored, not zeroed: at rest the verbs are present but unresolved, so
       a still of this page is a whole sentence at two brightnesses rather
       than a sentence with two words missing. The event is the resolve. */
    opacity: calc(0.26 + 0.74 * var(--hinge));
    transform: translate3d(0, calc((1 - var(--hinge)) * 0.16em), 0);
  }
  .fsay__p :global(em:last-of-type) {
    --hinge: clamp(0, calc((var(--settle, 1) - 0.60) / 0.34), 1);
  }

  /* THE MEASURE FOLLOWS THE SIZE DOWN. 17ch was the shape of this sentence
     at 86px — three ranged lines about 570px wide. At --step-head the same
     17ch would be a 450px block half as tall, which is what a demotion looks
     like. 24ch sets it in two long, level lines instead: a smaller voice
     saying a longer thing, which is a different shape rather than a shrunken
     one, and it holds the same left-ranged column the rule and the numeral
     above it measure. */
  .fsay__p {
    max-width: 24ch;
    margin-top: clamp(1.6rem, 3.2vw, 2.8rem);
    /* the settle grows from the baseline the reader is already on */
    --settle-origin: 0% 100%;
    --settle-scale: 0.945;
    --settle-shift: 4vh;
  }

  /* ── The room band ──────────────────────────────────────────────────
     Absent from the built HTML until a Lion Forum photograph is on disk, so
     none of this matches today. Column-wide plates, one to three, ranged
     from the rail and CAPPED — a single frame must not grow to fill the
     measure, because the cap is the honest scale for a picture of guests at
     a private convening (refs/PHOTO-FACTS.md) and not a fallback shape. */
  .froom { padding-block: 0 clamp(1.2rem, 0.8rem + 1.8vw, 2.8rem); }
  /* The COUNT is a variable, not a media query, because the count is not
     known until the client sends files. One frame, two or three, the plate
     stays the same ~400px wide: the cap is on the LIST, so a single picture
     cannot grow to fill the measure and quietly become the full-bleed frame
     this band exists to avoid. */
  .froom__list {
    display: grid;
    grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr));
    gap: clamp(1rem, 2.2vw, 2rem);
    max-width: min(100%, calc(var(--n, 3) * 26rem));
    margin: 0; padding: 0; list-style: none;
  }

  /* ── 3. The ledger ──────────────────────────────────────────────── */
  /* The page's one change of axis. .on-panel retunes --rule / --fg-meta for
     the lighter ground; do not paint the background by hand. */
  .fbrief {
    padding-block: clamp(2.6rem, 1.8rem + 3.4vw, 5rem) clamp(3rem, 2rem + 4vw, 6rem);
  }
  /* ONE GRID, four rows: the eyebrow is the first term and the lede is the
     first definition, so the ledger's axis is established by the beat's own
     heading rather than arriving underneath it. */
  /* ONE AXIS AND ONE RIGHT EDGE. The lead row and the three rows below used
     to sit on different grids — the lead's terms hung at x=369, the rows'
     at x=305, a 143px offset repeated nowhere else on the site, which reads
     as drift rather than as a decision. Both now share this one grid, and
     the grid is the full measure, so the row hairlines end where the §02
     rule and its numeral end instead of stopping 394px short of them. */
  .fdef {
    display: grid;
    grid-template-columns: minmax(0, 0.24fr) minmax(0, 0.76fr);
    column-gap: clamp(1.25rem, 3vw, 2.6rem);
    align-items: baseline;
  }
  .fdef__t {
    text-align: right;
    margin: 0;
    /* micro caps sit above the x-height of the sentence beside them; drop
       them onto its first baseline rather than onto its box */
    transform: translateY(0.12em);
  }
  .fbrief__top { padding-top: clamp(1.1rem, 2vw, 1.7rem); }
  .fbrief__lede { max-width: 34ch; margin: 0; color: var(--fg); }

  /* THE RULES ARE EARNED OR THEY ARE PULLED BACK. They used to span the full
     1338px measure while every sentence in the list ended by x≈968 — 419px of
     hairline with nothing under it, four times. The list now measures itself:
     the block is capped so the rules end where the sentences do. The full-
     width span belongs to .frow, whose rule has a mark at its far end. */
  .fdefs { margin: clamp(1.9rem, 3.6vw, 3.2rem) 0 0; }
  .fdef--row {
    border-top: 1px solid var(--rule);
    padding-block: clamp(1rem, 2vw, 1.6rem);
  }
  .fdef--row:last-child { border-bottom: 1px solid var(--rule); }
  /* THE READING SIZE. There was none anywhere on this page. */
  .fdef__d {
    margin: 0;
    font-size: var(--step-body);
    line-height: 1.58;
    color: var(--fg-mute);
    max-width: 62ch;
    text-wrap: pretty;
  }

  /* ── The plate ───────────────────────────────────────────────────── */
  /* NOT IN THE BUILD TODAY — the slot is empty and none of this matches the
     rendered page. It is kept whole, and tuned, because the day a Lion Forum
     stage frame lands in /media/ this is the band it arrives in.

     A BAND, not a screen. Roughly 16:5.5 at 1440 and always shorter than the
     viewport, so the pause is bounded by the ledger above and the cream below
     rather than by two screen edges — which was the same held-space failure
     the rest of the site was fixing, relocated to a photograph.

     The frame it takes must be a DIFFERENT PHOTOGRAPH, not a crop of the
     masthead's. That was the old arrangement and it failed the only test that
     matters: a reviewer looked at the render and saw the same harbour twice.
     If the stage frame ever turns out to be the same scene as the masthead's,
     leave this slot empty rather than filling it. */
  .fplate {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: clamp(400px, 62svh, 600px);
  }
  /* THE APPROACH. Scroll-linked, reversible: the band sits 5.5% large while
     it is arriving and closes to 1.000 at reading position, so the duration
     of the pause is something the reader is doing rather than watching. */
  .fplate__frame {
    position: absolute;
    inset: 0;
    --settle-scale: 1.055;
    --settle-shift: 0vh;
    --settle-origin: 50% 50%;
  }
  /* The band carries NO type. Its one mark is the photograph's own credit —
     Figure's corner voice, in the deep zone of a bottom-left ramp, which is
     the only place on a photograph the meta register is legal. The bridge
     line that once sat on the water was a fourth slogan on a page that was
     already being sold with slogans; the plate's job is the picture. */

  /* ── The close, on cream ─────────────────────────────────────────── */
  /* THE PAGE TURNED OVER. Full-bleed .on-cream, arriving directly off the
     page's own navy: L* 15 → L* 92, the largest step the system owns, spent
     once, on the page's actual job. .on-cream retunes the ink levels, the
     rules and --brass (to --brass-deep) for the light ground — never paint it
     by hand. Ground budget: hero photograph, this, and the plate when it has
     a picture. Three, the ceiling, which is why the ledger's .on-panel band
     came off — a 13-point step on a 255 scale was costing a ground event and
     reading as nothing. The step used to be measured off the plate's dark
     foot; with the plate empty it is measured off flat navy, which is the
     same L* and a cleaner edge for the curtain below to retract from. */
  .frole {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3.2rem, 2rem + 5vw, 7rem) clamp(2rem, 1.4rem + 1.8vw, 3rem);
  }
  .frole__shell { position: relative; z-index: 0; }

  /* THE CUT, ANIMATED. This edge — L* 15 navy to L* 92 cream — is the
     largest tonal event on the site, and it was the only one the page did
     not move: the hero parallaxes, the claim settles, and then the page's
     biggest moment simply appeared.

     A navy curtain sits over the cream and retracts to the left as the
     reader scrolls into the section, so the ground itself turns over rather
     than arriving already turned. It is scroll-linked, therefore reversible,
     and it is the same left-to-right vector the page's rules already wipe
     along — a fourth motion KIND would be decoration; this is the third,
     used at the one place that deserves it. */
  .frole__cut {
    position: absolute;
    inset: -1px;
    z-index: 1;
    pointer-events: none;
    background: var(--ink-900);
    --cut: clamp(0, calc((var(--settle, 1) - 0.06) / 0.34), 1);
    transform: scaleX(calc(1 - var(--cut)));
    transform-origin: 100% 50%;
  }
  /* THE ONE BEAT THAT DOES NOT BEGIN AT THE RAIL. Above it the page opens
     flush left four times; here the eyebrow holds a narrow rail and the
     sentence starts at ~34% and runs into the right-hand column the rest of
     the page leaves empty. */
  /* Two rows now: the rail's eyebrow at the top, its invitation note at the
     foot, and the sentence spanning both on the right. The indent is
     unchanged — the display still starts at 34% — but the column beside it
     is no longer 700px of nothing. */
  .frole__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.34fr) minmax(0, 0.66fr);
    grid-template-rows: auto minmax(0, 1fr);
    column-gap: clamp(1.25rem, 4vw, 3.25rem);
    padding-top: clamp(1.1rem, 2vw, 1.9rem);
  }
  .frole__brow { margin: 0; transform: translateY(0.55em); grid-area: 1 / 1; }
  .frole__body { display: grid; justify-items: start; grid-area: 1 / 2 / 3 / 3; }

  /* THE QUIET END OF THE DIAGONAL. Smallest voice on the section, hung at
     the bottom of the rail so it sits on the ask's line, with the page's own
     brass hairline over it — the same mark the CTA uses, at a fifth of the
     weight, so the two read as one object at two volumes. */
  .frole__invite {
    grid-area: 2 / 1;
    align-self: end;
    max-width: 30ch;
    padding-bottom: clamp(0.3rem, 1vw, 0.9rem);
  }
  .frole__inviteRule {
    display: block; height: 1px; width: clamp(28px, 4vw, 46px);
    background: var(--rule);
    margin-bottom: clamp(0.8rem, 1.4vw, 1.1rem);
  }
  .frole__inviteT { margin: 0 0 0.55rem; }
  .frole__inviteL {
    margin: 0;
    font-size: var(--step-body);
    line-height: 1.5;
    color: var(--fg-mute);
    text-wrap: pretty;
  }
  .frole__inviteL + .frole__inviteL { margin-top: 0.45em; }
  /* THE SERIES-BREAKER, used once. --step-feature exists to lift one thing
     out of a set; on this page the set is four beats at head/poster/banner
     and this is the fifth, on the opposite ground, at the rung none of them
     use. It is allowed a wide measure because the width is the point. */
  .frole__p {
    max-width: 20ch;
    color: var(--fg);
    text-wrap: balance;
    margin: 0 0 clamp(1.1rem, 2vw, 1.7rem);
  }
  .frole__note {
    margin: 0;
    font-size: var(--step-lede);
    line-height: 1.5;
    color: var(--fg-mute);
    max-width: 36ch;
    text-wrap: pretty;
  }

  /* The one ask on the page. The footer's quieter Forum door is suppressed on
     this route (see below), so this is the close, singular. */
  .frole__cta {
    display: grid;
    gap: clamp(0.7rem, 1.1vw, 1rem);
    justify-items: start;
    padding-block: 0.4rem 0.6rem;
    margin-top: clamp(2.2rem, 5vw, 4rem);
    color: var(--fg);
  }
  .frole__ctaText {
    color: var(--fg);
    display: inline-flex; align-items: baseline; gap: 0.6ch;
    position: relative;
    max-width: none;
    text-transform: none;
  }
  .frole__ctaText :global(.arrow) { width: 0.72em; align-self: center; transition: transform 520ms var(--ease-out); }
  /* The address, inside the door, one rung down. It is the .label register,
     so it can never compete with the verb above it; it lights with the rest
     of the link rather than being a second thing to click. */
  /* Lowercase, and not because caps are ugly: micro-caps plus .label's
     tracking put a 30-character address 4px past the right edge of a 390
     viewport, and an address is the one string on this site that is written
     down somewhere else and must match it. Same treatment /partner/ gives
     it — sans, its own case, allowed to break rather than to overflow. */
  .frole__ctaMail {
    color: var(--fg-meta);
    text-transform: none;
    letter-spacing: 0.015em;
    overflow-wrap: anywhere;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .frole__cta:hover .frole__ctaMail,
  .frole__cta:focus-visible .frole__ctaMail { color: var(--brass); }
  .frole__ctaRule {
    display: block; height: 1px; width: clamp(34px, 5vw, 72px);
    background: var(--brass);
    transition: width 520ms var(--ease-out);
  }
  .frole__cta:hover .frole__ctaRule,
  .frole__cta:focus-visible .frole__ctaRule { width: clamp(54px, 9vw, 132px); }
  .frole__cta:hover :global(.arrow),
  .frole__cta:focus-visible :global(.arrow) { transform: translateX(4px); }
  .frole__ctaText::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -0.24em; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: right;
    transition: transform 520ms var(--ease-out);
  }
  .frole__cta:hover .frole__ctaText::after,
  .frole__cta:focus-visible .frole__ctaText::after { transform: scaleX(1); transform-origin: left; }

  /* THE DUPLICATE ASK. The footer's secondary door is "Inquire about the Lion
     Forum" → /forum/. On this route that is a link to the page you are on,
     330px under an ask with the same words, so the page had two endings and
     one of them was a self-reference. Suppressed here only. */
  :global(.foot .foot__second) { display: none !important; }

  /* ── Mobile ──────────────────────────────────────────────────────── */
  @media (max-width: 860px) {
    /* No open half to set into at 390: the lock comes back to the rail, the
       name turns over, and the bar stacks its meta above the rule. */
    /* Matches `.fh--hangR .fh__lock`'s specificity on purpose: the right-hand
       set is a desktop answer to a desktop frame's empty half, and a 0,1,0
       rule here silently lost to it and hung the name off the right edge of
       a 390 screen. There is no open half at this width on any photograph. */
    .fh .fh__lock, .fh--hangR .fh__lock { width: auto; justify-self: stretch; max-width: 100%; }
    .fh__bar { grid-template-columns: minmax(0, 1fr) auto; row-gap: 1.1rem; }
    .fh__meta { grid-column: 1 / -1; }

    .fsay { padding-block: clamp(2.5rem, 8vw, 3.5rem) clamp(2.75rem, 10vw, 4.5rem); }
    /* Same move as the desktop measure: 13ch was the block at --step-poster,
       17ch is the same block at --step-head. */
    .fsay__p { max-width: 17ch; }

    .fbrief { padding-block: clamp(2.2rem, 8vw, 3.2rem) clamp(2.6rem, 9vw, 3.8rem); }
    /* THE SECOND AXIS SURVIVES THE PHONE. The ledger used to stack flush left
       below 860, which left the whole mobile page as one column at x=24 for
       2934px. The terms now HANG in the left margin at micro size instead —
       a 4.6rem rail, right-aligned against a narrow sentence measure. That is
       the same decision the desktop makes, taken at a size a phone can pay
       for. The heading row still stacks: a lede does not belong in 26ch. */
    .fdef { grid-template-columns: 4.6rem minmax(0, 1fr); column-gap: 0.9rem; }
    .fdef__d { max-width: none; }
    .fdef__t { text-align: right; transform: translateY(0.14em); }
    .fbrief__top { grid-template-columns: minmax(0, 1fr); row-gap: 0.7rem; }
    .fbrief__top .fdef__t { text-align: left; transform: none; }
    .fbrief__lede { max-width: 26ch; }
    .fdefs { max-width: 100%; }
    .fdef__d { max-width: none; }

    .fplate { height: clamp(340px, 52svh, 460px); }

