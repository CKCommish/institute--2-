---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { forum } from '../data/site.js';

/* The room plate has no dedicated frame of its own yet. It names the file it
   wants first and falls back to the interior in public/media/ — Figure takes
   the first candidate that is actually on disk at build time. */
const roomPlate = [forum.imageDetail, '/media/institute.jpg'];
---
<Base title="Forum" description="The Lion Forum: an invitation-only convening at the Kennedy Compound, Hyannis Port.">
  <!-- 1 ── full bleed. Name, then a hairline carrying the three facts. -->
  <section class="fh">
    <Figure src={forum.image} alt="" ratio="auto" grade={0.6} parallax={6} scrim="bottom" loading="eager" class="fh__bg" />

    <div class="shell fh__in">
      <div class="fh__tick" aria-hidden="true"></div>
      <h1 class="display display--hero fh__h lines">{forum.name}</h1>

      <div class="fh__bar">
        <span class="fh__rule" aria-hidden="true"></span>
        <div class="fh__cells">
          <span class="cap fh__cell">{forum.place}</span>
          <span class="label fh__cell fh__cell--b">{forum.access}</span>
          <span class="label fh__cell fh__cue">
            Scroll<i class="fh__cueLine" aria-hidden="true"></i>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 ── one sentence, alone, at display size. -->
  <section class="scene fsay">
    <div class="shell fsay__in">
      <p class="label fsay__k" data-reveal>The convening</p>
      <p class="display display--xl fsay__p lines">{forum.line}</p>
    </div>
  </section>

  <!-- 3 ── the room. The tallest object on the page, and the only one held to
       the text measure: the margin beside it carries the caption. -->
  <section class="fplate">
    <figure class="shell fplate__in">
      <figcaption class="fplate__cap">
        <i class="fplate__tick" data-reveal="360" aria-hidden="true"></i>
        <span class="cap" data-reveal="440">{forum.caption}</span>
      </figcaption>

      <div class="fplate__frame">
        <Figure src={roomPlate} alt="" ratio="auto" grade={0.72} parallax={7}
                focal="50% 46%" enter="wipe" sizes="(max-width: 860px) 100vw, 66vw" />
      </div>
    </figure>
  </section>

  <!-- 4 ── the Institute's relationship to it, and the quiet CTA. -->
  <section class="frole">
    <div class="shell">
      <div class="frole__in">
        <div class="frole__side">
          <div class="frole__ruleWrap" data-reveal="60"><span class="frole__rule"></span></div>
          <p class="label frole__k" data-reveal="140">The Institute's role</p>
        </div>
        <div class="frole__body">
          <p class="frole__p lines">{forum.role}</p>
          <a class="frole__cta" href="/partner/" data-reveal="300">
            {forum.cta}
            <svg viewBox="0 0 14 10" aria-hidden="true"><path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.1" fill="none"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Two ranks of small type. `.label` (global) is the section marker: tracked,
     uppercase, 11.7px. `.cap` is the photograph's own voice: sentence case,
     untracked, smaller, quieter — so the page's small type is not one flat
     band of interchangeable objects. Local because it is a Forum/Figure idea. */
  .cap {
    font-family: var(--sans);
    font-size: clamp(0.62rem, 0.6rem + 0.1vw, 0.665rem);
    font-weight: 400;
    letter-spacing: 0.012em;
    line-height: 1.35;
    text-transform: none;
    color: color-mix(in srgb, var(--cream) 58%, transparent);
  }

  /* ── 1. Hero ─────────────────────────────────────────────────────── */
  .fh {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    isolation: isolate;
  }
  .fh__bg { position: absolute; inset: 0; aspect-ratio: auto; z-index: -1; }
  .fh__in {
    width: 100%;
    padding-block: var(--nav-h) clamp(1.5rem, 2.6vw, 2.6rem);
  }

  /* brass tick — a graphic anchor above the name, no words spent */
  .fh__tick {
    width: 1px; height: clamp(34px, 5vw, 62px);
    background: linear-gradient(to bottom, transparent, var(--brass));
    margin-bottom: clamp(1rem, 1.8vw, 1.8rem);
  }

  .fh__h { max-width: 13ch; }

  .fh__bar { margin-top: clamp(2.5rem, 6vw, 5rem); }

  /* Local motion primitive: the hero bar sits below motion.js's reveal
     rootMargin (-12%), so scroll-triggered reveal never fires above the fold.
     This block is a load-time entrance instead — same easings, no observer. */
  .fh__rule {
    display: block; height: 1px; width: 100%;
    background: color-mix(in srgb, var(--cream) 26%, transparent);
    transform: scaleX(0); transform-origin: left;
    animation: fhDraw 1150ms var(--ease-io) 340ms forwards;
  }
  .fh__tick, .fh__cell {
    opacity: 0;
    animation: fhIn var(--dur-2) var(--ease-out) forwards;
  }
  .fh__tick { animation-delay: 140ms; }
  .fh__cell:nth-child(1) { animation-delay: 620ms; }
  .fh__cell:nth-child(2) { animation-delay: 700ms; }
  .fh__cell:nth-child(3) { animation-delay: 780ms; }
  @keyframes fhIn  { from { opacity: 0; transform: translate3d(0, 12px, 0); } to { opacity: 1; transform: none; } }
  @keyframes fhDraw { to { transform: scaleX(1); } }

  .fh__cells {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: clamp(1.25rem, 4vw, 3.5rem);
    padding-top: clamp(0.85rem, 1.4vw, 1.15rem);
  }
  .fh__cell--b { color: var(--brass); }

  .fh__cue { display: inline-flex; align-items: center; gap: 0.85em; color: color-mix(in srgb, var(--cream) 66%, transparent); }
  .fh__cueLine {
    position: relative; display: block;
    width: 1px; height: 26px; overflow: hidden;
    background: color-mix(in srgb, var(--cream) 22%, transparent);
    align-self: center;
  }
  .fh__cueLine::after {
    content: ''; position: absolute; inset: 0;
    background: var(--brass);
    animation: fhCue 2600ms var(--ease-io) infinite;
  }
  @keyframes fhCue {
    0%   { transform: translateY(-100%); }
    55%  { transform: translateY(100%); }
    100% { transform: translateY(100%); }
  }

  /* ── 2. The sentence ─────────────────────────────────────────────── */
  /* Deliberately shorter than --scene-pad: this beat must not measure the
     same as the photograph below it. */
  .fsay { padding-block: clamp(3rem, 2.4rem + 4.8vw, 8rem); }
  .fsay__in {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    column-gap: clamp(1rem, 4vw, 4rem);
    align-items: start;
  }
  .fsay__k { padding-top: 0.85em; }
  .fsay__p { max-width: 16ch; }
  /* The shared .lines mask (base.css) clips descenders at this size. Give the
     mask box room locally and lengthen the travel to keep it hidden. The
     spans are built at runtime, so they need :global(). */
  .fsay__p :global(.line) { padding-bottom: 0.16em; margin-bottom: -0.16em; }
  .fsay__p :global(.line > span) { transform: translate3d(0, 130%, 0); }
  .fsay__p.is-in :global(.line > span) { transform: none; }

  /* ── 3. The room ─────────────────────────────────────────────────── */
  .fplate { padding-block: clamp(1rem, 2vw, 2.5rem) clamp(3rem, 6vw, 7rem); }
  .fplate__in {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    column-gap: clamp(1rem, 4vw, 4rem);
    align-items: start;
  }
  /* The one object on the page that is neither full-bleed nor a paragraph:
     held to the 9-column measure and taken to nearly the full viewport, so
     the scroll changes width, height and tempo all at once. */
  .fplate__frame {
    position: relative;
    isolation: isolate;
    height: clamp(520px, 88svh, 900px);
  }
  /* The caption rides the photograph's top edge, so the frame and the words
     that name it arrive in the same glance. */
  .fplate__cap {
    display: grid;
    justify-items: start;
    gap: clamp(0.7rem, 1vw, 1rem);
    padding-top: clamp(0.35rem, 0.7vw, 0.7rem);
    max-width: 22ch;
  }
  .fplate__tick {
    --reveal-y: 0px;
    display: block; width: clamp(24px, 2.6vw, 40px); height: 1px;
    background: var(--brass);
  }

  /* ── 4. Role + CTA ───────────────────────────────────────────────── */
  .frole { --fgap: clamp(1rem, 4vw, 4rem); padding-block: clamp(3rem, 5.5vw, 7rem) clamp(3.5rem, 6vw, 7.5rem); }
  .frole__in {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    column-gap: var(--fgap);
    align-items: start;
  }
  /* Held to the label field, not the page: the hero's hairline is a full-width
     break, this one only opens a column. */
  .frole__ruleWrap { --reveal-y: 0px; display: block; }
  .frole__rule {
    display: block; height: 1px; width: 100%;
    background: var(--rule);
    transform: scaleX(0); transform-origin: left;
    transition: transform 900ms var(--ease-io) 60ms;
  }
  .frole__ruleWrap.is-in .frole__rule { transform: scaleX(1); }
  .frole__k { padding-top: clamp(0.9rem, 1.35vw, 1.25rem); }
  .frole__body { display: grid; gap: clamp(2rem, 3.6vw, 3.25rem); justify-items: start; }
  /* The missing intermediate step: between the 86px thesis and the 12px
     labels the page had nothing but body copy. The Institute's role is the
     one place worth spending a mid-display size on. */
  .frole__p {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 1.02rem + 1.9vw, 2.55rem);
    line-height: 1.2;
    font-weight: 300;
    letter-spacing: -0.012em;
    color: color-mix(in srgb, var(--cream) 84%, transparent);
    max-width: 26ch;
    text-wrap: pretty;
  }
  .frole__p :global(.line) { padding-bottom: 0.14em; margin-bottom: -0.14em; }
  .frole__p :global(.line > span) { transform: translate3d(0, 120%, 0); }
  .frole__p.is-in :global(.line > span) { transform: none; }

  .frole__cta {
    display: inline-flex; align-items: center; gap: 0.9ch;
    font-size: var(--step-label); letter-spacing: 0.145em;
    text-transform: uppercase; font-weight: 500;
    color: var(--cream);
    position: relative;
  }
  .frole__cta svg { width: 0.95em; height: auto; transition: transform 460ms var(--ease-out); }
  .frole__cta:hover svg { transform: translateX(4px); }
  /* local hover rule — the shared .link underline assumes inline-block */
  .frole__cta::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -0.45em; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: right;
    transition: transform 520ms var(--ease-out);
  }
  .frole__cta:hover::after { transform: scaleX(1); transform-origin: left; }

  /* ── Mobile ──────────────────────────────────────────────────────── */
  @media (max-width: 860px) {
    .fsay__in, .frole__in { grid-template-columns: minmax(0, 1fr); row-gap: clamp(1.5rem, 5vw, 2.25rem); }
    .fsay__k { padding-top: 0; }
    .frole__k { padding-top: clamp(0.9rem, 3vw, 1.2rem); }
    .fsay__p { max-width: 13ch; }
    .frole__p { max-width: 20ch; }

    /* On a phone the 9-column trick is gone, so the plate takes its contrast
       the other way: edge to edge, and still by far the tallest beat. */
    .fplate { padding-block: clamp(0.5rem, 2vw, 1.5rem) clamp(2rem, 6vw, 3rem); }
    .fplate__in { grid-template-columns: minmax(0, 1fr); row-gap: clamp(0.9rem, 3vw, 1.2rem); }
    .fplate__frame {
      order: -1;
      height: clamp(440px, 76svh, 720px);
      margin-inline: calc(var(--gutter) * -1);
    }
    .fplate__cap { max-width: 26ch; }
    /* keep the two hairlines different ranks where the margin column is gone */
    .frole__ruleWrap { width: 42%; }
  }
  @media (max-width: 620px) {
    .fh__h { max-width: 9ch; }
    .fh__cells { grid-template-columns: 1fr auto; row-gap: 0.9rem; }
    .fh__cell:first-child { grid-column: 1 / -1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .frole__rule { transition-duration: 1ms; }
    .fh__rule { animation: none; transform: scaleX(1); }
    .fh__tick, .fh__cell { animation: none; opacity: 1; }
    .fh__cueLine::after { animation: none; transform: translateY(0); }
  }
</style>
